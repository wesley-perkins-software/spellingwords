---
// Shared layout + design-token system for "Exploration B" prototype.
// Self-contained: does NOT import production global.css or tailwind.config tokens.
// File is prefixed with an underscore so Astro excludes it from routing.
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;600;700;800;900&family=Work+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* ============================================================
         EXPLORATION B — design token system (prototype-only)
         Canvas philosophy: a warm, hue-present blush that shifts between
         bands. Colour is a genuine duotone anchor (sunset coral + deep
         teal-navy) spent structurally — the nav bar, section bands, and
         the practice card's top edge — not confined to one dark panel.
         ============================================================ */
      :root {
        /* Canvas — warm blush, never gray-blue near-white, never beige */
        --canvas: #fbeee6;
        --canvas-band-warm: #f8ddca;
        --canvas-band-cool: #e4efec;
        --canvas-raised: #fffbf8;
        --canvas-sunken: #f3e2d6;

        /* Ink — warm charcoal, not cool black */
        --ink: #241d18;
        --ink-soft: #5c4f45;
        --ink-faint: #6d5f54;
        --ink-on-teal: #f3ece3;
        --ink-on-teal-soft: #b9d6d1;

        /* Borders */
        --border: #e6d3c4;
        --border-strong: #d3b9a3;
        --border-interactive: #a68a72;

        /* Brand duotone anchor. --coral is the vivid decorative/large-display
           shade (headline accent, borders, non-text UI fills); --coral-strong
           is the AA-safe shade for small text, links, and button labels. */
        --coral: #e2521f;
        --coral-strong: #9c3410;
        --coral-strong-hover: #7c260c;
        --coral-tint: #fbe0d2;
        --teal: #0d3b3c;
        --teal-strong: #082728;
        --teal-tint: #d9ece9;
        --teal-bright: #1c6b69;

        /* Grade wayfinding accents — saturated, used in small doses */
        --gold: #8a5c0f;
        --gold-tint: #f6e6c8;
        --plum: #7a3f7a;
        --plum-tint: #f1e0ee;
        --sky: #1f6f8b;
        --sky-tint: #dcedf3;

        /* Feedback — calm, never the sole signal (paired with icon/text) */
        --correct-bg: #e1f2e3;
        --correct-ink: #1e6b34;
        --correct-border: #a3d6ab;
        --incorrect-bg: #fbe3df;
        --incorrect-ink: #a3311f;
        --incorrect-border: #eab3a8;

        --focus-ring: #e2521f;

        --font-display: 'Unbounded', 'Arial Black', system-ui, sans-serif;
        --font-body: 'Work Sans', system-ui, -apple-system, sans-serif;
        --font-word: 'IBM Plex Mono', 'Courier New', monospace;

        --radius-sm: 6px;
        --radius-md: 12px;
        --radius-lg: 20px;
        --radius-btn: 14px;

        --shadow-sm: 0 1px 2px rgba(36, 29, 24, 0.08), 0 1px 1px rgba(36, 29, 24, 0.05);
        --shadow-md: 0 10px 26px rgba(36, 29, 24, 0.12), 0 3px 8px rgba(36, 29, 24, 0.07);
        --shadow-card: 0 18px 40px rgba(13, 59, 60, 0.16);

        color-scheme: light;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--canvas);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }

      img {
        max-width: 100%;
        display: block;
      }

      a {
        color: inherit;
      }

      h1,
      h2,
      h3,
      h4 {
        font-family: var(--font-display);
        margin: 0;
        color: var(--ink);
        font-weight: 700;
        letter-spacing: -0.01em;
      }

      p {
        margin: 0;
      }

      button {
        font-family: inherit;
      }

      :focus-visible {
        outline: 3px solid var(--focus-ring);
        outline-offset: 3px;
        border-radius: 6px;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
      }

      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        background: var(--teal);
        color: var(--ink-on-teal);
        padding: 0.75rem 1.25rem;
        border-radius: var(--radius-sm);
        font-weight: 700;
        z-index: 100;
        transition: top 0.15s ease;
      }
      .skip-link:focus {
        top: 1rem;
      }

      .wrap {
        max-width: 1240px;
        margin-inline: auto;
        padding-inline: clamp(1.25rem, 4vw, 3rem);
      }

      /* Prototype corner badge — clearly marks this as design exploration */
      .proto-badge {
        position: fixed;
        bottom: 10px;
        right: 10px;
        z-index: 999;
        background: rgba(13, 59, 60, 0.82);
        backdrop-filter: blur(3px);
        color: #fff;
        font-family: var(--font-body);
        font-size: 9.5px;
        font-weight: 600;
        letter-spacing: 0.02em;
        padding: 4px 9px;
        border-radius: 999px;
        opacity: 0.85;
        pointer-events: none;
        box-shadow: 0 1px 6px rgba(0, 0, 0, 0.3);
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <span class="proto-badge" aria-hidden="true">Design exploration — Exploration B</span>
  </body>
</html>
