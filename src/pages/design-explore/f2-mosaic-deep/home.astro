---
import Layout from './_Layout.astro';

const grades = [
  { g: 'K', color: 'var(--grade-k)', desc: 'First sounds, letters, and three-letter words.' },
  { g: '1', color: 'var(--grade-1)', desc: 'Silent e, letter teams, everyday high-frequency words.' },
  { g: '2', color: 'var(--grade-2)', desc: 'Blends, digraphs, and longer word families.' },
  { g: '3', color: 'var(--grade-3)', desc: 'Prefixes, suffixes, and multi-syllable patterns.' },
  { g: '4', color: 'var(--grade-4)', desc: 'Latin roots and more demanding spelling patterns.' },
  { g: '5', color: 'var(--grade-5)', desc: 'Advanced patterns getting students ready for middle school.' },
];

const skills = ['Short A Words', 'Long A Silent E Words', 'Soft C and Soft G', 'Consonant Blends', 'Silent Letters'];
---

<Layout title="Home">
  <header class="explore-f2__header">
    <div class="explore-f2__header-inner">
      <span class="explore-f2__wordmark">spelling<span class="accent">words</span></span>
      <nav class="explore-f2__nav">
        <a href="#grades">Grades</a>
        <a href="#skills">Skills</a>
        <a href="#">How it works</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- Hero: exactly one dominant color region + one neutral region. Nothing else competes. -->
    <section class="wrap" style="padding: 8px 24px 8px;">
      <div class="hero-mosaic">
        <div class="tile tile--dominant" style="display: flex; flex-direction: column; justify-content: center; gap: 16px; padding: 36px;">
          <span class="badge" style="background: rgba(255,255,255,0.2); align-self: flex-start;">Practice · Any List</span>
          <h1 style="font-size: clamp(28px, 3.6vw, 42px); line-height: 1.08;">
            One dominant color. Everything else rests.
          </h1>
          <p style="font-size: 16px; opacity: 0.92; max-width: 46ch; line-height: 1.6;">
            Paste your own list or follow a grade-level path. Hear each word, then type it.
            The eye gets exactly one place to land.
          </p>
        </div>
        <div class="panel" style="display: flex; flex-direction: column; overflow: hidden;">
          <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; border-bottom: 1px solid var(--border);">
            <span style="font-size: 12.5px; font-weight: 700; color: var(--ink-soft); text-transform: uppercase; letter-spacing: 0.03em;">Your Words</span>
            <span style="font-size: 12px; font-weight: 700; background: var(--dominant); color: #fff; padding: 3px 9px; border-radius: 999px;">0</span>
          </div>
          <textarea
            rows="5"
            placeholder="Type or paste your words here, one per line"
            style="flex: 1; width: 100%; border: none; resize: none; padding: 16px 18px; font-family: var(--font-word); font-size: 16px; color: var(--ink); background: transparent;"
          ></textarea>
          <div style="padding: 14px 18px; border-top: 1px solid var(--border);">
            <button type="button" class="btn btn--primary" style="width: 100%;">Start Practicing</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Browse by Grade: the one place the full palette earns its keep — six items genuinely need to be told apart. -->
    <section id="grades" class="wrap" style="padding: 48px 24px 20px;">
      <h2 style="font-size: 24px; margin-bottom: 8px;">Browse by Grade</h2>
      <p style="color: var(--ink-soft); max-width: 60ch; margin-bottom: 20px;">
        A Kindergarten&ndash;5th grade path across Core Spelling, High-Frequency Words, and Themed Practice.
      </p>
      <div class="mosaic grade-mosaic">
        {grades.map((item) => (
          <a href="#" class="tile" style={`background: ${item.color}; color: #fff; text-decoration: none; padding: 18px 16px; min-height: 130px; display: flex; flex-direction: column; justify-content: space-between;`}>
            <span style="font-family: var(--font-display); font-weight: 800; font-size: 28px; line-height: 1;">{item.g}</span>
            <p style="font-size: 12px; opacity: 0.95; line-height: 1.4;">{item.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Browse by Skill: neutral tiles, one restrained contrast tag — not five competing hues. -->
    <section id="skills" class="wrap" style="padding: 34px 24px 56px;">
      <h2 style="font-size: 24px; margin-bottom: 8px;">Browse by Skill</h2>
      <p style="color: var(--ink-soft); max-width: 60ch; margin-bottom: 18px;">
        Already know what to work on? Explore 41 spelling skills, each with its own practice bank.
      </p>
      <div class="panel" style="max-width: 700px; overflow: hidden;">
        {skills.map((s, i) => (
          <a href="#" style={`display: flex; align-items: center; justify-content: space-between; padding: 15px 18px; text-decoration: none; color: inherit; ${i < skills.length - 1 ? 'border-bottom: 1px solid var(--border);' : ''}`}>
            <span style="font-family: var(--font-display); font-weight: 700; font-size: 15.5px;">{s}</span>
            <span class="tag">Phonics</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <footer class="explore-f2__footer">
    <div class="wrap">No accounts. No timers. Just spelling.</div>
  </footer>
</Layout>
