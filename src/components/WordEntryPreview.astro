---
interface Props {
  words: string[];
}

const { words } = Astro.props;
---

<div
  class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-lg"
  role="figure"
  aria-label="Word entry panel — example preview"
>
  <!-- Label bar -->
  <div class="flex items-center justify-between border-b border-slate-100 bg-slate-50 px-5 py-3">
    <span class="text-xs font-bold uppercase tracking-widest text-app-charcoal/40">
      Enter one word per line
    </span>
    <span
      class="rounded-full bg-classroom-blue/12 px-3 py-0.5 text-xs font-bold text-classroom-blue"
      aria-label={`${words.length} words`}
    >
      {words.length} words
    </span>
  </div>

  <!-- Word lines — simulates a real textarea -->
  <div
    class="px-5 py-3"
    aria-label="Example spelling words"
  >
    {
      words.map((word: string) => (
        <div class="flex items-center border-b border-slate-100 py-2.5 last:border-0">
          <span class="font-sans text-base font-medium text-app-charcoal">{word}</span>
        </div>
      ))
    }
    <!-- Blinking cursor — signals this is an input area -->
    <div class="flex items-center py-2">
      <span class="cursor" aria-hidden="true"></span>
    </div>
  </div>

  <!-- Preview footer -->
  <div class="border-t border-slate-100 bg-slate-50/80 px-5 py-2.5">
    <p class="text-xs text-slate-400">
      Preview only — paste your own words to get started
    </p>
  </div>
</div>

<style>
  .cursor {
    display: inline-block;
    width: 2px;
    height: 1.125rem;
    background-color: #3B82F6;
    border-radius: 1px;
    vertical-align: middle;
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>
