---
// Design exploration — Direction 3: "Shifting Environments"
// Homepage / arrival environment. Standalone prototype: no Layout, no production tokens.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>spellingwords.app — Practice spelling words (Design exploration)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,560;0,9..144,650;1,9..144,500&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="proto-badge" aria-hidden="true">Design exploration — Shifting Environments</div>

    <div class="env-arrival">
      <header class="topline">
        <a class="wordmark" href="/design-explore/shifting-environments/">
          <span class="wordmark-mark">sw</span>spellingwords
        </a>
        <nav class="topnav" aria-label="Prototype navigation">
          <a href="/design-explore/shifting-environments/grade-hub">Grade Hub</a>
          <a href="/design-explore/shifting-environments/skill">Skill page</a>
          <a href="/design-explore/shifting-environments/practice">Practice</a>
        </nav>
      </header>

      <main>
        <section class="hero">
          <p class="hero-eyebrow">Spelling practice, out loud</p>
          <h1 class="hero-title">Hear a word.<br />Write it down.<br />That&rsquo;s the whole idea.</h1>
          <p class="hero-sub">
            No timers, no points, no leaderboard. Just a calm way for kids to practice the words
            that trip them up &mdash; read aloud, typed by hand, one list at a time.
          </p>
        </section>

        <section class="plate plate-input" aria-labelledby="own-words-h">
          <div class="plate-glow" aria-hidden="true"></div>
          <h2 id="own-words-h">Enter your spelling words</h2>
          <p class="plate-hint">Got a list from school this week? Paste it in and start right away.</p>
          <form class="word-form">
            <label class="sr-only" for="words">Enter your spelling words</label>
            <textarea
              id="words"
              name="words"
              rows="5"
              placeholder="Type or paste your words here, one per line"
            ></textarea>
            <div class="form-row">
              <span class="form-note">10 words a session, by default &mdash; you can change that later.</span>
              <button type="submit" class="btn-primary">Start Practicing</button>
            </div>
          </form>
        </section>

        <section class="strip" aria-labelledby="grade-h">
          <div class="strip-head">
            <h2 id="grade-h">Browse by Grade</h2>
            <p>Word lists mapped to what kids are actually learning in class, K&ndash;5.</p>
          </div>
          <ul class="shelf" role="list">
            <li><a href="/design-explore/shifting-environments/grade-hub"><span class="shelf-grade">K</span><span class="shelf-label">Kindergarten</span></a></li>
            <li><a href="/design-explore/shifting-environments/grade-hub"><span class="shelf-grade">1</span><span class="shelf-label">1st Grade</span></a></li>
            <li><a href="/design-explore/shifting-environments/grade-hub"><span class="shelf-grade">2</span><span class="shelf-label">2nd Grade</span></a></li>
            <li><a href="/design-explore/shifting-environments/grade-hub"><span class="shelf-grade">3</span><span class="shelf-label">3rd Grade</span></a></li>
            <li><a href="/design-explore/shifting-environments/grade-hub"><span class="shelf-grade">4</span><span class="shelf-label">4th Grade</span></a></li>
            <li><a href="/design-explore/shifting-environments/grade-hub"><span class="shelf-grade">5</span><span class="shelf-label">5th Grade</span></a></li>
          </ul>
        </section>

        <section class="strip strip-skill" aria-labelledby="skill-h">
          <div class="strip-head">
            <h2 id="skill-h">Browse by Skill</h2>
            <p>Practice one spelling pattern at a time &mdash; digraphs, blends, silent letters, and more.</p>
          </div>
          <div class="skill-band">
            <ul class="skill-list" role="list">
              <li><a href="/design-explore/shifting-environments/skill">SH Digraph Words</a></li>
              <li><a href="/design-explore/shifting-environments/skill">Compound Words</a></li>
              <li><a href="/design-explore/shifting-environments/skill">Silent E Words</a></li>
              <li><a href="/design-explore/shifting-environments/skill">Double Consonants</a></li>
            </ul>
            <a class="skill-all" href="/design-explore/shifting-environments/skill">See every skill &rarr;</a>
          </div>
        </section>

        <p class="trust-line">
          No accounts to make, no clock running, no score to chase &mdash; just words, read aloud, as many
          times as it takes.
        </p>
      </main>
    </div>

    <style>
      :global(html, body) {
        margin: 0;
        padding: 0;
      }
      * {
        box-sizing: border-box;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .proto-badge {
        position: fixed;
        bottom: 10px;
        right: 10px;
        z-index: 50;
        background: rgba(30, 24, 18, 0.82);
        color: #fdf6ec;
        font: 500 11px/1.4 'Inter', sans-serif;
        padding: 6px 10px;
        border-radius: 6px;
        letter-spacing: 0.01em;
        pointer-events: none;
      }

      .env-arrival {
        --env-a: #ffe4c7;
        --env-b: #fdf6ec;
        --env-c: #dbe9f5;
        --ink: #2b2116;
        --ink-soft: #5c4e3f;
        --ink-faint: #8a7a67;
        --accent: #c8632f;
        --accent-ink: #7a3c17;
        --plate: #fffaf1;
        --focus-ring: #1c4f8c;

        min-height: 100vh;
        background: linear-gradient(158deg, var(--env-a) 0%, var(--env-b) 46%, var(--env-c) 100%);
        font-family: 'Inter', system-ui, sans-serif;
        color: var(--ink);
        padding: 0 clamp(20px, 5vw, 64px) 96px;
      }

      a {
        color: inherit;
      }
      *:focus-visible {
        outline: 3px solid var(--focus-ring);
        outline-offset: 3px;
        border-radius: 4px;
      }

      .topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 28px 0 8px;
        flex-wrap: wrap;
        gap: 12px;
      }
      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: 'Fraunces', serif;
        font-weight: 650;
        font-size: 20px;
        text-decoration: none;
        color: var(--ink);
      }
      .wordmark-mark {
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 9px;
        background: var(--accent);
        color: #fff;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 13px;
        font-weight: 600;
      }
      .topnav {
        display: flex;
        gap: 22px;
        font-size: 14px;
        font-weight: 500;
      }
      .topnav a {
        text-decoration: none;
        color: var(--ink-soft);
        border-bottom: 1px solid transparent;
        padding-bottom: 2px;
      }
      .topnav a:hover {
        border-color: var(--ink-soft);
      }

      main {
        max-width: 1080px;
        margin: 0 auto;
      }

      .hero {
        padding: 56px 0 40px;
        max-width: 720px;
      }
      .hero-eyebrow {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 13px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent-ink);
        margin: 0 0 18px;
        font-weight: 600;
      }
      .hero-title {
        font-family: 'Fraunces', serif;
        font-weight: 560;
        font-size: clamp(34px, 5.4vw, 58px);
        line-height: 1.06;
        margin: 0 0 22px;
        letter-spacing: -0.01em;
      }
      .hero-sub {
        font-size: 17px;
        line-height: 1.6;
        color: var(--ink-soft);
        max-width: 52ch;
        margin: 0;
      }

      /* The floating layer: one deliberate "plate" for the input area only.
         Asymmetric radius + tinted glow + inner top highlight instead of a
         generic gray-shadow white rectangle. */
      .plate {
        position: relative;
        background: var(--plate);
        border-radius: 34px 12px 34px 12px;
        padding: clamp(24px, 4vw, 40px) clamp(24px, 4vw, 44px) 32px;
        margin: 12px 0 64px;
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.9) inset,
          0 22px 44px -26px rgba(120, 66, 20, 0.38),
          0 2px 10px -2px rgba(120, 66, 20, 0.14);
        overflow: hidden;
      }
      .plate-glow {
        position: absolute;
        top: -70px;
        right: -60px;
        width: 220px;
        height: 220px;
        background: radial-gradient(circle, rgba(200, 99, 47, 0.16), transparent 70%);
        pointer-events: none;
      }
      .plate h2 {
        font-family: 'Fraunces', serif;
        font-weight: 560;
        font-size: 23px;
        margin: 0 0 8px;
      }
      .plate-hint {
        margin: 0 0 20px;
        color: var(--ink-soft);
        font-size: 15px;
      }
      .word-form textarea {
        width: 100%;
        border: 1px solid #e6d8c3;
        background: #fffdf9;
        border-radius: 14px;
        padding: 16px 18px;
        font: 400 15px/1.5 'Inter', sans-serif;
        color: var(--ink);
        resize: vertical;
        min-height: 120px;
      }
      .word-form textarea::placeholder {
        color: #a6957e;
      }
      .word-form textarea:focus-visible {
        outline: 3px solid var(--focus-ring);
        outline-offset: 2px;
      }
      .form-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-top: 16px;
        flex-wrap: wrap;
      }
      .form-note {
        font-size: 13px;
        color: var(--ink-faint);
      }
      .btn-primary {
        font: 600 15px/1 'Inter', sans-serif;
        background: var(--accent);
        color: #fff;
        border: none;
        padding: 14px 24px;
        border-radius: 999px;
        cursor: pointer;
        box-shadow: 0 10px 20px -10px rgba(200, 99, 47, 0.6);
      }
      .btn-primary:hover {
        background: var(--accent-ink);
      }

      .strip {
        padding: 20px 0 8px;
      }
      .strip-head h2 {
        font-family: 'Fraunces', serif;
        font-weight: 560;
        font-size: 24px;
        margin: 0 0 6px;
      }
      .strip-head p {
        margin: 0 0 22px;
        color: var(--ink-soft);
        font-size: 15px;
        max-width: 56ch;
      }

      /* Grade "shelf": not cards — a row of plaques standing on a shared
         baseline rule, differentiated by a bottom-hairline lift on hover. */
      .shelf {
        list-style: none;
        margin: 0 0 56px;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 2px;
        border-bottom: 2px solid rgba(43, 33, 22, 0.14);
      }
      .shelf li a {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        padding: 20px 8px 22px;
        border-radius: 14px 14px 0 0;
        transition: background 0.15s ease, transform 0.15s ease;
      }
      .shelf li a:hover {
        background: rgba(255, 255, 255, 0.55);
        transform: translateY(-3px);
      }
      .shelf-grade {
        font-family: 'Fraunces', serif;
        font-weight: 650;
        font-size: 26px;
        color: var(--accent-ink);
      }
      .shelf-label {
        font-size: 12.5px;
        font-weight: 500;
        color: var(--ink-soft);
        text-align: center;
      }

      /* Skill band: a single low, wide panel holding an inline list of
         underlined links, not four separate white cards. */
      .skill-band {
        background: rgba(255, 255, 255, 0.45);
        border-radius: 8px 28px 8px 28px;
        padding: 26px clamp(20px, 3vw, 34px);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 60px;
        border-top: 1px solid rgba(255, 255, 255, 0.9);
      }
      .skill-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 10px 26px;
      }
      .skill-list a {
        text-decoration: none;
        font-weight: 500;
        font-size: 15px;
        color: var(--ink);
        border-bottom: 1.5px solid rgba(200, 99, 47, 0.4);
        padding-bottom: 2px;
      }
      .skill-list a:hover {
        border-color: var(--accent);
        color: var(--accent-ink);
      }
      .skill-all {
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        color: var(--accent-ink);
        white-space: nowrap;
      }

      .trust-line {
        text-align: center;
        font-family: 'Fraunces', serif;
        font-style: italic;
        font-size: 17px;
        color: var(--ink-soft);
        max-width: 44ch;
        margin: 40px auto 0;
        line-height: 1.5;
      }

      @media (max-width: 720px) {
        .shelf {
          grid-template-columns: repeat(3, 1fr);
        }
        .form-row {
          align-items: stretch;
        }
        .btn-primary {
          width: 100%;
        }
      }
      @media (max-width: 480px) {
        .shelf {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .shelf li a {
          transition: none;
        }
      }
    </style>
  </body>
</html>
