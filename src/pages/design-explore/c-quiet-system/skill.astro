---
import Layout from './_Layout.astro';

const families = [
  { family: '-ake', words: 'cake, bake, lake, make, take, wake' },
  { family: '-ate', words: 'gate, late, date, plate, skate' },
  { family: '-ame', words: 'flame, game, name, same, tame' },
  { family: '-ape', words: 'cape, grape, shape, tape' },
  { family: '-ave', words: 'brave, cave, gave, save, wave' },
];

const compare = [
  ['cap', 'cape'],
  ['tap', 'tape'],
  ['plan', 'plane'],
  ['past', 'paste'],
];

const words = ['cake', 'gate', 'name', 'plate', 'shape'];

const faq = [
  {
    q: 'Does the silent e in cake do anything if it isn’t pronounced?',
    a: 'Yes — it changes how the vowel before it sounds. Without the final e, cake would be spelled and read like cak, with the short a sound in cat.',
  },
  {
    q: 'Is silent e the only way to spell the long a sound?',
    a: 'No. Silent e is one common way to spell long a in one-syllable words, but English also spells it with letter pairs such as ai and ay, as in rain and day.',
  },
];
---

<Layout title="Long A Silent E Words">
  <header class="explore-c__header">
    <div class="explore-c__header-inner">
      <span class="explore-c__wordmark">spellingwords</span>
      <nav class="explore-c__nav">
        <a href="#">Grades</a>
        <a href="#">Skills</a>
      </nav>
    </div>
  </header>

  <main class="wrap wrap--narrow" style="padding: 36px 24px 72px;">
    <p style="font-size: 13px; color: var(--text-tertiary); margin-bottom: 20px;">Home / Skills / Long A Silent E Words</p>

    <div class="rail" style="border-left-color: var(--rail-green); margin-bottom: 18px;">
      <span class="rail-label" style="--rail-blue: var(--rail-green);">Skill · Grade 1 · Phonics</span>
      <h1 style="font-size: clamp(26px, 3.6vw, 36px); margin-top: 10px;">Long A Silent E Words</h1>
    </div>

    <p style="font-size: 16px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 26px; max-width: 62ch;">
      How the silent-e pattern turns a short vowel into a long "a" sound, as in cake and gate — with word
      families, the short-a-to-long-a contrast, common mistakes, and a teaching routine.
    </p>

    <div class="surface" style="padding: 20px 22px; margin-bottom: 30px; border-left: 3px solid var(--rail-green);">
      <p style="font-size: 12px; font-weight: 650; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 10px;">What is this pattern?</p>
      <p style="font-size: 15.5px; line-height: 1.65; color: var(--text-primary);">
        A silent e sits at the end of a word without making its own sound, but it changes the vowel before it.
        In words like <em>cake</em>, <em>gate</em>, and <em>plate</em>, that final silent e signals that the
        earlier vowel says its own name — long a — instead of the short a sound in <em>cat</em>.
      </p>
    </div>

    <a href="#" class="btn btn--primary" style="margin-bottom: 36px;">Practice these 5 words →</a>

    <h2 style="font-size: 18px; margin-bottom: 14px;">This week's words</h2>
    <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 36px;">
      {words.map((w) => (
        <span class="surface" style="padding: 10px 18px; font-weight: 600; font-size: 17px; border-left: 3px solid var(--rail-green);">{w}</span>
      ))}
    </div>

    <h2 style="font-size: 18px; margin-bottom: 12px;">Long A word families</h2>
    <table class="surface" style="margin-bottom: 32px; font-size: 14.5px;">
      <tbody>
        {families.map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 11px 16px; font-weight: 650; white-space: nowrap;">{row.family}</td>
            <td style="padding: 11px 16px; color: var(--text-secondary);">{row.words}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2 style="font-size: 18px; margin-bottom: 12px;">Long A compared with short A</h2>
    <table class="surface" style="margin-bottom: 32px; font-size: 14.5px;">
      <thead>
        <tr style="border-bottom: 1px solid var(--border);">
          <th style="padding: 11px 16px; text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--text-tertiary);">Short a</th>
          <th style="padding: 11px 16px; text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--text-tertiary);">Long a</th>
        </tr>
      </thead>
      <tbody>
        {compare.map(([short, long]) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 11px 16px;">{short}</td>
            <td style="padding: 11px 16px; color: var(--rail-green); font-weight: 650;">{long}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2 style="font-size: 18px; margin-bottom: 12px;">Common Long A mistakes</h2>
    <p style="font-size: 15.5px; line-height: 1.7; color: var(--text-primary); margin-bottom: 32px;">
      The most common mistake is dropping the silent e when writing — a sign the learner has heard the long
      vowel but hasn't yet connected it to the e that marks it, so <em>cake</em> comes out as <em>cak</em>.
    </p>

    <h2 style="font-size: 18px; margin-bottom: 14px;">Frequently asked questions</h2>
    <div class="surface">
      {faq.map((item, i) => (
        <div style={`padding: 18px 20px; ${i < faq.length - 1 ? 'border-bottom: 1px solid var(--border);' : ''}`}>
          <p style="font-weight: 650; margin-bottom: 6px; font-size: 15px;">{item.q}</p>
          <p style="color: var(--text-secondary); line-height: 1.6; font-size: 14.5px;">{item.a}</p>
        </div>
      ))}
    </div>
  </main>

  <footer class="explore-c__footer">
    <div class="wrap">No accounts. No timers. Just spelling.</div>
  </footer>
</Layout>
