---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { getCanonicalUrl } from '@/lib/canonicalUrl';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { isPublished } from '@/lib/content/spellingLists';
import { gradeConfig, getAdjacentGrades } from '@/lib/content/gradeConfig';
import type { GradeConfigEntry } from '@/lib/content/gradeConfig';
import { buildGradeHubModel } from '@/lib/content/gradeHubModel';

export async function getStaticPaths() {
  return gradeConfig.map((gradeEntry) => ({
    params: { gradeSlug: gradeEntry.slug },
    props: { gradeEntry },
  }));
}

const { gradeEntry } = Astro.props as { gradeEntry: GradeConfigEntry };
const { grade, label } = gradeEntry;
const { prev, next } = getAdjacentGrades(grade);

const entries = (await getCollection('spelling-lists')).filter(isPublished);
const hub = buildGradeHubModel(grade, entries);

// Strand accent styling — written as full literal class strings so Tailwind's
// JIT scanner detects them. Falls back to a neutral accent for any future strand.
const strandAccentClasses: Record<string, string> = {
  'core-spelling': 'border-l-accent-teal',
  'high-frequency-words': 'border-l-accent-gold',
  'themed-spelling-practice': 'border-l-accent-coral',
};
const defaultStrandAccent = 'border-l-border-strong';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label },
];

const canonicalURL = getCanonicalUrl(Astro.url.pathname, Astro.site);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};

const itemListElements = hub.strands.map((strand, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  url: new URL(strand.href, canonicalURL.origin).toString(),
  name: `${label} ${strand.label}`,
}));

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${label} Spelling Word Lists`,
  numberOfItems: hub.strands.length,
  itemListElement: itemListElements,
};
---

<Layout
  title={`${label} Spelling Words | spellingwords.app`}
  description={hub.metaDescription}
  jsonLd={[breadcrumbJsonLd, itemListJsonLd]}
>
  <SiteHeader variant="discovery" currentPath={gradeEntry.hubHref} />

  <main id="main-content">
    <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
      <div class="mb-6">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <!-- Hero -->
      <div class="mb-10 flex flex-col gap-4">
        <p class="text-xs font-bold uppercase tracking-[0.06em] text-brand">Grade {grade}</p>
        <h1 class="text-display-lg">
          {label} Spelling Words
        </h1>
        {hub.orientation.map((paragraph) => (
          <p class="max-w-2xl text-body text-ink-soft">{paragraph}</p>
        ))}
      </div>

      <div class="mb-10 flex flex-col gap-5">
          {hub.strands.map((strand) => (
            <section class={`card-raised border-l-4 flex flex-col gap-3 p-6 md:p-7 ${strandAccentClasses[strand.strand] ?? defaultStrandAccent}`} aria-labelledby={`grade-section-${strand.strand}`}>
              <h2 id={`grade-section-${strand.strand}`} class="font-display text-xl font-semibold text-ink">
                {strand.label}
              </h2>
              <p class="max-w-2xl text-sm leading-relaxed text-ink-soft">{strand.summary}</p>
              <p>
                <a href={strand.href} class="link text-sm font-semibold">
                  {strand.linkLabel} →
                </a>
              </p>
            </section>
          ))}
      </div>

      <!-- Choosing guidance -->
      <section aria-labelledby="guidance-heading" class="mb-10 rounded-2xl bg-canvas-sunken p-6">
          <h2 id="guidance-heading" class="mb-2 font-display text-base font-semibold text-ink">
            Where to begin
          </h2>
          <p class="text-sm leading-relaxed text-ink-soft">{hub.synthesis}</p>
      </section>

      <!-- Adjacent grade nav -->
      <nav aria-label="Adjacent grade levels" class="mb-10 flex items-center justify-between gap-4 border-t border-border pt-6">
        {prev ? (
          <a href={prev.hubHref} class="link inline-flex items-center gap-1 text-sm font-semibold">
            ← {prev.label} Spelling Words
          </a>
        ) : <span></span>}
        {next ? (
          <a href={next.hubHref} class="link inline-flex items-center gap-1 text-sm font-semibold">
            {next.label} Spelling Words →
          </a>
        ) : <span></span>}
      </nav>

      <!-- Back to grades -->
      <p>
        <a href="/#grades" class="link inline-flex items-center gap-1 text-sm font-semibold">
          ← Back to all grades
        </a>
      </p>
    </div>
  </main>

  <SiteFooter />
</Layout>
