---
interface Props {
  source?: {
    name: string;
    tier?: string;
    url?: string;
    publicAttribution?: boolean;
  };
}

const { source } = Astro.props;
---

{source?.publicAttribution && (
  <p class="text-xs text-da-ink-faint">
    Based on {source.name}
    {source.tier && <> ({source.tier})</>}
    {source.url && (
      <>
        {' '}&mdash;{' '}
        <a href={source.url} class="font-bold text-da-brand-strong hover:underline" target="_blank" rel="noopener noreferrer">
          source
        </a>
      </>
    )}
  </p>
)}
