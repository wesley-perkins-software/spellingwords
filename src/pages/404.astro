---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
---

<Layout
  title="Page Not Found | SpellingWords"
  description="The SpellingWords page you requested could not be found."
>
  <SiteHeader currentPath="/404" />
  <main id="main-content" class="px-5 py-16 sm:px-6 md:py-24">
    <div class="mx-auto max-w-content-md text-center">
      <p class="font-quicksand text-sm font-bold uppercase tracking-[0.08em] text-da-brand-strong">
        404 · Page not found
      </p>
      <h1
        class="mt-3 font-quicksand text-[clamp(2.2rem,6vw,3.6rem)] font-bold leading-tight text-da-ink"
      >
        This word path ends here.
      </h1>
      <p class="mx-auto mt-5 max-w-[52ch] text-lg leading-relaxed text-da-ink-soft">
        The page may have moved, or the address may be incomplete. Choose a grade, browse a spelling
        skill, or return to your own word list.
      </p>
      <div
        class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center"
      >
        <a
          href="/practice-your-own-words"
          class="inline-flex min-h-[48px] items-center justify-center rounded-lg bg-da-coral px-6 py-3 font-bold text-white no-underline transition hover:bg-da-coral-strong"
        >
          Practice your own words
        </a>
        <a
          href="/grades"
          class="inline-flex min-h-[48px] items-center justify-center rounded-lg border-2 border-da-brand px-6 py-3 font-bold text-da-brand-strong no-underline transition hover:bg-da-brand-tint"
        >
          Browse grades
        </a>
        <a
          href="/skills"
          class="inline-flex min-h-[48px] items-center justify-center rounded-lg px-6 py-3 font-bold text-da-brand-strong underline decoration-2 underline-offset-4"
        >
          Browse Skills
        </a>
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>
