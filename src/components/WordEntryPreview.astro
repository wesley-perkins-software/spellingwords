---
interface Props {
  words: string[];
}

const { words } = Astro.props;
---

<div
  class="overflow-hidden rounded-3xl border border-line bg-white shadow-[0_4px_16px_-6px_rgba(31,41,55,0.08)]"
  role="figure"
  aria-label="Word entry panel — example preview"
>
  <!-- Label bar -->
  <div class="flex items-center justify-between border-b border-line px-5 py-3">
    <span class="text-sm font-semibold text-ink-soft">
      Enter one word per line
    </span>
    <span
      class="rounded-full bg-brand-blue px-3 py-1 font-mono text-xs font-bold text-white"
      aria-label={`${words.length} words`}
    >
      {words.length} words
    </span>
  </div>

  <!-- Word lines — simulates a real textarea -->
  <div
    class="px-5 py-3"
    aria-label="Example spelling words"
  >
    {
      words.map((word: string) => (
        <div class="flex items-center border-b border-line py-2.5 last:border-0">
          <span class="font-sans text-base font-medium text-ink">{word}</span>
        </div>
      ))
    }
    <!-- Blinking cursor — signals this is an input area -->
    <div class="flex items-center py-2">
      <span class="cursor" aria-hidden="true"></span>
    </div>
  </div>

  <!-- Preview footer -->
  <div class="border-t border-line px-5 py-2.5">
    <p class="text-xs text-ink-soft">
      Preview only — paste your own words to get started
    </p>
  </div>
</div>

<style>
  .cursor {
    display: inline-block;
    width: 2px;
    height: 1.125rem;
    background-color: #2F6FED;
    border-radius: 1px;
    vertical-align: middle;
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>
