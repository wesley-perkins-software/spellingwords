---
import Layout from '@/layouts/Layout.astro';
import WordEntryPreview from '@/components/WordEntryPreview.astro';
import CategoryChip from '@/components/CategoryChip.astro';

const sampleWords = [
  'friend',
  'because',
  'different',
  'people',
  'every',
  'school',
  'always',
  'again',
];
---

<Layout
  title="spellingwords — Create a spelling test in seconds"
  description="Paste your spelling words to create a spelling test, practice session, or printable worksheet. Free, no account needed."
>
  <!-- Site header -->
  <header class="sticky top-0 z-10 border-b border-classroom-blue/10 bg-white/90 backdrop-blur-sm">
    <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
      <!-- Logo -->
      <a
        href="/"
        class="flex items-center gap-2 font-display text-lg font-bold text-app-charcoal tracking-tight"
        aria-label="spellingwords home"
      >
        <span
          aria-hidden="true"
          class="flex h-7 w-7 items-center justify-center rounded-xl bg-classroom-blue text-white"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M11.5 2.5l2 2-8 8H3.5v-2l8-8z" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9.5 4.5l2 2" stroke="white" stroke-width="1.75" stroke-linecap="round"/>
          </svg>
        </span>
        spelling<span class="text-classroom-blue">words</span>
      </a>

      <nav aria-label="Site navigation">
        <ul class="flex items-center gap-1 text-sm font-medium">
          <li>
            <a
              href="#"
              class="rounded-xl px-3 py-1.5 text-app-charcoal/55 transition-colors hover:bg-classroom-blue/8 hover:text-classroom-blue"
            >
              How it works
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- Main content -->
  <main id="main-content">
    <section
      class="relative mx-auto max-w-3xl px-6 py-12 md:py-16"
      aria-labelledby="hero-heading"
    >
      <!-- Subtle background accent (yellow only — no coral decoratively) -->
      <div aria-hidden="true" class="pointer-events-none select-none">
        <div class="absolute -top-10 right-0 h-40 w-40 rounded-full bg-classroom-yellow/20 blur-3xl"></div>
        <div class="absolute bottom-0 -left-8 h-32 w-32 rounded-full bg-classroom-blue/10 blur-3xl"></div>
      </div>

      <div class="relative flex flex-col gap-8">

        <!-- Headline block — utility-first, not marketing -->
        <div class="flex flex-col gap-2">
          <h1
            id="hero-heading"
            class="font-display text-2xl font-bold text-app-charcoal md:text-3xl"
          >
            Create a spelling test in seconds
          </h1>
          <p class="text-base leading-relaxed text-app-charcoal/60">
            Paste your spelling words below. Practice, test, or print with no account.
          </p>
        </div>

        <!-- Central word-entry panel -->
        <WordEntryPreview words={sampleWords} />

        <!-- Primary actions — directly under the panel -->
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <button
            type="button"
            class="flex-1 rounded-2xl bg-classroom-blue px-6 py-3.5 text-sm font-bold text-white shadow-md shadow-classroom-blue/25 transition hover:bg-blue-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-classroom-blue active:scale-95 sm:flex-none"
            aria-label="Start a spelling test"
          >
            Start Spelling Test →
          </button>
          <button
            type="button"
            class="flex-1 rounded-2xl border-2 border-classroom-green/40 bg-classroom-green/8 px-6 py-3.5 text-sm font-bold text-classroom-green transition hover:bg-classroom-green/15 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-classroom-green active:scale-95 sm:flex-none"
            aria-label="Practice words"
          >
            Practice Words
          </button>
          <a
            href="#"
            class="flex-1 rounded-2xl px-6 py-3.5 text-center text-sm font-semibold text-app-charcoal/50 transition hover:bg-slate-100 hover:text-app-charcoal sm:flex-none"
            aria-label="Print a worksheet"
          >
            Print Worksheet
          </a>
        </div>

        <!-- Divider with label -->
        <div class="flex items-center gap-3">
          <div class="h-px flex-1 bg-slate-200"></div>
          <span class="text-xs font-bold uppercase tracking-widest text-app-charcoal/35">
            or try a built-in list
          </span>
          <div class="h-px flex-1 bg-slate-200"></div>
        </div>

        <!-- Category chips -->
        <div
          class="flex flex-wrap gap-2"
          role="list"
          aria-label="Built-in word list categories"
        >
          <div role="listitem"><CategoryChip label="2nd Grade" variant="blue" /></div>
          <div role="listitem"><CategoryChip label="Sight Words" variant="green" /></div>
          <div role="listitem"><CategoryChip label="Silent E" variant="yellow" /></div>
          <div role="listitem"><CategoryChip label="Spelling Bee" variant="sage" /></div>
        </div>

        <!-- Trust microcopy -->
        <div class="flex items-center gap-2 text-xs text-app-charcoal/40">
          <span aria-hidden="true" class="inline-block h-1.5 w-1.5 rounded-full bg-classroom-green"></span>
          Free
          <span aria-hidden="true" class="text-slate-300">·</span>
          No account needed
          <span aria-hidden="true" class="text-slate-300">·</span>
          Works on Chromebooks &amp; iPads
        </div>

      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-100 bg-white/60">
    <div class="mx-auto max-w-3xl px-6 py-8 text-center text-xs text-app-charcoal/35">
      &copy; {new Date().getFullYear()} spellingwords.app &mdash; Free spelling practice for every classroom.
    </div>
  </footer>
</Layout>
