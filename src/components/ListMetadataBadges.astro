---
import { categoryLabels, difficultyLabels } from '@/lib/content/categoryMeta';
import type { SpellingListEntry } from '@/lib/content/spellingLists';

interface Props {
  category?: SpellingListEntry['data']['category'];
  difficulty: SpellingListEntry['data']['difficulty'];
  durationMinutes: number;
  wordCount: number;
}

const { category, difficulty, durationMinutes, wordCount } = Astro.props;
---

<div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
  {category && (
    <span class="rounded-full bg-classroom-blue/12 px-3 py-1 text-classroom-blue">
      {categoryLabels[category] ?? category}
    </span>
  )}
  <span class="rounded-full bg-classroom-yellow/20 px-3 py-1 text-amber-700">
    {difficultyLabels[difficulty] ?? difficulty}
  </span>
  <span class="rounded-full bg-app-sage/15 px-3 py-1 text-app-sage">
    ~{durationMinutes} min
  </span>
  <span class="rounded-full bg-classroom-coral/12 px-3 py-1 text-classroom-coral">
    {wordCount} words
  </span>
</div>
