---
import Layout from './_Layout.astro';

const families = [
  { family: '-ake', words: 'cake, bake, lake, make, take, wake' },
  { family: '-ate', words: 'gate, late, date, plate, skate' },
  { family: '-ame', words: 'flame, game, name, same, tame' },
  { family: '-ape', words: 'cape, grape, shape, tape' },
  { family: '-ave', words: 'brave, cave, gave, save, wave' },
];

const compare = [
  ['cap', 'cape'],
  ['tap', 'tape'],
  ['plan', 'plane'],
  ['past', 'paste'],
];

const words = ['cake', 'gate', 'name', 'plate', 'shape'];

const faq = [
  {
    q: 'Does the silent e in cake do anything if it isn’t pronounced?',
    a: 'Yes — it changes how the vowel before it sounds. Without the final e, cake would be spelled and read like cak, with the short a sound in cat. The e itself stays silent, but it isn’t optional.',
  },
  {
    q: 'Is silent e the only way to spell the long a sound?',
    a: 'No. Silent e is one common way to spell long a in one-syllable words, but English also spells it with letter pairs such as ai and ay, as in rain and day.',
  },
];
---

<Layout title="Long A Silent E Words">
  <header class="explore-a__header">
    <div class="explore-a__header-inner">
      <span class="explore-a__wordmark">spelling<span class="accent">words</span></span>
      <nav class="explore-a__nav">
        <a href="#">Grades</a>
        <a href="#">Skills</a>
      </nav>
    </div>
  </header>

  <main class="wrap wrap--narrow" style="padding: 40px 24px 72px;">
    <p style="font-size: 13px; color: var(--text-tertiary); margin-bottom: 18px;">Home / Skills / Long A Silent E Words</p>

    <div class="soundmark" style="color: var(--mark-b); margin-bottom: 14px;">
      <span class="dot"></span><span class="dot"></span>
      <span class="soundmark--label">Skill · Grade 1 · Phonics</span>
    </div>

    <h1 style="font-size: clamp(28px, 4vw, 40px); margin-bottom: 14px;">Long A Silent E Words</h1>
    <p style="font-size: 17px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 28px; max-width: 62ch;">
      How the silent-e pattern turns a short vowel into a long "a" sound, as in cake and gate — with word
      families, the short-a-to-long-a contrast, common mistakes, and a teaching routine.
    </p>

    <div class="card" style="padding: 22px 24px; margin-bottom: 32px; border-left: 3px solid var(--mark-b);">
      <p style="font-size: 13px; font-weight: 700; color: var(--mark-b); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 10px;">What is this pattern?</p>
      <p style="font-size: 16px; line-height: 1.65; color: var(--text-primary);">
        A silent e sits at the end of a word without making its own sound, but it changes the vowel before it.
        In words like <em>cake</em>, <em>gate</em>, and <em>plate</em>, that final silent e signals that the
        earlier vowel says its own name — long a — instead of the short a sound in <em>cat</em>.
      </p>
    </div>

    <a href="#" class="btn btn--primary" style="margin-bottom: 40px;">Practice these 5 words →</a>

    <h2 style="font-size: 20px; margin-bottom: 16px;">This week's words</h2>
    <div style="display: flex; flex-wrap: wrap; gap: 22px; margin-bottom: 40px; padding: 24px; background: var(--stage-bg); border-radius: var(--radius-lg);">
      {words.map((w) => (
        <span class="spoken-word" style="color: var(--stage-text);">
          <span class="spoken-word__text" style="font-size: 26px;">{w}</span>
          <span class="spoken-word__beats" style="color: var(--stage-accent);"><span class="beat"></span></span>
        </span>
      ))}
    </div>

    <h2 style="font-size: 20px; margin-bottom: 14px;">Long A Word Families</h2>
    <p style="color: var(--text-secondary); margin-bottom: 16px; line-height: 1.6;">
      Grouping words by their ending makes the pattern easy to hear across several words at once.
    </p>
    <table class="card" style="margin-bottom: 36px; font-size: 15px;">
      <tbody>
        {families.map((row) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 12px 18px; font-weight: 700; font-family: var(--font-display); white-space: nowrap;">{row.family}</td>
            <td style="padding: 12px 18px; color: var(--text-secondary);">{row.words}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2 style="font-size: 20px; margin-bottom: 14px;">Long A Compared With Short A</h2>
    <table class="card" style="margin-bottom: 36px; font-size: 15px;">
      <thead>
        <tr style="border-bottom: 1px solid var(--border); background: var(--surface-page);">
          <th style="padding: 12px 18px; text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--text-tertiary);">Short a</th>
          <th style="padding: 12px 18px; text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--text-tertiary);">Long a</th>
        </tr>
      </thead>
      <tbody>
        {compare.map(([short, long]) => (
          <tr style="border-bottom: 1px solid var(--border);">
            <td style="padding: 12px 18px;">{short}</td>
            <td style="padding: 12px 18px; color: var(--accent); font-weight: 600;">{long}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2 style="font-size: 20px; margin-bottom: 14px;">Common Long A Mistakes</h2>
    <p style="font-size: 16px; line-height: 1.7; color: var(--text-primary); margin-bottom: 36px;">
      The most common mistake is dropping the silent e when writing — a sign the learner has heard the long
      vowel but hasn't yet connected it to the e that marks it, so <em>cake</em> comes out as <em>cak</em>.
      Practicing the stretch-and-write routine, then reading the result back, usually resolves this quickly.
    </p>

    <h2 style="font-size: 20px; margin-bottom: 16px;">Frequently asked questions</h2>
    <div class="card" style="margin-bottom: 8px;">
      {faq.map((item, i) => (
        <div style={`padding: 20px 22px; ${i < faq.length - 1 ? 'border-bottom: 1px solid var(--border);' : ''}`}>
          <p style="font-weight: 700; margin-bottom: 8px;">{item.q}</p>
          <p style="color: var(--text-secondary); line-height: 1.6; font-size: 15px;">{item.a}</p>
        </div>
      ))}
    </div>
  </main>

  <footer class="explore-a__footer">
    <div class="wrap">No accounts. No timers. Just spelling.</div>
  </footer>
</Layout>
