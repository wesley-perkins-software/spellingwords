---
import Proto from './_shared/Proto.astro';
import Header from './_shared/Header.astro';
import Footer from './_shared/Footer.astro';
---

<Proto
  title="Practice — Direction A prototype"
  description="Spelling practice session: hear each word, type it, and check your spelling — no timers, no points."
>
  <Header currentPath="/design-explore/direction-a/practice" />

  <main id="main">
    <div class="wrap page-shell">
      <p class="proto-note">
        This page shows all four practice states stacked for review. In the real app only one
        state is visible at a time.
      </p>
    </div>

    <!--
      Implementation note: in the live component, wrap the active state in an
      aria-live="polite" (or role="status") region so screen reader users hear
      "Well spelled." / "A good attempt." and progress updates announced on
      each state transition. This static prototype has no JS, so no live
      region is wired here.
    -->

    <!-- ============================= PRACTICE STAGE =============================
         A restrained, full-bleed brand-tint band contains the interaction and
         its feedback/results demo states — giving Practice its own
         environmental identity as a distinct mode, rather than a white card
         floating on the same cream canvas as the editorial pages. -->
    <div class="practice-stage">
      <div class="wrap stage-inner">
      <!-- ============================= QUESTION STATE ============================= -->
      <section class="practice-card" aria-labelledby="question-heading">
        <div class="progress-row">
          <p class="progress-label" id="question-heading">Word 3 of 10</p>
          <div class="progress-track" role="progressbar" aria-valuenow="3" aria-valuemin="0" aria-valuemax="10" aria-label="Progress: word 3 of 10">
            <div class="progress-fill" style="width: 30%;"></div>
          </div>
        </div>

        <div class="listen-block">
          <button
            type="button"
            class="hear-word-btn"
            aria-label="Play the word"
            aria-describedby="hear-word-caption"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 10v4h3.5L12 17.5v-11L7.5 10H4z" />
              <path d="M15.5 9a3.5 3.5 0 010 6" />
              <path d="M18 6.5a7 7 0 010 11" />
            </svg>
          </button>
          <p class="hear-word-caption" id="hear-word-caption">Hear Word</p>

          <button type="button" class="hear-sentence-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 10v4h2.8L10 17.5v-11L5.8 10H3z" />
              <path d="M13 8.5a3.5 3.5 0 010 7" />
            </svg>
            Hear Sentence
          </button>
        </div>

        <form class="answer-form">
          <label for="spelling-input">Type the word you hear</label>
          <input
            id="spelling-input"
            name="spelling"
            type="text"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            class="spelling-input"
          />
          <button type="submit" class="check-btn">Check Spelling</button>
        </form>
      </section>

      <!-- ============================= CORRECT STATE ============================= -->
      <section class="state-block">
        <h2>Correct feedback</h2>
        <div class="feedback-card feedback-correct">
          <span class="feedback-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9" />
              <path d="M8 12.5l2.5 2.5L16 9" />
            </svg>
          </span>
          <div class="feedback-body">
            <p class="feedback-phrase">Well spelled.</p>
            <p class="feedback-word">bed</p>
          </div>
          <button type="button" class="continue-btn continue-correct">Continue</button>
        </div>
      </section>

      <!-- ============================= INCORRECT STATE ============================= -->
      <section class="state-block">
        <h2>Incorrect feedback</h2>
        <div class="feedback-card feedback-incorrect">
          <span class="feedback-icon feedback-icon-incorrect" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 8v5" />
              <circle cx="12" cy="16" r="0.75" fill="currentColor" stroke="none" />
            </svg>
          </span>
          <div class="feedback-body">
            <p class="feedback-phrase">A good attempt.</p>
            <dl class="compare-list">
              <div class="compare-row">
                <dt>You wrote:</dt>
                <dd class="compare-wrong">kat</dd>
              </div>
              <div class="compare-row">
                <dt>Correct spelling:</dt>
                <dd class="compare-right">cat</dd>
              </div>
            </dl>
            <p class="feedback-note">We'll come back to this one.</p>
          </div>
          <button type="button" class="continue-btn continue-incorrect">Continue</button>
        </div>
      </section>

      <!-- ============================= RESULTS STATE ============================= -->
      <section class="state-block">
        <h2>Results</h2>
        <div class="results-card">
          <p class="results-headline">Good practice today.</p>
          <p class="results-summary">You spelled 8 of 10 words correctly.</p>

          <div class="missed-block">
            <p class="missed-label">Words to revisit</p>
            <ul class="missed-list">
              <li class="missed-chip">pig</li>
              <li class="missed-chip">bug</li>
            </ul>
          </div>

          <div class="results-actions">
            <button type="button" class="results-btn results-btn-primary">Practice Again</button>
            <button type="button" class="results-btn results-btn-secondary">Review Missed Words</button>
          </div>
        </div>
      </section>
      </div>
    </div>
  </main>

  <Footer />

  <style>
    .page-shell {
      padding-block: clamp(1.75rem, 4vw, 2.5rem) 0;
      max-width: 820px;
    }

    .proto-note {
      background: var(--canvas-sunken);
      border: 1px dashed var(--border-strong);
      border-radius: var(--radius-sm);
      padding: 0.85rem 1.1rem;
      font-size: 0.88rem;
      color: var(--ink-faint);
      margin: 0;
    }

    /* ============================= PRACTICE STAGE ============================= */
    /* Low-strength brand-derived surface — a distinct "stage," not the
       strongest or most saturated background in the system. */
    .practice-stage {
      background: var(--brand-tint-soft);
      padding-block: clamp(2.5rem, 5vw, 4rem);
      margin-top: clamp(2rem, 4vw, 3rem);
    }

    .stage-inner {
      max-width: 820px;
    }

    .state-block {
      margin-top: clamp(3rem, 6vw, 4rem);
    }

    .state-block h2 {
      font-size: 0.95rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ink-faint);
      margin-bottom: 1rem;
    }

    /* ============================= QUESTION CARD ============================= */
    .practice-card {
      background: var(--canvas-raised);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: clamp(1.75rem, 4vw, 2.75rem);
      box-shadow: var(--shadow-md);
      display: flex;
      flex-direction: column;
      gap: clamp(1.75rem, 4vw, 2.25rem);
    }

    .progress-row {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .progress-label {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--ink-soft);
    }

    .progress-track {
      height: 12px;
      border-radius: var(--radius-pill);
      background: var(--canvas-sunken);
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      background: var(--brand);
      border-radius: var(--radius-pill);
    }

    /* ============================= LISTEN BLOCK ============================= */
    .listen-block {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      padding: 1.75rem 1rem 1.5rem;
      background: var(--canvas-sunken);
      border-radius: var(--radius-lg);
    }

    .hear-word-btn {
      width: 7.5rem;
      height: 7.5rem;
      border-radius: 50%;
      background: var(--brand);
      color: #ffffff;
      border: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: var(--shadow-lift), 0 0 0 6px var(--canvas-raised), 0 0 0 8px var(--brand-tint);
      transition: background 0.15s ease, transform 0.15s ease;
    }

    .hear-word-btn svg {
      width: 3.1rem;
      height: 3.1rem;
    }

    .hear-word-btn:hover {
      background: var(--brand-strong);
      transform: translateY(-2px);
    }

    .hear-word-btn:active {
      background: var(--brand-strong);
      transform: translateY(0) scale(0.96);
    }

    .hear-word-caption {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.15rem;
      color: var(--ink);
    }

    .hear-sentence-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 44px;
      margin-top: 0.5rem;
      background: var(--canvas-sunken);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-pill);
      padding: 0.6rem 1.25rem;
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 0.92rem;
      color: var(--ink-soft);
      cursor: pointer;
      transition: background 0.15s ease, color 0.15s ease;
    }

    .hear-sentence-btn svg {
      width: 1.1rem;
      height: 1.1rem;
    }

    .hear-sentence-btn:hover {
      background: var(--brand-tint);
      color: var(--brand-strong);
    }

    /* ============================= ANSWER FORM ============================= */
    .answer-form {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    .answer-form label {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--ink);
    }

    .spelling-input {
      width: 100%;
      max-width: 24rem;
      text-align: center;
      font-family: var(--font-word);
      font-size: 1.85rem;
      letter-spacing: 0.02em;
      color: var(--ink);
      background: var(--canvas);
      border: 2.5px solid var(--border-strong);
      border-radius: var(--radius-md);
      padding: 1rem 1.25rem;
    }

    .spelling-input:focus-visible {
      border-color: var(--brand);
    }

    .check-btn {
      background: var(--coral);
      color: #ffffff;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.05rem;
      border: none;
      border-radius: var(--radius-sm);
      padding: 0.9rem 2rem;
      min-height: 44px;
      cursor: pointer;
      transition: background 0.15s ease, transform 0.15s ease;
    }

    .check-btn:hover {
      background: var(--coral-strong);
      transform: translateY(-1px);
    }

    /* ============================= FEEDBACK CARDS ============================= */
    .feedback-card {
      border-radius: var(--radius-lg);
      padding: clamp(1.5rem, 4vw, 2.25rem);
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1rem;
    }

    .feedback-correct {
      background: var(--correct-bg);
      border: 1px solid var(--correct-border);
    }

    .feedback-incorrect {
      background: var(--incorrect-bg);
      border: 1px solid var(--incorrect-border);
    }

    .feedback-icon {
      width: 3.75rem;
      height: 3.75rem;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--correct-ink);
      color: #ffffff;
    }

    .feedback-icon svg {
      width: 2rem;
      height: 2rem;
    }

    .feedback-icon-incorrect {
      background: var(--incorrect-ink);
    }

    .feedback-phrase {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.4rem;
    }

    .feedback-correct .feedback-phrase {
      color: var(--correct-ink);
    }

    .feedback-incorrect .feedback-phrase {
      color: var(--incorrect-ink);
    }

    .feedback-word {
      font-family: var(--font-word);
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--ink);
      margin-top: 0.35rem;
    }

    .compare-list {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      margin: 0.75rem 0 0;
    }

    .compare-row {
      display: flex;
      align-items: baseline;
      justify-content: center;
      gap: 0.6rem;
      font-size: 1.05rem;
    }

    .compare-row dt {
      color: var(--ink-soft);
      font-weight: 600;
    }

    .compare-row dd {
      margin: 0;
      font-family: var(--font-word);
      font-size: 1.35rem;
      font-weight: 700;
    }

    .compare-wrong {
      color: var(--incorrect-ink);
      text-decoration: line-through;
    }

    .compare-right {
      color: var(--correct-ink);
    }

    .feedback-note {
      margin-top: 0.5rem;
      font-size: 0.92rem;
      color: var(--ink-soft);
    }

    .continue-btn {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1rem;
      border: none;
      border-radius: var(--radius-sm);
      padding: 0.85rem 2rem;
      min-height: 44px;
      cursor: pointer;
      color: #ffffff;
      transition: background 0.15s ease;
    }

    .continue-correct {
      background: var(--correct-ink);
    }

    .continue-correct:hover {
      background: var(--correct-ink-strong);
    }

    .continue-incorrect {
      background: var(--canvas-raised);
      color: var(--brand-strong);
      border: 2px solid var(--brand);
    }

    .continue-incorrect:hover {
      background: var(--brand-tint);
    }

    /* ============================= RESULTS CARD ============================= */
    /* White/raised, not brand-tint — the results card now sits inside the
       brand-tint practice stage, so it needs its own contrast to stay a
       distinct, legible surface rather than disappearing into the stage. */
    .results-card {
      background: var(--canvas-raised);
      border: 1px solid var(--brand);
      border-top: 4px solid var(--brand);
      border-radius: var(--radius-lg);
      padding: clamp(1.75rem, 4vw, 2.5rem);
      box-shadow: var(--shadow-sm);
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .results-headline {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.5rem;
      color: var(--brand-strong);
    }

    .results-summary {
      font-size: 1.05rem;
      color: var(--ink-soft);
    }

    .missed-block {
      margin-top: 1rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.6rem;
    }

    .missed-label {
      font-weight: 700;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--ink-faint);
    }

    .missed-list {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.6rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .missed-chip {
      background: var(--coral-tint);
      color: var(--coral-ink);
      font-family: var(--font-word, var(--font-display));
      font-weight: 700;
      font-size: 1rem;
      padding: 0.5rem 1.1rem;
      border-radius: var(--radius-pill);
    }

    .results-actions {
      display: flex;
      gap: 1rem;
      margin-top: 1.5rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .results-btn {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1rem;
      border-radius: var(--radius-sm);
      padding: 0.85rem 1.75rem;
      min-height: 44px;
      cursor: pointer;
      transition: background 0.15s ease, transform 0.15s ease;
    }

    .results-btn-primary {
      background: var(--coral);
      color: #ffffff;
      border: none;
    }

    .results-btn-primary:hover {
      background: var(--coral-strong);
      transform: translateY(-1px);
    }

    .results-btn-secondary {
      background: var(--canvas-raised);
      color: var(--brand-strong);
      border: 2px solid var(--brand);
    }

    .results-btn-secondary:hover {
      background: var(--brand-tint);
    }

    /* ============================= RESPONSIVE ============================= */
    @media (max-width: 560px) {
      .hear-word-btn {
        width: 6.5rem;
        height: 6.5rem;
      }

      .hear-word-btn svg {
        width: 2.6rem;
        height: 2.6rem;
      }

      .check-btn,
      .continue-btn {
        width: 100%;
      }

      .spelling-input {
        max-width: 100%;
      }

      .results-actions {
        flex-direction: column;
        width: 100%;
      }

      .results-btn {
        width: 100%;
      }
    }
  </style>
</Proto>
