---
// Direction A Grade Hub body — lavender-neutral atmosphere, three strand
// destination cards, editorial "Where to begin" guidance, prev/next/all-grades
// nav. Built from the same buildGradeHubModel() data the legacy template
// uses; only the rendered markup/styles differ.
import AtmosphereBand from './AtmosphereBand.astro';
import type { GradeHubModel } from '@/lib/content/gradeHubModel';
import { STRAND_ACCENT, ACCENT_INK_CLASS, ACCENT_BEFORE_BG_CLASS } from '@/lib/content/pilotContent';
import type { GradeConfigEntry } from '@/lib/content/gradeConfig';

interface Props {
  label: string;
  hub: GradeHubModel;
  prev?: GradeConfigEntry;
  next?: GradeConfigEntry;
}

const { label, hub, prev, next } = Astro.props;
---

<AtmosphereBand tone="grade" ariaLabel={`${label} spelling strands`} class="mt-6 rounded-3xl md:mt-8">
  <header class="mb-10 max-w-2xl md:mb-12">
    <h1 class="font-quicksand text-[clamp(2rem,4.2vw,2.75rem)] font-bold leading-[1.1] text-da-ink">
      {label} Spelling Words
    </h1>
    {hub.orientation.map((paragraph) => (
      <p class="mt-4 text-[1.1rem] leading-relaxed text-da-ink-soft">{paragraph}</p>
    ))}
  </header>

  <div class="grid gap-5 md:grid-cols-3" role="list" aria-label={`${label} strands`}>
    {hub.strands.map((strand) => {
      const accent = STRAND_ACCENT[strand.strand];
      return (
        <a
          href={strand.href}
          role="listitem"
          class:list={[
            'group relative flex flex-col gap-3 overflow-hidden rounded-2xl border border-da-border bg-da-canvas-raised p-7 shadow-sm transition',
            'before:absolute before:inset-y-0 before:left-0 before:w-1.5 before:content-[\'\']',
            'hover:-translate-y-1 hover:border-da-border-strong hover:shadow-lg',
            'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-da-brand',
            ACCENT_BEFORE_BG_CLASS[accent],
          ]}
        >
          <h2 class:list={['font-quicksand text-xl font-bold', ACCENT_INK_CLASS[accent]]}>{strand.label}</h2>
          <p class="flex-grow text-[0.98rem] leading-relaxed text-da-ink-soft">{strand.summary}</p>
          <span class:list={['mt-2 inline-flex items-center gap-1.5 text-[0.95rem] font-bold', ACCENT_INK_CLASS[accent]]}>
            {strand.linkLabel}
            <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
          </span>
        </a>
      );
    })}
  </div>
</AtmosphereBand>

<div class="mx-auto max-w-2xl px-5 sm:px-6 md:max-w-3xl">
  <section aria-labelledby="guidance-heading" class="my-10 max-w-[60ch] border-l-[3px] border-da-brand pl-5 sm:pl-6 md:my-12">
    <p class="mb-2 font-quicksand text-[0.78rem] font-bold uppercase tracking-[0.08em] text-da-brand-strong">Guidance</p>
    <h2 id="guidance-heading" class="font-quicksand text-xl font-bold text-da-ink">Where to begin</h2>
    <p class="mt-2 text-[1.02rem] leading-relaxed text-da-ink-soft">{hub.synthesis}</p>
  </section>

  <nav aria-label="Adjacent grade levels" class="mb-6 grid grid-cols-1 items-center gap-2 rounded-xl border border-da-border bg-da-canvas-raised p-2 shadow-sm sm:grid-cols-[1fr_auto_1fr]">
    {prev ? (
      <a href={prev.hubHref} class="inline-flex min-h-[44px] items-center gap-2 rounded-lg px-3 py-2 text-sm font-bold text-da-ink-soft transition hover:bg-da-surface-neutral hover:text-da-brand-strong">
        ← {prev.label} Spelling Words
      </a>
    ) : <span></span>}
    <a href="/#grades" class="inline-flex min-h-[44px] items-center justify-center rounded-full border-[1.5px] border-da-border-strong bg-da-surface-neutral px-4 py-2 text-sm font-bold text-da-ink-soft transition hover:border-da-brand hover:text-da-brand-strong sm:order-none">
      All grades
    </a>
    {next ? (
      <a href={next.hubHref} class="inline-flex min-h-[44px] items-center justify-end gap-2 rounded-lg px-3 py-2 text-right text-sm font-bold text-da-ink-soft transition hover:bg-da-surface-neutral hover:text-da-brand-strong">
        {next.label} Spelling Words →
      </a>
    ) : <span></span>}
  </nav>
</div>
