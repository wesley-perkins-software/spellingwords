---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ListMetadataBadges from '@/components/ListMetadataBadges.astro';
import { getListsByGrade, isPublished, resolveListRefs, getMemberListIds } from '@/lib/content/spellingLists';
import { categoryLabels } from '@/lib/content/categoryMeta';
import { LEARNING_PATHS } from '@/lib/content/learningPaths';

const allCollections = (await getCollection('spelling-collections')).filter((c) => c.data.status === 'published');
const memberIds = getMemberListIds(allCollections);

const entries = (await getCollection('spelling-lists')).filter(isPublished);

// Grade-first sections — only show grades that have published content
const gradeConfig = [
  { grade: 'K', label: 'Kindergarten' },
  { grade: '1', label: '1st Grade' },
  { grade: '2', label: '2nd Grade' },
  { grade: '3', label: '3rd Grade' },
  { grade: '4', label: '4th Grade' },
  { grade: '5', label: '5th Grade' },
];

type GradeItem =
  | { kind: 'collection'; entry: (typeof allCollections)[number] }
  | { kind: 'list'; entry: (typeof entries)[number] };

const gradeSections = gradeConfig
  .map(({ grade, label }) => {
    const gradeLists = getListsByGrade(grade, entries);
    const gradeCollections = allCollections.filter((c) => c.data.grade === grade);
    const items: GradeItem[] = [
      ...gradeCollections.map((c) => ({ kind: 'collection' as const, entry: c })),
      ...gradeLists
        .filter((e) => !memberIds.has(e.data.id))
        .map((e) => ({ kind: 'list' as const, entry: e })),
    ];
    return { grade, label, items };
  })
  .filter(({ items }) => items.length > 0);

const ungradedLists = entries.filter((e) => !e.data.grade && !memberIds.has(e.data.id));

const resolvedPaths = LEARNING_PATHS.map((path) => ({
  path,
  lists: resolveListRefs([...path.listIds], entries),
})).filter(({ lists }) => lists.length > 0);

// Editorial featured list definitions — verified against published content
const featuredListIds = [
  'kindergarten-first-words',
  'grade-1-list-01',
  'grade-2-list-01',
  'silent-e-long-a',
  'digraph-th-words',
] as const;

const featuredLists = featuredListIds
  .map((id) => entries.find((e) => e.data.id === id))
  .filter((e): e is (typeof entries)[number] => e !== undefined);

const gradeHubSlugs: Record<string, string> = {
  K: 'kindergarten',
  '1': '1st-grade',
  '2': '2nd-grade',
  '3': '3rd-grade',
  '4': '4th-grade',
  '5': '5th-grade',
};

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Spelling Lists Library' },
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://spellingwords.app');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};
---

<Layout
  title="Spelling Lists Library — Free, Curated Spelling Words for Grades K–5"
  description="Browse hundreds of free spelling lists for kindergarten through 5th grade. Organized by grade level and skill type — phonics, sight words, grade-level, and challenge. Audio-supported, no account required."
  jsonLd={breadcrumbJsonLd}
>
  <SiteHeader variant="discovery" currentPath="/spelling-lists" />

  <main id="main-content">
    <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
      <div class="mb-6">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <!-- Hero -->
      <div class="mb-14">
        <h1 class="mb-4 font-display text-3xl font-semibold text-ink md:text-4xl">
          Find the Right Spelling List for Your Child
        </h1>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">
          This library contains hundreds of hand-curated spelling lists for children in kindergarten
          through 5th grade — organized by grade level and by spelling skill. Every list is free,
          audio-supported, and ready to practice in seconds. No account required.
        </p>
        <p class="mt-4">
          <a
            href="/"
            class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
          >
            ← Enter your own word list instead
          </a>
        </p>
      </div>

      <!-- Primary Decision Area -->
      <section aria-labelledby="browse-paths-heading" class="mb-14">
        <h2 id="browse-paths-heading" class="sr-only">Choose How to Browse</h2>
        <div class="grid gap-5 sm:grid-cols-2">
          <!-- Browse by Grade -->
          <div class="flex flex-col gap-4 rounded-2xl border border-line bg-app-cloud p-6">
            <div>
              <h2 class="mb-2 font-display text-lg font-semibold text-ink">Browse by Grade</h2>
              <p class="text-sm leading-relaxed text-ink-soft">
                Good for parents following weekly school spelling assignments, teachers planning by
                curriculum year, or anyone who knows their child's grade level.
              </p>
            </div>
            <div class="flex flex-wrap gap-2" role="list" aria-label="Grade levels">
              {gradeConfig.map(({ grade, label }) => {
                const hasContent = gradeSections.some((s) => s.grade === grade);
                const hubHref = `/spelling-lists/${gradeHubSlugs[grade]}`;
                return hasContent ? (
                  <a
                    href={hubHref}
                    role="listitem"
                    class="inline-flex items-center rounded-xl border border-brand-blue/30 bg-white px-3 py-1.5 text-sm font-semibold text-brand-blue transition hover:bg-brand-blue/5 hover:border-brand-blue/50"
                  >
                    {label}
                  </a>
                ) : (
                  <span
                    role="listitem"
                    title="Coming soon"
                    class="inline-flex items-center rounded-xl border border-line bg-white px-3 py-1.5 text-sm font-medium text-ink-faint cursor-default select-none"
                  >
                    {label}
                  </span>
                );
              })}
            </div>
            <a
              href="/spelling-lists/kindergarten"
              class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
            >
              Browse Kindergarten–5th Grade →
            </a>
          </div>

          <!-- Browse by Skill -->
          <div class="flex flex-col gap-4 rounded-2xl border border-line bg-app-cloud p-6">
            <div>
              <h2 class="mb-2 font-display text-lg font-semibold text-ink">Browse by Skill</h2>
              <p class="text-sm leading-relaxed text-ink-soft">
                Good for teachers working through a phonics sequence, parents targeting a specific
                pattern like silent e or vowel teams, or anyone supporting a child with targeted
                reading practice.
              </p>
            </div>
            <div class="flex flex-col gap-2">
              <a
                href="/spelling-lists/phonics"
                class="flex items-start gap-3 rounded-xl border border-line bg-white p-3 transition hover:border-brand-blue/30 hover:bg-brand-blue/3"
              >
                <div>
                  <div class="font-display text-sm font-semibold text-ink">Phonics</div>
                  <div class="text-xs leading-relaxed text-ink-soft">Blends, digraphs, vowel teams, silent e, and more</div>
                </div>
              </a>
              <a
                href="/spelling-lists/sight-words"
                class="flex items-start gap-3 rounded-xl border border-line bg-white p-3 transition hover:border-brand-blue/30 hover:bg-brand-blue/3"
              >
                <div>
                  <div class="font-display text-sm font-semibold text-ink">Sight Words</div>
                  <div class="text-xs leading-relaxed text-ink-soft">Dolch high-frequency words, Pre-Primer through Grade 3</div>
                </div>
              </a>
              <a
                href="/spelling-lists/grade-level"
                class="flex items-start gap-3 rounded-xl border border-line bg-white p-3 transition hover:border-brand-blue/30 hover:bg-brand-blue/3"
              >
                <div>
                  <div class="font-display text-sm font-semibold text-ink">Grade-Level Vocabulary</div>
                  <div class="text-xs leading-relaxed text-ink-soft">Core words matched to grade expectations, K–5</div>
                </div>
              </a>
              <a
                href="/spelling-lists/challenge"
                class="flex items-start gap-3 rounded-xl border border-line bg-white p-3 transition hover:border-brand-blue/30 hover:bg-brand-blue/3"
              >
                <div>
                  <div class="font-display text-sm font-semibold text-ink">Challenge &amp; Advanced</div>
                  <div class="text-xs leading-relaxed text-ink-soft">Greek and Latin roots, spelling bee prep, advanced patterns</div>
                </div>
              </a>
            </div>
            <a
              href="/spelling-lists/phonics"
              class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
            >
              Browse All Categories →
            </a>
          </div>
        </div>
      </section>

      <!-- Featured Collections -->
      {featuredLists.length > 0 && (
        <section aria-labelledby="featured-heading" class="mb-14">
          <h2 id="featured-heading" class="mb-1 font-display text-lg font-semibold text-ink">
            A Few Good Places to Start
          </h2>
          <p class="mb-5 text-sm leading-relaxed text-ink-soft">
            Not sure where to begin? These lists represent some of the most useful starting points in the library.
          </p>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {featuredLists.map((entry) => (
              <a
                href={`/spelling-lists/${entry.data.category}/${entry.data.urlSlug}`}
                class="flex flex-col gap-2 rounded-2xl border border-line bg-white p-4 shadow-card transition hover:-translate-y-0.5 hover:shadow-card-md"
              >
                <div class="flex flex-col gap-0.5">
                  <span class="text-xs font-medium text-ink-faint">
                    {categoryLabels[entry.data.category] ?? entry.data.category}
                    {entry.data.grade ? ` · ${entry.data.grade === 'K' ? 'Kindergarten' : `Grade ${entry.data.grade}`}` : ''}
                  </span>
                  <h3 class="font-display text-sm font-semibold text-ink">{entry.data.title}</h3>
                </div>
                <p class="text-xs leading-relaxed text-ink-soft line-clamp-2">{entry.data.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Help Choosing -->
      <section aria-labelledby="help-choosing-heading" class="mb-14">
        <h2 id="help-choosing-heading" class="mb-1 font-display text-lg font-semibold text-ink">
          Not Sure Which Path Is Right?
        </h2>
        <p class="mb-5 text-sm leading-relaxed text-ink-soft">
          Here are a few common situations and where each one usually leads.
        </p>
        <div class="flex flex-col gap-3">
          <div class="rounded-xl border border-line bg-app-cloud px-5 py-4">
            <p class="text-sm leading-relaxed text-ink">
              <strong class="font-semibold">Your child brings home a weekly spelling list from school.</strong>{' '}
              <span class="text-ink-soft">Start with Browse by Grade — you'll find lists that match what most schools teach at that level.</span>
            </p>
          </div>
          <div class="rounded-xl border border-line bg-app-cloud px-5 py-4">
            <p class="text-sm leading-relaxed text-ink">
              <strong class="font-semibold">You're working on reading and want to reinforce phonics.</strong>{' '}
              <span class="text-ink-soft">Browse Phonics — the lists are organized by pattern, so you can work through blends, digraphs, and vowel sounds in sequence.</span>
            </p>
          </div>
          <div class="rounded-xl border border-line bg-app-cloud px-5 py-4">
            <p class="text-sm leading-relaxed text-ink">
              <strong class="font-semibold">Your child is an early reader learning high-frequency words.</strong>{' '}
              <span class="text-ink-soft">Browse Sight Words — the Dolch lists cover the most common words in early reading, from Pre-Primer through Grade 3.</span>
            </p>
          </div>
          <div class="rounded-xl border border-line bg-app-cloud px-5 py-4">
            <p class="text-sm leading-relaxed text-ink">
              <strong class="font-semibold">You're preparing for a spelling bee or want more challenge.</strong>{' '}
              <span class="text-ink-soft">Browse Challenge Lists — built around Greek and Latin roots and advanced patterns for strong spellers ready to go further.</span>
            </p>
          </div>
        </div>
      </section>

      <!-- Learning Paths -->
      {resolvedPaths.length > 0 && (
        <section aria-labelledby="learning-paths-heading" class="mb-14">
          <h2 id="learning-paths-heading" class="mb-1 font-display text-lg font-semibold text-ink">
            Guided Sequences
          </h2>
          <p class="mb-6 max-w-2xl text-sm leading-relaxed text-ink-soft">
            These curated sequences walk through a skill step by step — a good choice when you're not sure which list to tackle next.
          </p>
          <div class="flex flex-col gap-6">
            {resolvedPaths.map(({ path, lists }) => (
              <div class="rounded-2xl border border-line bg-app-cloud p-5">
                <h3 class="mb-1 font-display text-base font-semibold text-ink">
                  <a href={`/learning-paths/${path.id}`} class="hover:text-brand-blue hover:underline">{path.title}</a>
                </h3>
                <p class="mb-4 text-sm leading-relaxed text-ink-soft">{path.description}</p>
                <ol class="flex flex-wrap items-center gap-2" aria-label={`${path.title} steps`}>
                  {lists.map((entry, i) => (
                    <>
                      <li class="flex items-center">
                        <a
                          href={`/spelling-lists/${entry.data.category}/${entry.data.urlSlug}`}
                          class="rounded-lg border border-line bg-white px-3 py-1.5 text-sm font-medium text-ink shadow-sm transition hover:border-brand-blue/40 hover:text-brand-blue"
                        >
                          {entry.data.title}
                        </a>
                      </li>
                      {i < lists.length - 1 && (
                        <li aria-hidden="true" class="select-none text-sm text-ink-faint">→</li>
                      )}
                    </>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Explore Everything -->
      <section aria-labelledby="all-lists-heading" class="flex flex-col gap-12">
        <div>
          <h2 id="all-lists-heading" class="mb-1 font-display text-lg font-semibold text-ink">
            Explore Every List
          </h2>
          <p class="text-sm leading-relaxed text-ink-soft">
            Every list in the library, organized by grade. Start here if you already know what you're looking for.
          </p>
        </div>

        {gradeSections.map(({ grade, label, items }) => (
          <section id={`grade-${grade}`} aria-labelledby={`grade-${grade}-heading`} class="flex flex-col gap-4 scroll-mt-20">
            <div class="flex items-baseline gap-3">
              <h3
                id={`grade-${grade}-heading`}
                class="font-display text-base font-semibold text-ink"
              >
                {label}
              </h3>
              <span class="text-sm text-ink-faint">{items.length} {items.length === 1 ? 'item' : 'items'}</span>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              {items.map((item) => item.kind === 'collection' ? (
                <a
                  href={`/spelling-lists/collections/${item.entry.data.urlSlug}`}
                  class="flex flex-col gap-3 rounded-2xl border border-line bg-white p-5 shadow-card transition hover:-translate-y-0.5 hover:shadow-card-md"
                >
                  <div class="flex flex-col gap-1">
                    <div class="flex items-center gap-2">
                      <span class="rounded-md bg-app-cloud px-2 py-0.5 text-xs font-medium text-ink-soft">
                        {categoryLabels[item.entry.data.category] ?? item.entry.data.category}
                      </span>
                      <span class="rounded-md bg-brand-blue/8 px-2 py-0.5 text-xs font-semibold text-brand-blue">
                        {item.entry.data.listIds.length}-part collection
                      </span>
                    </div>
                    <h4 class="mt-1 font-display text-base font-semibold text-ink">{item.entry.data.title}</h4>
                    <p class="text-sm leading-relaxed text-ink-soft">{item.entry.data.description}</p>
                  </div>
                </a>
              ) : (
                <a
                  href={`/spelling-lists/${item.entry.data.category}/${item.entry.data.urlSlug}`}
                  class="flex flex-col gap-3 rounded-2xl border border-line bg-white p-5 shadow-card transition hover:-translate-y-0.5 hover:shadow-card-md"
                >
                  <div class="flex flex-col gap-1">
                    <div class="flex items-center gap-2">
                      <span class="rounded-md bg-app-cloud px-2 py-0.5 text-xs font-medium text-ink-soft">
                        {categoryLabels[item.entry.data.category] ?? item.entry.data.category}
                      </span>
                    </div>
                    <h4 class="mt-1 font-display text-base font-semibold text-ink">{item.entry.data.title}</h4>
                    <p class="text-sm leading-relaxed text-ink-soft">{item.entry.data.description}</p>
                  </div>
                  <ListMetadataBadges
                    difficulty={item.entry.data.difficulty}
                    durationMinutes={item.entry.data.estimatedDurationMinutes}
                    wordCount={item.entry.data.words.length}
                  />
                </a>
              ))}
            </div>
          </section>
        ))}

        {ungradedLists.length > 0 && (
          <section id="challenge" aria-labelledby="challenge-heading" class="flex flex-col gap-4 scroll-mt-20">
            <div class="flex items-baseline gap-3">
              <h3 id="challenge-heading" class="font-display text-base font-semibold text-ink">
                Challenge &amp; Advanced
              </h3>
              <span class="text-sm text-ink-faint">{ungradedLists.length} {ungradedLists.length === 1 ? 'list' : 'lists'}</span>
            </div>
            <p class="max-w-2xl text-sm leading-relaxed text-ink-soft">
              Advanced lists for strong spellers — built around Greek and Latin roots and tricky patterns, for spelling-bee prep or students ready to go further.
            </p>
            <div class="grid gap-4 sm:grid-cols-2">
              {ungradedLists.map((entry) => (
                <a
                  href={`/spelling-lists/${entry.data.category}/${entry.data.urlSlug}`}
                  class="flex flex-col gap-3 rounded-2xl border border-line bg-white p-5 shadow-card transition hover:-translate-y-0.5 hover:shadow-card-md"
                >
                  <div class="flex flex-col gap-1">
                    <h4 class="font-display text-base font-semibold text-ink">{entry.data.title}</h4>
                    <p class="text-sm leading-relaxed text-ink-soft">{entry.data.description}</p>
                  </div>
                  <ListMetadataBadges
                    difficulty={entry.data.difficulty}
                    durationMinutes={entry.data.estimatedDurationMinutes}
                    wordCount={entry.data.words.length}
                  />
                </a>
              ))}
            </div>
          </section>
        )}
      </section>

      <!-- Editorial quality note -->
      <p class="mt-14 border-t border-line pt-6 text-sm leading-relaxed text-ink-faint">
        Every list in this library was hand-reviewed for age-appropriateness. Example sentences are
        human-written, not generated.
      </p>
    </div>
  </main>

  <SiteFooter />
</Layout>
