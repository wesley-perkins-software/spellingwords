---
import Proto from './_shared/Proto.astro';
import Header from './_shared/Header.astro';
import Footer from './_shared/Footer.astro';
import Button from './_shared/Button.astro';
import Chip from './_shared/Chip.astro';
import SectionBand from './_shared/SectionBand.astro';

const grades = [
  {
    label: 'Kindergarten',
    short: 'K',
    teaser: 'Letter sounds, sight words, and first spelling patterns.',
    accent: 'sun',
  },
  {
    label: 'Grade 1',
    short: '1',
    teaser: 'Short vowels, digraphs, and high-frequency words.',
    accent: 'coral',
  },
  {
    label: 'Grade 2',
    short: '2',
    teaser: 'Compound words, blends, and long vowel patterns.',
    accent: 'teal',
  },
  {
    label: 'Grade 3',
    short: '3',
    teaser: 'Prefixes, suffixes, and multisyllable words.',
    accent: 'periwinkle',
  },
  {
    label: 'Grade 4',
    short: '4',
    teaser: 'Word roots, homophones, and spelling patterns that trip students up.',
    accent: 'pink',
  },
  {
    label: 'Grade 5',
    short: '5',
    teaser: 'Advanced patterns, commonly confused words, and academic vocabulary.',
    accent: 'brand',
  },
];
---

<Proto
  title="SpellingWords.app — Direction A prototype"
  description="Free K–5 spelling practice by grade or skill, no account required."
>
  <Header currentPath="/design-explore/direction-a/" />

  <main id="main">
    <!-- ============================= HERO ============================= -->
    <section class="hero">
      <div class="wrap hero-inner">
        <div class="hero-copy">
          <h1>Practice <span class="accent-word">spelling</span> your way.</h1>
          <p class="hero-sub">
            Use your own words, follow a structured K–5 spelling curriculum, or explore a
            library of focused spelling skills. Free to use, with no account or login required.
          </p>
        </div>

        <form class="word-card" aria-labelledby="word-card-heading">
          <div class="word-card-head">
            <label id="word-card-heading" for="word-input">Enter your spelling words</label>
            <span class="word-count-pill" aria-hidden="true">0 words</span>
          </div>
          <textarea
            id="word-input"
            name="words"
            rows="6"
            placeholder="Type or paste your words here, one per line"></textarea>
          <p class="word-helper">Add at least 1 word to start practicing.</p>
          <Button type="submit" size="lg" class="start-btn">Start Practicing →</Button>
        </form>
      </div>
    </section>

    <!-- ========================= BROWSE BY GRADE ======================== -->
    <SectionBand tone="sunken" class="section grades-section">
      <div class="section-head">
        <h2>Browse by Grade</h2>
        <p>
          Follow an organized Kindergarten–5th Grade spelling path built around Core Spelling,
          High-Frequency Words, and Themed Spelling Practice.
        </p>
      </div>

      <div class="grade-grid">
        {
          grades.map((grade) => (
            <a class={`grade-card accent-${grade.accent}`} href="/design-explore/direction-a/grade-hub">
              <span class="grade-band" aria-hidden="true" />
              <span class="grade-numeral" aria-hidden="true">{grade.short}</span>
              <span class="grade-label">{grade.label}</span>
              <span class="grade-teaser">{grade.teaser}</span>
            </a>
          ))
        }
      </div>
    </SectionBand>

    <!-- ========================= BROWSE BY SKILL ======================== -->
    <SectionBand tone="teal" class="section skill-section">
      <div class="skill-inner">
        <div class="skill-copy">
          <h2>Browse by Skill</h2>
          <p>
            Already know what to work on? Explore dozens of spelling skills, from short vowels
            and consonant blends to prefixes, suffixes, homophones, and commonly confused
            words — go straight to the specific spelling skill your student needs.
          </p>
          <Button
            href="/design-explore/direction-a/skill-detail"
            variant="secondary"
            class="browse-skills-btn"
          >
            Browse Spelling Skills →
          </Button>
        </div>
        <ul class="skill-chips">
          <li class="visually-hidden">Examples of spelling skills:</li>
          <li><Chip tone="teal">Short vowels</Chip></li>
          <li><Chip tone="periwinkle">Consonant blends</Chip></li>
          <li><Chip tone="sun">Prefixes</Chip></li>
          <li><Chip tone="teal">Homophones</Chip></li>
          <li><Chip tone="periwinkle">Suffixes</Chip></li>
          <li><Chip tone="sun">Commonly confused words</Chip></li>
        </ul>
      </div>
    </SectionBand>

    <!-- ============================ TRUST ============================= -->
    <SectionBand tone="sun" class="section trust-section">
      <div class="trust-inner">
        <h2>More than a list of spelling words</h2>
        <p>
          SpellingWords.app brings a structured K–5 spelling curriculum, a library of focused
          spelling skills, and space to practice a student's own words together in one place —
          organized by spelling patterns and high-frequency words, not a random list to
          memorize. Parents and teachers get an organized path to follow, and students get calm,
          focused practice. It's free, with no account required, and there are no timers,
          points, or competitions.
        </p>
      </div>
    </SectionBand>
  </main>

  <Footer />

  <style>
    /* ============================== HERO ============================== */
    .hero {
      background: linear-gradient(180deg, var(--brand-tint) 0%, var(--canvas) 78%);
      padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(3rem, 7vw, 5rem);
    }

    .hero-inner {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: center;
    }

    .hero-copy h1 {
      font-size: clamp(2.25rem, 4.6vw, 3.6rem);
      line-height: 1.08;
      letter-spacing: -0.01em;
    }

    .accent-word {
      color: var(--coral-strong);
    }

    .hero-sub {
      margin-top: 1.25rem;
      font-size: 1.1rem;
      line-height: 1.6;
      color: var(--ink-soft);
      max-width: 46ch;
    }

    .word-card {
      background: var(--canvas-raised);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: clamp(1.5rem, 3vw, 2.25rem);
      box-shadow: var(--shadow-md);
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
    }

    .word-card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .word-card-head label {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.15rem;
      color: var(--ink);
    }

    .word-count-pill {
      flex-shrink: 0;
      background: var(--coral-tint);
      color: var(--coral-ink);
      font-weight: 700;
      font-size: 0.82rem;
      padding: 0.3rem 0.75rem;
      border-radius: var(--radius-pill);
    }

    .word-card textarea {
      width: 100%;
      resize: vertical;
      min-height: 9.5rem;
      border: 2px solid var(--border-strong);
      border-radius: var(--radius-sm);
      padding: 0.9rem 1rem;
      font-family: var(--font-body);
      font-size: 1rem;
      color: var(--ink);
      background: var(--canvas);
    }

    .word-card textarea::placeholder {
      color: var(--ink-faint);
    }

    .word-card textarea:focus-visible {
      border-color: var(--brand);
    }

    .word-helper {
      font-size: 0.88rem;
      color: var(--ink-faint);
    }

    :global(.start-btn) {
      align-self: flex-start;
    }

    /* ============================ SECTIONS ============================= */
    .section-head {
      max-width: 62ch;
      margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
    }

    .section-head h2,
    .skill-copy h2,
    .trust-inner h2 {
      font-size: clamp(1.7rem, 3vw, 2.15rem);
    }

    .section-head p {
      margin-top: 0.75rem;
      color: var(--ink-soft);
      font-size: 1.05rem;
      line-height: 1.6;
    }

    /* ============================ GRADE GRID ============================ */
    .grade-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .grade-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      background: var(--canvas-raised);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.5rem 1.35rem 1.6rem;
      text-decoration: none;
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .grade-card:hover,
    .grade-card:focus-visible {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lift);
    }

    .grade-band {
      position: absolute;
      inset: 0 0 auto 0;
      height: 8px;
    }

    .grade-numeral {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 2.4rem;
      line-height: 1;
      margin-top: 0.5rem;
    }

    .grade-label {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--ink);
    }

    .grade-teaser {
      font-size: 0.92rem;
      color: var(--ink-soft);
      line-height: 1.5;
    }

    .accent-sun .grade-band {
      background: var(--sun);
    }
    .accent-sun .grade-numeral {
      color: var(--sun-ink);
    }

    .accent-coral .grade-band {
      background: var(--coral);
    }
    .accent-coral .grade-numeral {
      color: var(--coral-ink);
    }

    .accent-teal .grade-band {
      background: var(--teal);
    }
    .accent-teal .grade-numeral {
      color: var(--teal-ink);
    }

    .accent-periwinkle .grade-band {
      background: var(--periwinkle);
    }
    .accent-periwinkle .grade-numeral {
      color: var(--periwinkle-ink);
    }

    .accent-pink .grade-band {
      background: var(--pink);
    }
    .accent-pink .grade-numeral {
      color: var(--pink-ink);
    }

    .accent-brand .grade-band {
      background: var(--brand);
    }
    .accent-brand .grade-numeral {
      color: var(--brand-strong);
    }

    /* ============================ SKILL SECTION ========================= */
    .skill-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
      gap: clamp(2rem, 5vw, 3.5rem);
      align-items: center;
    }

    .skill-copy p {
      margin-top: 1rem;
      color: var(--ink-soft);
      font-size: 1.05rem;
      line-height: 1.65;
      max-width: 54ch;
    }

    :global(.browse-skills-btn) {
      margin-top: 1.5rem;
    }

    .skill-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-content: flex-start;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    /* ============================ TRUST SECTION ========================= */
    .trust-inner {
      max-width: 74ch;
      background: var(--brand-tint);
      border: 1px solid color-mix(in srgb, var(--brand) 55%, var(--border-strong));
      border-radius: var(--radius-lg);
      padding: clamp(2rem, 5vw, 3rem);
      box-shadow: var(--shadow-sm);
    }

    .trust-inner h2 {
      color: var(--brand-strong);
    }

    .trust-inner p {
      margin-top: 1.1rem;
      color: var(--ink-soft);
      font-size: 1.05rem;
      line-height: 1.7;
    }

    /* ============================ RESPONSIVE ============================ */
    @media (max-width: 900px) {
      .hero-inner {
        grid-template-columns: 1fr;
      }

      .grade-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .skill-inner {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 560px) {
      .grade-grid {
        grid-template-columns: 1fr;
      }

      .word-card-head {
        flex-wrap: wrap;
      }

      :global(.start-btn) {
        width: 100%;
        justify-content: center;
      }
    }
  </style>
</Proto>
