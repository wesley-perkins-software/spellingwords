---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SpellingListCard from '@/components/SpellingListCard.astro';
import { getListsByGrade, isPublished, getMemberListIds, groupByStrand } from '@/lib/content/spellingLists';
import { strandLabels, strandDescriptions, strandOrder, type Strand } from '@/lib/content/categoryMeta';

const GRADE = 'K';

const allCollections = (await getCollection('spelling-collections')).filter(
  (c) => c.data.status === 'published',
);
const memberIds = getMemberListIds(allCollections);
const entries = (await getCollection('spelling-lists')).filter(isPublished);

const gradeLists = getListsByGrade(GRADE, entries).filter((e) => !memberIds.has(e.data.id));
const gradeCollections = allCollections.filter((c) => c.data.grade === GRADE);
const totalItems = gradeCollections.length + gradeLists.length;
const byStrand = groupByStrand(gradeLists);
const presentStrands = strandOrder.filter((s) => (byStrand.get(s)?.length ?? 0) > 0) as Strand[];

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Spelling Lists Library', href: '/spelling-lists' },
  { label: 'Kindergarten' },
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://spellingwords.app');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Kindergarten Spelling Word Lists',
  numberOfItems: totalItems,
  itemListElement: [
    ...gradeCollections.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/spelling-lists/collections/${c.data.urlSlug}`, canonicalURL.origin).toString(),
      name: c.data.title,
    })),
    ...gradeLists.map((e, i) => ({
      '@type': 'ListItem',
      position: gradeCollections.length + i + 1,
      url: new URL(
        `/spelling-lists/${e.data.category}/${e.data.urlSlug}`,
        canonicalURL.origin,
      ).toString(),
      name: e.data.title,
    })),
  ],
};
---

<Layout
  title="Kindergarten Spelling Words | spellingwords.app"
  description="Free kindergarten spelling word lists for early practice — first words, number and color words, and describing words. Calm, simple practice with audio support."
  jsonLd={[breadcrumbJsonLd, itemListJsonLd]}
>
  <SiteHeader variant="discovery" currentPath="/spelling-lists" />

  <main id="main-content">
    <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
      <div class="mb-6">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <!-- Hero -->
      <div class="mb-10 flex flex-col gap-4">
        <h1 class="font-display text-2xl font-semibold text-ink md:text-3xl">
          Kindergarten Spelling Words
        </h1>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">
          Here are free kindergarten spelling word lists for early reading and writing practice,
          including first words, number words, color words, and describing words. All lists include
          audio support — a child can hear each word read aloud before typing it.
        </p>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">
          Kindergarten spelling practice should feel simple, encouraging, and concrete. These lists
          focus on early words children can hear, say, and spell — words that show up in their world
          every day. There are no timers or scores, just calm, supported practice.
        </p>
      </div>

      <!-- Lists -->
      {totalItems === 0 ? (
        <div class="rounded-2xl border border-line bg-app-cloud p-8 text-center">
          <p class="text-base text-ink-soft">
            Kindergarten lists are being prepared. Check back soon, or{' '}
            <a href="/spelling-lists" class="font-semibold text-brand-blue hover:underline">
              browse the full library
            </a>{' '}
            in the meantime.
          </p>
        </div>
      ) : (
        <div class="mb-12 flex flex-col gap-10">
          {gradeCollections.length > 0 && (
            <section aria-labelledby="collections-heading">
              <h2 id="collections-heading" class="mb-1 font-display text-base font-semibold text-ink">
                {strandLabels['foundations']}
              </h2>
              <p class="mb-4 text-sm text-ink-soft">{strandDescriptions['foundations']}</p>
              <div class="grid gap-4 sm:grid-cols-2">
                {gradeCollections.map((c) => (
                  <a
                    href={`/spelling-lists/collections/${c.data.urlSlug}`}
                    class="flex flex-col gap-3 rounded-2xl border border-line bg-white p-5 shadow-[0_4px_16px_-6px_rgba(31,41,55,0.06)] transition hover:-translate-y-0.5 hover:shadow-[0_8px_22px_-8px_rgba(47,111,237,0.25)]"
                  >
                    <div class="flex flex-col gap-1">
                      <div class="flex items-center gap-2">
                        <span class="rounded-md bg-app-cloud px-2 py-0.5 text-xs font-medium text-ink-soft">
                          Sight Words
                        </span>
                        <span class="rounded-md bg-brand-blue/8 px-2 py-0.5 text-xs font-semibold text-brand-blue">
                          {c.data.listIds.length}-part collection
                        </span>
                      </div>
                      <h3 class="mt-1 font-display text-base font-semibold text-ink">{c.data.title}</h3>
                      <p class="text-sm leading-relaxed text-ink-soft">{c.data.description}</p>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          )}
          {presentStrands.map((strand) => {
            const strandLists = byStrand.get(strand) ?? [];
            if (strandLists.length === 0) return null;
            const headingId = `strand-heading-${strand}`;
            return (
              <section aria-labelledby={headingId}>
                <h2 id={headingId} class="mb-1 font-display text-base font-semibold text-ink">
                  {strandLabels[strand]}
                </h2>
                <p class="mb-4 text-sm text-ink-soft">{strandDescriptions[strand]}</p>
                <div class="grid gap-4 sm:grid-cols-2">
                  {strandLists.map((entry) => (
                    <SpellingListCard
                      href={`/spelling-lists/${entry.data.category}/${entry.data.urlSlug}`}
                      category={entry.data.category}
                      title={entry.data.title}
                      description={entry.data.description}
                      difficulty={entry.data.difficulty}
                      durationMinutes={entry.data.estimatedDurationMinutes}
                      wordCount={entry.data.words.length}
                    />
                  ))}
                </div>
              </section>
            );
          })}
        </div>
      )}

      <!-- Choosing guidance -->
      {totalItems > 1 && (
        <section aria-labelledby="guidance-heading" class="mb-12 rounded-2xl border border-line bg-app-cloud p-6">
          <h2 id="guidance-heading" class="mb-2 font-display text-base font-semibold text-ink">
            How to choose a list
          </h2>
          <p class="text-sm leading-relaxed text-ink-soft">
            Start with <strong class="font-semibold text-ink">First Words</strong> if your child is
            just beginning to connect letters to sounds. <strong class="font-semibold text-ink">Number &amp;
            Color Words</strong> and <strong class="font-semibold text-ink">Describing Words</strong> work
            well alongside early reading practice. Sight word lists are great for daily repetition — short
            sessions of five to ten minutes work best at this age.
          </p>
        </section>
      )}

      <!-- Adjacent grade nav -->
      <nav aria-label="Adjacent grade levels" class="mb-10 flex items-center justify-between gap-4">
        <span></span>
        <a
          href="/spelling-lists/1st-grade"
          class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
        >
          1st Grade Spelling Words →
        </a>
      </nav>

      <!-- Back to library -->
      <p>
        <a
          href="/spelling-lists"
          class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
        >
          ← Back to the Spelling Lists Library
        </a>
      </p>
    </div>
  </main>

  <SiteFooter />
</Layout>
