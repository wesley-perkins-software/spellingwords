const directions = [
  { rank: 1, name: 'A — Focused word stage', href: './exploration-a/', palette: 'Indigo, cool paper, coral and gold accents', type: 'Petrona + Plus Jakarta Sans + Lexend', thesis: 'Make the word the event: a calm reading environment leads to one high-contrast practice stage.', appeal: 'Children get a clear sense of arrival and progress without mascots, prizes, or decoration.', strengths: 'Best practice hierarchy; warm editorial voice; feedback remains close to the answer.', weaknesses: 'The dark practice stage is visually heavier than the learning pages.', access: 'AA token pairs, explicit labels and status text, visible amber focus, 44px controls, reduced-motion fallback.', perf: 'HTML and scoped CSS only; three font families are the primary cost.' },
  { rank: 2, name: 'C — Clear learning index', href: './exploration-c/', palette: 'Neutral paper with cobalt, magenta, and emerald by content type', type: 'Sora + Public Sans + Readex Pro', thesis: 'Treat the curriculum as a beautifully typeset reference: color communicates content type, not decoration.', appeal: 'Predictable signposts help independent readers feel capable; generous word samples keep it concrete.', strengths: 'Strongest dense-page scanning and conventional navigation; easiest to extend.', weaknesses: 'Less emotionally distinctive and more school-like than A.', access: 'AA semantic colors, redundant feedback symbols and wording, strong focus, responsive tables/lists.', perf: 'No client JavaScript; restrained effects; external fonts can fall back to system faces.' },
  { rank: 3, name: 'B — Call and response', href: './exploration-b/', palette: 'Warm blush, coral, deep teal, and ink', type: 'Unbounded + Work Sans + IBM Plex Mono', thesis: 'Use bold typographic rhythm and alternating bands so instruction and child action feel like a conversation.', appeal: 'Energetic headings and workbook-like answer areas feel active without becoming juvenile.', strengths: 'Most expressive identity and strongest section rhythm.', weaknesses: 'Display type is slower to scan; warm bands can compete with dense curriculum.', access: 'Text and icons accompany color; large controls, focus outlines, landmarks, and reduced-motion rules.', perf: 'Static output and SVG icons are light; Unbounded font files are the largest likely transfer.' },
];
