---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';

const sampleWords = [
  'friend',
  'because',
  'different',
  'people',
  'every',
  'school',
  'always',
];

const placeholderText = sampleWords.join('\n');

const categories = [
  {
    href:        '/spelling-lists',
    count:       '48 words',
    name:        '1st Grade',
    desc:        'High-frequency sight words for early readers',
    accentClass: 'bg-brand-sky',
  },
  {
    href:        '/spelling-lists',
    count:       '72 words',
    name:        '2nd Grade',
    desc:        'Building blocks for confident spellers',
    accentClass: 'bg-chip-grass',
  },
  {
    href:        '/spelling-lists',
    count:       '96 words',
    name:        '3rd Grade',
    desc:        'Compound words, prefixes, and more',
    accentClass: 'bg-chip-sun',
  },
  {
    href:        '/spelling-lists',
    count:       '220 words',
    name:        'Sight Words',
    desc:        'Dolch and Fry high-frequency word lists',
    accentClass: 'bg-chip-berry',
  },
  {
    href:        '/spelling-lists',
    count:       '64 words',
    name:        'Silent E',
    desc:        'Magic-E patterns for stronger phonics',
    accentClass: 'bg-brand-red',
  },
  {
    href:        '/spelling-lists',
    count:       '150 words',
    name:        'Spelling Bee',
    desc:        'Classic bee words for competitive practice',
    accentClass: 'bg-brand-sky',
  },
];
---

<Layout
  title="spellingwords — Practice spelling words"
  description="Practice spelling with your own words or choose from hundreds of curated spelling lists. Free, no account needed."
>

  <style>
    /* ── Hero: very faint ruled-paper lines ─────────────────── */
    .hero-section::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      transform: translateX(-50%);
      width: 640px;
      background-image: repeating-linear-gradient(
        to bottom,
        transparent 0px,
        transparent 35px,
        rgba(43, 35, 24, 0.042) 35px,
        rgba(43, 35, 24, 0.042) 36px
      );
      pointer-events: none;
    }

    @media (max-width: 640px) {
      .hero-section::before { width: 100%; }
    }

    /* ── Load animations ─────────────────────────────────────── */
    .anim-1 { animation: fadeUp 0.55s 0.05s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .anim-2 { animation: fadeUp 0.55s 0.13s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .anim-3 { animation: fadeUp 0.55s 0.21s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .anim-4 { animation: fadeUp 0.55s 0.29s cubic-bezier(0.22, 1, 0.36, 1) both; }

    /* ── Input card: focus-within ring ───────────────────────── */
    .input-card:focus-within {
      box-shadow:
        0 6px 20px -6px rgba(43, 35, 24, 0.14),
        0 0 0 3px rgba(201, 64, 48, 0.16);
    }

    /* ── Word count pill: active state ───────────────────────── */
    #word-count-pill.has-words {
      @apply bg-ink text-app-paper;
    }

    /* ── CTA button arrow nudge ───────────────────────────────── */
    .btn-arrow { display: inline-block; transition: transform 0.15s; }
    #btn-start:hover .btn-arrow { transform: translateX(4px); }

    /* ── Category card scroll-reveal ─────────────────────────── */
    .cat-card {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity    0.4s ease,
        transform  0.4s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.15s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .cat-card.visible { opacity: 1; transform: translateY(0); }
    .cat-card:hover   { transform: translateY(-4px) !important; box-shadow: 0 12px 36px -8px rgba(43, 35, 24, 0.18) !important; }

    /* ── Trust item scroll-reveal ────────────────────────────── */
    .trust-item {
      opacity: 0;
      transform: translateY(12px);
      transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .trust-item.visible { opacity: 1; transform: translateY(0); }
  </style>

  <SiteHeader currentPath="/" />

  <main id="main-content">

    <!-- ═══ HERO ════════════════════════════════════════════════ -->
    <section
      class="hero-section relative overflow-hidden py-20 text-center md:py-24"
      aria-labelledby="hero-heading"
    >
      <!-- Ghost word — decorative background letterform -->
      <span
        class="pointer-events-none select-none absolute top-1/2 left-1/2 font-word font-bold leading-none tracking-[0.12em] whitespace-nowrap"
        style="transform: translate(-50%, -52%); font-size: clamp(120px, 18vw, 220px); color: rgba(43, 35, 24, 0.032);"
        aria-hidden="true"
      >spelling</span>

      <div class="relative mx-auto max-w-content-xl px-6">

        <h1
          id="hero-heading"
          class="anim-1 text-display-xl mb-9"
        >
          Practice <span class="text-brand-red">spelling</span>,<br>starting now.
        </h1>

        <!-- Word input card -->
        <div class="anim-2 input-card mx-auto mb-5 max-w-content-sm overflow-hidden rounded-[22px] border border-line bg-app-paper shadow-card-md transition-shadow">

          <div class="flex items-center justify-between border-b border-line bg-app-cloud px-[18px] py-2.5">
            <label for="word-input" class="text-[13px] font-bold text-ink-soft tracking-[0.01em]">
              Enter one word per line
            </label>
            <span
              id="word-count-pill"
              class="font-sans text-[11px] font-extrabold uppercase tracking-[0.04em] text-ink-soft bg-cream-deep px-3 py-1 rounded-full transition-colors duration-200"
              aria-live="polite"
              aria-atomic="true"
            >
              {sampleWords.length} words
            </span>
          </div>

          <textarea
            id="word-input"
            rows="7"
            class="w-full resize-none bg-app-paper px-5 py-4 font-word text-[19px] leading-[1.85] text-ink tracking-[0.015em] placeholder:text-ink-faint focus:outline-none"
            spellcheck="false"
            autocomplete="off"
            aria-label="Spelling words, one per line"
          >{placeholderText}</textarea>

          <div class="border-t border-line bg-app-cloud px-[18px] py-2">
            <p
              id="input-status"
              class="text-[13px] font-semibold text-ink-soft"
              aria-live="polite"
              aria-atomic="true"
            >
              {sampleWords.length} words ready to practice.
            </p>
          </div>
        </div>

        <!-- Primary CTA -->
        <div class="anim-3">
          <button
            id="btn-start"
            type="button"
            class="btn-action"
            aria-label="Start a spelling practice session"
          >
            Start Practicing <span class="btn-arrow" aria-hidden="true">→</span>
          </button>
        </div>

        <span class="anim-4 mt-5 block text-sm font-semibold text-ink-faint">
          or <a
            href="#curated-lists"
            class="font-bold text-brand-sky border-b border-brand-sky/35 pb-px transition hover:text-brand-blue hover:border-brand-blue"
          >choose from our spelling lists</a>
        </span>

      </div>
    </section>

    <hr class="h-px border-none bg-line mx-6" />

    <!-- ═══ CURATED LISTS ════════════════════════════════════════ -->
    <section
      id="curated-lists"
      class="mx-auto max-w-content-xl px-6 py-16 scroll-mt-[72px]"
      aria-labelledby="curated-heading"
    >
      <div class="mb-9">
        <p class="mb-2.5 text-[11px] font-extrabold uppercase tracking-[0.14em] text-brand-sky">
          Ready-Made Lists
        </p>
        <h2
          id="curated-heading"
          class="text-display-lg mb-2"
        >
          Hundreds of spelling lists,<br>ready to use.
        </h2>
        <p class="max-w-content-sm text-[15px] font-medium text-ink-soft leading-[1.55]">
          Choose by grade level, phonics pattern, sight words, and more —
          all free, no account needed.
        </p>
      </div>

      <div
        class="mb-8 grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-3"
        role="list"
        aria-label="Spelling list categories"
      >
        {categories.map(({ href, count, name, desc, accentClass }) => (
          <a
            href={href}
            class="cat-card flex flex-col overflow-hidden rounded-2xl border border-line bg-app-paper shadow-card"
            role="listitem"
          >
            <div class={`h-1 flex-shrink-0 ${accentClass}`}></div>
            <div class="flex flex-col gap-1 p-[18px] pb-4">
              <span class="text-caption">
                {count}
              </span>
              <span class="font-display text-[21px] font-semibold text-ink leading-[1.1] tracking-[-0.01em]">
                {name}
              </span>
              <span class="mt-0.5 text-[13px] font-medium text-ink-soft leading-[1.45]">
                {desc}
              </span>
            </div>
          </a>
        ))}
      </div>

      <a
        href="/spelling-lists"
        class="inline-flex items-center gap-1.5 border-b-2 border-brand-sky/30 pb-0.5 text-[15px] font-extrabold text-brand-sky transition hover:border-brand-blue hover:text-brand-blue"
      >
        Browse the full spelling library →
      </a>
    </section>

    <!-- ═══ TRUST ════════════════════════════════════════════════ -->
    <section
      id="how-it-works"
      class="border-t border-line py-12 md:py-14"
      aria-labelledby="trust-heading"
    >
      <div class="mx-auto max-w-content-xl px-6">
        <h2 id="trust-heading" class="sr-only">Why families and teachers choose spellingwords</h2>
        <ul class="grid grid-cols-1 gap-3.5 list-none sm:grid-cols-3" role="list">
          <li class="trust-item rounded-2xl bg-app-cloud px-5 py-5">
            <span class="mb-2.5 block text-[22px]" aria-hidden="true">📖</span>
            <p class="mb-1 font-display text-[18px] font-semibold text-ink tracking-[-0.01em]">No account needed</p>
            <p class="text-sm font-medium text-ink-soft leading-[1.45]">Jump straight in — no login, no email, no setup.</p>
          </li>
          <li class="trust-item rounded-2xl bg-app-cloud px-5 py-5">
            <span class="mb-2.5 block text-[22px]" aria-hidden="true">🎧</span>
            <p class="mb-1 font-display text-[18px] font-semibold text-ink tracking-[-0.01em]">Hear every word</p>
            <p class="text-sm font-medium text-ink-soft leading-[1.45]">Text-to-speech reads each word aloud, just like a real test.</p>
          </li>
          <li class="trust-item rounded-2xl bg-app-cloud px-5 py-5">
            <span class="mb-2.5 block text-[22px]" aria-hidden="true">💻</span>
            <p class="mb-1 font-display text-[18px] font-semibold text-ink tracking-[-0.01em]">Works everywhere</p>
            <p class="text-sm font-medium text-ink-soft leading-[1.45]">Chromebook, iPad, phone, or desktop — it just works.</p>
          </li>
        </ul>
      </div>
    </section>

  </main>

  <SiteFooter />

  <script>
    import { parseWordInput, encodeWordList } from '@/lib/words';

    const textarea = document.getElementById('word-input') as HTMLTextAreaElement;
    const pill     = document.getElementById('word-count-pill')!;
    const status   = document.getElementById('input-status')!;
    const btn      = document.getElementById('btn-start') as HTMLButtonElement;

    function getWords(): string[] {
      return parseWordInput(textarea.value);
    }

    function updateStatus(): void {
      const words = getWords();
      const count = words.length;

      pill.textContent = `${count} ${count === 1 ? 'word' : 'words'}`;
      pill.classList.toggle('has-words', count > 0);

      if (count === 0) {
        status.textContent = 'Enter your words above, then press Start.';
        btn.disabled = true;
      } else if (count > 200) {
        status.textContent = 'Maximum 200 words. Please remove some words.';
        btn.disabled = true;
      } else {
        status.textContent = `${count} ${count === 1 ? 'word' : 'words'} ready to practice.`;
        btn.disabled = false;
      }
    }

    function handleStart(): void {
      const words = getWords();
      if (words.length === 0 || words.length > 200) return;

      const result = encodeWordList(words);
      if (!result.ok) {
        status.textContent =
          result.code === 'payload_too_long'
            ? 'Word list is too long to encode. Please shorten some words.'
            : 'Could not create test. Please check your word list.';
        return;
      }

      window.location.href = `/play?list=${result.payload}`;
    }

    textarea.addEventListener('input', updateStatus);
    btn.addEventListener('click', handleStart);
    updateStatus();

    // Scroll-triggered reveal for category cards and trust items
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) {
          (e.target as HTMLElement).classList.add('visible');
          io.unobserve(e.target);
        }
      }),
      { threshold: 0.1 }
    );

    document.querySelectorAll('.cat-card').forEach((el, i) => {
      (el as HTMLElement).style.transitionDelay = `${i * 0.045}s`;
      io.observe(el);
    });

    document.querySelectorAll('.trust-item').forEach((el, i) => {
      (el as HTMLElement).style.transitionDelay = `${i * 0.07}s`;
      io.observe(el);
    });
  </script>

</Layout>
