---
import Proto from './_shared/Proto.astro';
import Header from './_shared/Header.astro';
import Footer from './_shared/Footer.astro';

const grades = [
  { label: 'Kindergarten', href: '#', blurb: 'Letter sounds and first sight words' },
  { label: '1st Grade', href: '#', blurb: 'Blends, digraphs, and short vowels' },
  { label: '2nd Grade', href: '#', blurb: 'Silent e, vowel teams, and contractions' },
  {
    label: '3rd Grade',
    href: '/design-explore/exploration-c/grade-hub.html',
    blurb: 'Prefixes, suffixes, and homophones',
  },
  { label: '4th Grade', href: '#', blurb: 'Advanced affixes and multisyllabic words' },
  { label: '5th Grade', href: '#', blurb: 'Greek and Latin word parts' },
];

const skills = [
  { label: 'Short Vowels', href: '#' },
  { label: 'Silent E', href: '#' },
  { label: 'Soft C and Soft G', href: '/design-explore/exploration-c/skill.html' },
  { label: 'Prefixes', href: '#' },
  { label: 'Suffixes', href: '#' },
  { label: 'Greek and Latin Roots', href: '#' },
  { label: 'Homophones', href: '#' },
  { label: 'R-Controlled Vowels', href: '#' },
];
---

<Proto
  title="SpellingWords.app — Exploration C"
  description="Design exploration C: homepage for calm K-5 spelling practice, a beautifully conventional information architecture."
>
  <Header currentPath="/design-explore/exploration-c/" />

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Free · No account needed</p>
          <h1 class="hero-title">
            Hear the word. Write it down. <span class="hero-title-accent"
              >That's the whole idea.</span
            >
          </h1>
          <p class="hero-sub">
            SpellingWords.app is calm, focused spelling practice for kids in kindergarten through
            5th grade — read aloud, typed by hand, with no timers, points, or streaks to chase.
          </p>
          <div class="hero-actions">
            <a class="btn btn-grade" href="/design-explore/exploration-c/grade-hub.html"
              >Browse by grade</a
            >
            <a class="btn btn-skill" href="/design-explore/exploration-c/skill.html"
              >Browse by skill</a
            >
          </div>
          <ul class="hero-trust">
            <li>K–5 curriculum, built by grade</li>
            <li>Works with your own word list</li>
            <li>No login, no ads, no data games</li>
          </ul>
        </div>

        <div class="hero-panel">
          <p class="hero-panel-eyebrow">Practice your own words</p>
          <label class="hero-panel-label" for="word-input"
            >Type or paste a list — one word per line</label
          >
          <textarea
            id="word-input"
            class="hero-textarea"
            rows="4"
            placeholder={'lighthouse\nbeneath\nharvest'}></textarea>
          <div class="hero-panel-row">
            <button type="button" class="btn btn-practice">Start this list</button>
            <span class="hero-panel-count">3 words ready</span>
          </div>
          <div class="hero-panel-divider" role="presentation"></div>
          <div class="hero-preview">
            <p class="hero-preview-label">Sounds like this:</p>
            <div class="hero-preview-word">
              <button type="button" class="hero-audio-btn" aria-label="Play the word harvest">
                <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
                  <path d="M4 9v6h4l5 5V4L8 9H4z" fill="currentColor" /><path
                    d="M16.5 8.5a5 5 0 0 1 0 7"
                    stroke="currentColor"
                    stroke-width="1.8"
                    fill="none"
                    stroke-linecap="round"
                  /><path
                    d="M19 6.5a8.5 8.5 0 0 1 0 11"
                    stroke="currentColor"
                    stroke-width="1.8"
                    fill="none"
                    stroke-linecap="round"
                    opacity="0.6"
                  /></svg
                >
              </button>
              <span class="hero-preview-word-text">harvest</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ BROWSE BY GRADE ============ -->
    <section class="section" id="grades" aria-labelledby="grades-heading">
      <div class="wrap">
        <div class="section-head">
          <span class="section-kicker kicker-grade">By grade</span>
          <h2 id="grades-heading">Browse by grade</h2>
          <p class="section-sub">
            Every grade combines a core spelling sequence, high-frequency word sets, and optional
            themed practice tied to what kids are learning in class.
          </p>
        </div>
        <ul class="grade-grid">
          {
            grades.map((grade, i) => (
              <li>
                <a class="grade-card" href={grade.href}>
                  <span class="grade-card-index">{String(i).padStart(2, '0')}</span>
                  <span class="grade-card-label">{grade.label}</span>
                  <span class="grade-card-blurb">{grade.blurb}</span>
                  <span class="grade-card-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ============ BROWSE BY SKILL ============ -->
    <section class="section section-tinted" id="skills" aria-labelledby="skills-heading">
      <div class="wrap">
        <div class="section-head">
          <span class="section-kicker kicker-skill">By skill</span>
          <h2 id="skills-heading">Browse by skill</h2>
          <p class="section-sub">
            Prefer to practice a specific pattern instead of a full grade? Jump straight to a
            phonics or spelling-rule skill.
          </p>
        </div>
        <ul class="skill-chip-row">
          {
            skills.map((skill) => (
              <li>
                <a class="skill-chip" href={skill.href}>
                  {skill.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="text-link link-skill" href="/design-explore/exploration-c/skill.html"
          >See all spelling skills →</a
        >
      </div>
    </section>

    <!-- ============ WHY IT WORKS ============ -->
    <section class="section" aria-labelledby="why-heading">
      <div class="wrap why-grid">
        <div class="why-copy">
          <span class="section-kicker kicker-practice">The approach</span>
          <h2 id="why-heading">Built for how kids actually learn to spell</h2>
          <p class="section-sub">
            No timers ticking down, no points to chase, no streak to protect. Just a word, spoken
            clearly, and a quiet place to write it — as many times as it takes.
          </p>
        </div>
        <ol class="why-list">
          <li>
            <span class="why-icon">1</span>
            <div>
              <h3>Hear it, clearly</h3>
              <p>Every word is read aloud on request, as many times as needed.</p>
            </div>
          </li>
          <li>
            <span class="why-icon">2</span>
            <div>
              <h3>Write it, calmly</h3>
              <p>One word at a time, with gentle, specific feedback — never a red flood.</p>
            </div>
          </li>
          <li>
            <span class="why-icon">3</span>
            <div>
              <h3>No pressure, ever</h3>
              <p>No timers, points, or streaks. Practice ends when the words are done.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    /* ============ HERO ============ */
    .hero {
      padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 6rem);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(2rem, 5vw, 4.5rem);
      align-items: start;
    }

    .eyebrow {
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 1.1rem;
    }

    .hero-title {
      font-size: clamp(2.25rem, 4.4vw, 3.15rem);
      line-height: 1.12;
      letter-spacing: -0.015em;
      color: var(--ink);
    }

    .hero-title-accent {
      color: var(--practice-strong);
    }

    .hero-sub {
      margin-top: 1.5rem;
      font-size: 1.08rem;
      line-height: 1.6;
      color: var(--ink-soft);
      max-width: 46ch;
    }

    .hero-actions {
      margin-top: 2rem;
      display: flex;
      gap: 0.9rem;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
      padding: 0.85rem 1.6rem;
      border-radius: var(--radius-pill);
      border: 2px solid transparent;
      cursor: pointer;
      transition:
        background 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease,
        transform 0.1s ease;
    }

    .btn-grade {
      background: var(--grade-strong);
      color: #fff;
    }
    .btn-grade:hover {
      background: var(--grade-ink);
    }

    .btn-skill {
      background: transparent;
      color: var(--skill-strong);
      border-color: var(--skill-strong);
    }
    .btn-skill:hover {
      background: var(--skill);
    }

    .btn-practice {
      background: var(--practice-strong);
      color: #fff;
      border: none;
    }
    .btn-practice:hover {
      background: var(--practice-ink);
    }

    .hero-trust {
      margin: 2.25rem 0 0;
      padding: 0;
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }

    .hero-trust li {
      font-size: 0.88rem;
      color: var(--ink-soft);
      padding-left: 1.4rem;
      position: relative;
    }

    .hero-trust li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.42rem;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--practice-vivid);
    }

    /* ---- hero panel: light surface, thin practice-hue ring, own craft ---- */
    .hero-panel {
      background: var(--canvas-raised);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-lg);
      padding: clamp(1.5rem, 3vw, 2.1rem);
      box-shadow: var(--shadow-lg);
      position: relative;
    }

    .hero-panel::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      border: 1.5px solid var(--practice-strong);
      opacity: 0.16;
      pointer-events: none;
    }

    .hero-panel-eyebrow {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--practice-strong);
      margin-bottom: 0.5rem;
    }

    .hero-panel-label {
      display: block;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--ink);
      margin-bottom: 0.7rem;
    }

    .hero-textarea {
      width: 100%;
      resize: vertical;
      min-height: 6.5rem;
      background: var(--canvas-sunken);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-md);
      color: var(--ink);
      font-family: var(--font-word);
      font-size: 1rem;
      padding: 0.85rem 1rem;
      line-height: 1.6;
    }

    .hero-textarea::placeholder {
      color: var(--ink-faint);
    }

    .hero-textarea:focus-visible {
      outline-color: var(--focus-ring);
      border-color: transparent;
    }

    .hero-panel-row {
      margin-top: 1.1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .hero-panel-count {
      font-size: 0.82rem;
      color: var(--ink-faint);
      font-weight: 600;
    }

    .hero-panel-divider {
      height: 1px;
      background: var(--border);
      margin: 1.4rem 0 1.2rem;
    }

    .hero-preview-label {
      font-size: 0.78rem;
      color: var(--ink-faint);
      margin-bottom: 0.65rem;
      font-weight: 600;
    }

    .hero-preview-word {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .hero-audio-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 50%;
      background: var(--practice);
      border: 1.5px solid var(--practice-vivid);
      color: var(--practice-ink);
      cursor: pointer;
      flex-shrink: 0;
      transition: background 0.15s ease;
    }
    .hero-audio-btn:hover {
      background: var(--practice-vivid);
      color: #fff;
    }

    .hero-preview-word-text {
      font-family: var(--font-word);
      font-size: 1.4rem;
      font-weight: 500;
      letter-spacing: 0.01em;
      color: var(--ink-faint);
    }

    /* ============ SECTION SHELL ============ */
    .section {
      padding-block: clamp(3rem, 6vw, 4.5rem);
    }

    .section-tinted {
      background: var(--canvas-sunken);
    }

    .section-head {
      max-width: 62ch;
      margin-bottom: 2.25rem;
    }

    .section-kicker {
      display: inline-block;
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.28rem 0.7rem;
      border-radius: var(--radius-pill);
      margin-bottom: 0.9rem;
    }
    .kicker-grade {
      background: var(--grade);
      color: var(--grade-ink);
    }
    .kicker-skill {
      background: var(--skill);
      color: var(--skill-ink);
    }
    .kicker-practice {
      background: var(--practice);
      color: var(--practice-ink);
    }

    .section-head h2 {
      font-size: clamp(1.5rem, 2.6vw, 1.9rem);
      margin-bottom: 0.65rem;
    }

    .section-sub {
      color: var(--ink-soft);
      font-size: 1rem;
      line-height: 1.6;
    }

    /* ============ GRADE GRID ============ */
    .grade-grid {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .grade-card {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      text-decoration: none;
      background: var(--canvas-raised);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.35rem 1.4rem 1.5rem;
      position: relative;
      box-shadow: var(--shadow-sm);
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease;
    }

    .grade-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
      border-color: var(--grade-vivid);
    }

    .grade-card-index {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 0.8rem;
      color: var(--grade-strong);
      letter-spacing: 0.03em;
      margin-bottom: 0.3rem;
    }

    .grade-card-label {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.12rem;
      color: var(--ink);
    }

    .grade-card-blurb {
      font-size: 0.88rem;
      color: var(--ink-soft);
      line-height: 1.5;
    }

    .grade-card-arrow {
      position: absolute;
      top: 1.3rem;
      right: 1.3rem;
      color: var(--grade-vivid);
      font-size: 1.1rem;
    }

    /* ============ SKILL CHIPS ============ */
    .skill-chip-row {
      list-style: none;
      margin: 0 0 1.5rem;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
    }

    .skill-chip {
      display: inline-flex;
      align-items: center;
      text-decoration: none;
      background: var(--canvas-raised);
      color: var(--ink);
      border: 1.5px solid var(--border-strong);
      border-radius: var(--radius-pill);
      padding: 0.55rem 1.15rem;
      font-size: 0.9rem;
      font-weight: 600;
      transition:
        border-color 0.15s ease,
        color 0.15s ease,
        background 0.15s ease;
    }

    .skill-chip:hover {
      border-color: var(--skill-strong);
      color: var(--skill-strong);
      background: var(--skill);
    }

    .text-link {
      display: inline-block;
      font-weight: 700;
      font-size: 0.92rem;
      text-decoration: none;
    }
    .text-link:hover {
      text-decoration: underline;
    }
    .link-skill {
      color: var(--skill-strong);
    }

    /* ============ WHY GRID ============ */
    .why-grid {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }

    .why-copy h2 {
      font-size: clamp(1.5rem, 2.6vw, 1.9rem);
      margin-bottom: 0.9rem;
    }

    .why-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
    }

    .why-list li {
      display: flex;
      gap: 1.1rem;
      align-items: flex-start;
    }

    .why-icon {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.4rem;
      height: 2.4rem;
      border-radius: 50%;
      background: var(--practice);
      color: var(--practice-ink);
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1rem;
    }

    .why-list h3 {
      font-size: 1.05rem;
      margin-bottom: 0.3rem;
    }

    .why-list p {
      font-size: 0.92rem;
      color: var(--ink-soft);
      line-height: 1.55;
    }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 980px) {
      .hero-grid {
        grid-template-columns: 1fr;
      }
      .why-grid {
        grid-template-columns: 1fr;
      }
      .grade-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 640px) {
      .grade-grid {
        grid-template-columns: 1fr;
      }
      .hero-actions .btn {
        flex: 1 1 auto;
      }
      .hero-panel-row {
        flex-direction: column;
        align-items: stretch;
        gap: 0.7rem;
      }
      .hero-panel-row .btn-practice {
        width: 100%;
      }
      .hero-panel-count {
        text-align: center;
      }
    }
  </style>
</Proto>
