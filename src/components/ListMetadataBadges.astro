---
import { categoryLabels, difficultyLabels } from '@/lib/content/categoryMeta';
import type { SpellingListEntry } from '@/lib/content/spellingLists';

interface Props {
  category?: SpellingListEntry['data']['category'];
  difficulty: SpellingListEntry['data']['difficulty'];
  durationMinutes: number;
  wordCount: number;
  wordCountLabel?: string;
}

const { category, difficulty, durationMinutes, wordCount, wordCountLabel } = Astro.props;
---

<div class="flex flex-wrap items-center gap-2 text-xs font-medium">
  {category && (
    <span class="rounded-full bg-accent-teal-tint px-3 py-1 font-semibold text-accent-teal">
      {categoryLabels[category] ?? category}
    </span>
  )}
  <span class="rounded-full bg-accent-gold-tint px-3 py-1 font-semibold text-accent-gold">
    {difficultyLabels[difficulty] ?? difficulty}
  </span>
  <span class="rounded-full bg-canvas-sunken px-3 py-1 font-semibold text-brand">
    ~{durationMinutes} min
  </span>
  <span class="rounded-full bg-accent-coral-tint px-3 py-1 font-semibold text-accent-coral">
    {wordCountLabel ?? `${wordCount} words`}
  </span>
</div>
