---
import Proto from './_shared/Proto.astro';
import Header from './_shared/Header.astro';
import Footer from './_shared/Footer.astro';
import Button from './_shared/Button.astro';
import Chip from './_shared/Chip.astro';

const words = ['cat', 'hat', 'bed', 'red', 'pig', 'sit', 'hot', 'dog', 'bug', 'run'];
---

<Proto
  title="Short Vowels: CVC Words — Direction A prototype"
  description="Practice short-vowel CVC spelling words: cat, hat, bed, red, pig, sit, hot, dog, bug, run."
>
  <Header currentPath="/design-explore/direction-a/skill" />

  <main id="main">
    <div class="wrap page-shell">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol>
          <li><a href="/design-explore/direction-a/">Home</a></li>
          <li><a href="/design-explore/direction-a/grade-hub">Grade 1 Spelling Words</a></li>
          <li><a href="/design-explore/direction-a/skill">Core Spelling</a></li>
          <li aria-current="page">Short Vowels: CVC Words</li>
        </ol>
      </nav>

      <section class="hero-card">
        <ul class="hero-chips">
          <li><Chip tone="brand"><span class="visually-hidden">Grade: </span>Grade 1</Chip></li>
          <li><Chip tone="teal"><span class="visually-hidden">Skill area: </span>Phonics</Chip></li>
          <li><Chip tone="sun"><span class="visually-hidden">Level: </span>Beginner</Chip></li>
        </ul>
        <h1>Short Vowels: CVC Words</h1>
        <Button href="/design-explore/direction-a/practice" size="lg">Practice these words →</Button>
      </section>

      <div class="content-grid">
        <div class="content-main">
          <!-- ============ CHAPTER 1 — ORIENTATION ============ -->
          <section class="prose-section chapter-open" aria-labelledby="what-heading">
            <h2 id="what-heading">What are Short Vowels: CVC Words?</h2>
            <p>
              This list practices short-vowel CVC words such as cat, hot, and bug — a
              foundational phonics pattern from the early-elementary curriculum.
            </p>
            <p class="readiness-line">
              <strong>A good fit for students who</strong> can identify beginning and ending
              consonant sounds, and are ready to blend a single short-vowel sound in the middle
              of a three-letter word.
            </p>
          </section>

          <hr class="rule chapter-rule" />

          <!-- ============ CHAPTER 2 — THE WORDS (central artifact) ============ -->
          <section class="wordlist-chapter" aria-labelledby="wordlist-heading">
            <p class="eyebrow">Word list</p>
            <div class="wordlist-head">
              <h2 id="wordlist-heading">10 words for this unit</h2>
              <p class="wordlist-meta">Grade 1 · Core Spelling · Short vowels</p>
            </div>
            <!--
              Tinted sun field ties this word list back to its Core Spelling
              strand color on the Grade Hub. A skill page under a different
              strand (High-Frequency Words, Themed Spelling Practice) would
              use that strand's own tint (teal, periwinkle) here instead.
            -->
            <div class="word-list-panel">
              <ul class="word-list">
                {words.map((word) => <li>{word}</li>)}
              </ul>
            </div>
          </section>

          <!-- ============ CHAPTER 3 — TEACHING CONTEXT ============ -->
          <section class="teaching-chapter" aria-labelledby="about-heading">
            <p class="eyebrow">About this pattern</p>
            <h2 id="about-heading">Why CVC words come first</h2>
            <p>
              Consonant-vowel-consonant (CVC) words are the first words most students decode and
              spell independently. Practicing one short-vowel sound at a time — and then mixing
              them — builds the pattern recognition that later phonics work depends on.
            </p>
          </section>

          <hr class="rule chapter-rule" />

          <!-- ============ CHAPTER 4 — FAQ ============ -->
          <section class="prose-section" aria-labelledby="faq-heading">
            <p class="eyebrow">Common questions</p>
            <h2 id="faq-heading">Frequently asked questions</h2>
            <dl class="faq-list">
              <div class="faq-item">
                <dt>What are short-vowel CVC words?</dt>
                <dd>
                  This list practices short-vowel CVC words such as cat, hot, and bug — a
                  foundational phonics pattern from the early-elementary curriculum.
                </dd>
              </div>
            </dl>
          </section>
        </div>

        <aside class="content-side" aria-label="Related learning">
          <section class="deeper-card">
            <h2>Go deeper</h2>
            <a class="deeper-link" href="#">
              <span class="deeper-title">Silent E: Long A Words</span>
              <span class="deeper-desc">
                The next step after short vowels: words where a silent e changes the vowel sound.
              </span>
            </a>
          </section>

          <a class="skill-ref-link" href="/design-explore/direction-a/skill-detail">
            <span class="skill-ref-label">Skill reference</span>
            <span class="skill-ref-title">AI and AY Words →</span>
            <span class="skill-ref-desc">
              Later in the sequence, students meet two-letter vowel teams. See the full teaching
              reference.
            </span>
          </a>

          <p class="source-line">Curated by the SpellingWords.app editorial team.</p>
        </aside>
      </div>
    </div>
  </main>

  <Footer />

  <style>
    /* Page-role atmosphere: Grade Unit pages read as a quiet warm-neutral
       (blush/apricot cast), distinct from the Grade Hub's lavender-neutral
       and the Skill page's mint-neutral. The blue hero and internal chapter
       surfaces (word-list neutral, "about this pattern" cool) stay as-is on
       top of it. */
    :global(body) {
      background: var(--surface-unit);
    }

    .page-shell {
      padding-block: clamp(2rem, 5vw, 3rem) clamp(3rem, 6vw, 4.5rem);
    }

    /* ============================= BREADCRUMB ============================= */
    .breadcrumb ol {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      list-style: none;
      margin: 0 0 1.5rem;
      padding: 0;
      font-size: 0.9rem;
      color: var(--ink-faint);
    }

    .breadcrumb li:not(:last-child)::after {
      content: '/';
      margin-left: 0.5rem;
      color: var(--border-strong);
    }

    .breadcrumb a {
      text-decoration: none;
      color: var(--ink-soft);
      font-weight: 600;
    }

    .breadcrumb a:hover {
      color: var(--brand);
    }

    .breadcrumb li[aria-current='page'] {
      color: var(--ink);
      font-weight: 700;
    }

    /* ============================= HERO CARD ============================= */
    .hero-card {
      background: var(--brand-tint);
      border: 1px solid var(--brand);
      border-radius: var(--radius-lg);
      padding: clamp(1.75rem, 4vw, 2.5rem);
      margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
      display: flex;
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }

    .hero-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .hero-card h1 {
      font-size: clamp(1.9rem, 4vw, 2.5rem);
    }

    /* ============================= CONTENT GRID ============================= */
    .content-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: clamp(2rem, 5vw, 3rem);
      align-items: start;
    }

    .prose-section {
      margin-bottom: clamp(2rem, 4vw, 2.75rem);
    }

    .prose-section h2 {
      font-size: 1.3rem;
      margin-bottom: 0.75rem;
    }

    .prose-section p {
      color: var(--ink-soft);
      font-size: 1.02rem;
      line-height: 1.7;
      max-width: 68ch;
    }

    .chapter-open p + p {
      margin-top: 0.9rem;
    }

    .readiness-line strong {
      color: var(--ink);
    }

    /* Chapter transitions read through spacing + a thin rule, not a
       change of card — keeps the page feeling like one flowing document
       with visible sections, rather than a stack of separate blocks. */
    .chapter-rule {
      margin-block: clamp(2.25rem, 4.5vw, 3rem);
    }

    /* ============================= WORD LIST (central artifact) ========= */
    /* A quiet neutral surface (layer 2) sits behind the sun-tint word-list
       panel (layer 3) sits behind the white word tiles (layer 4) — the
       word list gains presence through layered depth, not bigger tiles. */
    .wordlist-chapter {
      /* White, not surface-neutral — surface-neutral now sits too close in
         hue/lightness to the page's new warm-blush base to read as a
         distinct layer. */
      background: var(--surface-white);
      border-radius: var(--radius-lg);
      padding: clamp(1.5rem, 3.5vw, 2.25rem);
      margin-bottom: clamp(2.5rem, 5vw, 3.25rem);
    }

    .wordlist-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.5rem 1.5rem;
      margin-bottom: 1rem;
    }

    .wordlist-head h2 {
      font-size: 1.4rem;
    }

    .wordlist-meta {
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--ink-faint);
    }

    .word-list-panel {
      background: var(--sun-tint);
      border: 1px solid var(--sun);
      border-radius: var(--radius-lg);
      padding: clamp(1.5rem, 3.5vw, 2rem);
    }

    .word-list {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.75rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .word-list li {
      background: var(--canvas-raised);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 1rem 0.5rem;
      text-align: center;
      font-family: var(--font-word);
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--ink);
      box-shadow: var(--shadow-sm);
    }

    /* ============================= TEACHING CONTEXT ===================== */
    /* A cool-neutral surface — not another cream box on the cream page —
       marks the shift from the word list into teaching context. */
    .teaching-chapter {
      background: var(--surface-cool);
      border-radius: var(--radius-md);
      padding: clamp(1.5rem, 3.5vw, 2rem);
      margin-bottom: clamp(2rem, 4vw, 2.75rem);
    }

    .teaching-chapter h2 {
      font-size: 1.3rem;
      margin-bottom: 0.75rem;
    }

    .teaching-chapter p {
      color: var(--ink-soft);
      font-size: 1.02rem;
      line-height: 1.7;
      max-width: 68ch;
    }

    /* ============================= FAQ ============================= */
    /* Editorial rule-based treatment — a top rule and a small "Q" mark
       instead of a boxed accordion/SaaS-FAQ look. */
    .faq-list {
      margin: 0;
      display: flex;
      flex-direction: column;
    }

    .faq-item {
      padding-block: 1.25rem;
      border-top: 1px solid var(--border);
    }

    .faq-item dt {
      display: flex;
      gap: 0.6rem;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--ink);
      margin-bottom: 0.5rem;
    }

    .faq-item dt::before {
      content: 'Q';
      flex-shrink: 0;
      color: var(--brand);
      font-weight: 700;
    }

    .faq-item dd {
      margin: 0 0 0 1.35rem;
      color: var(--ink-soft);
      font-size: 1rem;
      line-height: 1.65;
    }

    /* ============================= SIDEBAR ============================= */
    .content-side {
      position: sticky;
      top: 5.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .deeper-card {
      background: var(--periwinkle-tint);
      border: 1px solid var(--periwinkle);
      border-radius: var(--radius-md);
      padding: 1.5rem;
    }

    .deeper-card h2 {
      font-size: 1rem;
      color: var(--periwinkle-ink);
      margin-bottom: 0.85rem;
    }

    .deeper-link {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      text-decoration: none;
    }

    .deeper-title {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--ink);
    }

    .deeper-link:hover .deeper-title {
      color: var(--periwinkle-ink);
      text-decoration: underline;
    }

    .deeper-desc {
      font-size: 0.92rem;
      color: var(--ink-soft);
      line-height: 1.55;
    }

    .skill-ref-link {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border);
      text-decoration: none;
    }

    .skill-ref-label {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--ink-faint);
    }

    .skill-ref-title {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1rem;
      color: var(--brand-strong);
    }

    .skill-ref-link:hover .skill-ref-title {
      text-decoration: underline;
    }

    .skill-ref-desc {
      font-size: 0.9rem;
      color: var(--ink-soft);
      line-height: 1.55;
    }

    .source-line {
      font-size: 0.85rem;
      color: var(--ink-faint);
    }

    /* ============================= RESPONSIVE ============================= */
    @media (max-width: 900px) {
      .content-grid {
        grid-template-columns: 1fr;
      }

      .content-side {
        position: static;
        flex-direction: row;
        flex-wrap: wrap;
      }

      .deeper-card {
        flex: 1 1 240px;
      }

      .skill-ref-link {
        flex: 1 1 240px;
        border-top: none;
        padding-top: 0;
      }

      .word-list {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    @media (max-width: 560px) {
      .word-list {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      :global(.hero-card .btn) {
        width: 100%;
        justify-content: center;
      }

      .content-side {
        flex-direction: column;
      }

      .skill-ref-link {
        border-top: 1px solid var(--border);
        padding-top: 1.25rem;
      }
    }
  </style>
</Proto>
