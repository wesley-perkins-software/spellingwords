---
// Word as Color Object — A3: Chromatic field + reading territory (skill / reference)
//
// The hero stays in the full dark chromatic field. The oversized "SH"
// ColorWord straddles the seam: it sits at the bottom of the field, and
// the reading territory (a light coral tint) slides up underneath it via
// a negative margin, so the giant letterform visually bridges both
// canvases — the transition device itself is the color-object grammar,
// not a physical paper/torn-edge metaphor.
import Proto from './_shared/Proto.astro';
import ColorWord from './_shared/ColorWord.astro';
import WordDisplay from './_shared/WordDisplay.astro';

const words = ['ship', 'shop', 'shut', 'wish', 'brush', 'dish'];

const comparisonRows = [
  { pattern1: 'ship', pattern2: 'chip' },
  { pattern1: 'shop', pattern2: 'chop' },
  { pattern1: 'wish', pattern2: 'witch' },
  { pattern1: 'dish', pattern2: 'ditch' },
];

const faqs = [
  {
    q: 'Does every SH sound get spelled with the letters S and H?',
    a: 'Usually, yes. In most words the /sh/ sound you hear is spelled with s and h together, as in ship or brush. There are a small number of exceptions, like sure and sugar, where the /sh/ sound is spelled differently — those are worth teaching separately once SH itself feels solid.',
  },
  {
    q: 'Can SH appear anywhere in a word, or just at the start?',
    a: 'Both. SH shows up at the start of words like ship and shop, and just as often at the end, as in wish, brush, and dish. Fewer words use it in the middle, but it does happen, as in washer.',
  },
];

const related = [
  { title: 'CH Digraph Words', kicker: 'Skill', fill: 'coral' as const },
  { title: 'Double Consonants', kicker: 'Skill', fill: 'periwinkle' as const },
  { title: '1st Grade Spelling Words', kicker: 'Grade', fill: 'lime' as const },
];
---

<Proto
  title="SH Digraph Words — A3 Field + reading territory — Word as Color Object exploration"
  description="Skill reference page: a dark chromatic field hands off into a coral-tinted reading territory, bridged by an oversized ColorWord letterform."
>
  <header class="site-head">
    <div class="wrap site-head-row">
      <a href="/design-explore/color-object-field-and-page" class="wordmark">
        <ColorWord word="spelling" fill="sunflower" ghostFill="coral" size="1.5rem" ghost={false} as="span" />
        <span class="wordmark-rest">words.app</span>
      </a>
      <nav aria-label="Primary">
        <a href="/design-explore/color-object-field-and-page/skill" aria-current="page">Skills</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <nav class="breadcrumb wrap" aria-label="Breadcrumb">
      <a href="/design-explore/color-object-field-and-page">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/design-explore/color-object-field-and-page/skill">Skills</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">SH Digraph Words</span>
    </nav>

    <section class="skill-hero">
      <div class="wrap">
        <p class="eyebrow">Skill &middot; Consonant digraphs</p>
        <p class="skill-intro">
          Words where the letters s and h team up to spell one single sound &mdash; not two sounds
          blended, one new one.
        </p>
      </div>
      <div class="seam" aria-hidden="true">
        <ColorWord word="SH" fill="coral" ghostFill="sunflower" size="clamp(6rem,22vw,13rem)" rotate="-2deg" strokeVar="--territory-bg" />
      </div>
    </section>

    <div class="reading-territory">
      <div class="wrap narrow territory-top">
        <h1 class="visually-hidden">SH Digraph Words</h1>
        <p class="territory-sub">
          This page covers how the SH pattern works, where it shows up, and six words to practice.
        </p>

        <div class="answer-block">
          <h2 class="answer-label">What are SH digraph words?</h2>
          <p class="answer-body">
            SH is a digraph: two letters, <strong>s</strong> and <strong>h</strong>, that together spell one
            new sound &mdash; the sound you hear at the start of <em>ship</em> or the end of <em>wish</em>.
            Neither letter keeps its usual sound on its own; combined, they make something new.
          </p>
        </div>

        <div class="word-list-block">
          <h2 class="word-list-label">Practice words</h2>
          <ul class="word-list" role="list">
            {
              words.map((w, i) => (
                <li class="word-chip">
                  <span class="chip-mark" style={`background: var(--${['coral', 'sunflower', 'periwinkle', 'lime'][i % 4]});`} aria-hidden="true" />
                  <WordDisplay word={w} size="clamp(1.35rem, 3vw, 1.75rem)" />
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="wrap narrow">
        <section class="section prose-section">
          <h2 class="prose-head">Understanding the pattern</h2>
          <div class="prose">
            <p>
              SH most often appears at the very start of a word, right where you&rsquo;d expect to hear it:
              <em>ship</em>, <em>shop</em>, and <em>shut</em> all open with the digraph, and the sound is
              usually the first thing a reader notices when sounding the word out.
            </p>
            <p>
              Just as often, SH lands at the end of a word instead &mdash; <em>wish</em>, <em>brush</em>, and
              <em>dish</em> all close with it. Ending SH words are a good next step once a student is
              comfortable spotting the pattern up front, since the sound is easy to hear but the spelling
              still needs to be remembered rather than guessed.
            </p>
            <p>
              A smaller number of words use SH in the middle, such as <em>washer</em> or <em>fisherman</em>.
              Those are worth introducing later, once the start- and end-of-word cases feel automatic.
            </p>
          </div>
        </section>

        <section class="section table-section">
          <h2 class="prose-head">SH vs. CH</h2>
          <p class="table-intro">
            SH and CH are easy to mix up early on &mdash; both are digraphs, and both can open or close a
            word. Hearing them side by side helps the distinction stick.
          </p>
          <div class="table-scroll">
            <table class="compare-table">
              <thead>
                <tr>
                  <th scope="col">SH words</th>
                  <th scope="col">CH words</th>
                </tr>
              </thead>
              <tbody>
                {
                  comparisonRows.map((r) => (
                    <tr>
                      <td><WordDisplay word={r.pattern1} size="1.15rem" /></td>
                      <td><WordDisplay word={r.pattern2} size="1.15rem" /></td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        <section class="section faq-section">
          <h2 class="prose-head">Frequently asked</h2>
          <dl class="faq-list">
            {
              faqs.map((f) => (
                <div class="faq-item">
                  <dt class="faq-q">{f.q}</dt>
                  <dd class="faq-a">{f.a}</dd>
                </div>
              ))
            }
          </dl>
        </section>
      </div>
    </div>

    <section class="section cta-section-wrap">
      <div class="wrap narrow cta-section cta-row">
        <div>
          <h2 class="cta-head">Ready to practice?</h2>
          <p class="cta-sub">Six words, read aloud one at a time, no timer running.</p>
        </div>
        <a class="btn btn-primary" href="/design-explore/color-object-field-and-page/skill">Practice these words</a>
      </div>
    </section>

    <section class="section related-section">
      <div class="wrap">
        <h2 class="section-head">Related</h2>
        <ul class="related-grid" role="list">
          {
            related.map((r) => (
              <li>
                <a class="related-card" href="/design-explore/color-object-field-and-page/skill">
                  <span class="related-kicker" style={`color: var(--${r.fill});`}>{r.kicker}</span>
                  <span class="related-title">{r.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <footer class="site-foot">
    <div class="wrap">
      <p>spellingwords.app &mdash; design exploration, not a live product. Variation A3 of Word as Color Object.</p>
    </div>
  </footer>
</Proto>

<style>
  .site-head {
    background: var(--canvas-deeper);
    border-bottom: 1px solid var(--border);
  }
  .site-head-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    text-decoration: none;
    font-family: var(--font-display);
  }
  .wordmark-rest {
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 700;
  }
  .site-head nav {
    display: flex;
    gap: 1.5rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .site-head nav a {
    text-decoration: none;
    color: var(--ink-soft);
    border-bottom: 2px solid transparent;
    padding-bottom: 0.2rem;
  }
  .site-head nav a[aria-current='page'] {
    color: var(--sunflower);
    border-bottom-color: var(--sunflower);
  }

  .breadcrumb {
    padding-block: 1.25rem;
    font-size: 0.88rem;
    color: var(--ink-faint);
    display: flex;
    gap: 0.5rem;
  }
  .breadcrumb a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .breadcrumb [aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }

  /* --- The field / seam / territory system --- */
  .skill-hero {
    background: radial-gradient(110% 160% at 10% 0%, var(--canvas-deep) 0%, var(--canvas) 70%);
    padding-block: 0.5rem 0;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-faint);
    margin: 0 0 0.75rem;
  }
  .skill-intro {
    max-width: 58ch;
    color: var(--ink-soft);
    font-size: 1.1rem;
    margin: 0;
  }

  .seam {
    /* The giant letterform straddles the field/territory boundary: it is
       the last thing in the (non-stacking-context) hero, so its own
       z-index competes directly with .reading-territory's z-index in the
       shared root stacking context, and a negative bottom margin lets it
       physically overlap the section that follows. */
    position: relative;
    z-index: 3;
    margin-top: clamp(0.5rem, 2vw, 1.5rem);
    margin-bottom: clamp(-3.25rem, -7vw, -5.5rem);
    padding-inline: clamp(1.25rem, 4vw, 3rem);
    line-height: 1;
  }

  .reading-territory {
    position: relative;
    z-index: 2;
    background: var(--territory-bg);
    padding-bottom: clamp(1rem, 3vw, 2rem);
  }
  .territory-top {
    padding-top: clamp(4.5rem, 10vw, 7.5rem);
  }
  .territory-sub {
    max-width: 62ch;
    color: var(--territory-ink-soft);
    font-size: 1.05rem;
    margin: 0 0 2rem;
  }

  .section {
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
  }
  .narrow {
    max-width: 820px;
  }

  .answer-block {
    background: var(--territory-bg-deep);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    margin-bottom: 2rem;
    border: 1px solid var(--territory-border);
  }
  .answer-label {
    margin: 0 0 0.6rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--territory-accent);
  }
  .answer-body {
    margin: 0;
    color: var(--territory-ink-soft);
    font-size: 1.02rem;
  }
  .answer-body strong {
    color: var(--territory-ink);
  }

  .word-list-block {
    margin-top: 2rem;
  }
  .word-list-label {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--territory-ink);
    margin: 0 0 0.9rem;
  }
  .word-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .word-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: #fff8f0;
    border: 1px solid var(--territory-border);
    border-radius: var(--radius-md);
    padding: 0.6rem 1.2rem 0.6rem 0.9rem;
  }
  .chip-mark {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    flex-shrink: 0;
  }

  .prose-head {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.35rem, 2.6vw, 1.7rem);
    color: var(--territory-ink);
    margin: 0 0 1rem;
  }
  .prose p {
    color: var(--territory-ink-soft);
    font-size: 1.02rem;
    max-width: 72ch;
    margin: 0 0 1rem;
  }
  .prose em {
    color: var(--territory-ink);
    font-style: normal;
    font-weight: 600;
  }

  .table-intro {
    color: var(--territory-ink-soft);
    max-width: 68ch;
    margin: 0 0 1.25rem;
  }
  .table-scroll {
    overflow-x: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--territory-border);
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    background: #fff8f0;
    min-width: 340px;
  }
  .compare-table th {
    text-align: left;
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--territory-ink);
    background: var(--territory-bg-deep);
    padding: 0.8rem 1.1rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .compare-table td {
    padding: 0.75rem 1.1rem;
    border-top: 1px solid var(--territory-border);
    color: var(--territory-ink);
  }

  .faq-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .faq-item {
    border-bottom: 1px solid var(--territory-border);
    padding-bottom: 1.25rem;
  }
  .faq-q {
    font-weight: 700;
    color: var(--territory-ink);
    font-size: 1.05rem;
    margin: 0 0 0.5rem;
  }
  .faq-a {
    margin: 0;
    color: var(--territory-ink-soft);
    max-width: 70ch;
  }

  /* CTA sits back in the field, marking the return trip from reading
     territory to the product's active-practice register. */
  .cta-section-wrap {
    padding-block: clamp(2rem, 4vw, 3rem);
    background: radial-gradient(120% 200% at 90% 0%, var(--canvas-deep) 0%, var(--canvas) 70%);
  }
  .cta-section {
    background: var(--canvas-deeper);
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 4vw, 2.5rem) clamp(1.25rem, 4vw, 2.5rem);
    border: 1px solid var(--border);
  }
  .cta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    max-width: 1180px;
  }
  .cta-head {
    margin: 0 0 0.3rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--ink);
  }
  .cta-sub {
    margin: 0;
    color: var(--ink-soft);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.85rem 1.6rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    min-height: 48px;
  }
  .btn-primary {
    background: var(--sunflower);
    color: var(--canvas-deeper);
  }
  .btn-primary:hover {
    background: #ffd464;
  }

  .related-section {
    background: var(--canvas);
  }
  .section-head {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 2.8vw, 1.9rem);
    margin: 0 0 1.5rem;
    color: var(--ink);
  }
  .related-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-decoration: none;
    background: var(--canvas-deep);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.4rem;
  }
  .related-card:hover {
    border-color: var(--sunflower);
  }
  .related-kicker {
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .related-title {
    color: var(--ink);
    font-weight: 700;
    font-size: 1.05rem;
  }

  .site-foot {
    background: var(--canvas-deeper);
    padding-block: 1.5rem;
    color: var(--ink-faint);
    font-size: 0.85rem;
  }

  @media (max-width: 860px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
    .cta-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 560px) {
    .seam {
      margin-bottom: clamp(-2rem, -8vw, -3rem);
    }
    .territory-top {
      padding-top: clamp(3.5rem, 16vw, 5rem);
    }
  }
</style>
