---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Button from '@/components/direction-a/Button.astro';
import Chip from '@/components/direction-a/Chip.astro';
import { SKILLS_INDEX_PATH } from '@/lib/content/canonicalSkillRoutes';
import { gradeConfig } from '@/lib/content/gradeConfig';
import {
  GRADE_ACCENT,
  STRAND_ACCENT,
  ACCENT_BG_CLASS,
  ACCENT_INK_CLASS,
  ACCENT_TINT_BG_CLASS,
  ACCENT_BORDER_CLASS,
  type DaAccent,
} from '@/lib/content/pilotContent';
import {
  homepageGradeHubs,
  homepageJsonLd,
  homepageFaqJsonLd,
  HOMEPAGE_SKILL_COUNT,
  HOMEPAGE_REPRESENTATIVE_SKILLS,
  HOMEPAGE_STRANDS,
  HOMEPAGE_PROGRESSION_STAGES,
  HOMEPAGE_PROGRESSION_NOTE,
  HOMEPAGE_US_POSITIONING,
  HOMEPAGE_AUDIENCES,
  HOMEPAGE_CLOSING_STATEMENT,
  HOMEPAGE_FAQ,
} from '@/lib/content/homepage';

const placeholderText = 'Type or paste your words here, one per line';

const gradeCards = homepageGradeHubs.map((hub, index) => ({
  ...hub,
  numeral: gradeConfig[index].grade,
  accent: GRADE_ACCENT[gradeConfig[index].grade],
}));

// Illustrative examples of the range of Skills on offer — drawn from the
// homepage's own permanent HOMEPAGE_REPRESENTATIVE_SKILLS list (also used
// in the prose above). These are category labels, not individual
// Skill-page destinations (per the same
// design-explore/direction-a mockup this section is drawn from), so they
// stay as plain decorative Chips — the "Browse Spelling Skills" button
// remains the one real link, to the canonical Skills index.
const REPRESENTATIVE_SKILL_TONES: readonly DaAccent[] = [
  'teal',
  'periwinkle',
  'sun',
  'teal',
  'periwinkle',
  'sun',
];
const representativeSkillChips = HOMEPAGE_REPRESENTATIVE_SKILLS.map((label, index) => ({
  label: label.charAt(0).toUpperCase() + label.slice(1),
  tone: REPRESENTATIVE_SKILL_TONES[index % REPRESENTATIVE_SKILL_TONES.length],
}));

// Reuses the same strand->accent mapping Grade Unit pages already draw
// from (STRAND_ACCENT), rather than inventing a fourth accent scheme just
// for this homepage section — HOMEPAGE_STRANDS is written in the same
// Core/HFW/Themed order as STRAND_ACCENT's own declaration.
const strandAccents = Object.values(STRAND_ACCENT);
const strandCards = HOMEPAGE_STRANDS.map((strand, index) => ({
  ...strand,
  accent: strandAccents[index],
}));
---

<Layout
  title="Free K–5 Spelling Practice by Grade or Skill, No Account | SpellingWords.app"
  description="Free spelling practice for K–5 students, with no account required. Practice your own words, or find structured curriculum practice by grade or spelling skill."
  jsonLd={[...homepageJsonLd, homepageFaqJsonLd]}
>
  <SiteHeader currentPath="/" />

  <main id="main-content">
    <!-- ═══ HERO ════════════════════════════════════════════════ -->
    <section
      class="bg-gradient-to-b from-da-brand-tint to-da-canvas px-5 py-12 sm:px-6 md:py-16"
      aria-labelledby="hero-heading"
    >
      <div
        class="mx-auto grid max-w-content-xl items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16"
      >
        <div>
          <h1
            id="hero-heading"
            class="font-quicksand text-[clamp(2.1rem,4.6vw,3.4rem)] font-bold leading-[1.08] tracking-tight text-da-ink"
          >
            Practice <span class="text-da-coral-strong">spelling</span> your way.
          </h1>
          <p class="mt-5 max-w-[46ch] text-[1.1rem] leading-relaxed text-da-ink-soft">
            Use your own words, follow a structured K–5 spelling curriculum, or explore a library of
            focused spelling skills. Free to use, with no account or login required.
          </p>
        </div>

        <div
          id="practice"
          class="scroll-mt-24 rounded-2xl border border-da-border bg-da-canvas-raised p-6 shadow-lg sm:p-8"
        >
          <div class="flex items-center justify-between gap-3">
            <label for="word-input" class="font-quicksand text-[1.15rem] font-bold text-da-ink">
              Enter your spelling words
            </label>
            <span
              id="word-count-pill"
              class="flex-shrink-0 rounded-full bg-da-coral-tint px-3 py-1.5 text-[0.82rem] font-bold text-da-coral-ink transition-colors"
              aria-live="polite"
              aria-atomic="true"
            >
              0 words
            </span>
          </div>

          <textarea
            id="word-input"
            rows="6"
            class="mt-3.5 w-full resize-y rounded-lg border-2 border-da-border-strong bg-da-canvas px-4 py-3.5 font-mulish text-base leading-relaxed text-da-ink placeholder:text-da-ink-faint focus:outline-none focus-visible:border-da-brand"
            spellcheck="false"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            aria-label="Your spelling words, one per line"
            placeholder={placeholderText}></textarea>

          <p
            id="input-status"
            class="mt-3 text-[0.88rem] text-da-ink-faint"
            aria-live="polite"
            aria-atomic="true"
          >
            Add at least 1 word to start practicing.
          </p>

          <Button
            id="btn-start"
            type="button"
            size="lg"
            class="mt-3.5"
            aria-label="Start a spelling practice session"
          >
            Start Practicing <span aria-hidden="true">→</span>
          </Button>
        </div>
      </div>
    </section>

    <!-- ═══ BROWSE BY GRADE ═══════════════════════════════════════ -->
    <section
      id="grades"
      class="scroll-mt-[72px] bg-da-surface-home px-5 py-14 sm:px-6 md:py-20"
      aria-labelledby="grade-heading"
    >
      <div class="mx-auto max-w-content-xl">
        <div class="mb-9 max-w-2xl">
          <h2
            id="grade-heading"
            class="font-quicksand text-[clamp(1.7rem,3vw,2.15rem)] font-bold text-da-ink"
          >
            Browse by Grade
          </h2>
          <p class="mt-2.5 text-[1.05rem] leading-relaxed text-da-ink-soft">
            Follow an organized Kindergarten–5th Grade spelling path built around Core Spelling,
            High-Frequency Words, and Themed Spelling Practice.
          </p>
        </div>

        <div
          class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
          role="list"
          aria-label="Grade levels"
        >
          {
            gradeCards.map(({ href, label, teaser, focus, numeral, accent }) => (
              <a
                href={href}
                class="relative flex flex-col gap-1.5 overflow-hidden rounded-2xl border border-da-border bg-da-canvas-raised p-6 pt-7 shadow-sm transition hover:-translate-y-1 hover:shadow-md"
                role="listitem"
              >
                <span
                  class:list={['absolute inset-x-0 top-0 h-2', ACCENT_BG_CLASS[accent]]}
                  aria-hidden="true"
                />
                <span
                  class:list={[
                    'font-quicksand text-4xl font-bold leading-none',
                    ACCENT_INK_CLASS[accent],
                  ]}
                  aria-hidden="true"
                >
                  {numeral}
                </span>
                <span class="mt-1 font-quicksand text-lg font-bold text-da-ink">{label}</span>
                <span class="text-sm leading-relaxed text-da-ink-soft">{teaser}</span>
                <span class:list={['mt-1 text-[0.8rem] font-bold', ACCENT_INK_CLASS[accent]]}>
                  {focus}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ═══ HOW THE K-5 CURRICULUM IS ORGANIZED ══════════════════ -->
    <section class="px-5 py-14 sm:px-6 md:py-20" aria-labelledby="curriculum-org-heading">
      <div class="mx-auto max-w-content-xl">
        <div class="mb-9 max-w-2xl">
          <p
            class="mb-2 font-quicksand text-[0.78rem] font-bold uppercase tracking-[0.08em] text-da-brand-strong"
          >
            How it's structured
          </p>
          <h2
            id="curriculum-org-heading"
            class="font-quicksand text-[clamp(1.7rem,3vw,2.15rem)] font-bold text-da-ink"
          >
            How the K–5 curriculum is organized
          </h2>
          <p class="mt-2.5 text-[1.05rem] leading-relaxed text-da-ink-soft">
            Each grade is organized into three complementary types of spelling practice.
          </p>
        </div>

        <div
          class="grid grid-cols-1 gap-5 md:grid-cols-3"
          role="list"
          aria-label="The three curriculum strands"
        >
          {
            strandCards.map(({ name, href, definition, examples, accent }) => (
              <div
                class:list={[
                  'flex flex-col gap-3 rounded-2xl border p-6',
                  ACCENT_TINT_BG_CLASS[accent],
                  ACCENT_BORDER_CLASS[accent],
                ]}
                role="listitem"
              >
                <h3 class="font-quicksand text-lg font-bold text-da-ink">
                  <a href={href} class="hover:text-da-brand-strong hover:underline">{name}</a>
                </h3>
                <p class="text-sm leading-relaxed text-da-ink-soft">{definition}</p>
                <ul class="mt-auto flex flex-wrap gap-2 pt-1" aria-label={`Examples of ${name}`}>
                  {examples.map((example) => (
                    <li class="rounded-full border border-da-border bg-da-canvas-raised px-3 py-1 text-xs font-bold text-da-ink-soft">
                      {example}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <p class="mt-8">
          <a
            href="/curriculum"
            class="inline-flex min-h-[44px] items-center font-bold text-da-brand-strong underline decoration-2 underline-offset-4 hover:text-da-brand"
          >
            Read about our spelling curriculum <span class="ml-1" aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </section>

    <!-- ═══ BROWSE BY SKILL ═══════════════════════════════════════ -->
    <section
      id="skills"
      class="scroll-mt-[72px] bg-da-teal-tint px-5 py-14 sm:px-6 md:py-20"
      aria-labelledby="skill-heading"
    >
      <div
        class="mx-auto grid max-w-content-xl gap-10 lg:grid-cols-[1fr_0.9fr] lg:items-center lg:gap-16"
      >
        <div>
          <h2
            id="skill-heading"
            class="font-quicksand text-[clamp(1.7rem,3vw,2.15rem)] font-bold text-da-ink"
          >
            Browse by Skill
          </h2>
          <p class="mt-2.5 max-w-[54ch] text-[1.05rem] leading-relaxed text-da-ink-soft">
            Already know what to work on? Explore {HOMEPAGE_SKILL_COUNT} spelling skills, from {
              HOMEPAGE_REPRESENTATIVE_SKILLS[0]
            } and {HOMEPAGE_REPRESENTATIVE_SKILLS[1]} to {HOMEPAGE_REPRESENTATIVE_SKILLS[2]}, {
              HOMEPAGE_REPRESENTATIVE_SKILLS[3]
            }, {HOMEPAGE_REPRESENTATIVE_SKILLS[4]}, and {HOMEPAGE_REPRESENTATIVE_SKILLS[5]}
            — go straight to the specific spelling skill your student needs.
          </p>
          <Button href={SKILLS_INDEX_PATH} variant="outline" class="mt-6">
            Browse Spelling Skills <span aria-hidden="true">→</span>
          </Button>
        </div>

        <ul class="flex flex-wrap gap-3" aria-label="Examples of spelling skills">
          {
            representativeSkillChips.map((chip) => (
              <li>
                <Chip tone={chip.tone}>{chip.label}</Chip>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ═══ PROGRESSION + U.S. POSITIONING ═══════════════════════ -->
    <section
      class="bg-da-surface-home px-5 py-14 sm:px-6 md:py-20"
      aria-labelledby="progression-heading"
    >
      <div class="mx-auto max-w-content-xl">
        <div class="mb-9 max-w-2xl">
          <h2
            id="progression-heading"
            class="font-quicksand text-[clamp(1.7rem,3vw,2.15rem)] font-bold text-da-ink"
          >
            How spelling develops from Kindergarten through 5th Grade
          </h2>
          <p class="mt-2.5 text-[1.05rem] leading-relaxed text-da-ink-soft">
            {HOMEPAGE_PROGRESSION_NOTE}
          </p>
        </div>

        <div
          class="grid grid-cols-1 gap-5 md:grid-cols-3"
          role="list"
          aria-label="The three stages of K-5 spelling development"
        >
          {
            HOMEPAGE_PROGRESSION_STAGES.map(({ grades, label, description }) => (
              <div
                class="flex flex-col gap-2 rounded-2xl border border-da-border bg-da-canvas-raised p-6 shadow-sm"
                role="listitem"
              >
                <p class="font-quicksand text-[0.78rem] font-bold uppercase tracking-[0.08em] text-da-brand-strong">
                  {grades}
                </p>
                <h3 class="font-quicksand text-lg font-bold text-da-ink">{label}</h3>
                <p class="text-sm leading-relaxed text-da-ink-soft">{description}</p>
              </div>
            ))
          }
        </div>

        <p class="mx-auto mt-9 max-w-[68ch] text-[0.95rem] leading-relaxed text-da-ink-soft">
          {HOMEPAGE_US_POSITIONING}
        </p>
      </div>
    </section>

    <!-- ═══ AUDIENCE + CLOSING TRUST CONTENT ═══════════════════════ -->
    <section
      id="how-it-works"
      class="scroll-mt-[72px] px-5 py-14 sm:px-6 md:py-20"
      aria-labelledby="audience-heading"
    >
      <div class="mx-auto max-w-content-xl">
        <h2
          id="audience-heading"
          class="text-center font-quicksand text-[clamp(1.7rem,3vw,2.15rem)] font-bold text-da-ink"
        >
          Built for students, parents, and teachers
        </h2>

        <div class="mx-auto mt-9 grid max-w-content-lg grid-cols-1 gap-6 sm:grid-cols-3">
          {
            HOMEPAGE_AUDIENCES.map(({ label, description }) => (
              <div class="flex flex-col gap-1.5">
                <h3 class="font-quicksand text-base font-bold text-da-ink">{label}</h3>
                <p class="text-sm leading-relaxed text-da-ink-soft">{description}</p>
              </div>
            ))
          }
        </div>

        <div
          class="mx-auto mt-10 max-w-content-lg rounded-2xl border border-da-brand bg-da-brand-tint px-6 py-8 text-center shadow-sm sm:px-10"
        >
          <p class="text-[1.02rem] leading-relaxed text-da-ink-soft">
            {HOMEPAGE_CLOSING_STATEMENT}
          </p>
        </div>
      </div>
    </section>

    <!-- ═══ FAQ ═══════════════════════════════════════════════════ -->
    <section class="bg-da-surface-home px-5 py-14 sm:px-6 md:py-20" aria-labelledby="faq-heading">
      <div class="mx-auto max-w-content-md">
        <h2
          id="faq-heading"
          class="font-quicksand text-[clamp(1.7rem,3vw,2.15rem)] font-bold text-da-ink"
        >
          Frequently asked questions
        </h2>

        <div class="mt-8 flex flex-col gap-7">
          {
            HOMEPAGE_FAQ.map(({ question, answer }) => (
              <div>
                <h3 class="font-quicksand text-base font-bold text-da-ink">{question}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-da-ink-soft">{answer}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script>
    import { parseWordInput, encodeWordList } from '@/lib/words';
    import { resolveCustomPracticeSource } from '@/lib/content/practiceSource';

    const textarea = document.getElementById('word-input') as HTMLTextAreaElement;
    const pill = document.getElementById('word-count-pill')!;
    const status = document.getElementById('input-status')!;
    const btn = document.getElementById('btn-start') as HTMLButtonElement;

    function getWords(): string[] {
      return parseWordInput(textarea.value);
    }

    function updateStatus(): void {
      const words = getWords();
      const count = words.length;

      pill.textContent = `${count} ${count === 1 ? 'word' : 'words'}`;

      if (count === 0) {
        status.textContent = 'Add at least 1 word to start practicing.';
        btn.disabled = true;
      } else if (count > 200) {
        status.textContent = 'Maximum 200 words. Please remove some words.';
        btn.disabled = true;
      } else {
        status.textContent = `${count} ${count === 1 ? 'word' : 'words'} ready to practice.`;
        btn.disabled = false;
      }
    }

    function handleStart(): void {
      const words = getWords();
      if (words.length === 0 || words.length > 200) return;

      const result = encodeWordList(words);
      if (!result.ok) {
        status.textContent =
          result.code === 'payload_too_long'
            ? 'Word list is too long to encode. Please shorten some words.'
            : 'Could not create test. Please check your word list.';
        return;
      }

      try {
        sessionStorage.setItem(`sw:source:${result.payload}`, JSON.stringify(resolveCustomPracticeSource()));
      } catch {
        /* sessionStorage unavailable — non-fatal */
      }

      window.location.href = `/play?list=${result.payload}`;
    }

    textarea.addEventListener('input', updateStatus);
    btn.addEventListener('click', handleStart);
    updateStatus();
  </script>
</Layout>
