---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Spelling Test — spellingwords"
  description="Take your custom spelling test. Hear each word spoken aloud and type your answer."
>
  <!-- Site header -->
  <header class="sticky top-0 z-10 border-b border-app-hairline bg-app-cream/90 backdrop-blur-sm">
    <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
      <a
        href="/"
        class="flex items-center gap-2 font-display text-lg font-semibold text-app-charcoal tracking-tight"
        aria-label="spellingwords home"
      >
        <span
          aria-hidden="true"
          class="flex h-7 w-7 items-center justify-center rounded-md bg-app-charcoal text-app-cream"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M11.5 2.5l2 2-8 8H3.5v-2l8-8z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9.5 4.5l2 2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
          </svg>
        </span>
        spelling<span class="text-app-sage">words</span>
      </a>
      <a
        href="/"
        class="rounded-md px-3 py-1.5 text-sm font-medium text-app-charcoal/55 transition-colors hover:bg-app-sage/10 hover:text-app-sage"
      >
        ← New list
      </a>
    </div>
  </header>

  <main id="main-content">
    <div class="mx-auto max-w-xl px-6 py-12 md:py-16">

      <!-- Error screen -->
      <section id="screen-error" class="hidden text-center" aria-labelledby="error-heading">
        <div class="flex flex-col items-center gap-6">
          <div class="flex h-16 w-16 items-center justify-center rounded-xl bg-feedback-incorrect/10 text-3xl text-feedback-incorrect" aria-hidden="true">✗</div>
          <div class="flex flex-col gap-2">
            <h1 id="error-heading" class="font-display text-2xl font-semibold text-app-charcoal">
              No word list found
            </h1>
            <p id="error-message" class="text-base text-app-charcoal/60"></p>
          </div>
          <a
            href="/"
            class="rounded-lg bg-app-charcoal px-6 py-3 text-sm font-semibold text-app-cream transition hover:bg-app-charcoal/90"
          >
            ← Enter new words
          </a>
        </div>
      </section>

      <!-- Unsupported browser screen -->
      <section id="screen-unsupported" class="hidden text-center" aria-labelledby="unsupported-heading">
        <div class="flex flex-col items-center gap-6">
          <div class="flex h-16 w-16 items-center justify-center rounded-xl bg-accent-rust/10 text-3xl" aria-hidden="true">🔇</div>
          <div class="flex flex-col gap-2">
            <h1 id="unsupported-heading" class="font-display text-2xl font-semibold text-app-charcoal">
              Audio not supported
            </h1>
            <p class="text-base text-app-charcoal/60">
              Audio spelling tests are not supported in this browser.<br />
              Please try a modern browser with speech support.
            </p>
          </div>
          <a
            href="/"
            class="rounded-lg bg-app-charcoal px-6 py-3 text-sm font-semibold text-app-cream transition hover:bg-app-charcoal/90"
          >
            ← Go back
          </a>
        </div>
      </section>

      <!-- Begin screen -->
      <section id="screen-begin" class="hidden text-center" aria-labelledby="begin-heading">
        <div class="flex flex-col items-center gap-8">
          <div class="flex flex-col items-center gap-3">
            <h1 id="begin-heading" class="font-display text-3xl font-semibold text-app-charcoal">
              Ready to spell?
            </h1>
            <p id="begin-word-count" class="text-base text-app-charcoal/60"></p>
            <p class="text-sm text-app-charcoal/40">Each word will be spoken aloud. Take your time, and type what you hear.</p>
          </div>
          <button
            id="btn-begin"
            type="button"
            class="rounded-lg bg-app-charcoal px-8 py-4 text-base font-semibold text-app-cream transition hover:bg-app-charcoal/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-app-sage active:scale-[0.98]"
          >
            Begin Test
          </button>
        </div>
      </section>

      <!-- Question screen -->
      <section id="screen-question" class="hidden" aria-labelledby="question-heading">
        <div class="flex flex-col gap-8">
          <!-- Progress -->
          <div class="flex items-center justify-between">
            <p
              id="progress"
              class="font-mono text-sm font-medium tracking-wide text-app-charcoal/40"
              aria-live="polite"
              aria-atomic="true"
            ></p>
            <button
              id="btn-repeat"
              type="button"
              class="flex items-center gap-2 rounded-lg border border-app-hairline bg-white px-4 py-2 text-sm font-medium text-app-charcoal/60 transition hover:border-app-sage/40 hover:bg-app-sage/5 hover:text-app-sage focus-visible:outline focus-visible:outline-2 focus-visible:outline-app-sage"
              aria-label="Repeat the word"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
              </svg>
              Repeat Word
            </button>
          </div>

          <!-- Instruction and answer area -->
          <div class="flex flex-col gap-5">
            <h1 id="question-heading" class="sr-only">Type the word you hear</h1>
            <p class="text-base leading-relaxed text-app-charcoal/60">
              Listen carefully, and type the word you hear. Take your time — there's no rush.
            </p>
            <div class="flex flex-col gap-2">
              <input
                id="answer-input"
                type="text"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                placeholder="Type the word…"
                class="w-full rounded-xl border-2 border-app-hairline bg-white px-5 py-4 text-lg font-medium text-app-charcoal placeholder:text-app-charcoal/25 transition focus:border-app-sage focus:outline-none"
                aria-label="Your answer"
              />
              <p
                id="answer-error"
                class="min-h-[1.25rem] px-1 text-sm text-feedback-incorrect"
                aria-live="polite"
                role="alert"
              ></p>
            </div>
            <button
              id="btn-submit"
              type="button"
              class="w-full rounded-lg bg-app-charcoal px-6 py-3.5 text-sm font-semibold text-app-cream transition hover:bg-app-charcoal/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-app-sage active:scale-[0.98]"
            >
              Submit Answer
            </button>
          </div>

          <!-- Voice settings (collapsed by default) -->
          <div class="mt-2">
            <button
              id="btn-voice-toggle"
              type="button"
              aria-expanded="false"
              aria-controls="voice-settings-panel"
              class="text-xs text-app-charcoal/35 transition-colors hover:text-app-charcoal/60"
            >
              Voice settings ▾
            </button>
            <div
              id="voice-settings-panel"
              class="hidden mt-3 rounded-xl border border-app-hairline bg-white p-4 flex flex-col gap-3"
              role="group"
              aria-label="Voice settings"
            >
              <!-- Auto-selected voice status -->
              <p class="text-xs text-app-charcoal/50">
                Voice: <span id="voice-name-display">best available</span>
              </p>

              <!-- Speed slider -->
              <div class="flex items-center gap-3">
                <label for="speed-range" class="text-xs font-medium text-app-charcoal/50 whitespace-nowrap w-10">Speed</label>
                <input
                  id="speed-range"
                  type="range"
                  min="0.5"
                  max="1.1"
                  step="0.05"
                  value="0.5"
                  class="flex-1 accent-app-sage"
                  aria-label="Speech speed"
                />
                <span id="speed-label" class="text-xs font-medium text-app-charcoal/40 w-10 text-right">0.50×</span>
              </div>

              <!-- Test voice -->
              <button
                id="btn-test-voice"
                type="button"
                class="self-start rounded-lg border border-app-hairline bg-white px-4 py-2 text-xs font-medium text-app-charcoal/60 transition-colors hover:border-app-sage/40 hover:text-app-sage"
              >
                Test voice
              </button>

              <!-- Helper text -->
              <p class="text-xs italic leading-relaxed text-app-charcoal/35">
                Voice quality depends on your browser and device.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Feedback screen -->
      <section id="screen-feedback" class="hidden text-center" aria-labelledby="feedback-heading" aria-live="assertive">
        <div class="flex flex-col items-center gap-8">
          <div id="feedback-icon" class="flex h-20 w-20 items-center justify-center rounded-xl text-4xl" aria-hidden="true"></div>
          <div class="flex flex-col gap-2">
            <h1 id="feedback-heading" class="font-display text-2xl font-semibold text-app-charcoal"></h1>
            <p id="feedback-detail" class="text-base text-app-charcoal/60"></p>
          </div>
          <button
            id="btn-next"
            type="button"
            class="rounded-lg bg-app-charcoal px-8 py-3.5 text-sm font-semibold text-app-cream transition hover:bg-app-charcoal/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-app-sage active:scale-[0.98]"
          >
            Next Word →
          </button>
        </div>
      </section>

      <!-- Results screen -->
      <section id="screen-results" class="hidden" aria-labelledby="results-heading">
        <div class="flex flex-col gap-8">
          <div class="text-center">
            <h1 id="results-heading" class="font-display text-3xl font-semibold text-app-charcoal">
              Nice work!
            </h1>
            <p id="results-score" class="mt-3 text-xl font-semibold text-app-charcoal/70"></p>
          </div>

          <!-- Missed words — hidden when score is perfect -->
          <div id="results-missed-section" class="hidden rounded-xl border border-app-hairline bg-white p-6">
            <h2 class="mb-1 text-sm font-semibold uppercase tracking-widest text-app-charcoal/40">
              Words to look at again
            </h2>
            <p class="mb-3 text-sm text-app-charcoal/50">A little more practice with these, and you'll have them down.</p>
            <ul id="results-missed-list" class="flex flex-wrap gap-2" aria-label="Words you missed"></ul>
          </div>

          <!-- Actions -->
          <div class="flex flex-col gap-3">
            <button
              id="btn-retry"
              type="button"
              class="w-full rounded-lg bg-app-charcoal px-6 py-3.5 text-sm font-semibold text-app-cream transition hover:bg-app-charcoal/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-app-sage active:scale-[0.98]"
            >
              Try Again
            </button>
            <button
              id="btn-review-missed"
              type="button"
              class="hidden w-full rounded-lg border border-app-sage/30 bg-app-sage/5 px-6 py-3.5 text-sm font-semibold text-app-sage transition hover:bg-app-sage/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-app-sage active:scale-[0.98]"
            >
              Review Words to Practice
            </button>
            <a
              href="/"
              class="w-full rounded-lg px-6 py-3.5 text-center text-sm font-medium text-app-charcoal/50 transition hover:bg-app-charcoal/5 hover:text-app-charcoal"
            >
              Enter New Words
            </a>
          </div>
        </div>
      </section>

    </div>
  </main>

  <footer class="border-t border-app-hairline">
    <div class="mx-auto max-w-3xl px-6 py-8 text-center text-xs text-app-charcoal/35">
      &copy; {new Date().getFullYear()} spellingwords.app &mdash; Free spelling practice for every classroom.
    </div>
  </footer>
</Layout>

<script>
  import { decodeWordList } from '@/lib/words';
  import { createSpeechController, selectPreferredVoice } from '@/modules/speech';
  import type { SpeechSynthesisVoiceAdapter } from '@/modules/speech';
  import {
    spellingTestReducer,
    createInitialState,
    initializeTest,
    startTest,
    submitAnswer,
    nextWord,
    resetTest,
    reviewMissed,
  } from '@/modules/spellingTest/stateMachine';
  import type { TestState } from '@/modules/spellingTest/types';

  // --- DOM refs ---
  const $ = (id: string) => document.getElementById(id)!;

  const screenError = $('screen-error');
  const screenUnsupported = $('screen-unsupported');
  const screenBegin = $('screen-begin');
  const screenQuestion = $('screen-question');
  const screenFeedback = $('screen-feedback');
  const screenResults = $('screen-results');

  const allScreens = [screenError, screenUnsupported, screenBegin, screenQuestion, screenFeedback, screenResults];

  const beginWordCount = $('begin-word-count');
  const progressEl = $('progress');
  const answerInput = $('answer-input') as HTMLInputElement;
  const answerError = $('answer-error');
  const feedbackIcon = $('feedback-icon');
  const feedbackHeading = $('feedback-heading');
  const feedbackDetail = $('feedback-detail');
  const resultsScore = $('results-score');
  const resultsMissedSection = $('results-missed-section');
  const resultsMissedList = $('results-missed-list');
  const btnBegin = $('btn-begin') as HTMLButtonElement;
  const btnRepeat = $('btn-repeat') as HTMLButtonElement;
  const btnSubmit = $('btn-submit') as HTMLButtonElement;
  const btnNext = $('btn-next') as HTMLButtonElement;
  const btnRetry = $('btn-retry') as HTMLButtonElement;
  const btnReviewMissed = $('btn-review-missed') as HTMLButtonElement;
  const errorMessage = $('error-message');

  // Voice controls
  const btnVoiceToggle = $('btn-voice-toggle') as HTMLButtonElement;
  const voiceSettingsPanel = $('voice-settings-panel');
  const voiceNameDisplay = $('voice-name-display');
  const speedRange = $('speed-range') as HTMLInputElement;
  const speedLabel = $('speed-label');
  const btnTestVoice = $('btn-test-voice') as HTMLButtonElement;

  // --- Module state ---
  const speech = createSpeechController();
  let state: TestState = createInitialState();
  let originalWords: string[] = [];

  // Voice settings state — no persistence; resets on page load
  let selectedVoice: SpeechSynthesisVoiceAdapter | null = null;
  let currentRate = 0.5;

  // --- Screen management ---
  function showScreen(target: HTMLElement): void {
    for (const screen of allScreens) {
      screen.classList.toggle('hidden', screen !== target);
    }
  }

  function showError(message: string): void {
    errorMessage.textContent = message;
    showScreen(screenError);
  }

  // --- Voice controls setup ---
  async function initVoiceControls(): Promise<void> {
    const allVoices = await speech.loadVoices();
    selectedVoice = selectPreferredVoice(allVoices);
    if (selectedVoice) {
      voiceNameDisplay.textContent = selectedVoice.name;
    }
  }

  // --- Initialization ---
  function init(): void {
    const params = new URLSearchParams(window.location.search);
    const payload = params.get('list');

    if (!payload) {
      showError('No word list found. Please go back and enter your words.');
      return;
    }

    const decoded = decodeWordList(payload);
    if (!decoded.ok) {
      showError('The word list could not be loaded. Please go back and try again.');
      return;
    }

    if (!speech.isSpeechSupported()) {
      showScreen(screenUnsupported);
      return;
    }

    originalWords = decoded.words;
    state = spellingTestReducer(createInitialState(), initializeTest(originalWords));

    const count = originalWords.length;
    beginWordCount.textContent = `${count} ${count === 1 ? 'word' : 'words'} loaded`;
    showScreen(screenBegin);

    // Load voices in the background — does not require a user gesture
    initVoiceControls();
  }

  // --- Render helpers ---
  function speechOptions() {
    return { voice: selectedVoice, rate: currentRate };
  }

  function renderQuestion(): void {
    const current = state.words[state.currentIndex];
    const total = state.words.length;
    const pos = state.currentIndex + 1;

    progressEl.textContent = `Word ${pos} of ${total}`;
    answerInput.value = '';
    answerError.textContent = '';

    showScreen(screenQuestion);
    requestAnimationFrame(() => answerInput.focus());

    speech.speakWord(current.word, speechOptions());
  }

  function renderFeedback(): void {
    const correct = state.lastAnswerCorrect;
    const currentWord = state.words[state.currentIndex].word;

    if (correct) {
      feedbackIcon.textContent = '✓';
      feedbackIcon.className = 'flex h-20 w-20 items-center justify-center rounded-xl bg-feedback-correct/12 text-4xl text-feedback-correct';
      feedbackHeading.textContent = 'Correct!';
      feedbackHeading.className = 'font-display text-2xl font-semibold text-feedback-correct';
      feedbackDetail.textContent = '';
    } else {
      feedbackIcon.textContent = '✗';
      feedbackIcon.className = 'flex h-20 w-20 items-center justify-center rounded-xl bg-feedback-incorrect/10 text-4xl text-feedback-incorrect';
      feedbackHeading.textContent = 'Not quite — nice try';
      feedbackHeading.className = 'font-display text-2xl font-semibold text-feedback-incorrect';
      feedbackDetail.textContent = `The word was: ${currentWord}`;
    }

    const isLast = state.currentIndex === state.words.length - 1;
    btnNext.textContent = isLast ? 'See Results →' : 'Next Word →';

    showScreen(screenFeedback);
  }

  function renderResults(): void {
    const result = state.result!;
    const pct = result.percentage;

    resultsScore.textContent = `You got ${result.correct} out of ${result.total} correct (${pct}%)`;

    if (result.missedWords.length > 0) {
      resultsMissedList.textContent = '';
      for (const w of result.missedWords) {
        const li = document.createElement('li');
        li.textContent = w.word;
        li.className = 'rounded-lg bg-feedback-incorrect/8 px-3 py-1.5 text-sm font-medium text-feedback-incorrect';
        resultsMissedList.appendChild(li);
      }
      resultsMissedSection.classList.remove('hidden');
      btnReviewMissed.classList.remove('hidden');
    } else {
      resultsMissedSection.classList.add('hidden');
      btnReviewMissed.classList.add('hidden');
    }

    showScreen(screenResults);
  }

  // --- Event handlers ---
  function handleSubmit(): void {
    const answer = answerInput.value.trim();

    if (!answer) {
      answerError.textContent = 'Please type your answer.';
      answerInput.focus();
      return;
    }

    state = spellingTestReducer(state, submitAnswer(answer, Date.now()));
    renderFeedback();
  }

  btnBegin.addEventListener('click', () => {
    state = spellingTestReducer(state, startTest(Date.now()));
    renderQuestion();
  });

  btnRepeat.addEventListener('click', () => {
    speech.repeatWord(speechOptions());
  });

  answerInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') handleSubmit();
  });

  btnSubmit.addEventListener('click', handleSubmit);

  btnNext.addEventListener('click', () => {
    state = spellingTestReducer(state, nextWord(Date.now()));
    if (state.status === 'awaitingAnswer') {
      renderQuestion();
    } else if (state.status === 'complete') {
      renderResults();
    }
  });

  btnRetry.addEventListener('click', () => {
    state = spellingTestReducer(resetTest(), initializeTest(originalWords));
    const count = originalWords.length;
    beginWordCount.textContent = `${count} ${count === 1 ? 'word' : 'words'} loaded`;
    showScreen(screenBegin);
  });

  btnReviewMissed.addEventListener('click', () => {
    // reviewMissed transitions directly to awaitingAnswer — call in click handler (iOS-safe)
    state = spellingTestReducer(state, reviewMissed());
    renderQuestion();
  });

  // Voice settings toggle
  btnVoiceToggle.addEventListener('click', () => {
    const open = voiceSettingsPanel.classList.toggle('hidden') === false;
    btnVoiceToggle.setAttribute('aria-expanded', String(open));
    btnVoiceToggle.textContent = open ? 'Voice settings ▴' : 'Voice settings ▾';
  });

  speedRange.addEventListener('input', () => {
    currentRate = parseFloat(speedRange.value);
    speedLabel.textContent = `${currentRate.toFixed(2).replace(/0$/, '')}×`;
  });

  btnTestVoice.addEventListener('click', () => {
    speech.speakWord('because', speechOptions());
  });

  // --- Boot ---
  init();
</script>
