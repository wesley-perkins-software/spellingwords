---
import Layout from './_Layout.astro';
---

<Layout title="Practice" env="var(--grade-1)">
  <header class="explore-b3__header" style="padding: 4px 0;">
    <div class="explore-b3__header-inner">
      <span class="explore-b3__wordmark" style="font-size: 15px;">spelling<span class="accent">words</span></span>
      <a href="#" style="font-size: 14px; font-weight: 700; color: var(--ink-soft); text-decoration: none;">← New list</a>
    </div>
  </header>

  <main class="wrap wrap--narrow" style="padding: 16px 24px 64px; display: flex; flex-direction: column; gap: 0;">
    <section style="display: flex; align-items: center; gap: 14px; margin-bottom: 24px;">
      <span class="badge" style="background: var(--ink); color: #fff;">Word 3 / 10</span>
      <div style="flex: 1; height: 6px; background: var(--border); border-radius: 999px; overflow: hidden;">
        <div style="width: 30%; height: 100%; background: var(--grade-1);"></div>
      </div>
    </section>

    <!-- The Doorway, at practice scale: the whole tray is the environment, arcing into the white action zone -->
    <div class="env-band" style="padding: 36px 32px 56px; display: flex; flex-direction: column; gap: 22px;">
      <p style="color: rgba(255,255,255,0.9); font-size: 15px; font-weight: 600;">
        Listen carefully and type what you hear.
      </p>

      <input
        type="text"
        class="answer-input"
        placeholder="Type the word"
        style="width: 100%; background: #fff; border: none; border-radius: 16px; padding: 18px 22px; font-family: var(--font-word); font-size: 28px; font-weight: 700; color: var(--ink);"
      />

      <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <button type="button" class="btn btn--ghost-on-env">🔊 Hear word again</button>
        <button type="button" class="btn btn--ghost-on-env">💬 Hear sentence again</button>
      </div>
    </div>

    <button type="button" class="btn btn--primary" style="width: 100%; padding: 18px; margin-top: -30px; position: relative; z-index: 2; background: var(--ink);">
      Submit Answer
    </button>

    <!-- Feedback state (correct) -->
    <section style="margin-top: 36px;">
      <p style="font-size: 13px; font-weight: 700; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 14px;">Feedback state — correct</p>
      <div class="env-band" style="background: var(--correct); padding: 40px 34px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px;">
        <span style="width: 44px; height: 44px; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; color: var(--correct); font-weight: 800;">✓</span>
        <span style="font-family: var(--font-word); font-weight: 800; font-size: 40px; color: #fff;">cake</span>
        <p style="color: rgba(255,255,255,0.9); font-size: 15px; font-weight: 600;">Well spelled.</p>
      </div>
    </section>
  </main>
</Layout>
