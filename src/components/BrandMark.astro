---
/**
 * The one canonical SpellingWords brand mark + wordmark — the SW icon and
 * the `SpellingWords` link, used identically by both the discovery header
 * and the simpler practice header. Only the surrounding header chrome
 * (border, background, navigation) is allowed to differ between them; the
 * brand identity itself has exactly one source.
 */
---

<a
  href="/"
  class="mr-auto flex min-w-0 flex-shrink items-center gap-2.5 font-quicksand text-lg font-bold text-da-ink no-underline sm:text-xl"
  aria-label="SpellingWords home"
>
  <img
    src="/favicon.svg"
    alt=""
    width="36"
    height="36"
    class="h-9 w-9 flex-shrink-0"
    aria-hidden="true"
  />
  <span class="hidden min-[390px]:inline">SpellingWords</span>
</a>
