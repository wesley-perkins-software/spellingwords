---
// Design exploration — Direction 2: "Call & Response" — Skill / reference page
const words = ['ship', 'shop', 'shut', 'wish', 'brush', 'dish'];

const comparisonRows = [
  { sh: 'ship', ch: 'chip' },
  { sh: 'shop', ch: 'chop' },
  { sh: 'wish', ch: 'witch' },
  { sh: 'dish', ch: 'ditch' },
];

const faqs = [
  {
    q: 'Does every SH sound get spelled with the letters S and H?',
    a: "Almost always — but not every time. Most SH sounds you'll hear in a word are spelled with s and h together, like in ship or brush. A few borrowed words break the pattern, like sure or sugar, where the SH sound comes from other letters entirely.",
  },
  {
    q: 'Where can the SH digraph appear in a word?',
    a: 'Anywhere — at the start (ship, shop), in the middle (washing, fishing), or at the end (wish, brush). It behaves the same way no matter where it lands.',
  },
];

const related = [
  { label: 'CH Digraph Words', hint: 'The next digraph pattern', dir: 'Next skill →' },
  { label: 'Double Consonants', hint: 'A related pattern', dir: 'Related skill →' },
  { label: '1st Grade Spelling Words', hint: 'Where SH words first appear', dir: '← Back to grade' },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>SH Digraph Words — Call &amp; Response (Design Exploration)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Figtree:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="proto-badge">Design exploration — Call &amp; Response</div>

    <div class="cr">
      <header class="site-head">
        <a class="wordmark" href="/design-explore/call-and-response/">
          spelling<span>words</span>
        </a>
        <nav class="head-nav" aria-label="Primary">
          <a href="/design-explore/call-and-response/grade-hub">Grades</a>
          <a href="/design-explore/call-and-response/skill" aria-current="page">Skills</a>
          <a href="/design-explore/call-and-response/practice">Practice</a>
        </nav>
      </header>

      <main>
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/design-explore/call-and-response/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/design-explore/call-and-response/skill">Skills</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">SH Digraph Words</span>
        </nav>

        <!-- HERO -->
        <section class="pair pair--hero" aria-labelledby="skill-heading">
          <div class="zone zone--call">
            <p class="tag tag--call">Spelling skill</p>
            <h1 id="skill-heading">SH Digraph Words</h1>
          </div>
          <div class="connector" aria-hidden="true">
            <span class="connector-dot"></span>
            <span class="connector-line"></span>
          </div>
          <div class="zone zone--response">
            <p class="orient">
              Words where the letters <strong>s</strong> and <strong>h</strong> team up to spell
              one soft, whooshing sound — the sound you hear at the start of <em>ship</em> and the
              end of <em>wish</em>.
            </p>
          </div>
        </section>

        <!-- Q&A — the natural call/response pair -->
        <section class="qa-pair" aria-labelledby="qa-heading">
          <div class="qa-call">
            <p class="tag tag--call">The question</p>
            <h2 id="qa-heading">What are SH digraph words?</h2>
          </div>
          <div class="qa-response">
            <p class="tag tag--response">The short answer</p>
            <p>
              SH is a <strong>digraph</strong> — two letters, <em>s</em> and <em>h</em>, that
              together spell one new sound. It isn't an S sound plus an H sound; it's a single
              sound, like in <em>ship</em> or <em>wish</em>.
            </p>
          </div>
        </section>

        <!-- WORD LIST -->
        <section class="word-list-section" aria-labelledby="wordlist-heading">
          <h2 id="wordlist-heading" class="sr-only">Word list</h2>
          <ul class="word-list" role="list">
            {words.map((w) => <li class="word-chip">{w}</li>)}
          </ul>
        </section>

        <!-- BODY: Understanding the pattern -->
        <section class="body-pair" aria-labelledby="pattern-heading">
          <div class="body-call">
            <p class="tag tag--call">Read this</p>
            <h2 id="pattern-heading">Understanding the pattern</h2>
          </div>
          <div class="body-response">
            <p>
              SH shows up at the beginning of words (<em>ship</em>, <em>shop</em>, <em>shut</em>),
              at the end (<em>wish</em>, <em>brush</em>, <em>dish</em>), and in the middle of
              longer words (<em>washing</em>, <em>fisherman</em>). Wherever it lands, it keeps its
              one soft sound — kids don't need to sound out "s" then "h" separately.
            </p>
            <p>
              Because SH is so consistent, it's usually one of the first digraphs taught after
              short vowels are secure. It pairs naturally with CH, TH, and WH — the other common
              two-letter, one-sound teams in English spelling.
            </p>
            <p>
              A good way to practice: say the word slowly, notice the single SH sound, then write
              the two letters together as one unit — never split them across a syllable break.
            </p>
          </div>
        </section>

        <!-- COMPARISON TABLE -->
        <section class="table-pair" aria-labelledby="compare-heading">
          <div class="table-call">
            <p class="tag tag--call">Compare</p>
            <h2 id="compare-heading">SH vs. CH</h2>
            <p>
              SH and CH are easy to mix up — both are two-letter digraphs, and a few words look
              deceptively similar. Say each pair out loud to feel the difference.
            </p>
          </div>
          <div class="table-response">
            <div class="table-scroll">
              <table>
                <caption class="sr-only">Comparison of SH and CH digraph example words</caption>
                <thead>
                  <tr>
                    <th scope="col">SH words</th>
                    <th scope="col">CH words</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    comparisonRows.map((r) => (
                      <tr>
                        <td>{r.sh}</td>
                        <td>{r.ch}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- FAQ -->
        <section class="section" aria-labelledby="faq-heading">
          <div class="section-head">
            <p class="tag tag--response">Common questions</p>
            <h2 id="faq-heading">FAQ</h2>
          </div>
          <ul class="faq-list" role="list">
            {
              faqs.map((f, i) => (
                <li class="faq-pair" style={`--i:${i}`}>
                  <div class="faq-q">
                    <span class="qmark" aria-hidden="true">
                      Q
                    </span>
                    <p>{f.q}</p>
                  </div>
                  <div class="faq-a">
                    <span class="amark" aria-hidden="true">
                      A
                    </span>
                    <p>{f.a}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </section>

        <!-- PRACTICE CTA -->
        <section class="practice-cta">
          <div class="practice-cta-call">
            <p>Six words. One pattern. No timer.</p>
          </div>
          <a class="practice-cta-response" href="/design-explore/call-and-response/practice">
            Practice these words →
          </a>
        </section>

        <!-- RELATED CONTENT -->
        <section class="section" aria-labelledby="related-heading">
          <h2 id="related-heading" class="sr-only">Related content</h2>
          <ul class="related-list" role="list">
            {
              related.map((r) => (
                <li class="related-pair">
                  <div class="related-call">
                    <span class="related-dir">{r.dir}</span>
                  </div>
                  <a class="related-response" href="/design-explore/call-and-response/skill">
                    <strong>{r.label}</strong>
                    <span>{r.hint}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </main>

      <footer class="site-foot">
        <p>spellingwords.app · a calm place to practice</p>
      </footer>
    </div>

    <style>
      .cr {
        --canvas: #16262c;
        --canvas-raised: #1d323a;
        --canvas-line: rgba(251, 246, 236, 0.14);
        --ink-0: #fbf6ec;
        --ink-100: #e4dfd2;
        --ink-300: #93a6a4;
        --call: #ff6b4a;
        --call-deep: #d43f1f;
        --call-ink: #2c1206;
        --response: #ffc93c;
        --response-deep: #c98a0a;
        --response-ink: #2b2205;
        --tertiary: #c9a6ff;
        --tertiary-deep: #8c5ff0;
        --tertiary-ink: #241238;
        --focus: #ffe08a;
        --radius-call: 28px 8px 28px 8px;
        --radius-response: 8px 28px 8px 28px;
        background: var(--canvas);
        color: var(--ink-0);
        font-family: 'Figtree', ui-sans-serif, system-ui, sans-serif;
        min-height: 100vh;
        line-height: 1.5;
      }
      .cr * {
        box-sizing: border-box;
      }
      .cr h1,
      .cr h2,
      .cr h3 {
        font-family: 'Fraunces', ui-serif, Georgia, serif;
        font-weight: 600;
        line-height: 1.1;
        margin: 0;
        color: var(--ink-0);
      }
      .cr a {
        color: inherit;
      }
      .cr em {
        font-style: italic;
      }
      .cr :focus-visible {
        outline: 3px solid var(--focus);
        outline-offset: 3px;
        border-radius: 4px;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }
      .proto-badge {
        position: fixed;
        bottom: 14px;
        right: 14px;
        z-index: 999;
        background: #0f1a1e;
        color: #f2ead8;
        font: 600 12px/1 'Figtree', sans-serif;
        padding: 8px 12px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
      }
      .site-head {
        max-width: 1180px;
        margin: 0 auto;
        padding: 28px 24px 8px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }
      .wordmark {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.35rem;
        text-decoration: none;
        color: var(--ink-0);
      }
      .wordmark span {
        color: var(--response);
      }
      .head-nav {
        display: flex;
        gap: 22px;
        font-weight: 600;
        font-size: 0.95rem;
      }
      .head-nav a {
        text-decoration: none;
        color: var(--ink-100);
        padding-bottom: 3px;
        border-bottom: 2px solid transparent;
      }
      .head-nav a:hover,
      .head-nav a[aria-current='page'] {
        border-bottom-color: var(--response);
        color: var(--ink-0);
      }
      main {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 24px 96px;
      }
      .crumbs {
        margin: 26px 0 0;
        font-size: 0.85rem;
        color: var(--ink-300);
        display: flex;
        gap: 8px;
      }
      .crumbs a {
        text-decoration: none;
        color: var(--ink-300);
      }
      .crumbs a:hover {
        color: var(--response);
      }
      .crumbs [aria-current='page'] {
        color: var(--ink-100);
      }
      .tag {
        display: inline-block;
        font: 700 0.72rem/1 'Figtree', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        padding: 6px 12px;
        border-radius: 999px;
        margin: 0 0 14px;
      }
      .tag--call {
        background: var(--call);
        color: var(--call-ink);
      }
      .tag--response {
        background: var(--response);
        color: var(--response-ink);
      }

      /* hero */
      .pair {
        display: grid;
        position: relative;
      }
      .pair--hero {
        grid-template-columns: minmax(0, 5fr) 64px minmax(0, 7fr);
        align-items: start;
        margin-top: 34px;
      }
      .zone {
        padding: 36px 34px;
        position: relative;
      }
      .zone--call {
        background: var(--call);
        color: var(--call-ink);
        border-radius: var(--radius-call);
        z-index: 2;
        box-shadow: 0 22px 50px -18px rgba(212, 63, 31, 0.55);
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .zone--call h1 {
        color: var(--call-ink);
        font-size: clamp(1.9rem, 3.2vw, 2.6rem);
      }
      .zone--response {
        background: var(--canvas-raised);
        border: 1px solid var(--canvas-line);
        border-radius: var(--radius-response);
        transform: translateY(50px);
        z-index: 1;
        display: flex;
        align-items: center;
      }
      .orient {
        margin: 0;
        color: var(--ink-100);
        font-size: 1.05rem;
      }
      .orient strong {
        color: var(--ink-0);
      }
      .connector {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 70px;
      }
      .connector-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--response);
        box-shadow: 0 0 0 6px rgba(255, 201, 60, 0.18);
      }
      .connector-line {
        width: 2px;
        flex: 1;
        margin-top: 6px;
        background: repeating-linear-gradient(
          to bottom,
          var(--response) 0 8px,
          transparent 8px 16px
        );
      }

      /* Q&A pair */
      .qa-pair {
        margin-top: 70px;
        display: grid;
        grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid var(--canvas-line);
      }
      .qa-call {
        background: var(--canvas-raised);
        padding: 30px 32px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .qa-call h2 {
        font-size: 1.4rem;
      }
      .qa-response {
        background: rgba(255, 201, 60, 0.1);
        padding: 30px 34px;
        border-left: 1px solid var(--canvas-line);
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .qa-response p:not(.tag) {
        margin: 0;
        font-size: 1.08rem;
        color: var(--ink-0);
      }

      /* word list */
      .word-list-section {
        margin-top: 50px;
      }
      .word-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
      }
      .word-chip {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 700;
        font-size: 1.15rem;
        background: var(--call);
        color: var(--call-ink);
        padding: 14px 22px;
        border-radius: 14px;
      }
      .word-chip:nth-child(even) {
        background: var(--response);
        color: var(--response-ink);
        transform: translateY(10px);
      }

      /* body understanding-pattern pair */
      .body-pair {
        margin-top: 80px;
        display: grid;
        grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
        gap: 40px;
      }
      .body-call {
        position: sticky;
        top: 24px;
        align-self: start;
      }
      .body-call h2 {
        font-size: 1.5rem;
      }
      .body-response {
        display: flex;
        flex-direction: column;
        gap: 18px;
      }
      .body-response p {
        margin: 0;
        color: var(--ink-100);
        font-size: 1.02rem;
        max-width: 68ch;
      }
      .body-response em {
        color: var(--response);
        font-style: italic;
      }

      /* table pair */
      .table-pair {
        margin-top: 80px;
        display: grid;
        grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
        gap: 30px;
        align-items: start;
      }
      .table-call h2 {
        font-size: 1.5rem;
        margin-bottom: 12px;
      }
      .table-call p {
        margin: 0;
        color: var(--ink-100);
        max-width: 40ch;
      }
      .table-response {
        background: var(--canvas-raised);
        border: 1px solid var(--canvas-line);
        border-radius: 18px;
        padding: 8px;
        transform: translateY(16px);
      }
      .table-scroll {
        overflow-x: auto;
      }
      table {
        border-collapse: collapse;
        width: 100%;
        min-width: 320px;
      }
      th {
        text-align: left;
        font: 700 0.78rem/1 'Figtree', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--canvas);
        background: var(--response);
        padding: 12px 20px;
      }
      th:first-child {
        border-radius: 10px 0 0 0;
      }
      th:last-child {
        border-radius: 0 10px 0 0;
      }
      td {
        padding: 14px 20px;
        font-family: 'JetBrains Mono', monospace;
        font-weight: 600;
        color: var(--ink-0);
        border-bottom: 1px solid var(--canvas-line);
      }
      tr:last-child td {
        border-bottom: none;
      }
      td:first-child {
        color: var(--call);
      }
      td:last-child {
        color: var(--tertiary);
      }

      /* faq */
      .section {
        margin-top: 90px;
      }
      .section-head {
        max-width: 620px;
        margin-bottom: 34px;
      }
      .section-head h2 {
        font-size: 1.9rem;
        margin-bottom: 8px;
      }
      .faq-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }
      .faq-pair {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        align-items: stretch;
      }
      .faq-pair:nth-child(even) {
        transform: translateX(28px);
      }
      .faq-q {
        background: var(--call);
        color: var(--call-ink);
        border-radius: 18px 4px 4px 18px;
        padding: 22px 24px;
        display: flex;
        gap: 14px;
        align-items: flex-start;
        z-index: 2;
      }
      .faq-q p {
        margin: 0;
        font-weight: 700;
        font-size: 1.02rem;
      }
      .faq-a {
        background: var(--canvas-raised);
        border: 1px solid var(--canvas-line);
        border-left: none;
        border-radius: 4px 18px 18px 4px;
        padding: 22px 26px;
        margin-left: -8px;
        display: flex;
        gap: 14px;
        align-items: flex-start;
      }
      .faq-a p {
        margin: 0;
        color: var(--ink-100);
        font-size: 0.98rem;
      }
      .qmark,
      .amark {
        font-family: 'Fraunces', serif;
        font-weight: 700;
        font-size: 1.2rem;
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: grid;
        place-items: center;
      }
      .qmark {
        background: var(--call-ink);
        color: var(--call);
      }
      .amark {
        background: var(--response);
        color: var(--response-ink);
      }

      /* practice cta */
      .practice-cta {
        margin-top: 90px;
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 3fr);
        border-radius: 22px;
        overflow: hidden;
      }
      .practice-cta-call {
        background: var(--canvas-raised);
        border: 1px solid var(--canvas-line);
        border-right: none;
        display: flex;
        align-items: center;
        padding: 30px 32px;
      }
      .practice-cta-call p {
        margin: 0;
        font-family: 'Fraunces', serif;
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--ink-0);
      }
      .practice-cta-response {
        background: var(--response);
        color: var(--response-ink);
        font-weight: 700;
        font-size: 1.05rem;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px 32px;
        text-align: center;
      }
      .practice-cta-response:hover {
        background: var(--response-deep);
      }

      /* related */
      .related-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 14px;
      }
      .related-pair {
        display: grid;
        grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
        align-items: stretch;
      }
      .related-call {
        background: transparent;
        border: 1px dashed var(--canvas-line);
        border-right: none;
        border-radius: 14px 0 0 14px;
        display: flex;
        align-items: center;
        padding: 16px 20px;
      }
      .related-dir {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--tertiary);
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }
      .related-response {
        background: var(--canvas-raised);
        border: 1px solid var(--canvas-line);
        border-radius: 0 14px 14px 0;
        margin-left: -1px;
        padding: 16px 22px;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .related-response strong {
        color: var(--ink-0);
        font-family: 'Fraunces', serif;
        font-size: 1.05rem;
        font-weight: 600;
      }
      .related-response span {
        color: var(--ink-300);
        font-size: 0.88rem;
      }
      .related-response:hover strong {
        color: var(--response);
      }

      .site-foot {
        max-width: 1180px;
        margin: 0 auto;
        padding: 30px 24px 50px;
        color: var(--ink-300);
        font-size: 0.85rem;
      }

      @media (max-width: 900px) {
        .pair--hero {
          grid-template-columns: 1fr;
        }
        .connector {
          flex-direction: row;
          padding: 0;
          margin: 14px 0 14px 30px;
        }
        .connector-line {
          width: 40px;
          height: 2px;
          flex: none;
          margin: 0 0 0 6px;
          background: repeating-linear-gradient(
            to right,
            var(--response) 0 8px,
            transparent 8px 16px
          );
        }
        .zone--response {
          transform: none;
        }
        .qa-pair {
          grid-template-columns: 1fr;
