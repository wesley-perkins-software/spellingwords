---
// Design exploration — Shifting Environments, Variation B3:
// "More ownable/digital-native environment system."
//
// Hypothesis under test: the environments thesis (a warm, editorial,
// serif-led "different places" system) can gain one restrained recurring
// device that makes it recognizable without the logo, without becoming
// Word as Color Object and without a decorative gimmick.
//
// Device explored and kept: the TYPING CURSOR. Spelling practice here is
// fundamentally "hear a word, type it" — the one truly native interaction
// this product has that print/editorial design never had to represent.
// A slim blinking vertical bar (an actual text-input caret, not a
// waveform or any audio-looking mark) recurs at a few restrained points:
// finishing the hero headline like an unfinished line waiting to be
// typed, marking the wordmark, and standing in as the word-list bullet
// on the skill page — always static except at the hero, where the one
// blinking instance earns its motion because it sits beside the product's
// literal typing prompt.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>spellingwords.app — Practice spelling words (Design exploration)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,560;0,9..144,650;1,9..144,500&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="proto-badge" aria-hidden="true">Design exploration — Shifting Environments / B3: Signature device</div>

    <div class="env-arrival">
      <header class="topline">
        <a class="wordmark" href="/design-explore/environments-signature-device/">
          <span class="wordmark-mark">sw</span>spellingwords<span class="cursor cursor-static" aria-hidden="true"></span>
        </a>
        <nav class="topnav" aria-label="Prototype navigation">
          <a href="/design-explore/environments-signature-device/skill">Skill page</a>
        </nav>
      </header>

      <main>
        <section class="hero">
          <p class="hero-eyebrow"><span class="cursor cursor-static" aria-hidden="true"></span>Spelling practice, out loud</p>
          <h1 class="hero-title">
            Hear a word.<br />Write it down.<br />That&rsquo;s the whole idea.<span
              class="cursor cursor-blink"
              aria-hidden="true"
            ></span>
          </h1>
          <p class="hero-sub">
            No timers, no points, no leaderboard. Just a calm way for kids to practice the words
            that trip them up &mdash; read aloud, typed by hand, one list at a time.
          </p>
        </section>

        <section class="plate plate-input" aria-labelledby="own-words-h">
          <div class="plate-glow" aria-hidden="true"></div>
          <h2 id="own-words-h"><span class="cursor cursor-static" aria-hidden="true"></span>Enter your spelling words</h2>
          <p class="plate-hint">Got a list from school this week? Paste it in and start right away.</p>
          <form class="word-form">
            <label class="sr-only" for="words">Enter your spelling words</label>
            <textarea
              id="words"
              name="words"
              rows="5"
              placeholder="Type or paste your words here, one per line"
            ></textarea>
            <div class="form-row">
              <span class="form-note">10 words a session, by default &mdash; you can change that later.</span>
              <button type="submit" class="btn-primary">Start Practicing</button>
            </div>
          </form>
        </section>

        <section class="strip" aria-labelledby="grade-h">
          <div class="strip-head">
            <h2 id="grade-h"><span class="cursor cursor-static" aria-hidden="true"></span>Browse by Grade</h2>
            <p>Word lists mapped to what kids are actually learning in class, K&ndash;5.</p>
          </div>
          <ul class="shelf" role="list">
            <li><a href="/design-explore/environments-signature-device/skill"><span class="shelf-grade">K</span><span class="shelf-label">Kindergarten</span></a></li>
            <li><a href="/design-explore/environments-signature-device/skill"><span class="shelf-grade">1</span><span class="shelf-label">1st Grade</span></a></li>
            <li><a href="/design-explore/environments-signature-device/skill"><span class="shelf-grade">2</span><span class="shelf-label">2nd Grade</span></a></li>
            <li><a href="/design-explore/environments-signature-device/skill"><span class="shelf-grade">3</span><span class="shelf-label">3rd Grade</span></a></li>
            <li><a href="/design-explore/environments-signature-device/skill"><span class="shelf-grade">4</span><span class="shelf-label">4th Grade</span></a></li>
            <li><a href="/design-explore/environments-signature-device/skill"><span class="shelf-grade">5</span><span class="shelf-label">5th Grade</span></a></li>
          </ul>
        </section>

        <section class="strip strip-skill" aria-labelledby="skill-h">
          <div class="strip-head">
            <h2 id="skill-h"><span class="cursor cursor-static" aria-hidden="true"></span>Browse by Skill</h2>
            <p>Practice one spelling pattern at a time &mdash; digraphs, blends, silent letters, and more.</p>
          </div>
          <div class="skill-band">
            <ul class="skill-list" role="list">
              <li><a href="/design-explore/environments-signature-device/skill">SH Digraph Words</a></li>
              <li><a href="/design-explore/environments-signature-device/skill">Compound Words</a></li>
              <li><a href="/design-explore/environments-signature-device/skill">Silent E Words</a></li>
              <li><a href="/design-explore/environments-signature-device/skill">Double Consonants</a></li>
            </ul>
            <a class="skill-all" href="/design-explore/environments-signature-device/skill">See every skill &rarr;</a>
          </div>
        </section>

        <p class="trust-line">
          No accounts to make, no clock running, no score to chase &mdash; just words, read aloud, as many
          times as it takes.
        </p>
      </main>
    </div>

    <style>
      :global(html, body) {
        margin: 0;
        padding: 0;
      }
      * {
        box-sizing: border-box;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .proto-badge {
        position: fixed;
        bottom: 10px;
        right: 10px;
        z-index: 50;
        background: rgba(30, 24, 18, 0.82);
        color: #fdf6ec;
        font: 500 11px/1.4 'Inter', sans-serif;
        padding: 6px 10px;
        border-radius: 6px;
        letter-spacing: 0.01em;
        pointer-events: none;
      }

      /* The recurring device: a slim caret bar. Static everywhere except
         the hero, where the blinking instance sits right beside the
         product's own "type the word" prompt. */
      .cursor {
        display: inline-block;
        width: 3px;
        border-radius: 1px;
        background: currentColor;
        vertical-align: -0.08em;
      }
      .cursor-static {
        height: 0.72em;
        margin-right: 0.5em;
        opacity: 0.85;
      }
      .hero-eyebrow .cursor-static,
      h2 .cursor-static {
        color: var(--accent);
      }
      .cursor-blink {
        height: 0.78em;
        margin-left: 0.14em;
        color: var(--accent);
        animation: cursor-blink 1.1s step-end infinite;
      }
      @keyframes cursor-blink {
        0%,
        45% {
          opacity: 1;
        }
        50%,
        100% {
          opacity: 0;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .cursor-blink {
          animation: none;
          opacity: 0.85;
        }
      }

      .env-arrival {
        /* Built on B1's dusk-plum palette (not the parent's peach/mint/
           cream) so this variation is distinguishable from the untouched
           parent at a glance — the cursor device is what's under test
           here, not the palette, but reusing the parent's literal colors
           made this read as an unstyled clone rather than a variation. */
        --env-a: #e6cfe0;
        --env-b: #f1e4ee;
        --env-c: #dce3f2;
        --ink: #2e1f2c;
        --ink-soft: #5c4a58;
        --ink-faint: #8a7a86;
        --accent: #7a3f6b;
        --accent-ink: #4f2941;
        --plate: #faf3f8;
        --focus-ring: #1c4f8c;

        min-height: 100vh;
        background: linear-gradient(158deg, var(--env-a) 0%, var(--env-b) 46%, var(--env-c) 100%);
        font-family: 'Inter', system-ui, sans-serif;
        color: var(--ink);
        padding: 0 clamp(20px, 5vw, 64px) 96px;
      }

      a {
        color: inherit;
      }
      *:focus-visible {
        outline: 3px solid var(--focus-ring);
        outline-offset: 3px;
        border-radius: 4px;
      }

      .topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 28px 0 8px;
        flex-wrap: wrap;
        gap: 12px;
      }
      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: 'Fraunces', serif;
        font-weight: 650;
        font-size: 20px;
        text-decoration: none;
        color: var(--ink);
      }
      .wordmark .cursor-static {
        margin-right: 0;
        margin-left: 1px;
        height: 0.62em;
      }
      .wordmark-mark {
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 9px;
        background: var(--accent);
        color: #fff;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 13px;
        font-weight: 600;
      }
      .topnav {
        display: flex;
        gap: 22px;
        font-size: 14px;
        font-weight: 500;
      }
      .topnav a {
        text-decoration: none;
        color: var(--ink-soft);
        border-bottom: 1px solid transparent;
        padding-bottom: 2px;
      }
      .topnav a:hover {
        border-color: var(--ink-soft);
      }

      main {
        max-width: 1080px;
        margin: 0 auto;
      }

      .hero {
        padding: 56px 0 40px;
        max-width: 720px;
      }
      .hero-eyebrow {
        display: flex;
        align-items: center;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 13px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent-ink);
        margin: 0 0 18px;
        font-weight: 600;
      }
      .hero-title {
        font-family: 'Fraunces', serif;
        font-weight: 560;
        font-size: clamp(34px, 5.4vw, 58px);
        line-height: 1.06;
        margin: 0 0 22px;
        letter-spacing: -0.01em;
      }
      .hero-sub {
        font-size: 17px;
        line-height: 1.6;
        color: var(--ink-soft);
        max-width: 52ch;
        margin: 0;
      }

      .plate {
        position: relative;
        background: var(--plate);
        border-radius: 34px 12px 34px 12px;
        padding: clamp(24px, 4vw, 40px) clamp(24px, 4vw, 44px) 32px;
        margin: 12px 0 64px;
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.9) inset,
          0 22px 44px -26px rgba(122, 63, 107, 0.38),
          0 2px 10px -2px rgba(122, 63, 107, 0.14);
        overflow: hidden;
      }
      .plate-glow {
        position: absolute;
        top: -70px;
        right: -60px;
        width: 220px;
        height: 220px;
        background: radial-gradient(circle, rgba(122, 63, 107, 0.16), transparent 70%);
        pointer-events: none;
      }
      .plate h2 {
        display: flex;
        align-items: center;
        font-family: 'Fraunces', serif;
        font-weight: 560;
        font-size: 23px;
        margin: 0 0 8px;
      }
      .plate-hint {
        margin: 0 0 20px;
        color: var(--ink-soft);
        font-size: 15px;
      }
      .word-form textarea {
        width: 100%;
        border: 1px solid #e6d8c3;
        background: #fffdf9;
        border-radius: 14px;
        padding: 16px 18px;
        font: 400 15px/1.5 'Inter', sans-serif;
        color: var(--ink);
        resize: vertical;
        min-height: 120px;
      }
      .word-form textarea::placeholder {
        color: #a6957e;
      }
      .word-form textarea:focus-visible {
        outline: 3px solid var(--focus-ring);
        outline-offset: 2px;
      }
      .form-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-top: 16px;
        flex-wrap: wrap;
      }
      .form-note {
        font-size: 13px;
        color: var(--ink-faint);
      }
      .btn-primary {
        font: 600 15px/1 'Inter', sans-serif;
        background: var(--accent);
        color: #fff;
        border: none;
        padding: 14px 24px;
        border-radius: 999px;
        cursor: pointer;
        box-shadow: 0 10px 20px -10px rgba(122, 63, 107, 0.6);
      }
      .btn-primary:hover {
        background: var(--accent-ink);
      }

      .strip {
        padding: 20px 0 8px;
      }
      .strip-head h2 {
        display: flex;
        align-items: center;
        font-family: 'Fraunces', serif;
        font-weight: 560;
        font-size: 24px;
        margin: 0 0 6px;
      }
      .strip-head p {
        margin: 0 0 22px;
        color: var(--ink-soft);
        font-size: 15px;
        max-width: 56ch;
      }

      .shelf {
        list-style: none;
        margin: 0 0 56px;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 2px;
        border-bottom: 2px solid rgba(43, 33, 22, 0.14);
      }
      .shelf li a {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        padding: 20px 8px 22px;
        border-radius: 14px 14px 0 0;
        transition: background 0.15s ease, transform 0.15s ease;
      }
      .shelf li a:hover {
        background: rgba(255, 255, 255, 0.55);
        transform: translateY(-3px);
      }
      .shelf-grade {
        font-family: 'Fraunces', serif;
        font-weight: 650;
        font-size: 26px;
        color: var(--accent-ink);
      }
      .shelf-label {
        font-size: 12.5px;
        font-weight: 500;
        color: var(--ink-soft);
        text-align: center;
      }

      .skill-band {
        background: rgba(255, 255, 255, 0.45);
        border-radius: 8px 28px 8px 28px;
        padding: 26px clamp(20px, 3vw, 34px);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 60px;
        border-top: 1px solid rgba(255, 255, 255, 0.9);
      }
      .skill-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 10px 26px;
      }
      .skill-list a {
        text-decoration: none;
        font-weight: 500;
        font-size: 15px;
        color: var(--ink);
        border-bottom: 1.5px solid rgba(122, 63, 107, 0.4);
        padding-bottom: 2px;
      }
      .skill-list a:hover {
        border-color: var(--accent);
        color: var(--accent-ink);
      }
      .skill-all {
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        color: var(--accent-ink);
        white-space: nowrap;
      }

      .trust-line {
        text-align: center;
        font-family: 'Fraunces', serif;
        font-style: italic;
        font-size: 17px;
        color: var(--ink-soft);
        max-width: 44ch;
        margin: 40px auto 0;
        line-height: 1.5;
      }

      @media (max-width: 720px) {
        .shelf {
          grid-template-columns: repeat(3, 1fr);
        }
        .form-row {
          align-items: stretch;
        }
        .btn-primary {
          width: 100%;
        }
      }
      @media (max-width: 480px) {
        .shelf {
          grid-template-columns: repeat(2, 1fr);
        }
      }
    </style>
  </body>
</html>
