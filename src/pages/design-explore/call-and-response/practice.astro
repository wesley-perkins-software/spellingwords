---
// Design exploration — Direction 2: "Call & Response" — Practice session states (static mockup)
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Practice Session — Call &amp; Response (Design Exploration)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Figtree:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="proto-badge">Design exploration — Call &amp; Response</div>

    <div class="cr">
      <header class="site-head">
        <a class="wordmark" href="/design-explore/call-and-response/">
          spelling<span>words</span>
        </a>
        <nav class="head-nav" aria-label="Primary">
          <a href="/design-explore/call-and-response/grade-hub">Grades</a>
          <a href="/design-explore/call-and-response/skill">Skills</a>
          <a href="/design-explore/call-and-response/practice" aria-current="page">Practice</a>
        </nav>
      </header>

      <main>
        <p class="proto-note">
          Static prototype — this page stacks four practice states for review. In the real
          product only one state shows at a time.
        </p>

        <!-- ============ STATE: QUESTION ============ -->
        <section class="state-block" aria-labelledby="s1-heading">
          <h2 class="state-label" id="s1-heading">State: Question</h2>

          <div class="question-card">
            <div class="progress-row">
              <span class="progress-text">Word 3 of 10</span>
              <div class="progress-track" role="presentation">
                <div class="progress-fill" style="width:30%"></div>
              </div>
            </div>

            <div class="pair pair--question">
              <div class="zone zone--call zone--question-call">
                <p class="tag tag--call">Listen</p>
                <p class="instruction">Listen, then type the word.</p>
                <button type="button" class="hear-btn">🔊 Hear word again</button>
              </div>

              <div class="connector" aria-hidden="true">
                <span class="connector-dot"></span>
                <span class="connector-line"></span>
              </div>

              <div class="zone zone--response zone--question-response">
                <p class="tag tag--response">Your turn</p>
                <label for="answer-input" class="sr-only">Type the word you heard</label>
                <div class="answer-shell">
                  <input
                    id="answer-input"
                    type="text"
                    class="answer-input"
                    value="backpack"
                    autocomplete="off"
                    spellcheck="false"
                  />
                  <span class="answer-caret" aria-hidden="true"></span>
                </div>
                <button type="button" class="btn btn-primary">Submit Answer</button>
              </div>
            </div>
          </div>
        </section>

        <!-- ============ STATE: CORRECT ============ -->
        <section class="state-block" aria-labelledby="s2-heading">
          <h2 class="state-label" id="s2-heading">State: Correct feedback</h2>

          <div class="feedback-pair feedback-pair--correct">
            <div class="feedback-call">
              <span class="feedback-word">sunshine</span>
            </div>
            <div class="feedback-response">
              <p class="feedback-note">
                <span class="feedback-icon" aria-hidden="true">✓</span>
                That's it exactly. Nicely spelled.
              </p>
              <button type="button" class="btn btn-primary">Continue</button>
            </div>
          </div>
        </section>

        <!-- ============ STATE: INCORRECT ============ -->
        <section class="state-block" aria-labelledby="s3-heading">
          <h2 class="state-label" id="s3-heading">State: Incorrect feedback</h2>

          <div class="feedback-pair feedback-pair--incorrect">
            <div class="compare-pair">
              <div class="compare-call">
                <p class="tag tag--call">You wrote</p>
                <span class="compare-word compare-word--wrong">berthday</span>
              </div>
              <div class="compare-connector" aria-hidden="true">→</div>
              <div class="compare-response">
                <p class="tag tag--response">It's spelled</p>
                <span class="compare-word compare-word--right">birthday</span>
              </div>
            </div>
            <div class="feedback-response feedback-response--incorrect">
              <p class="feedback-note">
                Close — the middle vowel sound is the tricky part here. Take a look, and let's
                keep going.
              </p>
              <button type="button" class="btn btn-primary">Continue</button>
            </div>
          </div>
        </section>

        <!-- ============ STATE: RESULTS ============ -->
        <section class="state-block" aria-labelledby="s4-heading">
          <h2 class="state-label" id="s4-heading">State: Results</h2>

          <div class="pair pair--results">
            <div class="zone zone--call zone--results-call">
              <p class="tag tag--call">Session complete</p>
              <p class="results-headline">You spelled 8 of 10 words correctly.</p>
            </div>

            <div class="connector" aria-hidden="true">
              <span class="connector-dot"></span>
              <span class="connector-line"></span>
            </div>

            <div class="zone zone--response zone--results-response">
              <p class="tag tag--response">Worth another look</p>
              <ul class="missed-list">
                <li><span class="missed-word">birthday</span><span class="missed-hint">written as "berthday"</span></li>
                <li><span class="missed-word">necessary</span><span class="missed-hint">written as "neccessary"</span></li>
              </ul>
              <div class="results-actions">
                <a href="/design-explore/call-and-response/practice" class="btn btn-primary"
                  >Practice these words again</a
                >
                <a href="/design-explore/call-and-response/" class="btn btn-secondary"
                  >Choose another list</a
                >
              </div>
            </div>
          </div>
        </section>
      </main>

      <footer class="site-foot">
        <p>spellingwords.app · a calm place to practice</p>
      </footer>
    </div>

    <style>
      .cr {
        --canvas: #16262c;
        --canvas-raised: #1d323a;
        --canvas-line: rgba(251, 246, 236, 0.14);
        --ink-0: #fbf6ec;
        --ink-100: #e4dfd2;
        --ink-300: #93a6a4;
        --call: #ff6b4a;
        --call-deep: #d43f1f;
        --call-ink: #2c1206;
        --response: #ffc93c;
        --response-deep: #c98a0a;
        --response-ink: #2b2205;
        --tertiary: #c9a6ff;
        --tertiary-deep: #8c5ff0;
        --tertiary-ink: #241238;
        --correct-surface: #26443b;
        --correct-line: #5fae82;
        --correct-text: #cdeedb;
        --incorrect-surface: #3a2a22;
        --incorrect-line: #c97b4a;
        --incorrect-text: #f0d4bf;
        --focus: #ffe08a;
        --radius-call: 28px 8px 28px 8px;
        --radius-response: 8px 28px 8px 28px;
        background: var(--canvas);
        color: var(--ink-0);
        font-family: 'Figtree', ui-sans-serif, system-ui, sans-serif;
        min-height: 100vh;
        line-height: 1.5;
      }
      .cr * {
        box-sizing: border-box;
      }
      .cr h1,
      .cr h2 {
        font-family: 'Fraunces', ui-serif, Georgia, serif;
        font-weight: 600;
        line-height: 1.1;
        margin: 0;
        color: var(--ink-0);
      }
      .cr a {
        color: inherit;
      }
      .cr :focus-visible {
        outline: 3px solid var(--focus);
        outline-offset: 3px;
        border-radius: 4px;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }
      .proto-badge {
        position: fixed;
        bottom: 14px;
        right: 14px;
        z-index: 999;
        background: #0f1a1e;
        color: #f2ead8;
        font: 600 12px/1 'Figtree', sans-serif;
        padding: 8px 12px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
      }
      .site-head {
        max-width: 1180px;
        margin: 0 auto;
        padding: 28px 24px 8px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }
      .wordmark {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.35rem;
        text-decoration: none;
        color: var(--ink-0);
      }
      .wordmark span {
        color: var(--response);
      }
      .head-nav {
        display: flex;
        gap: 22px;
        font-weight: 600;
        font-size: 0.95rem;
      }
      .head-nav a {
        text-decoration: none;
        color: var(--ink-100);
        padding-bottom: 3px;
        border-bottom: 2px solid transparent;
      }
      .head-nav a:hover,
      .head-nav a[aria-current='page'] {
        border-bottom-color: var(--response);
        color: var(--ink-0);
      }
      main {
        max-width: 1000px;
        margin: 0 auto;
        padding: 0 24px 120px;
      }
      .proto-note {
        margin: 30px 0 0;
        color: var(--ink-300);
        font-size: 0.88rem;
        border-left: 3px solid var(--tertiary);
        padding-left: 14px;
      }
      .tag {
        display: inline-block;
        font: 700 0.72rem/1 'Figtree', sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        padding: 6px 12px;
        border-radius: 999px;
        margin: 0 0 14px;
      }
      .tag--call {
        background: var(--call);
        color: var(--call-ink);
      }
      .tag--response {
        background: var(--response);
        color: var(--response-ink);
      }

      .state-block {
        margin-top: 76px;
      }
      .state-block:first-of-type {
        margin-top: 40px;
      }
      .state-label {
        font-family: 'Figtree', sans-serif;
        font-weight: 800;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--tertiary);
        margin-bottom: 18px;
        padding-bottom: 10px;
        border-bottom: 1px dashed var(--canvas-line);
      }

      /* ---------- question card ---------- */
      .question-card {
        background: var(--canvas-raised);
        border: 1px solid var(--canvas-line);
        border-radius: 26px;
        padding: 32px;
      }
      .progress-row {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 30px;
      }
      .progress-text {
        font-weight: 700;
        font-size: 0.85rem;
        color: var(--ink-100);
        white-space: nowrap;
      }
      .progress-track {
        flex: 1;
        height: 6px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        overflow: hidden;
      }
      .progress-fill {
        height: 100%;
        background: var(--response);
        border-radius: 999px;
      }

      .pair {
        display: grid;
        position: relative;
      }
      .pair--question {
        grid-template-columns: minmax(0, 5fr) 56px minmax(0, 7fr);
        align-items: stretch;
      }
      .zone {
        padding: 34px 32px;
        position: relative;
      }
      .zone--call {
        background: var(--call);
        color: var(--call-ink);
        border-radius: var(--radius-call);
        z-index: 2;
        box-shadow: 0 18px 40px -16px rgba(212, 63, 31, 0.5);
      }
      .zone--response {
        background: var(--canvas);
        border: 1px solid var(--canvas-line);
        border-radius: var(--radius-response);
        z-index: 1;
      }
      .zone--question-call {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 6px;
      }
      .instruction {
        margin: 0 0 20px;
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.5rem;
        color: var(--call-ink);
      }
      .hear-btn {
        align-self: flex-start;
        background: var(--call-ink);
        color: var(--call);
        border: none;
        font: 700 0.95rem/1 'Figtree', sans-serif;
        padding: 13px 20px;
        border-radius: 999px;
        cursor: pointer;
      }
      .hear-btn:hover {
        background: #43220f;
      }
      .zone--question-response {
        transform: translateY(28px);
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .connector {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 60px;
      }
      .connector-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--response);
        box-shadow: 0 0 0 6px rgba(255, 201, 60, 0.18);
      }
      .connector-line {
        width: 2px;
        flex: 1;
        margin-top: 6px;
        background: repeating-linear-gradient(
          to bottom,
          var(--response) 0 8px,
          transparent 8px 16px
        );
      }
      .answer-shell {
        position: relative;
        margin-bottom: 20px;
      }
      .answer-input {
        width: 100%;
        background: var(--canvas-raised);
        border: 2px solid var(--response);
        border-radius: 14px;
        color: var(--ink-0);
        font: 700 1.7rem/1 'JetBrains Mono', ui-monospace, monospace;
        letter-spacing: 0.04em;
        padding: 18px 20px;
      }
      .answer-caret {
        position: absolute;
        right: 24px;
        top: 50%;
        transform: translateY(-50%);
        width: 2px;
        height: 26px;
        background: var(--response);
        animation: blink 1.1s steps(1) infinite;
      }
      @keyframes blink {
        50% {
          opacity: 0;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .answer-caret {
          animation: none;
        }
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font: 700 1rem/1 'Figtree', sans-serif;
        padding: 15px 26px;
        border-radius: 999px;
        border: none;
        cursor: pointer;
        text-decoration: none;
      }
      .btn-primary {
        background: var(--response);
        color: var(--response-ink);
      }
      .btn-primary:hover {
        background: var(--response-deep);
      }
      .btn-secondary {
        background: transparent;
        color: var(--ink-0);
        border: 2px solid var(--canvas-line);
      }
      .btn-secondary:hover {
        border-color: var(--response);
      }

      /* ---------- correct feedback ---------- */
      .feedback-pair {
        display: grid;
        border-radius: 24px;
        overflow: hidden;
      }
      .feedback-pair--correct {
        grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      }
      .feedback-call {
        background: var(--call);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px;
      }
      .feedback-word {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 700;
        font-size: 2rem;
        color: var(--call-ink);
        letter-spacing: 0.02em;
      }
      .feedback-response {
        background: var(--correct-surface);
        border: 1px solid var(--correct-line);
        border-left: none;
        padding: 30px 34px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
      }
      .feedback-note {
        margin: 0;
        color: var(--correct-text);
        font-size: 1.05rem;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .feedback-icon {
        display: inline-grid;
        place-items: center;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: var(--correct-line);
        color: #113022;
        font-weight: 700;
        flex-shrink: 0;
      }

      /* ---------- incorrect feedback ---------- */
      .feedback-pair--incorrect {
        display: flex;
        flex-direction: column;
        gap: 0;
        border-radius: 24px;
      }
      .compare-pair {
        display: grid;
        grid-template-columns: minmax(0, 5fr) 50px minmax(0, 5fr);
        align-items: stretch;
      }
      .compare-call,
      .compare-response {
        padding: 26px 28px;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .compare-call {
        background: var(--incorrect-surface);
        border: 1px solid var(--incorrect-line);
        border-radius: 20px 4px 0 0;
      }
      .compare-response {
        background: var(--canvas-raised);
        border: 1px solid var(--canvas-line);
        border-radius: 4px 20px 0 0;
      }
      .compare-connector {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--ink-300);
        font-size: 1.3rem;
        font-weight: 700;
      }
      .compare-word {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 700;
        font-size: 1.6rem;
      }
      .compare-word--wrong {
        color: var(--incorrect-text);
        text-decoration: line-through;
        text-decoration-color: var(--incorrect-line);
        text-decoration-thickness: 2px;
      }
      .compare-word--right {
        color: var(--ink-0);
      }
      .feedback-response--incorrect {
        background: var(--canvas-raised);
        border: 1px solid var(--canvas-line);
        border-top: none;
        border-radius: 0 0 20px 20px;
        justify-content: space-between;
      }
      .feedback-response--incorrect .feedback-note {
        color: var(--ink-100);
      }

      /* ---------- results ---------- */
      .pair--results {
        grid-template-columns: minmax(0, 5fr) 56px minmax(0, 7fr);
        align-items: start;
      }
      .zone--results-call {
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .results-headline {
        margin: 0;
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.7rem;
        color: var(--call-ink);
      }
      .zone--results-response {
        transform: translateY(30px);
      }
      .missed-list {
        list-style: none;
        margin: 0 0 24px;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .missed-list li {
        display: flex;
        align-items: baseline;
        gap: 12px;
        padding: 12px 16px;
        background: var(--incorrect-surface);
        border: 1px solid var(--incorrect-line);
        border-radius: 10px;
      }
      .missed-word {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 700;
        color: var(--ink-0);
        font-size: 1.05rem;
      }
      .missed-hint {
        color: var(--ink-300);
        font-size: 0.85rem;
      }
      .results-actions {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
      }

      .site-foot {
        max-width: 1000px;
        margin: 0 auto;
        padding: 30px 24px 50px;
        color: var(--ink-300);
        font-size: 0.85rem;
      }

      @media (max-width: 860px) {
        .pair--question,
        .pair--results {
          grid-template-columns: 1fr;
        }
        .connector {
          flex-direction: row;
          padding: 0;
          margin: 14px 0 14px 30px;
        }
        .connector-line {
          width: 40px;
          height: 2px;
          flex: none;
          margin: 0 0 0 6px;
          background: repeating-linear-gradient(
            to right,
            var(--response) 0 8px,
            transparent 8px 16px
          );
        }
        .zone--question-response,
        .zone--results-response {
          transform: none;
        }
        .feedback-pair--correct {
          grid-template-columns: 1fr;
        }
        .feedback-call {
          border-radius: 24px 24px 0 0;
        }
        .feedback-response {
          border-left: 1px solid var(--correct-line);
          border-top: none;
          border-radius: 0 0 24px 24px;
        }
        .compare-pair {
          grid-template-columns: 1fr;
        }
        .compare-call {
          border-radius: 20px 20px 0 0;
        }
        .compare-connector {
          padding: 4px 0;
        }
        .compare-response {
          border-radius: 0;
          border-top: none;
        }
      }
    </style>
  </body>
</html>
