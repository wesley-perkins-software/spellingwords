---
interface Props {
  variant?: 'discovery' | 'practice';
  currentPath?: string;
}

const { variant = 'discovery', currentPath = '' } = Astro.props;

const isActive = (path: string) => currentPath.startsWith(path);
---

<!-- Discovery header: "Sw" brand mark, a structural 3px brand-blue rule
     beneath the whole header, coral underline on the active nav item,
     coral primary CTA. Promoted from
     design-explore/direction-a/_shared/Header.astro.
     Practice header (else branch below): minimal chrome — wordmark + a way
     back to a new list — so the practice stage stays the focus. -->
{variant === 'discovery' ? (
  <header class="sticky top-0 z-10 border-b-[3px] border-da-brand bg-da-canvas-raised">
    <div class="mx-auto flex max-w-content-xl items-center justify-between gap-3 px-4 py-3 sm:gap-6 sm:px-6">
      <a href="/" class="flex min-w-0 flex-shrink items-center gap-2.5 font-quicksand text-lg font-bold text-da-ink no-underline sm:text-xl" aria-label="SpellingWords home">
        <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-da-brand font-quicksand text-sm font-bold text-white" aria-hidden="true">Sw</span>
        <span class="truncate">SpellingWords</span>
      </a>

      <nav aria-label="Site navigation" class="hidden flex-1 md:block">
        <ul class="m-0 flex list-none items-center gap-7 p-0">
          <li>
            <a href="/#grades" class="flex min-h-[44px] items-center border-b-[3px] border-transparent py-2 text-[0.94rem] font-bold text-da-ink-soft no-underline hover:text-da-brand">
              Grades
            </a>
          </li>
          <li>
            <a
              href="/skills"
              class:list={[
                'flex min-h-[44px] items-center border-b-[3px] py-2 text-[0.94rem] font-bold no-underline',
                isActive('/skills') ? 'border-da-coral text-da-brand' : 'border-transparent text-da-ink-soft hover:text-da-brand',
              ]}
              aria-current={isActive('/skills') ? 'page' : undefined}
            >
              Skills
            </a>
          </li>
          <li>
            <a href="/#how-it-works" class="flex min-h-[44px] items-center border-b-[3px] border-transparent py-2 text-[0.94rem] font-bold text-da-ink-soft no-underline hover:text-da-brand">
              How it Works
            </a>
          </li>
        </ul>
      </nav>

      <a href="/" class="flex-shrink-0 whitespace-nowrap rounded-lg bg-da-coral px-3.5 py-2 text-sm font-bold text-white no-underline transition hover:bg-da-coral-strong sm:px-5 sm:py-2.5">
        <span class="sm:hidden">Practice</span>
        <span class="hidden sm:inline">Start practicing</span>
      </a>
    </div>
  </header>
) : (
  <header class="sticky top-0 z-10 border-b border-da-border bg-da-canvas/95 backdrop-blur-sm">
    <div class="mx-auto flex max-w-content-lg items-center justify-between px-6 py-3">
      <a
        href="/"
        class="flex items-center gap-1.5 font-quicksand text-sm font-semibold tracking-tight text-da-ink-soft transition-colors hover:text-da-ink"
        aria-label="spellingwords home"
      >
        <span class="inline-block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-da-coral opacity-60" aria-hidden="true"></span>
        spelling<span class="text-da-ink-faint">words</span>
      </a>
      <a
        href="/"
        class="flex min-h-[36px] items-center rounded-full px-3 py-2 text-xs font-semibold text-da-ink-soft/70 transition hover:bg-da-surface-neutral hover:text-da-ink-soft"
      >
        ← New list
      </a>
    </div>
  </header>
)}
