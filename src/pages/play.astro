---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
---

<Layout
  title="Spelling Test — spellingwords"
  description="Take your custom spelling test. Hear each word spoken aloud and type your answer."
>
  <SiteHeader variant="practice" />

  <main id="main-content">

    <!-- Narrow container: error / unsupported / begin / results -->
    <div class="mx-auto max-w-xl px-6 py-12 md:py-16">

      <!-- Error screen -->
      <section id="screen-error" class="hidden text-center" aria-labelledby="error-heading">
        <div class="flex flex-col items-center gap-6">
          <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-feedback-incorrect/10 text-feedback-incorrect" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </div>
          <div class="flex flex-col gap-2">
            <h1 id="error-heading" class="font-display text-2xl font-semibold text-ink">
              No word list found
            </h1>
            <p id="error-message" class="text-base text-ink-soft"></p>
          </div>
          <a
            href="/"
            class="rounded-full bg-brand-blue px-6 py-3 text-sm font-bold text-white shadow-[0_8px_20px_-8px_rgba(47,111,237,0.45)] transition hover:bg-brand-blue-deep"
          >
            ← Enter new words
          </a>
        </div>
      </section>

      <!-- Unsupported browser screen -->
      <section id="screen-unsupported" class="hidden text-center" aria-labelledby="unsupported-heading">
        <div class="flex flex-col items-center gap-6">
          <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-chip-sun/15 text-ink-soft" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
          </div>
          <div class="flex flex-col gap-2">
            <h1 id="unsupported-heading" class="font-display text-2xl font-semibold text-ink">
              Audio not supported
            </h1>
            <p class="text-base text-ink-soft">
              Audio spelling tests are not supported in this browser.<br />
              Please try a modern browser with speech support.
            </p>
          </div>
          <a
            href="/"
            class="rounded-full bg-brand-blue px-6 py-3 text-sm font-bold text-white shadow-[0_8px_20px_-8px_rgba(47,111,237,0.45)] transition hover:bg-brand-blue-deep"
          >
            ← Go back
          </a>
        </div>
      </section>

      <!-- Begin screen -->
      <section id="screen-begin" class="hidden" aria-labelledby="begin-heading">
        <div class="flex flex-col items-center gap-10 text-center">

          <!-- Readiness phrase -->
          <p class="font-sans text-base font-medium text-ink tracking-wide">Let's begin.</p>

          <!-- Session identity -->
          <div class="flex flex-col items-center gap-2">
            <h1 id="begin-heading" class="font-display text-3xl font-bold text-ink leading-snug"></h1>
            <p id="begin-word-count" class="font-sans text-base text-ink"></p>
          </div>

          <!-- Instructional line -->
          <p class="font-sans text-base text-ink">Listen carefully and type what you hear.</p>

          <!-- Primary CTA -->
          <button
            id="btn-begin"
            type="button"
            class="w-full rounded-full bg-brand-red px-10 py-4 font-display text-[19px] font-semibold text-white tracking-[0.01em] shadow-[0_8px_28px_-6px_rgba(201,64,48,0.22)] transition hover:bg-brand-red-deep hover:-translate-y-0.5 hover:shadow-[0_14px_32px_-6px_rgba(201,64,48,0.35)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red active:translate-y-0"
          >
            Start Practice <span aria-hidden="true">→</span>
          </button>

          <!-- Hidden session meta slot for future chunking -->
          <span id="begin-session-meta" class="hidden"></span>
        </div>
      </section>

    </div>

    <!-- Wider container: question + feedback screens (more workbook-page width on desktop) -->
    <div class="mx-auto max-w-xl md:max-w-content-md px-6 pb-12 md:pb-16">

      <!-- Shared session progress — visible during question AND feedback, hidden otherwise -->
      <div id="session-progress" class="hidden mb-4 flex flex-col gap-2">
        <p
          id="progress"
          class="font-sans text-sm font-semibold text-ink"
          aria-live="polite"
          aria-atomic="true"
        ></p>
        <div class="h-1 rounded-full bg-line overflow-hidden">
          <div id="progress-bar" class="h-full rounded-full bg-brand-red/70 transition-[width] duration-400" style="width: 0%"></div>
        </div>
      </div>

      <!-- Question screen
           Uses CSS grid (1fr auto) with a shared min-height so the Submit Answer button
           always occupies a consistent vertical slot. -->
      <section id="screen-question" class="hidden grid grid-rows-[1fr_auto] gap-4 min-h-[420px]" aria-labelledby="question-heading">

        <!-- Practice Tray — the focused workbook surface -->
        <div class="rounded-3xl border border-line bg-app-cloud shadow-card px-7 py-8 md:px-8 md:py-9 flex flex-col gap-6">

          <!-- Instruction and answer area -->
          <div class="flex flex-col gap-4">
            <h1 id="question-heading" class="sr-only">Type the word you hear</h1>
            <p id="question-instruction" class="text-base font-medium text-ink leading-relaxed"></p>

            <!-- Answer input -->
            <div class="flex flex-col gap-2">
              <input
                id="answer-input"
                type="text"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                placeholder="Type the word"
                class="w-full rounded-2xl border border-line bg-white px-5 py-4 font-word text-3xl font-semibold text-ink tracking-wide placeholder:font-normal placeholder:text-ink-faint/50 transition focus:border-brand-blue/50 focus:outline-none focus:ring-2 focus:ring-brand-blue/15 focus:shadow-[inset_0_1px_4px_rgba(0,0,0,0.04)]"
                aria-label="Your answer"
              />
              <p
                id="answer-error"
                class="min-h-[1.25rem] px-1 text-sm text-feedback-incorrect"
                aria-live="polite"
                role="alert"
              ></p>
            </div>

            <!-- Audio controls — centered, clearly clickable, secondary to submit -->
            <div class="flex flex-col items-center gap-3">
              <div class="flex items-center justify-center gap-2 flex-wrap">
                <!-- Hear word again — primary audio control -->
                <button
                  id="btn-repeat"
                  type="button"
                  class="inline-flex items-center gap-2 rounded-xl border border-line bg-white px-5 py-3.5 text-base font-semibold text-ink transition hover:bg-app-paper hover:border-ink-soft/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-ink/30"
                  aria-label="Hear the word again"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                  </svg>
                  Hear word again
                </button>

                <!-- Hear sentence again — only shown when sentence exists -->
                <button
                  id="btn-sentence"
                  type="button"
                  class="hidden items-center gap-2 rounded-xl border border-line bg-white px-5 py-3.5 text-base font-semibold text-ink transition hover:bg-app-paper hover:border-ink-soft/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-ink/30"
                  aria-label="Hear the word used in a sentence again"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                  </svg>
                  Hear sentence again
                </button>
              </div>

              <!-- Shown only when no example sentence exists for this word -->
              <p id="no-sentence-note" class="hidden text-sm font-medium text-ink" aria-live="polite">No sentence available for this word.</p>
            </div>
          </div>
        </div>

        <!-- Primary action — grid row 2, same slot as Next Word on feedback screen -->
        <button
          id="btn-submit"
          type="button"
          class="w-full rounded-full bg-brand-red px-6 py-4 font-display text-xl font-semibold text-white shadow-btn-red transition hover:bg-brand-red-deep hover:-translate-y-0.5 hover:shadow-[0_14px_32px_-6px_rgba(201,64,48,0.35)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red active:translate-y-0"
        >
          Submit Answer
        </button>
      </section>

      <!-- Feedback screen — mirrors question screen grid so content centers between progress and button -->
      <section
        id="screen-feedback"
        class="hidden grid grid-rows-[1fr_auto] gap-4 min-h-[420px] text-center"
        aria-labelledby="feedback-heading"
        aria-live="assertive"
      >
        <!-- Visually hidden heading updated for screen readers -->
        <h1 id="feedback-heading" class="sr-only"></h1>

        <!-- Content zone — centered vertically in the 1fr row -->
        <div class="flex flex-col items-center justify-center gap-6">

          <!-- Correct answer: word (green + inline checkmark) first, calm phrase below -->
          <div id="feedback-correct-layout" class="hidden flex-col items-center gap-4">
            <div class="flex items-center justify-center gap-3">
              <span class="text-feedback-correct flex-shrink-0" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              <p id="feedback-correct-word" class="font-word text-6xl font-bold tracking-tight leading-none text-feedback-correct"></p>
            </div>
            <p id="feedback-correct-phrase" class="font-display text-2xl font-semibold text-ink"></p>
          </div>

          <!-- Incorrect answer: phrase → attempt → correct word (safe ink) → closing note -->
          <div id="feedback-incorrect-layout" class="hidden flex-col items-center gap-3">
            <p id="feedback-incorrect-phrase" class="font-display text-xl font-semibold text-feedback-incorrect"></p>
            <p id="feedback-attempt" class="font-word text-xl text-ink-soft"></p>
            <p id="feedback-incorrect-word" class="font-word text-6xl font-bold tracking-tight leading-none text-ink mt-1"></p>
            <p id="feedback-detail" class="font-sans text-base text-ink mt-1"></p>
          </div>

        </div>

        <!-- Continue button — auto row, anchors at bottom like Submit Answer on question screen -->
        <button
          id="btn-next"
          type="button"
          aria-label="Continue to next word"
          class="w-full rounded-full bg-brand-red px-8 py-4 font-display text-xl font-semibold text-white shadow-btn-red transition hover:bg-brand-red-deep hover:-translate-y-0.5 hover:shadow-[0_14px_32px_-6px_rgba(201,64,48,0.35)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red active:translate-y-0 disabled:opacity-40 disabled:cursor-default disabled:translate-y-0 disabled:shadow-btn-red"
        >
          Continue →
        </button>

      </section>

      <!-- Results screen -->
      <section id="screen-results" class="hidden" aria-labelledby="results-heading">
        <div id="results-content" class="flex flex-col gap-6">

          <!-- Outcome zone -->
          <div class="text-center">
            <h1 id="results-heading" class="font-display text-4xl font-semibold text-ink leading-tight"></h1>
            <p id="results-summary" class="mt-3 text-xl font-medium text-ink"></p>
            <!-- Shown only for difficult sessions -->
            <p id="results-reassurance" class="hidden mt-2 text-sm text-ink">
              Some words take a few tries to stick.
            </p>
          </div>

          <!-- Missed words section — chips only, no button inside; hidden for perfect sessions -->
          <div id="results-missed-section" class="hidden rounded-3xl border border-line bg-app-cloud p-7 shadow-card">
            <h2 id="results-missed-heading" class="font-display text-lg font-semibold text-ink">
              Let's work on these words together.
            </h2>
            <ul id="results-missed-list" class="mt-4 flex flex-wrap gap-3" aria-label="Words to practice again"></ul>
            <p id="results-missed-overflow" class="hidden mt-3 text-sm font-medium text-ink-soft"></p>
          </div>

          <!-- Action zone — populated and ordered by renderResults() -->
          <div id="results-action-zone" class="flex flex-col gap-2">
            <!-- Perfect session primary -->
            <a
              id="btn-choose-list"
              href="/spelling-lists"
              class="hidden w-full rounded-full bg-brand-red px-6 py-4 text-center font-display text-lg font-semibold text-white shadow-btn-red transition hover:bg-brand-red-deep hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red active:translate-y-0"
            >
              Choose another list
            </a>

            <!-- Review missed — role (primary/secondary) and position set by JS -->
            <button
              id="btn-review-missed"
              type="button"
              class="hidden w-full rounded-full border border-line/60 bg-white px-6 py-3.5 text-base font-medium text-ink transition hover:bg-app-cloud focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink active:scale-[0.97]"
            >
              Practice missed words
            </button>

            <!-- Retry full list — role (primary/secondary) and label set by JS -->
            <button
              id="btn-retry"
              type="button"
              class="w-full rounded-full border border-line/60 bg-white px-6 py-3.5 text-base font-medium text-ink transition hover:bg-app-cloud focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink active:scale-[0.97]"
            >
              Practice this list again
            </button>

            <!-- Tertiary text link -->
            <a
              id="btn-home-link"
              href="/spelling-lists"
              class="hidden mt-1 block text-center text-sm font-semibold text-ink-soft transition hover:text-ink"
            >
              Choose another list
            </a>
          </div>

        </div>
      </section>

    </div>
  </main>

  <footer id="site-footer" class="border-t border-line">
    <div class="mx-auto max-w-3xl px-6 py-8 text-center text-xs text-ink-soft">
      &copy; {new Date().getFullYear()} spellingwords.app &mdash; Free spelling practice for every classroom.
    </div>
  </footer>
</Layout>

<script>
  import { decodeWordList } from '@/lib/words';
  import { getSentenceBankEntry } from '@/lib/sentenceBank';
  import { createSpeechController, selectPreferredVoice } from '@/modules/speech';
  import type { SpeechSynthesisVoiceAdapter } from '@/modules/speech';
  import {
    spellingTestReducer,
    createInitialState,
    initializeTest,
    startTest,
    submitAnswer,
    nextWord,
    resetTest,
  } from '@/modules/spellingTest/stateMachine';
  import type { TestState } from '@/modules/spellingTest/types';

  // --- DOM refs ---
  const $ = (id: string) => document.getElementById(id)!;

  const screenError = $('screen-error');
  const screenUnsupported = $('screen-unsupported');
  const screenBegin = $('screen-begin');
  const screenQuestion = $('screen-question');
  const screenFeedback = $('screen-feedback');
  const screenResults = $('screen-results');

  const allScreens = [screenError, screenUnsupported, screenBegin, screenQuestion, screenFeedback, screenResults];

  const beginHeading = $('begin-heading');
  const beginWordCount = $('begin-word-count');
  const progressEl = $('progress');
  const questionInstruction = $('question-instruction');
  const answerInput = $('answer-input') as HTMLInputElement;
  const answerError = $('answer-error');
  const feedbackHeading = $('feedback-heading');
  const feedbackCorrectLayout = $('feedback-correct-layout');
  const feedbackCorrectWord = $('feedback-correct-word');
  const feedbackCorrectPhrase = $('feedback-correct-phrase');
  const feedbackIncorrectLayout = $('feedback-incorrect-layout');
  const feedbackIncorrectPhrase = $('feedback-incorrect-phrase');
  const feedbackAttempt = $('feedback-attempt');
  const feedbackIncorrectWord = $('feedback-incorrect-word');
  const feedbackDetail = $('feedback-detail');
  const progressBar = $('progress-bar') as HTMLElement;
  const sessionProgress = $('session-progress');
  const resultsContent = $('results-content');
  const resultsReassurance = $('results-reassurance');
  const resultsSummary = $('results-summary');
  const resultsMissedSection = $('results-missed-section');
  const resultsMissedHeading = $('results-missed-heading');
  const resultsMissedList = $('results-missed-list');
  const resultsMissedOverflow = $('results-missed-overflow');
  const btnChooseList = $('btn-choose-list') as HTMLAnchorElement;
  const btnBegin = $('btn-begin') as HTMLButtonElement;
  const btnRepeat = $('btn-repeat') as HTMLButtonElement;
  const btnSentence = $('btn-sentence') as HTMLButtonElement;
  const noSentenceNote = $('no-sentence-note');
  const btnSubmit = $('btn-submit') as HTMLButtonElement;
  const btnNext = $('btn-next') as HTMLButtonElement;
  const btnRetry = $('btn-retry') as HTMLButtonElement;
  const errorMessage = $('error-message');

  // --- Module state ---
  const speech = createSpeechController();
  let state: TestState = createInitialState();
  let originalWords: string[] = [];
  let originalRichWords: { word: string; exampleSentence?: string }[] = [];

  let selectedVoice: SpeechSynthesisVoiceAdapter | null = null;
  const currentRate = 1.0;

  // Pending auto-sentence timeout handle — cancelled whenever we move to a new word
  let sentenceTimeout: ReturnType<typeof setTimeout> | null = null;

  function cancelPendingSentence(): void {
    if (sentenceTimeout !== null) {
      clearTimeout(sentenceTimeout);
      sentenceTimeout = null;
    }
  }

  // --- Warm, varied feedback copy ---
  // A calm adult helping a child — not a scoreboard. We rotate through these
  // so the same phrase doesn't land twice in a row and start to feel canned.
  const CORRECT_PHRASES = ['Well spelled.', 'Good listening.', "That's it exactly.", 'Correct.', 'Just right.', "You've got it."];
  const INCORRECT_PHRASES = ['A good attempt.', "That's a tricky one.", 'Close — good effort.', 'Worth another look.', 'Nearly there.'];
  const NOT_PERFECT_HEADLINES = [
    'Good practice today.',
    'Worth another pass.',
    'Nice effort today.',
    'Good effort today.',
    'Keep going.',
    'That\'s the way.',
  ];

  let lastCorrectPhrase = -1;
  let lastIncorrectPhrase = -1;
  let lastNotPerfectHeadline = -1;

  // Delay before the Continue button becomes active on incorrect answers —
  // enforces a brief reading moment without auto-advancing.
  let nextWordDelayTimeout: ReturnType<typeof setTimeout> | null = null;

  function pickPhrase(pool: string[], lastIndex: number, remember: (i: number) => void): string {
    let i = Math.floor(Math.random() * pool.length);
    if (pool.length > 1 && i === lastIndex) i = (i + 1) % pool.length;
    remember(i);
    return pool[i];
  }

  // --- Progressive instructions ---
  // Full guidance up front; as the child settles in, the screen quietly
  // steps back rather than repeating itself on every single word.
  function instructionForIndex(): string {
    return "Listen, then type the word.";
  }

  // --- Screen management ---
  const siteFooter = document.getElementById('site-footer');
  const immersiveScreens = [screenQuestion, screenFeedback, screenResults];

  const practiceScreens = [screenQuestion, screenFeedback];

  function showScreen(target: HTMLElement): void {
    for (const screen of allScreens) {
      screen.classList.toggle('hidden', screen !== target);
      screen.classList.remove('screen-entering');
    }
    siteFooter?.classList.toggle('hidden', immersiveScreens.includes(target));
    sessionProgress.classList.toggle('hidden', !practiceScreens.includes(target));
    // Trigger reflow so the animation restarts each time
    void (target as HTMLElement).offsetHeight;
    target.classList.add('screen-entering');
  }

  function showError(message: string): void {
    errorMessage.textContent = message;
    showScreen(screenError);
  }

  // --- Voice setup ---
  async function initVoiceControls(): Promise<void> {
    const allVoices = await speech.loadVoices();
    selectedVoice = selectPreferredVoice(allVoices);
  }

  // --- Initialization ---
  function init(): void {
    const params = new URLSearchParams(window.location.search);
    const payload = params.get('list');

    if (!payload) {
      showError('No word list found. Please go back and enter your words.');
      return;
    }

    const decoded = decodeWordList(payload);
    if (!decoded.ok) {
      showError('The word list could not be loaded. Please go back and try again.');
      return;
    }

    if (!speech.isSpeechSupported()) {
      showScreen(screenUnsupported);
      return;
    }

    originalWords = decoded.words;

    // Try to recover rich SpellingWord data (with exampleSentence) stored by curated list pages.
    let richWords: { word: string; exampleSentence?: string }[] | null = null;
    try {
      const stored = sessionStorage.getItem(`sw:words:${payload}`);
      if (stored) {
        const parsed: unknown = JSON.parse(stored);
        if (Array.isArray(parsed) && parsed.every((e) => typeof e?.word === 'string')) {
          richWords = parsed as { word: string; exampleSentence?: string }[];
        }
      }
    } catch { /* sessionStorage unavailable or parse failed — fall through to plain words */ }

    // For custom lists (no sessionStorage entry), enrich words from the sentence bank.
    // Curated list words already carry their exampleSentence inside richWords — never overwrite those.
    if (!richWords) {
      richWords = originalWords.map((w) => {
        const entry = getSentenceBankEntry(w);
        return entry ? { word: w, exampleSentence: entry.exampleSentence } : { word: w };
      });
    }

    originalRichWords = richWords;
    state = spellingTestReducer(createInitialState(), initializeTest(richWords));

    const count = originalWords.length;

    // Resolve session title: curated list title from sessionStorage, else custom fallback
    let sessionTitle = 'Your spelling words.';
    try {
      const stored = sessionStorage.getItem(`sw:title:${payload}`);
      if (stored) sessionTitle = stored;
    } catch { /* sessionStorage unavailable — use fallback */ }

    beginHeading.textContent = sessionTitle;
    beginWordCount.textContent = `${count} ${count === 1 ? 'word' : 'words'}`;
    showScreen(screenBegin);

    // Load voices in the background — does not require a user gesture
    initVoiceControls();
  }

  // --- Render helpers ---
  function speechOptions() {
    return { voice: selectedVoice, rate: currentRate };
  }

  function renderQuestion(): void {
    const current = state.words[state.currentIndex];
    const total = state.words.length;
    const pos = state.currentIndex + 1;

    progressEl.textContent = `Word ${pos} of ${total}`;
    progressBar.style.width = `${(pos / total) * 100}%`;
    questionInstruction.textContent = instructionForIndex();
    answerInput.value = '';
    answerError.textContent = '';

    // Show sentence button only when this word has an example sentence
    const hasSentence = Boolean(current.exampleSentence);
    btnSentence.classList.toggle('hidden', !hasSentence);
    btnSentence.classList.toggle('inline-flex', hasSentence);
    noSentenceNote.classList.toggle('hidden', hasSentence);

    showScreen(screenQuestion);
    requestAnimationFrame(() => answerInput.focus());

    // Cancel any pending sentence from the previous word, then speak this word.
    // After a short natural pause, auto-speak the sentence if one exists.
    cancelPendingSentence();
    speech.cancelSpeech();

    const result = speech.speakWord(current.word, speechOptions());
    if (!result.ok) {
      answerError.textContent = 'Audio is not available right now. Try "Hear word again", or check your device sound.';
    } else if (hasSentence) {
      sentenceTimeout = setTimeout(() => {
        sentenceTimeout = null;
        speech.speakWord(current.exampleSentence!, speechOptions());
      }, 1000);
    }
  }

  function renderFeedback(): void {
    const correct = state.lastAnswerCorrect;
    const currentWord = state.words[state.currentIndex].word;
    const lastAttempt = state.attempts[state.attempts.length - 1];
    const submittedAnswer = lastAttempt?.answer ?? '';

    const isLast = state.currentIndex === state.words.length - 1;
    const continueLabel = isLast ? 'See results' : 'Continue to next word';
    btnNext.setAttribute('aria-label', continueLabel);

    // Update shared progress immediately when feedback renders
    const pos = state.currentIndex + 1;
    const total = state.words.length;
    progressEl.textContent = `Word ${pos} of ${total}`;
    progressBar.style.width = `${(pos / total) * 100}%`;

    if (correct) {
      // Correct: word first (green + inline checkmark), calm phrase below.
      feedbackCorrectLayout.classList.remove('hidden');
      feedbackCorrectLayout.classList.add('flex');
      feedbackIncorrectLayout.classList.add('hidden');
      feedbackIncorrectLayout.classList.remove('flex');

      feedbackCorrectWord.textContent = currentWord;
      const phrase = pickPhrase(CORRECT_PHRASES, lastCorrectPhrase, (i) => (lastCorrectPhrase = i));
      feedbackCorrectPhrase.textContent = phrase;

      // SR label covers both the outcome and the word
      feedbackHeading.textContent = `Correct. ${currentWord}. ${phrase}`;

      showScreen(screenFeedback);
      btnNext.disabled = false;
      btnNext.textContent = isLast ? 'See Results →' : 'Continue →';
      requestAnimationFrame(() => btnNext.focus());

    } else {
      // Incorrect: phrase → attempt → correct word (ink, not punitive red) → closing note.
      feedbackIncorrectLayout.classList.remove('hidden');
      feedbackIncorrectLayout.classList.add('flex');
      feedbackCorrectLayout.classList.add('hidden');
      feedbackCorrectLayout.classList.remove('flex');

      const phrase = pickPhrase(INCORRECT_PHRASES, lastIncorrectPhrase, (i) => (lastIncorrectPhrase = i));
      feedbackIncorrectPhrase.textContent = phrase;
      feedbackAttempt.textContent = submittedAnswer ? `You wrote: ${submittedAnswer}` : '';
      feedbackIncorrectWord.textContent = currentWord;
      feedbackDetail.textContent = "We'll come back to this one.";

      // SR label covers outcome, attempt, and correct word
      feedbackHeading.textContent = `${phrase} You wrote ${submittedAnswer}. The correct spelling is ${currentWord}.`;

      showScreen(screenFeedback);

      // Disable Continue for 600ms — enforces a minimum reading moment
      btnNext.disabled = true;
      btnNext.textContent = isLast ? 'See Results →' : 'Continue →';
      if (nextWordDelayTimeout) clearTimeout(nextWordDelayTimeout);
      nextWordDelayTimeout = setTimeout(() => {
        nextWordDelayTimeout = null;
        btnNext.disabled = false;
        btnNext.focus();
      }, 600);
    }
  }

  // CSS class sets for primary vs secondary button styling
  const PRIMARY_BTN_CLS =
    'w-full rounded-full bg-brand-red px-6 py-4 font-display text-lg font-semibold text-white shadow-btn-red transition hover:bg-brand-red-deep hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60 focus-visible:ring-offset-2 focus-visible:ring-offset-brand-red active:translate-y-0';
  const SECONDARY_BTN_CLS =
    'w-full rounded-full border border-line/60 bg-white px-6 py-3.5 text-base font-medium text-ink transition hover:bg-app-cloud focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink active:scale-[0.97]';
  const PRIMARY_LINK_CLS =
    'w-full rounded-full bg-brand-red px-6 py-4 text-center font-display text-lg font-semibold text-white shadow-btn-red transition hover:bg-brand-red-deep hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red active:translate-y-0';

  function buildMissedChips(missedWords: { word: string }[], cap: number): void {
    resultsMissedList.textContent = '';
    const visible = missedWords.slice(0, cap);
    const overflow = missedWords.length - cap;
    for (const w of visible) {
      const li = document.createElement('li');
      li.textContent = w.word;
      li.className =
        'rounded-full border border-line bg-white px-4 py-2.5 font-word text-base font-semibold text-ink select-none';
      resultsMissedList.appendChild(li);
    }
    if (overflow > 0) {
      resultsMissedOverflow.textContent = `+${overflow} more`;
      resultsMissedOverflow.classList.remove('hidden');
    } else {
      resultsMissedOverflow.classList.add('hidden');
    }
  }

  function renderResults(): void {
    const result = state.result!;
    const missedCount = result.missedWords.length;
    const isPerfect = missedCount === 0;

    // Adaptive headline — perfect gets a fixed phrase; not-perfect rotates through
    // a pool so the same line doesn't land twice in a row across sessions.
    const resultsHeading = $('results-heading');
    if (isPerfect) {
      resultsHeading.textContent = 'You got every word.';
    } else {
      resultsHeading.textContent = pickPhrase(
        NOT_PERFECT_HEADLINES,
        lastNotPerfectHeadline,
        (i) => (lastNotPerfectHeadline = i),
      );
    }

    // Performance summary — no percentage, natural grammar
    if (isPerfect) {
      if (result.total === 1) {
        resultsSummary.textContent = 'You spelled the word correctly.';
      } else if (result.total === 2) {
        resultsSummary.textContent = 'You spelled both words correctly.';
      } else {
        resultsSummary.textContent = `You spelled all ${result.total} words correctly.`;
      }
    } else {
      const wordLabel = result.total === 1 ? 'word' : 'words';
      resultsSummary.textContent = `You spelled ${result.correct} of ${result.total} ${wordLabel} correctly.`;
    }

    // Reassurance line not used in the simplified two-state layout
    resultsReassurance.classList.add('hidden');

    // Rebuild action zone in the correct DOM order so keyboard and screen reader
    // order matches the visual primary-first hierarchy.
    resultsContent.className = 'flex flex-col gap-6';
    const actionZone = $('results-action-zone');
    while (actionZone.firstChild) actionZone.removeChild(actionZone.firstChild);

    if (isPerfect) {
      resultsMissedSection.classList.add('hidden');

      btnChooseList.className = PRIMARY_LINK_CLS;
      btnRetry.className = SECONDARY_BTN_CLS;
      btnRetry.textContent = 'Practice this list again';

      actionZone.appendChild(btnChooseList);
      actionZone.appendChild(btnRetry);

      showScreen(screenResults);
      requestAnimationFrame(() => btnChooseList.focus());

    } else {
      buildMissedChips(result.missedWords, result.missedWords.length);
      resultsMissedSection.classList.remove('hidden');
      resultsMissedHeading.textContent = 'Words to practice next.';

      btnRetry.className = PRIMARY_BTN_CLS;
      btnRetry.textContent = 'Practice this list again';
      btnChooseList.className = SECONDARY_BTN_CLS;

      actionZone.appendChild(btnRetry);
      actionZone.appendChild(btnChooseList);

      showScreen(screenResults);
      requestAnimationFrame(() => btnRetry.focus());
    }
  }

  // --- Event handlers ---
  function handleSubmit(): void {
    const answer = answerInput.value.trim();

    if (!answer) {
      answerError.textContent = 'Please type your answer.';
      answerInput.focus();
      return;
    }

    // Cancel any pending auto-sentence before showing feedback
    cancelPendingSentence();
    speech.cancelSpeech();

    state = spellingTestReducer(state, submitAnswer(answer, Date.now()));
    renderFeedback();
  }

  btnBegin.addEventListener('click', () => {
    state = spellingTestReducer(state, startTest(Date.now()));
    renderQuestion();
  });

  // Always re-speak the current word directly from state — never repeatWord(),
  // which would replay whatever was last spoken (could be a sentence).
  btnRepeat.addEventListener('click', () => {
    const word = state.words[state.currentIndex]?.word;
    if (word) {
      cancelPendingSentence();
      speech.cancelSpeech();
      speech.speakWord(word, speechOptions());
    }
  });

  btnSentence.addEventListener('click', () => {
    const sentence = state.words[state.currentIndex]?.exampleSentence;
    if (sentence) {
      cancelPendingSentence();
      speech.cancelSpeech();
      speech.speakWord(sentence, speechOptions());
    }
  });

  answerInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') handleSubmit();
  });

  btnSubmit.addEventListener('click', handleSubmit);

  function handleNext(): void {
    if (btnNext.disabled) return;
    if (nextWordDelayTimeout) {
      clearTimeout(nextWordDelayTimeout);
      nextWordDelayTimeout = null;
    }
    cancelPendingSentence();
    speech.cancelSpeech();
    state = spellingTestReducer(state, nextWord(Date.now()));
    if (state.status === 'awaitingAnswer') {
      renderQuestion();
    } else if (state.status === 'complete') {
      renderResults();
    }
  }

  btnNext.addEventListener('click', handleNext);

  // Right-arrow key advances from feedback screen — keeps hands on keyboard
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' && !screenFeedback.classList.contains('hidden')) {
      handleNext();
    }
  });

  btnRetry.addEventListener('click', () => {
    state = spellingTestReducer(resetTest(), initializeTest(originalRichWords));
    showScreen(screenBegin);
  });

  // --- Boot ---
  init();
</script>
