---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { SKILLS_INDEX_PATH } from '@/lib/content/canonicalSkillRoutes';
import {
  homepageGradeHubs,
  homepageJsonLd,
  HOMEPAGE_SKILL_COUNT,
  HOMEPAGE_REPRESENTATIVE_SKILLS,
} from '@/lib/content/homepage';

const placeholderText = 'lighthouse\nbeneath\nharvest';

// Rotating accent set — small, purposeful color, not a rainbow per-grade key.
// Written as full literal class strings so Tailwind's JIT scanner detects them.
const gradeAccentBorders = [
  'border-t-accent-coral',
  'border-t-accent-gold',
  'border-t-accent-teal',
  'border-t-accent-plum',
];
---

<Layout
  title="Free K–5 Spelling Practice by Grade or Skill, No Account | SpellingWords.app"
  description="Free spelling practice for K–5 students, with no account required. Practice your own words, or find structured curriculum practice by grade or spelling skill."
  jsonLd={homepageJsonLd}
>
  <SiteHeader currentPath="/" />

  <main id="main-content">

    <!-- ═══ HERO ════════════════════════════════════════════════ -->
    <section class="mx-auto max-w-content-xl px-6 py-14 md:py-20" aria-labelledby="hero-heading">
      <div class="grid items-center gap-10 md:grid-cols-[1.05fr_0.95fr] md:gap-16">

        <div>
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.06em] text-brand">
            Free · No account needed
          </p>
          <h1 id="hero-heading" class="text-display-xl mb-6">
            Practice <span class="text-accent-coral">spelling</span> your way.
          </h1>
          <p class="mb-8 max-w-content-sm text-body-lg text-ink-soft">
            Use your own words, follow a structured K–5 spelling curriculum, or explore a library
            of focused spelling skills. Free to use, with no account or login required.
          </p>
          <div class="mb-8 flex flex-wrap gap-3">
            <a href="/#grades" class="btn-primary">Browse by grade</a>
            <a href="/skills" class="btn-secondary">Browse by skill</a>
          </div>
          <ul class="flex flex-col gap-2.5">
            {['K–5 curriculum, built by grade', 'Works with your own word list', 'No login, no ads, no data games'].map((item) => (
              <li class="flex items-center gap-2.5 text-sm font-medium text-ink-soft">
                <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent-teal" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Word input panel — previews the same light practice family used
             on /play, not the dark "stage" surface. -->
        <div class="practice-panel p-7 md:p-8">
          <span class="practice-panel-accent" aria-hidden="true"></span>
          <p class="mb-1 text-xs font-bold uppercase tracking-[0.05em] text-brand">
            Practice your own words
          </p>
          <label for="word-input" class="mb-3 block text-sm font-semibold text-ink">
            Type or paste a list — one word per line
          </label>

          <textarea
            id="word-input"
            rows="4"
            class="practice-input resize-none px-4 py-3.5 text-base leading-[1.7] tracking-[0.01em]"
            spellcheck="false"
            autocomplete="off"
            aria-label="Your spelling words, one per line"
            placeholder={placeholderText}
          ></textarea>

          <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
            <button
              id="btn-start"
              type="button"
              class="btn-action px-6 py-3 min-h-[44px] text-sm"
              aria-label="Start a spelling practice session"
            >
              Start this list <span aria-hidden="true">→</span>
            </button>
            <span
              id="word-count-pill"
              class="text-xs font-bold text-ink-soft"
              aria-live="polite"
              aria-atomic="true"
            >
              0 words
            </span>
          </div>

          <p id="input-status" class="mt-2 text-xs font-medium text-ink-soft" aria-live="polite" aria-atomic="true">
            Add at least 1 word to start practicing.
          </p>
        </div>

      </div>
    </section>

    <!-- ═══ BROWSE BY GRADE ═════════════════════════════════════ -->
    <section id="grades" class="mx-auto max-w-content-xl px-6 py-14 scroll-mt-[72px] md:py-16" aria-labelledby="grade-heading">
      <div class="mb-8 max-w-content-md">
        <h2 id="grade-heading" class="text-display-lg mb-2">Browse by Grade</h2>
        <p class="text-body text-ink-soft">
          Every grade combines Core Spelling, High-Frequency Words, and Themed Spelling Practice —
          an organized Kindergarten–5th Grade path tied to what kids are learning in class.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-3" role="list" aria-label="Grade levels">
        {homepageGradeHubs.map(({ href, label, teaser }, index) => (
          <a
            href={href}
            class={`reveal card-interactive flex flex-col overflow-hidden border-t-4 ${gradeAccentBorders[index % gradeAccentBorders.length]}`}
            role="listitem"
          >
            <div class="flex flex-col gap-1 p-5">
              <span class="font-display text-xl font-semibold leading-tight tracking-tight text-ink">
                {label}
              </span>
              <span class="text-sm font-medium leading-snug text-ink-soft">
                {teaser}
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ═══ BROWSE BY SKILL ═════════════════════════════════════ -->
    <section id="skills" class="bg-canvas-sunken py-14 scroll-mt-[72px] md:py-16" aria-labelledby="skill-heading">
      <div class="mx-auto max-w-content-xl px-6">
        <div class="mb-6 max-w-content-md">
          <h2 id="skill-heading" class="text-display-lg mb-2">Browse by Skill</h2>
          <p class="text-body text-ink-soft">
            Prefer to practice a specific pattern instead of a full grade? Explore {HOMEPAGE_SKILL_COUNT} spelling
            skills, from {HOMEPAGE_REPRESENTATIVE_SKILLS[0]} and {HOMEPAGE_REPRESENTATIVE_SKILLS[1]} to {HOMEPAGE_REPRESENTATIVE_SKILLS[2]}, {HOMEPAGE_REPRESENTATIVE_SKILLS[3]}, {HOMEPAGE_REPRESENTATIVE_SKILLS[4]}, and {HOMEPAGE_REPRESENTATIVE_SKILLS[5]}.
          </p>
        </div>
        <a href={SKILLS_INDEX_PATH} class="btn-primary">See all spelling skills <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- ═══ CLOSING ══════════════════════════════════════════════ -->
    <section id="how-it-works" class="border-t border-border py-12 md:py-14" aria-labelledby="trust-heading">
      <div class="reveal mx-auto max-w-content-sm px-6 text-center">
        <h2 id="trust-heading" class="text-display-lg mb-4">More than a list of spelling words</h2>
        <p class="text-body text-ink-soft">
          SpellingWords.app brings a structured K–5 spelling curriculum, a library of focused
          spelling skills, and space to practice a student's own words together in one place —
          organized by spelling patterns and high-frequency words, not a random list to memorize.
          Parents and teachers get an organized path to follow, and students get calm, focused
          practice. It's free, with no account required, and there are no timers, points, or
          competitions.
        </p>
      </div>
    </section>

  </main>

  <SiteFooter />

  <script>
    import { parseWordInput, encodeWordList } from '@/lib/words';

    const textarea = document.getElementById('word-input') as HTMLTextAreaElement;
    const pill     = document.getElementById('word-count-pill')!;
    const status   = document.getElementById('input-status')!;
    const btn      = document.getElementById('btn-start') as HTMLButtonElement;

    function getWords(): string[] {
      return parseWordInput(textarea.value);
    }

    function updateStatus(): void {
      const words = getWords();
      const count = words.length;

      pill.textContent = `${count} ${count === 1 ? 'word' : 'words'}`;

      if (count === 0) {
        status.textContent = 'Add at least 1 word to start practicing.';
        btn.disabled = true;
      } else if (count > 200) {
        status.textContent = 'Maximum 200 words. Please remove some words.';
        btn.disabled = true;
      } else {
        status.textContent = `${count} ${count === 1 ? 'word' : 'words'} ready to practice.`;
        btn.disabled = false;
      }
    }

    function handleStart(): void {
      const words = getWords();
      if (words.length === 0 || words.length > 200) return;

      const result = encodeWordList(words);
      if (!result.ok) {
        status.textContent =
          result.code === 'payload_too_long'
            ? 'Word list is too long to encode. Please shorten some words.'
            : 'Could not create test. Please check your word list.';
        return;
      }

      window.location.href = `/play?list=${result.payload}`;
    }

    textarea.addEventListener('input', updateStatus);
    btn.addEventListener('click', handleStart);
    updateStatus();

    // Scroll-triggered reveal, reusing the shared .reveal/.is-visible utility
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) {
          (e.target as HTMLElement).classList.add('is-visible');
          io.unobserve(e.target);
        }
      }),
      { threshold: 0.1 }
    );

    document.querySelectorAll('.reveal').forEach((el, i) => {
      (el as HTMLElement).style.transitionDelay = `${(i % 6) * 0.05}s`;
      io.observe(el);
    });
  </script>

</Layout>
