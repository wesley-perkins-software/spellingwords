---
import { getCollection } from 'astro:content';
import { getCanonicalGradeRoutes, getCanonicalGradeRouteByPath, getCanonicalListPath, getGradeHubPath } from '@/lib/content/canonicalGradeRoutes';
import Layout from '@/layouts/Layout.astro';
import { getCanonicalUrl } from '@/lib/canonicalUrl';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import WordListPreview from '@/components/WordListPreview.astro';
import RelatedListCards from '@/components/RelatedListCards.astro';
import SourceAttribution from '@/components/SourceAttribution.astro';
import GradeUnitWorldPage from '@/components/GradeUnitWorldPage.astro';
import {
  isPublished,
  resolveListRefs,
  dedupeRelatedLists,
  toPlayableWords,
} from '@/lib/content/spellingLists';
import { getSequenceNeighbors } from '@/lib/content/navigationSequence';
import { categoryLabels, cardAccent } from '@/lib/content/categoryMeta';
import { getKindergartenRoadmapPosition } from '@/lib/content/kindergartenProgression';
import { gradeConfig } from '@/lib/content/gradeConfig';

export async function getStaticPaths() {
  const entries = (await getCollection('spelling-lists')).filter(isPublished);
  const entriesById = new Map(entries.map((entry) => [entry.data.id, entry]));

  return getCanonicalGradeRoutes().map((route) => {
    const entry = entriesById.get(route.id);
    if (!entry) throw new Error(`Canonical grade route ${route.id} does not resolve to a published spelling list.`);
    return {
      params: { gradeSlug: route.gradeSlug, slug: route.finalSlug },
      props: { entry, allEntries: entries },
    };
  });
}

const { entry, allEntries } = Astro.props;
const { data } = entry;

const { Content } = await entry.render();

// Review First / Next Step are derived from the canonical CORE_SPELLING_SEQUENCE /
// HF_WORDS_SEQUENCE arrays, not authored frontmatter — see
// docs/planning/CANONICAL_NAVIGATION_RELATIONSHIPS.md. Explore More
// (`relatedLists`) remains manually curated frontmatter.
const { prerequisiteId, nextId } = getSequenceNeighbors(data.id);
const prerequisites = resolveListRefs(prerequisiteId ? [prerequisiteId] : [], allEntries);
const next = resolveListRefs(nextId ? [nextId] : [], allEntries);
const related = dedupeRelatedLists(prerequisites, resolveListRefs(data.relatedLists, allEntries), next);

const playWords = toPlayableWords(entry);
const playWordsJson = JSON.stringify(playWords);

function listLink(e: (typeof allEntries)[number]) {
  return getCanonicalListPath(e.data);
}

const categoryLabel = categoryLabels[data.category] ?? data.category;
const route = getCanonicalGradeRouteByPath(Astro.params.gradeSlug!, Astro.params.slug!);
if (!route) throw new Error(`No canonical grade route for ${Astro.params.gradeSlug}/${Astro.params.slug}`);

const gradeHubForBreadcrumb = gradeConfig.find((g) => g.grade === route.grade);
if (!gradeHubForBreadcrumb) throw new Error(`No grade hub for grade ${route.grade}`);
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: gradeHubForBreadcrumb.label, href: getGradeHubPath(route.grade) },
  { label: data.title },
];

const canonicalURL = getCanonicalUrl(Astro.url.pathname, Astro.site);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};

const faqJsonLd =
  data.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: data.faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : null;

const jsonLdBlocks = [breadcrumbJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])];

const roleDisplay = data.contentRole === 'skill' ? 'Skill' : null;
const gradeDisplay =
  data.contentRole === 'skill'
    ? null
    : data.grade
      ? data.grade === 'K'
        ? 'Kindergarten'
        : `Grade ${data.grade}`
      : null;

const isSkill = data.contentRole === 'skill';
const isGradeUnit = data.contentRole === 'grade-unit';
// A Grade Unit adopts the sequencing-page presentation (roadmap step, word
// sentences, Skill callout cards) only once it declares at least one
// canonical Skill. This keeps un-migrated grade-unit pages rendering exactly
// as before.
const isContractUnit = isGradeUnit && data.skillIds.length > 0;

// "Kindergarten Spelling · Step N of M" context for core-progression Grade Units.
const roadmapPosition = isContractUnit ? getKindergartenRoadmapPosition(data.id) : undefined;
const gradeHub = gradeConfig.find((g) => g.grade === data.grade);

// Grade Unit → its canonical reusable Skill(s) ("Go deeper"). Zero, one, or
// several — a mixed-review unit may declare more than one.
const conceptSkills = isContractUnit
  ? data.skillIds
      .map((id) => allEntries.find((e) => e.data.id === id))
      .filter((entry): entry is (typeof allEntries)[number] => entry !== undefined)
  : [];

// Skill → the Grade Units that declare it in their skillIds ("Where this
// fits"). Computed here, not stored on the Skill — the Skill never lists its
// own placements.
// Placements are sorted into canonical K-5 order (gradeConfig) rather than
// left in whatever order the content collection happens to return them —
// without this, cards can appear out of grade sequence whenever a Skill is
// placed in more than one grade (e.g. a Kindergarten and a Grade 1 unit).
function gradeSortIndex(grade?: string): number {
  const index = gradeConfig.findIndex((g) => g.grade === grade);
  return index === -1 ? gradeConfig.length : index;
}

const curriculumPlacements = isSkill
  ? allEntries
      .filter((e) => e.data.skillIds.includes(data.id))
      .map((unit) => ({
        unit,
        position: getKindergartenRoadmapPosition(unit.data.id),
        gradeLabel: gradeConfig.find((g) => g.grade === unit.data.grade)?.label,
      }))
      .sort((a, b) => gradeSortIndex(a.unit.data.grade) - gradeSortIndex(b.unit.data.grade))
  : [];

const bodyHeading = isSkill
  ? 'Understanding the pattern'
  : 'Why these words — and what they teach';

const commonWordsSetTitle = data.contentRole === 'sight-word-set' &&
  (data.id.startsWith('kindergarten-common-words-') || data.id.startsWith('grade-1-common-words-'))
  ? `${data.grade === '1' ? data.title.replace('Grade 1', '1st Grade') : data.title} | Sight Words and Spelling`
  : undefined;

const easierList = prerequisites[0];
const harderList = next[0];
---

{isGradeUnit && <GradeUnitWorldPage listId={data.id} />}

{!isGradeUnit && (
<Layout
  title={commonWordsSetTitle ?? `${data.title} — spellingwords`}
  description={data.description}
  ogType="article"
  jsonLd={jsonLdBlocks}
>
  <SiteHeader variant="discovery" currentPath={getGradeHubPath(route.grade)} />

  <main id="main-content">
    <!-- Breadcrumbs -->
    <div class="mx-auto max-w-2xl px-5 pt-8 sm:px-6 md:max-w-3xl md:pt-10">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <!-- Hero band: what is this list? -->
    <section class="px-5 pb-10 pt-6 sm:px-6 md:pb-14 md:pt-8">
      <div class="mx-auto max-w-2xl md:max-w-3xl">
        <div
          class="relative overflow-hidden rounded-3xl border border-line bg-white px-6 py-8 shadow-card-lg sm:px-10 sm:py-10"
        >
          <div class={`absolute inset-x-0 top-0 h-1.5 ${cardAccent.bg}`} aria-hidden="true"></div>

          {
            roadmapPosition && gradeHub && (
              <p class="mb-3 text-sm font-semibold text-brand-blue">
                <a href={gradeHub.hubHref} class="hover:underline">
                  {gradeHub.label} Spelling
                </a>
                <span aria-hidden="true"> · </span>
                <span>
                  Step {roadmapPosition.step} of {roadmapPosition.total}
                </span>
              </p>
            )
          }

          <div class="flex flex-wrap items-center gap-2">
            {
              roleDisplay && (
                <span class="rounded-full bg-app-cloud px-3 py-1 text-sm font-semibold text-ink">
                  {roleDisplay}
                </span>
              )
            }
            {
              gradeDisplay && (
                <span class="rounded-full bg-app-cloud px-3 py-1 text-sm font-semibold text-ink">
                  {gradeDisplay}
                </span>
              )
            }
            <span
              class={`rounded-full px-3 py-1 text-sm font-semibold text-white ${cardAccent.bg} ${cardAccent.glow}`}
            >
              {categoryLabel}
            </span>
          </div>

          <h1 class="text-display-lg mt-3">{data.title}</h1>
          <p class="text-body-lg mt-3 max-w-2xl text-ink-soft">{data.description}</p>

          {
            !isSkill && (
              <div class="mt-8">
                <button
                  id="btn-practice"
                  type="button"
                  data-words={playWordsJson}
                  data-list-title={data.title}
                  class="btn-primary w-full px-9 py-4 text-base sm:w-auto"
                  aria-label={`Practice these ${playWords.length} words in ${data.title}`}
                >
                  Practice these words
                </button>
                <p
                  id="start-test-status"
                  class="mt-3 text-sm text-feedback-incorrect"
                  aria-live="polite"
                  aria-atomic="true"
                />
              </div>
            )
          }
        </div>
      </div>
    </section>

    <!-- Skill answer block: the extractable "What is …?" definition -->
    {
      isSkill && data.shortAnswer && (
        <section class="px-5 pb-10 sm:px-6 md:pb-14" aria-labelledby="answer-heading">
          <div class="mx-auto max-w-2xl md:max-w-3xl">
            <div class={`rounded-3xl bg-cream-deep px-6 py-6 sm:px-8 border-l-[3px] ${cardAccent.border}`}>
              <h2 id="answer-heading" class="font-display text-lg font-semibold text-ink">
                What are {data.title.toLowerCase()}?
              </h2>
              <p class="mt-2 text-base leading-relaxed text-ink-soft">{data.shortAnswer}</p>
            </div>
          </div>
        </section>
      )
    }

    <!-- Is this the right list? -->
    {
      data.readinessSignals.length > 0 && (
        <section
          class="bg-app-cloud px-5 py-10 sm:px-6 md:py-14"
          aria-labelledby="readiness-heading"
        >
          <div class="mx-auto max-w-2xl md:max-w-3xl">
            <h2 id="readiness-heading" class="font-display text-lg font-semibold text-ink">
              These spelling words are a good fit for students who...
            </h2>
            <ul class="mt-4 space-y-3 text-base leading-relaxed text-ink-soft">
              {data.readinessSignals.map((signal) => (
                <li class="flex items-start gap-2.5">
                  <span aria-hidden="true" class="mt-0.5 flex-shrink-0 text-brand-blue">
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </span>
                  <span>{signal}</span>
                </li>
              ))}
            </ul>
            {(easierList || harderList) && (
              <p class="mt-4 text-base leading-relaxed text-ink-soft">
                {easierList && (
                  <>
                    Too much too soon?{' '}
                    <a
                      href={listLink(easierList)}
                      class="font-semibold text-brand-blue hover:underline"
                    >
                      {easierList.data.title}
                    </a>{' '}
                    is a gentler starting point.{' '}
                  </>
                )}
                {harderList && (
                  <>
                    Moving through it easily?{' '}
                    <a
                      href={listLink(harderList)}
                      class="font-semibold text-brand-blue hover:underline"
                    >
                      {harderList.data.title}
                    </a>{' '}
                    is a natural next step.
                  </>
                )}
              </p>
            )}
          </div>
        </section>
      )
    }

    <!-- Word list -->
    <section class="px-5 py-10 sm:px-6 md:py-14" aria-labelledby="word-list-heading">
      <div class="mx-auto max-w-2xl md:max-w-3xl">
        <h2 id="word-list-heading" class="mb-4 font-display text-lg font-semibold text-ink">
          {
            isSkill
              ? 'Hear the pattern in these words'
              : isContractUnit
                ? `The ${data.words.length} words to practice in this step`
                : `All ${data.words.length} words in this list`
          }
        </h2>
        <WordListPreview words={playWords} accentClass={cardAccent.bg} showSentences={isContractUnit} />
      </div>
    </section>

    <!-- Why these words were chosen / what children learn (markdown body) -->
    <section class="bg-cream-deep px-5 py-12 sm:px-6 md:py-16" aria-labelledby="why-heading">
      <div class="mx-auto max-w-2xl md:max-w-3xl">
        <div class={`border-l-[3px] pl-5 sm:pl-6 ${cardAccent.border}`}>
          <h2 class="text-display-md">{bodyHeading}</h2>
          <div
            class="text-body-lg [&_strong]:font-semibold [&_strong]:text-ink mt-4 max-w-2xl space-y-5 text-ink-soft sm:space-y-6 [&_table]:block [&_table]:max-w-full [&_table]:overflow-x-auto"
          >
            <Content />
          </div>
        </div>
      </div>
    </section>

    <!-- Grade Unit → canonical Skill(s): the "go deeper" recommendation(s) -->
    {
      conceptSkills.length > 0 && (
        <section class="px-5 py-10 sm:px-6 md:py-14" aria-labelledby="concept-skill-heading">
          <div class="mx-auto max-w-2xl md:max-w-3xl">
            <h2 id="concept-skill-heading" class="mb-3 font-display text-lg font-semibold text-ink">
              {conceptSkills.length > 1 ? 'Go deeper on these patterns' : 'Go deeper on this pattern'}
            </h2>
            <div class="flex flex-col gap-3">
              {conceptSkills.map((conceptSkill) => (
                <a
                  href={listLink(conceptSkill)}
                  class="relative block overflow-hidden rounded-3xl border border-line bg-white px-6 py-5 shadow-card transition before:absolute before:inset-y-0 before:left-0 before:w-1.5 before:bg-brand-blue before:content-[''] hover:-translate-y-0.5 hover:shadow-card-md"
                >
                  <span class="block font-display text-lg font-semibold text-brand-blue">
                    Learn more about {conceptSkill.data.title.replace(/ Words$/i, '')} →
                  </span>
                  <span class="mt-1 block text-sm leading-relaxed text-ink-soft sm:text-base">
                    {conceptSkill.data.title} is the full guide to this pattern — how it works, what
                    trips children up, and where else it's taught.
                  </span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Skill → Grade Units: the only route from here into assigned practice -->
    {
      curriculumPlacements.length > 0 && (
        <section
          class="bg-app-cloud px-5 py-10 sm:px-6 md:py-14"
          aria-labelledby="curriculum-heading"
        >
          <div class="mx-auto max-w-2xl md:max-w-3xl">
            <h2 id="curriculum-heading" class="mb-2 font-display text-lg font-semibold text-ink">
              Where this fits in the curriculum
            </h2>
            <p class="mb-5 max-w-2xl text-base leading-relaxed text-ink-soft">
              This page explains the pattern — practice it in the grade-level lesson where it's
              taught:
            </p>
            <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap">
              {curriculumPlacements.map(({ unit, position, gradeLabel }) => (
                <a
                  href={listLink(unit)}
                  class="relative flex-1 overflow-hidden rounded-3xl border border-line bg-white py-4 pl-5 pr-4 shadow-card transition before:absolute before:inset-y-0 before:left-0 before:w-1.5 before:bg-brand-blue before:content-[''] hover:-translate-y-0.5 hover:shadow-card-md sm:flex-none sm:min-w-[16rem]"
                >
                  {(gradeLabel || position) && (
                    <span class="block text-sm font-semibold text-brand-blue">
                      {gradeLabel}
                      {gradeLabel && position && <span aria-hidden="true"> · </span>}
                      {position && `Step ${position.step} of ${position.total}`}
                    </span>
                  )}
                  <span class="mt-0.5 block font-display text-base font-semibold text-ink">
                    {unit.data.title}
                  </span>
                  <span class="mt-1 block text-sm font-semibold text-brand-blue">
                    {unit.data.words.length} words to practice →
                  </span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- FAQ -->
    {
      data.faq.length > 0 && (
        <section class="px-5 py-10 sm:px-6 md:py-14" aria-labelledby="faq-heading">
          <div class="mx-auto max-w-2xl md:max-w-3xl">
            <h2 id="faq-heading" class="mb-4 font-display text-lg font-semibold text-ink">
              Frequently asked questions
            </h2>
            <div class="overflow-hidden rounded-3xl border border-line bg-white shadow-card">
              <div class="divide-y divide-line/60 px-6 sm:px-7">
                {data.faq.map((item) => (
                  <div class="py-5">
                    <h3 class="font-display text-base font-semibold text-ink">{item.question}</h3>
                    <p class="mt-2 text-base leading-relaxed text-ink-soft">{item.answer}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>
      )
    }

    <!-- Learning progression -->
    {
      (prerequisites.length > 0 || related.length > 0 || next.length > 0) && (
        <section
          class="bg-app-cloud px-5 py-10 sm:px-6 md:py-14"
          aria-labelledby="progression-heading"
        >
          <div class="mx-auto max-w-2xl md:max-w-3xl">
            <h2 id="progression-heading" class="mb-4 font-display text-lg font-semibold text-ink">
              Where to Go From Here
            </h2>
            <RelatedListCards
              heading="Review First"
              items={prerequisites}
              listLink={listLink}
              accent="previous"
            />
            <RelatedListCards
              heading="Next Step"
              items={next}
              listLink={listLink}
              accent="forward"
            />
            <RelatedListCards heading="Explore More" items={related} listLink={listLink} />
          </div>
        </section>
      )
    }

    {
      data.canonicalSource && (
        <div class="mx-auto max-w-2xl px-5 py-8 sm:px-6 md:max-w-3xl">
          <SourceAttribution source={data.canonicalSource} />
        </div>
      )
    }
  </main>

  <SiteFooter />
</Layout>
)}

<script>
  import { encodeWordList } from '@/lib/words';

  interface SpellingWordData {
    word: string;
    hint?: string;
    exampleSentence?: string;
    phonicsPattern?: string[];
  }

  const statusEl = document.getElementById('start-test-status');

  function getSpellingWords(button: HTMLButtonElement): SpellingWordData[] {
    try {
      const parsed: unknown = JSON.parse(button.dataset.words ?? '[]');
      if (!Array.isArray(parsed)) return [];
      return parsed.filter(
        (e): e is SpellingWordData =>
          typeof e === 'object' && e !== null && typeof (e as SpellingWordData).word === 'string',
      );
    } catch {
      return [];
    }
  }

  function handleStart(event: Event): void {
    const button = event.currentTarget as HTMLButtonElement;
    const words = getSpellingWords(button);
    if (words.length === 0) return;

    const result = encodeWordList(words.map((w) => w.word));
    if (!result.ok) {
      if (statusEl) {
        statusEl.textContent =
          result.code === 'payload_too_long'
            ? 'There are too many words to start automatically. Please try a shorter list.'
            : 'Could not start this spelling test. Please try again.';
      }
      return;
    }

    // Persist rich word data (with exampleSentence etc.) so play.astro can read it.
    const listTitle = button.dataset.listTitle ?? '';
    try {
      sessionStorage.setItem(`sw:words:${result.payload}`, JSON.stringify(words));
      if (listTitle) sessionStorage.setItem(`sw:title:${result.payload}`, listTitle);
    } catch {
      /* quota exceeded or private browsing — non-fatal */
    }

    window.location.href = `/play?list=${result.payload}`;
  }

  document.getElementById('btn-practice')?.addEventListener('click', handleStart);
</script>
