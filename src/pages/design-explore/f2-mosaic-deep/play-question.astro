---
import Layout from './_Layout.astro';
---

<Layout title="Practice">
  <header class="explore-f2__header">
    <div class="explore-f2__header-inner">
      <span class="explore-f2__wordmark" style="font-size: 15px;">spelling<span class="accent">words</span></span>
      <a href="#" style="font-size: 14px; font-weight: 700; color: var(--ink-soft); text-decoration: none;">← New list</a>
    </div>
  </header>

  <main class="wrap wrap--narrow" style="padding: 12px 24px 64px; display: flex; flex-direction: column; gap: 26px;">
    <section style="display: flex; align-items: center; gap: 14px;">
      <span class="badge" style="background: var(--ink);">Word 3 / 10</span>
      <div style="flex: 1; height: 6px; background: #ececec; border-radius: 999px; overflow: hidden;">
        <div style="width: 30%; height: 100%; background: var(--grade-1);"></div>
      </div>
    </section>

    <div class="mosaic" style="grid-template-columns: 1fr;">
      <div class="tile" style="background: var(--grade-1); color: #241b02; padding: 28px 28px 18px;">
        <p style="opacity: 0.85; font-size: 14.5px; font-weight: 600;">Listen carefully and type what you hear.</p>
      </div>
      <div class="panel" style="padding: 22px 24px; display: flex; flex-direction: column; gap: 16px;">
        <input
          type="text"
          class="answer-input"
          placeholder="Type the word"
          style="width: 100%; background: var(--canvas); border: 1.5px solid var(--border); border-radius: 12px; padding: 15px 18px; font-family: var(--font-word); font-size: 26px; font-weight: 700; color: var(--ink);"
        />
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <button type="button" class="btn btn--ghost" style="background: var(--grade-1); border-color: var(--grade-1); color: #241b02;">🔊 Hear word again</button>
          <button type="button" class="btn btn--ghost" style="background: var(--grade-1); border-color: var(--grade-1); color: #241b02;">💬 Hear sentence again</button>
        </div>
      </div>
    </div>

    <button type="button" class="btn btn--primary" style="width: 100%; padding: 16px;">
      Submit Answer
    </button>

    <section>
      <p style="font-size: 12px; font-weight: 700; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 12px;">Feedback state — correct</p>
      <div class="tile" style="background: var(--correct); padding: 34px 28px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12px;">
        <span style="width: 38px; height: 38px; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; color: var(--correct); font-weight: 800;">✓</span>
        <span style="font-family: var(--font-word); font-weight: 700; font-size: 36px; color: #fff;">cake</span>
        <p style="opacity: 0.9; font-size: 14px; color: #fff;">Well spelled.</p>
      </div>
    </section>
  </main>
</Layout>
