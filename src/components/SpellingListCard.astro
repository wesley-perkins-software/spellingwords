---
import ListMetadataBadges from '@/components/ListMetadataBadges.astro';
import { categoryLabels } from '@/lib/content/categoryMeta';

interface Props {
  href: string;
  category: string;
  title: string;
  description: string;
  difficulty?: string;
  durationMinutes?: number;
  wordCount?: number;
  /** Overrides the category-derived badge label when set (e.g. "Spelling Rules"). */
  badge?: string;
  /** Hides the category badge when the parent context already supplies the useful public classification. */
  showCategoryBadge?: boolean;
}

const { href, category, title, description, difficulty, durationMinutes, wordCount, badge, showCategoryBadge = true } = Astro.props;
const categoryLabel = badge ?? (categoryLabels[category as keyof typeof categoryLabels] ?? category);
---

<a
  href={href}
  class="flex flex-col gap-3 rounded-2xl border border-border bg-white p-5 shadow-card transition hover:-translate-y-0.5 hover:shadow-card-md hover:border-border-strong"
>
  <div class="flex flex-col gap-1">
    {showCategoryBadge && <div class="flex items-center gap-2">
      <span class="rounded-md bg-canvas-sunken px-2 py-0.5 text-xs font-medium text-ink-soft">
        {categoryLabel}
      </span>
    </div>}
    <h3 class="mt-1 font-display text-base font-semibold text-ink">{title}</h3>
    <p class="text-sm leading-relaxed text-ink-soft">{description}</p>
  </div>
  {difficulty && durationMinutes !== undefined && wordCount !== undefined && (
    <ListMetadataBadges
      difficulty={difficulty}
      durationMinutes={durationMinutes}
      wordCount={wordCount}
    />
  )}
</a>
