---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SpellingListCard from '@/components/SpellingListCard.astro';
import { isPublished } from '@/lib/content/spellingLists';

const entries = (await getCollection('spelling-lists')).filter(isPublished);
const phonicsLists = entries
  .filter((e) => e.data.category === 'phonics')
  .sort((a, b) => a.data.order - b.data.order);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Spelling Lists Library', href: '/spelling-lists' },
  { label: 'Phonics' },
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://spellingwords.app');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Phonics Spelling Lists',
  numberOfItems: phonicsLists.length,
  itemListElement: phonicsLists.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`/spelling-lists/phonics/${e.data.urlSlug}`, canonicalURL.origin).toString(),
    name: e.data.title,
  })),
};
---

<Layout
  title="Phonics Spelling Lists | spellingwords.app"
  description="Free phonics spelling lists organized by sound-letter pattern — short vowels, silent E, vowel teams, blends, and digraphs. Calm, audio-supported spelling practice."
  jsonLd={[breadcrumbJsonLd, itemListJsonLd]}
>
  <SiteHeader variant="discovery" currentPath="/spelling-lists" />

  <main id="main-content">
    <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
      <div class="mb-6">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <!-- Hero -->
      <div class="mb-10 flex flex-col gap-4">
        <h1 class="font-display text-2xl font-semibold text-ink md:text-3xl">
          Phonics Spelling Lists
        </h1>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">
          Phonics spelling lists focus on sound-letter patterns — short vowels, long vowels, silent
          E, vowel teams, consonant blends, and digraphs. They are useful when a child needs
          practice with how words are built, not just which words to memorize.
        </p>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">
          These lists follow a phonics progression: early lists cover simple CVC patterns and short
          vowels; later lists introduce blends, digraphs, silent E, and vowel teams. If you know
          which pattern a child is working on, you can jump straight to that list. If you're not
          sure, starting with short vowels and moving forward works well. All lists include audio
          support so children can hear each word before they type it.
        </p>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">
          Phonics lists are not tied to a specific grade. A second grader still practicing short
          vowels and a kindergartner ready for blends can both find the right starting point here.
        </p>
      </div>

      <!-- Lists -->
      {phonicsLists.length === 0 ? (
        <div class="rounded-2xl border border-line bg-app-cloud p-8 text-center">
          <p class="text-base text-ink-soft">
            Phonics lists are being prepared. Check back soon, or{' '}
            <a href="/spelling-lists" class="font-semibold text-brand-blue hover:underline">
              browse the full library
            </a>{' '}
            in the meantime.
          </p>
        </div>
      ) : (
        <section aria-labelledby="lists-heading" class="mb-12">
          <h2 id="lists-heading" class="mb-4 font-display text-lg font-semibold text-ink">
            All Phonics Lists
            <span class="ml-2 text-sm font-normal text-ink-faint">
              {phonicsLists.length} {phonicsLists.length === 1 ? 'list' : 'lists'}
            </span>
          </h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {phonicsLists.map((entry) => (
              <SpellingListCard
                href={`/spelling-lists/${entry.data.category}/${entry.data.urlSlug}`}
                category={entry.data.category}
                title={entry.data.title}
                description={entry.data.description}
                difficulty={entry.data.difficulty}
                durationMinutes={entry.data.estimatedDurationMinutes}
                wordCount={entry.data.words.length}
              />
            ))}
          </div>
        </section>
      )}

      <!-- Guidance -->
      {phonicsLists.length > 1 && (
        <section aria-labelledby="guidance-heading" class="mb-12 rounded-2xl border border-line bg-app-cloud p-6">
          <h2 id="guidance-heading" class="mb-2 font-display text-base font-semibold text-ink">
            How to choose a phonics list
          </h2>
          <p class="text-sm leading-relaxed text-ink-soft">
            The lists are arranged in a typical phonics teaching sequence. Start with{' '}
            <strong class="font-semibold text-ink">short vowels and CVC words</strong> if a child
            is just learning how letters make sounds. Move on to{' '}
            <strong class="font-semibold text-ink">consonant blends and digraphs</strong> once
            short vowels feel solid. <strong class="font-semibold text-ink">Silent E</strong> and{' '}
            <strong class="font-semibold text-ink">vowel teams</strong> come next. If you already
            know which pattern needs practice, pick that list directly — there is no need to work
            through every list in order.
          </p>
        </section>
      )}

      <!-- Related categories -->
      <nav aria-label="Related spelling list categories" class="mb-10">
        <p class="mb-3 text-sm font-semibold text-ink">Explore other categories</p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/spelling-lists/sight-words"
            class="inline-flex items-center rounded-xl border border-line bg-white px-4 py-2 text-sm font-medium text-ink-soft transition hover:border-brand-blue/40 hover:text-brand-blue"
          >
            Sight Words
          </a>
          <a
            href="/spelling-lists/grade-level"
            class="inline-flex items-center rounded-xl border border-line bg-white px-4 py-2 text-sm font-medium text-ink-soft transition hover:border-brand-blue/40 hover:text-brand-blue"
          >
            Grade-Level
          </a>
          <a
            href="/spelling-lists/challenge"
            class="inline-flex items-center rounded-xl border border-line bg-white px-4 py-2 text-sm font-medium text-ink-soft transition hover:border-brand-blue/40 hover:text-brand-blue"
          >
            Challenge
          </a>
        </div>
      </nav>

      <!-- Back to library -->
      <p>
        <a
          href="/spelling-lists"
          class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
        >
          ← Back to the Spelling Lists Library
        </a>
      </p>
    </div>
  </main>

  <SiteFooter />
</Layout>
