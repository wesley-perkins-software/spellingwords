---
// TEMPORARY diagnostic panel for the Chrome voice-selection regression
// investigation. Always rendered by `play.astro` (so it's present on
// Netlify deploy previews, which build in production mode), but inert for
// every normal visitor: its own script checks
// isVoiceDiagnosticsEnabled() — a runtime `?voiceDiagnostics=1` opt-in — and
// removes itself immediately if that isn't set, before touching
// speechSynthesis or doing any other work. Safe to delete this whole file,
// its `src/modules/speech/devDiagnostics.ts` companion, and the one
// `<VoiceDiagnosticsPanel />` render in `play.astro` once the regression is
// diagnosed and resolved.
---

<div
  id="voice-diagnostics-panel"
  class="hidden fixed bottom-3 right-3 z-[999] max-h-[85vh] w-[min(560px,calc(100vw-1.5rem))] overflow-hidden rounded-xl border-2 border-amber-500 bg-white text-xs text-slate-900 shadow-2xl"
>
  <button
    id="vd-toggle"
    type="button"
    class="flex w-full items-center justify-between gap-2 bg-amber-500 px-3 py-2 font-bold text-slate-900"
  >
    <span>🔊 Voice diagnostics</span>
    <span id="vd-toggle-caret" aria-hidden="true">▲</span>
  </button>

  <div id="vd-body" class="max-h-[calc(85vh-2.25rem)] overflow-y-auto p-3">
    <p id="vd-ua" class="mb-2 break-all font-mono text-[0.7rem] text-slate-600"></p>

    <div class="mb-2 flex flex-wrap items-center gap-2">
      <button
        id="vd-refresh"
        type="button"
        class="rounded border border-slate-400 bg-slate-100 px-2 py-1 font-bold hover:bg-slate-200"
      >
        Refresh getVoices()
      </button>
      <span id="vd-list-changed" class="font-bold text-amber-700"></span>
    </div>

    <table class="w-full border-collapse text-left text-[0.72rem]">
      <thead>
        <tr class="border-b border-slate-300">
          <th class="py-1 pr-2">#</th>
          <th class="py-1 pr-2">Score</th>
          <th class="py-1 pr-2">Name</th>
          <th class="py-1 pr-2">Lang</th>
          <th class="py-1 pr-2">Local</th>
          <th class="py-1 pr-2">Default</th>
          <th class="py-1 pr-2">voiceURI</th>
          <th class="py-1 pr-2">Reasons</th>
          <th class="py-1">Test</th>
        </tr>
      </thead>
      <tbody id="vd-voice-rows"></tbody>
    </table>

    <h3 class="mb-1 mt-4 font-bold">Event log (timing + selection at each speakWord() call)</h3>
    <div class="mb-1 flex gap-2">
      <button
        id="vd-clear-log"
        type="button"
        class="rounded border border-slate-400 bg-slate-100 px-2 py-1 font-bold hover:bg-slate-200"
      >
        Clear log
      </button>
    </div>
    <pre
      id="vd-log"
      class="max-h-40 overflow-y-auto whitespace-pre-wrap rounded bg-slate-100 p-2 font-mono text-[0.68rem] leading-relaxed">
    </pre>

    <h3 class="mb-1 mt-4 font-bold">Play sample through a specific voice</h3>
    <div class="mb-1 flex flex-wrap items-center gap-2">
      <input
        id="vd-sample-text"
        type="text"
        value="elephant. The elephant walked slowly through the tall grass."
        class="min-w-0 flex-1 rounded border border-slate-400 px-2 py-1 font-mono text-[0.72rem]"
      />
    </div>
    <div id="vd-voice-tester" class="flex flex-col gap-1"></div>
  </div>
</div>

<script>
  import { rankVoices, type SpeechSynthesisVoiceAdapter } from '@/modules/speech';
  import {
    isVoiceDiagnosticsEnabled,
    onSpeechDiagnosticEvent,
    speechDiagnosticEvents,
  } from '@/modules/speech/devDiagnostics';

  // Runtime opt-in only (see the frontmatter comment above for why this
  // can't be an import.meta.env.DEV build-time gate). Bail out before
  // touching speechSynthesis or doing any other work for every normal
  // visitor who didn't pass ?voiceDiagnostics=1.
  if (!isVoiceDiagnosticsEnabled()) {
    document.getElementById('voice-diagnostics-panel')?.remove();
  } else {
    mountVoiceDiagnosticsPanel();
  }

  function mountVoiceDiagnosticsPanel(): void {
    document.getElementById('voice-diagnostics-panel')!.classList.remove('hidden');
    const body = document.getElementById('vd-body')!;
    const toggle = document.getElementById('vd-toggle')!;
    const toggleCaret = document.getElementById('vd-toggle-caret')!;
    const uaEl = document.getElementById('vd-ua')!;
    const refreshBtn = document.getElementById('vd-refresh')!;
    const listChangedEl = document.getElementById('vd-list-changed')!;
    const rowsEl = document.getElementById('vd-voice-rows')!;
    const logEl = document.getElementById('vd-log')!;
    const clearLogBtn = document.getElementById('vd-clear-log')!;
    const sampleTextInput = document.getElementById('vd-sample-text') as HTMLInputElement;
    const testerEl = document.getElementById('vd-voice-tester')!;

    uaEl.textContent = navigator.userAgent;
    logEl.textContent = ''; // clear whitespace prettier left between <pre> and </pre>

    toggle.addEventListener('click', () => {
      const collapsed = body.classList.toggle('hidden');
      toggleCaret.textContent = collapsed ? '▼' : '▲';
    });

    let previousNames: Set<string> = new Set();

    function appendLog(line: string): void {
      logEl.textContent += `${line}\n`;
      logEl.scrollTop = logEl.scrollHeight;
    }

    function renderVoices(source: string): void {
      const voices = window.speechSynthesis?.getVoices() ?? [];
      const ranked = rankVoices(voices as unknown as SpeechSynthesisVoiceAdapter[]);
      const currentNames = new Set(voices.map((v) => v.name));

      if (previousNames.size > 0) {
        const added = [...currentNames].filter((n) => !previousNames.has(n));
        const removed = [...previousNames].filter((n) => !currentNames.has(n));
        if (added.length || removed.length) {
          listChangedEl.textContent = `Voice list changed since last check: +${added.length} / -${removed.length}`;
          appendLog(
            `[${source}] voice list CHANGED — added: [${added.join(', ') || 'none'}], removed: [${removed.join(', ') || 'none'}]`,
          );
        } else {
          listChangedEl.textContent = '';
        }
      }
      previousNames = currentNames;

      appendLog(`[${source}] getVoices() → ${voices.length} voice(s)`);

      rowsEl.innerHTML = '';
      ranked.forEach(({ voice, score, reasons }, index) => {
        const raw = voice as unknown as { voiceURI?: string };
        const tr = document.createElement('tr');
        tr.className =
          index === 0 ? 'bg-emerald-100 border-b border-slate-200' : 'border-b border-slate-200';
        tr.innerHTML = `
        <td class="py-1 pr-2">${index + 1}</td>
        <td class="py-1 pr-2 font-mono">${score}</td>
        <td class="py-1 pr-2 font-bold">${voice.name}</td>
        <td class="py-1 pr-2">${voice.lang}</td>
        <td class="py-1 pr-2">${voice.localService}</td>
        <td class="py-1 pr-2">${voice.default}</td>
        <td class="py-1 pr-2 font-mono text-[0.65rem] text-slate-500">${raw.voiceURI ?? ''}</td>
        <td class="py-1 pr-2 text-slate-600">${reasons.join(', ')}</td>
        <td class="py-1"></td>
      `;
        const testCell = tr.lastElementChild as HTMLTableCellElement;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = '▶';
        btn.className = 'rounded border border-slate-400 bg-slate-100 px-2 hover:bg-slate-200';
        btn.addEventListener('click', () => speakWithVoice(voice));
        testCell.append(btn);
        rowsEl.append(tr);
      });

      testerEl.innerHTML = '';
      ranked
        .filter((r) => r.voice.lang.toLowerCase().startsWith('en'))
        .forEach(({ voice, score }) => {
          const row = document.createElement('button');
          row.type = 'button';
          row.className =
            'w-full rounded border border-slate-300 bg-white px-2 py-1 text-left hover:bg-amber-50';
          row.textContent = `▶ ${voice.name} (${voice.lang}) — score ${score}`;
          row.addEventListener('click', () => speakWithVoice(voice));
          testerEl.append(row);
        });
    }

    function speakWithVoice(voice: SpeechSynthesisVoiceAdapter): void {
      if (!window.speechSynthesis) return;
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(
        sampleTextInput.value || 'testing one two three',
      );
      utterance.voice = voice as unknown as SpeechSynthesisUtterance['voice'];
      utterance.lang = voice.lang;
      window.speechSynthesis.speak(utterance);
      appendLog(`[voice tester] played "${sampleTextInput.value}" through "${voice.name}"`);
    }

    refreshBtn.addEventListener('click', () => renderVoices('manual refresh'));
    clearLogBtn.addEventListener('click', () => {
      logEl.textContent = '';
    });

    // Replay any events recorded before this panel mounted (unlikely, but
    // keeps the log complete if mount order ever shifts).
    speechDiagnosticEvents.forEach((event) => logSpeechEvent(event));
    onSpeechDiagnosticEvent(logSpeechEvent);

    function logSpeechEvent(event: {
      timestamp: number;
      label: string;
      text: string;
      selectedVoice: SpeechSynthesisVoiceAdapter | null;
    }): void {
      const t = event.timestamp.toFixed(0).padStart(7);
      const voiceDesc = event.selectedVoice
        ? `"${event.selectedVoice.name}" (${event.selectedVoice.lang}, local=${event.selectedVoice.localService})`
        : 'null (browser default — no voice was assigned!)';
      appendLog(`[t=${t}ms] speakWord(${event.label}) "${event.text}" → voice: ${voiceDesc}`);
    }

    renderVoices('initial getVoices() at panel mount');
    window.speechSynthesis?.addEventListener('voiceschanged', () =>
      renderVoices('voiceschanged event'),
    );
  } // end mountVoiceDiagnosticsPanel
</script>
