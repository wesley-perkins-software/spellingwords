---
import Layout from './_Layout.astro';

const grades = [
  { g: 'K', color: 'var(--grade-k)', desc: 'First sounds, letters, and three-letter words.' },
  { g: '1', color: 'var(--grade-1)', desc: 'Silent e, letter teams, everyday high-frequency words.' },
  { g: '2', color: 'var(--grade-2)', desc: 'Blends, digraphs, and longer word families.' },
  { g: '3', color: 'var(--grade-3)', desc: 'Prefixes, suffixes, and multi-syllable patterns.' },
  { g: '4', color: 'var(--grade-4)', desc: 'Latin roots and more demanding spelling patterns.' },
  { g: '5', color: 'var(--grade-5)', desc: 'Advanced patterns getting students ready for middle school.' },
];

const skills = ['Short A Words', 'Long A Silent E Words', 'Soft C and Soft G', 'Consonant Blends', 'Silent Letters'];
---

<Layout title="Home" env="var(--brand)">
  <header class="explore-h__header">
    <div class="explore-h__header-inner">
      <span class="explore-h__wordmark">spelling<span class="accent">words</span></span>
      <nav class="explore-h__nav">
        <a href="#grades">Grades</a>
        <a href="#skills">Skills</a>
        <a href="#">How it works</a>
      </nav>
    </div>
  </header>

  <!-- The one arrival moment on this page: curved, saturated, unmistakable. -->
  <div class="arrival" style="padding: 46px 24px 64px;">
    <div class="wrap wrap--narrow" style="text-align: center; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 16px;">
      <span class="badge">Practice · Any List</span>
      <h1 style="font-size: clamp(30px, 4.4vw, 46px); line-height: 1.08;">
        Curved where you arrive. Square where you work.
      </h1>
      <p style="opacity: 0.92; font-size: 16px; max-width: 46ch; line-height: 1.6;">
        Paste your own list or follow a grade-level path. Hear each word, then type it.
      </p>
    </div>
  </div>

  <div class="wrap wrap--narrow" style="margin-top: -36px; position: relative; z-index: 2; padding: 0 24px;">
    <div class="panel" style="overflow: hidden; box-shadow: 0 20px 40px -20px rgba(214, 51, 108, 0.25);">
      <div style="display: flex; align-items: center; justify-content: space-between; padding: 15px 20px; border-bottom: 1px solid var(--border);">
        <span style="font-family: var(--font-display); font-weight: 800; font-size: 12.5px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-soft);">Your Words</span>
        <span style="font-size: 12px; font-weight: 800; background: var(--brand); color: #fff; padding: 4px 11px; border-radius: 999px;">0</span>
      </div>
      <textarea rows="3" placeholder="Type or paste your words here, one per line" style="width: 100%; border: none; resize: none; padding: 18px 20px; font-family: var(--font-word); font-size: 17px; color: var(--ink); background: transparent;"></textarea>
      <div style="padding: 14px 20px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end;">
        <button type="button" class="btn btn--primary">Start Practicing</button>
      </div>
    </div>
  </div>

  <main>
    <!-- Working content: rectilinear, even where color carries real wayfinding meaning. -->
    <section id="grades" class="wrap" style="padding: 56px 24px 20px;">
      <h2 style="font-size: 25px; margin-bottom: 8px;">Browse by Grade</h2>
      <p style="color: var(--ink-soft); max-width: 60ch; margin-bottom: 22px;">
        A Kindergarten&ndash;5th grade path. Grade color is navigation, not arrival — square, not curved.
      </p>
      <div class="grade-mosaic">
        {grades.map((item) => (
          <a href="#" class="tile" style={`background: ${item.color}; color: #fff; text-decoration: none; padding: 18px 16px; min-height: 120px; display: flex; flex-direction: column; justify-content: space-between;`}>
            <span style="font-family: var(--font-display); font-weight: 800; font-size: 28px; line-height: 1;">{item.g}</span>
            <p style="font-size: 12px; opacity: 0.95; line-height: 1.4;">{item.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="skills" class="wrap" style="padding: 34px 24px 60px;">
      <h2 style="font-size: 25px; margin-bottom: 8px;">Browse by Skill</h2>
      <p style="color: var(--ink-soft); max-width: 60ch; margin-bottom: 20px;">
        Already know what to work on? Explore 41 spelling skills, each with its own practice bank.
      </p>
      <div class="panel" style="max-width: 700px; overflow: hidden;">
        {skills.map((s, i) => (
          <a href="#" style={`display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; text-decoration: none; color: inherit; ${i < skills.length - 1 ? 'border-bottom: 1px solid var(--border);' : ''}`}>
            <span style="font-family: var(--font-display); font-weight: 700; font-size: 15.5px;">{s}</span>
            <span class="tag">Phonics</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <footer class="explore-h__footer">
    <div class="wrap">No accounts. No timers. Just spelling.</div>
  </footer>
</Layout>
