---
import { getCollection } from 'astro:content';
import { getCanonicalListPath } from '@/lib/content/canonicalGradeRoutes';
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SpellingListCard from '@/components/SpellingListCard.astro';
import {
  buildGradeHubSections,
  getListsByGrade,
  getMemberListIds,
  groupBySkillFamily,
  isPublished,
} from '@/lib/content/spellingLists';
import {
  buildGradeHubCards,
  GRADE_1_HUB_SECTIONS,
  GRADE_2_HUB_SECTIONS,
  GRADE_3_HUB_SECTIONS,
  GRADE_4_HUB_SECTIONS,
  GRADE_5_HUB_SECTIONS,
  KINDERGARTEN_HUB_SECTIONS,
} from '@/lib/content/gradeHubCards';
import { categoryLabels } from '@/lib/content/categoryMeta';
import { gradeConfig, getAdjacentGrades } from '@/lib/content/gradeConfig';
import { gradeHubCopy } from '@/lib/content/gradeHubCopy';
import type { GradeCode, GradeConfigEntry } from '@/lib/content/gradeConfig';

export async function getStaticPaths() {
  return gradeConfig.map((gradeEntry) => ({
    params: { gradeSlug: gradeEntry.slug },
    props: { gradeEntry },
  }));
}

/**
 * Grades with a hand-curated hub progression (Core Spelling / High-Frequency
 * Words / Additional Practice). Every other grade falls back to the generic
 * category-grouped renderer below. A Partial lookup here, rather than a
 * nested ternary, keeps this readable as more grades are curated.
 */
const CURATED_HUB_SECTIONS: Partial<Record<GradeCode, typeof KINDERGARTEN_HUB_SECTIONS>> = {
  K: KINDERGARTEN_HUB_SECTIONS,
  '1': GRADE_1_HUB_SECTIONS,
  '2': GRADE_2_HUB_SECTIONS,
  '3': GRADE_3_HUB_SECTIONS,
  '4': GRADE_4_HUB_SECTIONS,
  '5': GRADE_5_HUB_SECTIONS,
};

const { gradeEntry } = Astro.props as { gradeEntry: GradeConfigEntry };
const { grade, label } = gradeEntry;
const copy = gradeHubCopy[grade];
const { prev, next } = getAdjacentGrades(grade);

const allCollections = (await getCollection('spelling-collections')).filter(
  (c) => c.data.status === 'published',
);
const memberIds = getMemberListIds(allCollections);
const entries = (await getCollection('spelling-lists')).filter(isPublished);

const gradeLists = getListsByGrade(grade, entries).filter((e) => !memberIds.has(e.data.id));
const gradeCollections = allCollections.filter((c) => c.data.grade === grade);
const totalItems = gradeCollections.length + gradeLists.length;

const sections = buildGradeHubSections(gradeLists, gradeCollections);
const curatedDefinitions = CURATED_HUB_SECTIONS[grade];
const curatedSections = curatedDefinitions
  ? buildGradeHubCards(curatedDefinitions, entries, allCollections)
  : null;
const displayedItemCount = curatedSections
  ? curatedSections.reduce((count, section) => count + section.cards.length, 0)
  : totalItems;

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Learn by Grade', href: '/spelling-lists' },
  { label },
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://spellingwords.app');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};

let position = 0;
function toListItem(e: (typeof gradeLists)[number]) {
  return {
    '@type': 'ListItem',
    position: ++position,
    url: new URL(getCanonicalListPath(e.data), canonicalURL.origin).toString(),
    name: e.data.title,
  };
}
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${label} Spelling Word Lists`,
  numberOfItems: displayedItemCount,
  itemListElement: curatedSections
    ? curatedSections.flatMap(({ cards }) => cards.map((card) => ({
      '@type': 'ListItem',
      position: ++position,
      url: new URL(card.href, canonicalURL.origin).toString(),
      name: card.title,
    })))
    : sections.flatMap(({ collections, entries: sectionEntries }) => [
        ...collections.map((c) => ({
          '@type': 'ListItem',
          position: ++position,
          url: new URL(`/spelling-lists/collections/${c.data.urlSlug}`, canonicalURL.origin).toString(),
          name: c.data.title,
        })),
        ...sectionEntries.map(toListItem),
      ]),
};
---

<Layout
  title={`${label} Spelling Words | spellingwords.app`}
  description={copy.metaDescription}
  jsonLd={[breadcrumbJsonLd, itemListJsonLd]}
>
  <SiteHeader variant="discovery" currentPath={gradeEntry.hubHref} />

  <main id="main-content">
    <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
      <div class="mb-6">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <!-- Hero -->
      <div class="mb-10 flex flex-col gap-4">
        <h1 class="font-display text-2xl font-semibold text-ink md:text-3xl">
          {label} Spelling Words
        </h1>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">{copy.heroParagraphs[0]}</p>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">{copy.heroParagraphs[1]}</p>
      </div>

      <!-- Lists: Kindergarten and Grade 1 render curated curriculum progressions;
           every other grade groups by category, grade-level first. -->
      {displayedItemCount === 0 ? (
        <div class="rounded-2xl border border-line bg-app-cloud p-8 text-center">
          <p class="text-base text-ink-soft">
            {copy.emptyStateLabel} lists are being prepared. Check back soon, or{' '}
            <a href="/spelling-lists" class="font-semibold text-brand-blue hover:underline">
              browse the full library
            </a>{' '}
            in the meantime.
          </p>
        </div>
      ) : curatedSections ? (
        <div class="mb-12 flex flex-col gap-10">
          {curatedSections.map((section) => (
            <section class="flex flex-col gap-4" aria-labelledby={`grade-section-${section.title.toLowerCase().replaceAll(' ', '-')}`}>
              <div class="flex flex-wrap items-baseline gap-3">
                <h2
                  id={`grade-section-${section.title.toLowerCase().replaceAll(' ', '-')}`}
                  class="font-display text-lg font-semibold text-ink"
                >
                  {section.title}
                </h2>
                {section.summary ? (
                  <p class="max-w-2xl text-sm leading-relaxed text-ink-faint">{section.summary}</p>
                ) : (
                  <span class="text-sm text-ink-faint">
                    {section.cards.length} {section.cards.length === 1 ? 'card' : 'cards'}
                  </span>
                )}
              </div>
              <ol class="flex flex-col gap-4">
                {section.cards.map((card, index) => (
                  <li class="flex items-start gap-3">
                    <span
                      aria-hidden="true"
                      class="mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-blue/10 text-sm font-semibold text-brand-blue"
                    >
                      {index + 1}
                    </span>
                    <div class="flex-1">
                      <SpellingListCard
                        href={card.href}
                        category={card.category}
                        title={card.title}
                        description={card.description}
                        difficulty={card.difficulty}
                        durationMinutes={card.durationMinutes}
                        wordCount={card.wordCount}
                        badge={card.badge}
                      />
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      ) : (
        <div class="mb-12 flex flex-col gap-10">
          {sections.map(({ category, collections, entries: sectionEntries }, sectionIndex) => {
            const phonicsGroups = category === 'phonics' ? groupBySkillFamily(sectionEntries) : null;
            return (
            <section
              aria-labelledby={`category-${category}-heading`}
              class={sectionIndex === 0
                ? 'flex flex-col gap-4 rounded-2xl border border-brand-blue/15 bg-brand-blue/[0.04] p-5'
                : 'flex flex-col gap-4'}
            >
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <div class="flex items-baseline gap-3">
                  <h2 id={`category-${category}-heading`} class="font-display text-lg font-semibold text-ink">
                    {categoryLabels[category] ?? category}
                  </h2>
                  <span class="text-sm text-ink-faint">
                    {collections.length + sectionEntries.length}{' '}
                    {collections.length + sectionEntries.length === 1 ? 'list' : 'lists'}
                  </span>
                </div>
                <a
                  href={`/spelling-lists/${category}`}
                  class="text-sm font-semibold text-brand-blue hover:underline"
                >
                  See all {categoryLabels[category] ?? category} lists →
                </a>
              </div>
              {phonicsGroups ? (
                <div class="flex flex-col gap-6">
                  {collections.length > 0 && (
                    <div class="grid gap-4 sm:grid-cols-2">
                      {collections.map((c) => (
                        <a
                          href={`/spelling-lists/collections/${c.data.urlSlug}`}
                          class="flex flex-col gap-3 rounded-2xl border border-line bg-white p-5 shadow-[0_4px_16px_-6px_rgba(31,41,55,0.06)] transition hover:-translate-y-0.5 hover:shadow-[0_8px_22px_-8px_rgba(47,111,237,0.25)]"
                        >
                          <div class="flex flex-col gap-1">
                            <div class="flex items-center gap-2">
                              <span class="rounded-md bg-app-cloud px-2 py-0.5 text-xs font-medium text-ink-soft">
                                {categoryLabels[c.data.category] ?? c.data.category}
                              </span>
                              <span class="rounded-md bg-brand-blue/8 px-2 py-0.5 text-xs font-semibold text-brand-blue">
                                {c.data.listIds.length}-part collection
                              </span>
                            </div>
                            <h3 class="mt-1 font-display text-base font-semibold text-ink">{c.data.title}</h3>
                            <p class="text-sm leading-relaxed text-ink-soft">{c.data.description}</p>
                          </div>
                        </a>
                      ))}
                    </div>
                  )}
                  {phonicsGroups.map((group) => (
                    <div class="flex flex-col gap-3">
                      <h3
                        id={`category-${category}-${group.key}-heading`}
                        class="font-display text-sm font-semibold text-ink-soft"
                      >
                        {group.label}
                      </h3>
                      <div class="grid gap-4 sm:grid-cols-2">
                        {group.entries.map((entry) => (
                          <SpellingListCard
                            href={getCanonicalListPath(entry.data)}
                            category={entry.data.category}
                            title={entry.data.title}
                            description={entry.data.description}
                            difficulty={entry.data.difficulty}
                            durationMinutes={entry.data.estimatedDurationMinutes}
                            wordCount={entry.data.words.length}
                          />
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="grid gap-4 sm:grid-cols-2">
                  {collections.map((c) => (
                    <a
                      href={`/spelling-lists/collections/${c.data.urlSlug}`}
                      class="flex flex-col gap-3 rounded-2xl border border-line bg-white p-5 shadow-[0_4px_16px_-6px_rgba(31,41,55,0.06)] transition hover:-translate-y-0.5 hover:shadow-[0_8px_22px_-8px_rgba(47,111,237,0.25)]"
                    >
                      <div class="flex flex-col gap-1">
                        <div class="flex items-center gap-2">
                          <span class="rounded-md bg-app-cloud px-2 py-0.5 text-xs font-medium text-ink-soft">
                            {categoryLabels[c.data.category] ?? c.data.category}
                          </span>
                          <span class="rounded-md bg-brand-blue/8 px-2 py-0.5 text-xs font-semibold text-brand-blue">
                            {c.data.listIds.length}-part collection
                          </span>
                        </div>
                        <h3 class="mt-1 font-display text-base font-semibold text-ink">{c.data.title}</h3>
                        <p class="text-sm leading-relaxed text-ink-soft">{c.data.description}</p>
                      </div>
                    </a>
                  ))}
                  {sectionEntries.map((entry) => (
                    <SpellingListCard
                      href={getCanonicalListPath(entry.data)}
                      category={entry.data.category}
                      title={entry.data.title}
                      description={entry.data.description}
                      difficulty={entry.data.difficulty}
                      durationMinutes={entry.data.estimatedDurationMinutes}
                      wordCount={entry.data.words.length}
                    />
                  ))}
                </div>
              )}
            </section>
            );
          })}
        </div>
      )}

      <!-- Choosing guidance -->
      {displayedItemCount > 1 && (
        <section aria-labelledby="guidance-heading" class="mb-12 rounded-2xl border border-line bg-app-cloud p-6">
          <h2 id="guidance-heading" class="mb-2 font-display text-base font-semibold text-ink">
            How to choose a list
          </h2>
          <p class="text-sm leading-relaxed text-ink-soft">{copy.guidanceBody}</p>
        </section>
      )}

      <!-- Adjacent grade nav -->
      <nav aria-label="Adjacent grade levels" class="mb-10 flex items-center justify-between gap-4">
        {prev ? (
          <a
            href={prev.hubHref}
            class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
          >
            ← {prev.label} Spelling Words
          </a>
        ) : <span></span>}
        {next ? (
          <a
            href={next.hubHref}
            class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
          >
            {next.label} Spelling Words →
          </a>
        ) : <span></span>}
      </nav>

      <!-- Back to library -->
      <p>
        <a
          href="/spelling-lists"
          class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
        >
          ← Back to the Spelling Lists Library
        </a>
      </p>
    </div>
  </main>

  <SiteFooter />
</Layout>
