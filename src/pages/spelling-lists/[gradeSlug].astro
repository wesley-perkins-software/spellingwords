---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SpellingListCard from '@/components/SpellingListCard.astro';
import {
  buildGradeHubSections,
  getListsByGrade,
  getMemberListIds,
  groupBySkillFamily,
  isPublished,
} from '@/lib/content/spellingLists';
import { categoryLabels } from '@/lib/content/categoryMeta';
import { gradeConfig, getAdjacentGrades } from '@/lib/content/gradeConfig';
import { gradeHubCopy } from '@/lib/content/gradeHubCopy';
import type { GradeConfigEntry } from '@/lib/content/gradeConfig';

export async function getStaticPaths() {
  return gradeConfig.map((gradeEntry) => ({
    params: { gradeSlug: gradeEntry.slug },
    props: { gradeEntry },
  }));
}

const { gradeEntry } = Astro.props as { gradeEntry: GradeConfigEntry };
const { grade, label } = gradeEntry;
const copy = gradeHubCopy[grade];
const { prev, next } = getAdjacentGrades(grade);

const allCollections = (await getCollection('spelling-collections')).filter(
  (c) => c.data.status === 'published',
);
const memberIds = getMemberListIds(allCollections);
const entries = (await getCollection('spelling-lists')).filter(isPublished);

const gradeLists = getListsByGrade(grade, entries).filter((e) => !memberIds.has(e.data.id));
const gradeCollections = allCollections.filter((c) => c.data.grade === grade);
const totalItems = gradeCollections.length + gradeLists.length;

const sections = buildGradeHubSections(gradeLists, gradeCollections);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Spelling Lists Library', href: '/spelling-lists' },
  { label },
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://spellingwords.app');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};

let position = 0;
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${label} Spelling Word Lists`,
  numberOfItems: totalItems,
  itemListElement: sections.flatMap(({ collections, entries: sectionEntries }) => [
    ...collections.map((c) => ({
      '@type': 'ListItem',
      position: ++position,
      url: new URL(`/spelling-lists/collections/${c.data.urlSlug}`, canonicalURL.origin).toString(),
      name: c.data.title,
    })),
    ...sectionEntries.map((e) => ({
      '@type': 'ListItem',
      position: ++position,
      url: new URL(`/spelling-lists/${e.data.category}/${e.data.urlSlug}`, canonicalURL.origin).toString(),
      name: e.data.title,
    })),
  ]),
};
---

<Layout
  title={`${label} Spelling Words | spellingwords.app`}
  description={copy.metaDescription}
  jsonLd={[breadcrumbJsonLd, itemListJsonLd]}
>
  <SiteHeader variant="discovery" currentPath="/spelling-lists" />

  <main id="main-content">
    <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
      <div class="mb-6">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <!-- Hero -->
      <div class="mb-10 flex flex-col gap-4">
        <h1 class="font-display text-2xl font-semibold text-ink md:text-3xl">
          {label} Spelling Words
        </h1>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">{copy.heroParagraphs[0]}</p>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">{copy.heroParagraphs[1]}</p>
      </div>

      <!-- Lists, grouped by category with grade-level first -->
      {totalItems === 0 ? (
        <div class="rounded-2xl border border-line bg-app-cloud p-8 text-center">
          <p class="text-base text-ink-soft">
            {copy.emptyStateLabel} lists are being prepared. Check back soon, or{' '}
            <a href="/spelling-lists" class="font-semibold text-brand-blue hover:underline">
              browse the full library
            </a>{' '}
            in the meantime.
          </p>
        </div>
      ) : (
        <div class="mb-12 flex flex-col gap-10">
          {sections.map(({ category, collections, entries: sectionEntries }, sectionIndex) => {
            const phonicsGroups = category === 'phonics' ? groupBySkillFamily(sectionEntries) : null;
            return (
            <section
              aria-labelledby={`category-${category}-heading`}
              class={sectionIndex === 0
                ? 'flex flex-col gap-4 rounded-2xl border border-brand-blue/15 bg-brand-blue/[0.04] p-5'
                : 'flex flex-col gap-4'}
            >
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <div class="flex items-baseline gap-3">
                  <h2 id={`category-${category}-heading`} class="font-display text-lg font-semibold text-ink">
                    {categoryLabels[category] ?? category}
                  </h2>
                  <span class="text-sm text-ink-faint">
                    {collections.length + sectionEntries.length}{' '}
                    {collections.length + sectionEntries.length === 1 ? 'list' : 'lists'}
                  </span>
                </div>
                <a
                  href={`/spelling-lists/${category}`}
                  class="text-sm font-semibold text-brand-blue hover:underline"
                >
                  See all {categoryLabels[category] ?? category} lists →
                </a>
              </div>
              {phonicsGroups ? (
                <div class="flex flex-col gap-6">
                  {collections.length > 0 && (
                    <div class="grid gap-4 sm:grid-cols-2">
                      {collections.map((c) => (
                        <a
                          href={`/spelling-lists/collections/${c.data.urlSlug}`}
                          class="flex flex-col gap-3 rounded-2xl border border-line bg-white p-5 shadow-[0_4px_16px_-6px_rgba(31,41,55,0.06)] transition hover:-translate-y-0.5 hover:shadow-[0_8px_22px_-8px_rgba(47,111,237,0.25)]"
                        >
                          <div class="flex flex-col gap-1">
                            <div class="flex items-center gap-2">
                              <span class="rounded-md bg-app-cloud px-2 py-0.5 text-xs font-medium text-ink-soft">
                                {categoryLabels[c.data.category] ?? c.data.category}
                              </span>
                              <span class="rounded-md bg-brand-blue/8 px-2 py-0.5 text-xs font-semibold text-brand-blue">
                                {c.data.listIds.length}-part collection
                              </span>
                            </div>
                            <h3 class="mt-1 font-display text-base font-semibold text-ink">{c.data.title}</h3>
                            <p class="text-sm leading-relaxed text-ink-soft">{c.data.description}</p>
                          </div>
                        </a>
                      ))}
                    </div>
                  )}
                  {phonicsGroups.map((group) => (
                    <div class="flex flex-col gap-3">
                      <h3
                        id={`category-${category}-${group.key}-heading`}
                        class="font-display text-sm font-semibold text-ink-soft"
                      >
                        {group.label}
                      </h3>
                      <div class="grid gap-4 sm:grid-cols-2">
                        {group.entries.map((entry) => (
                          <SpellingListCard
                            href={`/spelling-lists/${entry.data.category}/${entry.data.urlSlug}`}
                            category={entry.data.category}
                            title={entry.data.title}
                            description={entry.data.description}
                            difficulty={entry.data.difficulty}
                            durationMinutes={entry.data.estimatedDurationMinutes}
                            wordCount={entry.data.words.length}
                          />
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="grid gap-4 sm:grid-cols-2">
                  {collections.map((c) => (
                    <a
                      href={`/spelling-lists/collections/${c.data.urlSlug}`}
                      class="flex flex-col gap-3 rounded-2xl border border-line bg-white p-5 shadow-[0_4px_16px_-6px_rgba(31,41,55,0.06)] transition hover:-translate-y-0.5 hover:shadow-[0_8px_22px_-8px_rgba(47,111,237,0.25)]"
                    >
                      <div class="flex flex-col gap-1">
                        <div class="flex items-center gap-2">
                          <span class="rounded-md bg-app-cloud px-2 py-0.5 text-xs font-medium text-ink-soft">
                            {categoryLabels[c.data.category] ?? c.data.category}
                          </span>
                          <span class="rounded-md bg-brand-blue/8 px-2 py-0.5 text-xs font-semibold text-brand-blue">
                            {c.data.listIds.length}-part collection
                          </span>
                        </div>
                        <h3 class="mt-1 font-display text-base font-semibold text-ink">{c.data.title}</h3>
                        <p class="text-sm leading-relaxed text-ink-soft">{c.data.description}</p>
                      </div>
                    </a>
                  ))}
                  {sectionEntries.map((entry) => (
                    <SpellingListCard
                      href={`/spelling-lists/${entry.data.category}/${entry.data.urlSlug}`}
                      category={entry.data.category}
                      title={entry.data.title}
                      description={entry.data.description}
                      difficulty={entry.data.difficulty}
                      durationMinutes={entry.data.estimatedDurationMinutes}
                      wordCount={entry.data.words.length}
                    />
                  ))}
                </div>
              )}
            </section>
            );
          })}
        </div>
      )}

      <!-- Choosing guidance -->
      {totalItems > 1 && (
        <section aria-labelledby="guidance-heading" class="mb-12 rounded-2xl border border-line bg-app-cloud p-6">
          <h2 id="guidance-heading" class="mb-2 font-display text-base font-semibold text-ink">
            How to choose a list
          </h2>
          <p class="text-sm leading-relaxed text-ink-soft">{copy.guidanceBody}</p>
        </section>
      )}

      <!-- Adjacent grade nav -->
      <nav aria-label="Adjacent grade levels" class="mb-10 flex items-center justify-between gap-4">
        {prev ? (
          <a
            href={prev.hubHref}
            class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
          >
            ← {prev.label} Spelling Words
          </a>
        ) : <span></span>}
        {next ? (
          <a
            href={next.hubHref}
            class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
          >
            {next.label} Spelling Words →
          </a>
        ) : <span></span>}
      </nav>

      <!-- Back to library -->
      <p>
        <a
          href="/spelling-lists"
          class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
        >
          ← Back to the Spelling Lists Library
        </a>
      </p>
    </div>
  </main>

  <SiteFooter />
</Layout>
