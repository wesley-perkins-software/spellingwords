      content: '+';
      display: inline-block;
      width: 1.1em;
      color: var(--skill-strong);
      font-weight: 700;
    }
    .faq-item[open] summary::before {
      content: '–';
    }

    .faq-item p {
      margin-top: 0.75rem;
      font-size: 0.92rem;
      line-height: 1.65;
      color: var(--ink-soft);
    }

    /* ---- desktop-only related-content rail ---- */
    .skill-side {
      position: sticky;
      top: 5.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .wordlist-card,
    .related-card {
      background: var(--canvas-raised);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      box-shadow: var(--shadow-sm);
    }

    .wordlist-card {
      border-top: 3px solid var(--practice-strong);
    }

    .related-card {
      border-top: 3px solid var(--skill-strong);
    }

    .wordlist-card h2,
    .related-card h2 {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--ink-faint);
      margin-bottom: 1rem;
      font-family: var(--font-body);
      font-weight: 700;
    }

    .wordlist {
      list-style: none;
      margin: 0 0 1.25rem;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .wordlist li {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      padding: 0.55rem 0.7rem;
      border-radius: var(--radius-sm);
      background: var(--canvas-sunken);
    }

    .wordlist-audio {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.8rem;
      height: 1.8rem;
      border-radius: 50%;
      background: var(--practice-strong);
      color: #fff;
      border: none;
      cursor: pointer;
      flex-shrink: 0;
    }

    .wordlist-word {
      font-family: var(--font-word);
      font-size: 1.05rem;
      font-weight: 500;
      color: var(--ink);
    }

    .wordlist-cta {
      width: 100%;
      padding: 0.75rem 1rem;
      font-size: 0.9rem;
    }

    .related-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .related-list a {
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--skill-strong);
      text-decoration: none;
      line-height: 1.4;
    }
    .related-list a:hover {
      text-decoration: underline;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      text-decoration: none;
      border-radius: var(--radius-pill);
      border: none;
      cursor: pointer;
    }
    .btn-practice {
      background: var(--practice-strong);
      color: #fff;
    }
    .btn-practice:hover {
      background: var(--practice-ink);
    }

    @media (max-width: 980px) {
      .skill-layout {
        grid-template-columns: 1fr;
      }
      .skill-side {
        position: static;
        flex-direction: row;
        flex-wrap: wrap;
      }
      .wordlist-card,
      .related-card {
        flex: 1 1 260px;
      }
    }

    @media (max-width: 640px) {
      .skill-side {
        flex-direction: column;
      }
    }
  </style>
</Proto>
