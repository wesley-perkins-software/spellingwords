---
import Proto from './_shared/Proto.astro';
import Header from './_shared/Header.astro';
import Footer from './_shared/Footer.astro';
---

<Proto
  title="Practice — Exploration B"
  description="Design exploration B: static visual mock of the spelling practice loop, including correct and incorrect feedback states."
>
  <Header currentPath="/design-explore/exploration-b/practice.html" />

  <main id="main">
    <div class="wrap page">
      <p class="practice-eyebrow">Soft C and Soft G &middot; Word 3 of 6</p>

      <!-- ============ ACTIVE QUESTION STATE ============ -->
      <section class="stage" aria-labelledby="stage-heading">
        <h1 id="stage-heading" class="visually-hidden">Spelling practice</h1>

        <div class="progress-row" role="group" aria-label="Progress: word 3 of 6">
          <ol class="progress-bar">
            <li class="is-done" aria-label="Word 1, answered correctly"></li>
            <li class="is-done" aria-label="Word 2, answered correctly"></li>
            <li class="is-current" aria-current="step" aria-label="Word 3, current"></li>
            <li aria-label="Word 4, not yet answered"></li>
            <li aria-label="Word 5, not yet answered"></li>
            <li aria-label="Word 6, not yet answered"></li>
          </ol>
          <span class="progress-label">3 of 6</span>
        </div>

        <div class="stage-audio">
          <button type="button" class="audio-btn-primary" aria-label="Play the word">
            <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true">
              <path d="M5 9v6h4l5 5V4L9 9H5z" fill="currentColor" /><path
                d="M17.5 8.5a5 5 0 0 1 0 7"
                stroke="currentColor"
                stroke-width="1.8"
                fill="none"
                stroke-linecap="round"
              /><path
                d="M20 6.5a8.5 8.5 0 0 1 0 11"
                stroke="currentColor"
                stroke-width="1.8"
                fill="none"
                stroke-linecap="round"
                opacity="0.55"
              /></svg
            >
          </button>
          <p class="stage-audio-caption">Listen, then type the word you hear</p>
        </div>

        <form class="stage-form" aria-label="Type the word">
          <label class="visually-hidden" for="answer-input">Type the word you hear</label>
          <input
            id="answer-input"
            class="stage-input"
            type="text"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            placeholder="Type what you hear"
            value="giant"
          />
          <div class="stage-actions">
            <button type="button" class="btn btn-ghost-stage">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path
                  d="M4 9v6h4l5 5V4L8 9H4z"
                  fill="currentColor"
                /><path
                  d="M16.5 8.5a5 5 0 0 1 0 7"
                  stroke="currentColor"
                  stroke-width="1.8"
                  fill="none"
                  stroke-linecap="round"
                /></svg
              >
              Hear it again
            </button>
            <button type="submit" class="btn btn-primary-stage">Check my spelling</button>
          </div>
        </form>
      </section>

      <!-- ============ FEEDBACK STATE EXAMPLES ============ -->
      <section class="state-examples" aria-labelledby="state-examples-heading">
        <h2 id="state-examples-heading">Feedback states</h2>
        <p class="state-examples-note">
          Static examples of the two feedback states this stage can show, shown here side by side
          for review — feedback appears inline in the card, right beside the input, not as a
          full-screen color wash.
        </p>

        <div class="state-grid">
          <!-- CORRECT -->
          <div class="state-card is-correct">
            <p class="state-card-label">Correct</p>
            <div class="mini-stage">
              <div class="mini-audio-row">
                <span class="mini-audio-btn" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <path d="M5 9v6h4l5 5V4L9 9H5z" fill="currentColor" />
                  </svg>
                </span>
                <span class="mini-word">page</span>
              </div>
              <div class="mini-input-row">
                <input
                  class="mini-input is-correct"
                  type="text"
                  value="page"
                  readonly
                  aria-describedby="correct-feedback-msg"
                />
                <span class="mini-status-icon is-correct" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18">
                    <path
                      d="M5 13l4 4 10-10"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </div>
              <p id="correct-feedback-msg" class="mini-feedback is-correct">
                <strong>Correct.</strong> Soft g, right before the silent e.
              </p>
            </div>
          </div>

          <!-- INCORRECT -->
          <div class="state-card is-incorrect">
            <p class="state-card-label">Needs another look</p>
            <div class="mini-stage">
              <div class="mini-audio-row">
                <span class="mini-audio-btn" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <path d="M5 9v6h4l5 5V4L9 9H5z" fill="currentColor" />
                  </svg>
                </span>
                <span class="mini-word">gym</span>
              </div>
              <div class="mini-input-row">
                <input
                  class="mini-input is-incorrect"
                  type="text"
                  value="jim"
                  readonly
                  aria-describedby="incorrect-feedback-msg"
                />
                <span class="mini-status-icon is-incorrect" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18">
                    <path
                      d="M6 6l12 12M18 6L6 18"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                    />
                  </svg>
                </span>
              </div>
              <p id="incorrect-feedback-msg" class="mini-feedback is-incorrect">
                <strong>Not quite.</strong> The word is spelled <strong>gym</strong> — soft g
                before y, spelled with a g, not a j.
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />

  <style>
    .page {
      padding-block: clamp(2rem, 5vw, 3rem) clamp(3rem, 6vw, 5rem);
      max-width: 760px;
    }

    .practice-eyebrow {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--ink-faint);
      margin-bottom: 1.25rem;
      text-align: center;
    }

    /* ============ MAIN STAGE ============ */
    .stage {
      background: var(--canvas-raised);
      color: var(--ink);
      border-radius: var(--radius-lg);
      border-top: 8px solid var(--coral);
      padding: clamp(2rem, 5vw, 3rem) clamp(1.5rem, 5vw, 3.5rem);
      box-shadow: var(--shadow-card);
      text-align: center;
    }

    .progress-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.9rem;
      margin-bottom: 2.25rem;
    }

    .progress-bar {
      display: flex;
      gap: 0.4rem;
      list-style: none;
      margin: 0;
      padding: 0;
      width: 100%;
      max-width: 320px;
    }

    .progress-bar li {
      height: 8px;
      flex: 1;
      border-radius: 999px;
      background: var(--canvas-sunken);
    }

    .progress-bar li.is-done {
      background: var(--teal-bright);
    }

    .progress-bar li.is-current {
      background: var(--coral);
      box-shadow: 0 0 0 3px var(--coral-tint);
    }

    .progress-label {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--ink-faint);
      flex-shrink: 0;
    }

    .stage-audio {
      margin-bottom: 2.25rem;
    }

    .audio-btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 5.5rem;
      height: 5.5rem;
      border-radius: 50%;
      background: var(--teal);
      color: var(--ink-on-teal);
      border: none;
      cursor: pointer;
      transition:
        transform 0.12s ease,
        background 0.15s ease;
    }
    .audio-btn-primary:hover {
      background: var(--teal-strong);
      transform: scale(1.03);
    }

    .stage-audio-caption {
      margin-top: 1rem;
      font-size: 0.92rem;
      color: var(--ink-soft);
      font-weight: 500;
    }

    .stage-form {
      max-width: 420px;
      margin-inline: auto;
    }

    .stage-input {
      width: 100%;
      text-align: center;
      background: var(--canvas-sunken);
      border: 2px solid var(--border);
      border-radius: var(--radius-md);
      color: var(--ink);
      font-family: var(--font-word);
      font-size: 1.6rem;
      font-weight: 500;
      letter-spacing: 0.02em;
      padding: 0.9rem 1rem;
    }

    .stage-input:focus-visible {
      outline-color: var(--coral);
      border-color: transparent;
    }

    .stage-actions {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.9rem;
      margin-top: 1.5rem;
    }

    .btn {
      font-family: inherit;
      cursor: pointer;
    }

    .btn-ghost-stage {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: transparent;
      color: var(--ink-soft);
      border: none;
      font-weight: 600;
      font-size: 0.9rem;
      padding: 0.4rem;
    }
    .btn-ghost-stage:hover {
      color: var(--teal);
    }

    .btn-primary-stage {
      background: var(--coral-strong);
      color: #fff;
      border: none;
      font-weight: 700;
      font-size: 1rem;
      padding: 0.9rem 2.5rem;
      border-radius: var(--radius-btn);
      transition: background 0.15s ease;
    }
    .btn-primary-stage:hover {
      background: var(--coral-strong-hover);
    }

    /* ============ STATE EXAMPLES ============ */
    .state-examples {
      margin-top: 3.5rem;
    }

    .state-examples h2 {
      font-size: 1.15rem;
      margin-bottom: 0.5rem;
      text-align: center;
      color: var(--teal-strong);
    }

    .state-examples-note {
      font-size: 0.9rem;
      color: var(--ink-faint);
      text-align: center;
      max-width: 56ch;
      margin: 0 auto 1.75rem;
      line-height: 1.55;
    }

    .state-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .state-card {
      background: var(--canvas-raised);
      border-radius: var(--radius-lg);
      padding: 1.25rem;
      box-shadow: var(--shadow-sm);
      border-top: 5px solid var(--border);
    }
    .state-card.is-correct {
      border-top-color: var(--correct-ink);
    }
    .state-card.is-incorrect {
      border-top-color: var(--incorrect-ink);
    }

    .state-card-label {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 0.9rem;
    }

    .mini-stage {
      background: var(--canvas-band-cool);
      border-radius: var(--radius-md);
      padding: 1.25rem;
    }

    .mini-audio-row {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      margin-bottom: 1rem;
    }

    .mini-audio-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.2rem;
      height: 2.2rem;
      border-radius: 50%;
      background: var(--teal);
      color: #fff;
      flex-shrink: 0;
    }

    .mini-word {
      font-family: var(--font-word);
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--ink-faint);
    }

    .mini-input-row {
      position: relative;
      margin-bottom: 0.85rem;
    }

    .mini-input {
      width: 100%;
      font-family: var(--font-word);
      font-size: 1.25rem;
      font-weight: 500;
      padding: 0.65rem 2.6rem 0.65rem 0.9rem;
      border-radius: var(--radius-sm);
      background: var(--canvas-raised);
    }

    .mini-input.is-correct {
      border: 2px solid var(--correct-border);
      color: var(--correct-ink);
    }

    .mini-input.is-incorrect {
      border: 2px solid var(--incorrect-border);
      color: var(--incorrect-ink);
      text-decoration: line-through;
      text-decoration-thickness: 1.5px;
    }

    .mini-status-icon {
      position: absolute;
      right: 0.7rem;
      top: 50%;
      transform: translateY(-50%);
      display: inline-flex;
    }
    .mini-status-icon.is-correct {
      color: var(--correct-ink);
    }
    .mini-status-icon.is-incorrect {
      color: var(--incorrect-ink);
    }

    .mini-feedback {
      font-size: 0.86rem;
      line-height: 1.5;
      border-radius: var(--radius-sm);
      padding: 0.65rem 0.85rem;
      margin: 0;
    }
    .mini-feedback.is-correct {
      background: var(--correct-bg);
      color: var(--correct-ink);
    }
    .mini-feedback.is-incorrect {
      background: var(--incorrect-bg);
      color: var(--incorrect-ink);
    }

    @media (max-width: 640px) {
      .state-grid {
        grid-template-columns: 1fr;
      }
      .stage-input {
        font-size: 1.3rem;
      }
    }
  </style>
</Proto>
