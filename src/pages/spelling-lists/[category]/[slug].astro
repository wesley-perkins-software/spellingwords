---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import WordListPreview from '@/components/WordListPreview.astro';
import RelatedListCards from '@/components/RelatedListCards.astro';
import SourceAttribution from '@/components/SourceAttribution.astro';
import {
  isPublished,
  resolveListRefs,
  dedupeRelatedLists,
  toPlayableWords,
  getListCollection,
} from '@/lib/content/spellingLists';
import { categoryLabels, cardAccent } from '@/lib/content/categoryMeta';
import { getListPath } from '@/lib/content/learningPaths';

export async function getStaticPaths() {
  const entries = (await getCollection('spelling-lists')).filter(isPublished);
  const allCollections = await getCollection('spelling-collections');

  return entries.map((entry) => ({
    params: { category: entry.data.category, slug: entry.data.urlSlug },
    props: { entry, allEntries: entries, allCollections },
  }));
}

const { entry, allEntries, allCollections } = Astro.props;
const { data } = entry;

const { Content } = await entry.render();

const prerequisites = resolveListRefs(data.prerequisiteLists, allEntries);
const next = resolveListRefs(data.nextLists, allEntries);
const related = dedupeRelatedLists(prerequisites, resolveListRefs(data.relatedLists, allEntries), next);

const playWords = toPlayableWords(entry);
const playWordsJson = JSON.stringify(playWords);

function listLink(e: (typeof allEntries)[number]) {
  return `/spelling-lists/${e.data.category}/${e.data.urlSlug}`;
}

const categoryLabel = categoryLabels[data.category] ?? data.category;
const listPath = getListPath(data.id);
const listCollection = getListCollection(data.id, allCollections);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Spelling Lists Library', href: '/spelling-lists' },
  { label: categoryLabel, href: `/spelling-lists/${data.category}` },
  { label: data.title },
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://spellingwords.app');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};

const faqJsonLd =
  data.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: data.faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : null;

const jsonLdBlocks = [breadcrumbJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])];

const gradeDisplay = data.grade
  ? data.grade === 'K'
    ? 'Kindergarten'
    : `Grade ${data.grade}`
  : null;

const easierList = prerequisites[0];
const harderList = next[0];
---

<Layout
  title={`${data.title} — spellingwords`}
  description={data.description}
  ogType="article"
  jsonLd={jsonLdBlocks}
>
  <SiteHeader variant="discovery" currentPath="/spelling-lists" />

  <main id="main-content">
    <!-- Breadcrumbs -->
    <div class="mx-auto max-w-2xl px-5 pt-8 sm:px-6 md:max-w-3xl md:pt-10">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <!-- Hero band: what is this list? -->
    <section class="px-5 pb-10 pt-6 sm:px-6 md:pb-14 md:pt-8">
      <div class="mx-auto max-w-2xl md:max-w-3xl">
        <div
          class="relative overflow-hidden rounded-3xl border border-line bg-white px-6 py-9 shadow-card-lg sm:px-10 sm:py-12"
        >
          <div class={`absolute inset-x-0 top-0 h-1.5 ${cardAccent.bg}`} aria-hidden="true"></div>
          <div
            class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-brand-blue/[0.05] blur-2xl sm:h-72 sm:w-72"
            aria-hidden="true"
          >
          </div>

          <div class="relative flex flex-wrap items-center gap-2">
            {
              gradeDisplay && (
                <span class="rounded-full bg-app-cloud px-3 py-1 text-sm font-semibold text-ink">
                  {gradeDisplay}
                </span>
              )
            }
            <span
              class={`rounded-full px-3 py-1 text-sm font-semibold text-white ${cardAccent.bg} ${cardAccent.glow}`}
            >
              {categoryLabel}
            </span>
          </div>

          <h1 class="text-display-lg relative mt-4">{data.title}</h1>
          <p class="text-body-lg relative mt-3 max-w-2xl text-ink-soft">{data.description}</p>

          <div class="relative mt-8">
            <button
              id="btn-practice"
              type="button"
              data-words={playWordsJson}
              data-list-title={data.title}
              class="btn-primary w-full px-9 py-4 text-base sm:w-auto"
              aria-label={`Practice these ${playWords.length} words in ${data.title}`}
            >
              Practice these words
            </button>
            <p
              id="start-test-status"
              class="mt-3 text-sm text-feedback-incorrect"
              aria-live="polite"
              aria-atomic="true"
            >
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Is this the right list? -->
    {
      data.readinessSignals.length > 0 && (
        <section class="px-5 pb-10 sm:px-6 md:pb-14" aria-labelledby="readiness-heading">
          <div class="mx-auto max-w-2xl md:max-w-3xl">
            <div class="rounded-3xl border border-line bg-app-cloud px-6 py-8 sm:px-9 sm:py-9">
              <h2 id="readiness-heading" class="font-display text-lg font-semibold text-ink">
                These spelling words are a good fit for students who...
              </h2>
              <ul class="mt-4 space-y-3 text-base leading-relaxed text-ink-soft">
                {data.readinessSignals.map((signal) => (
                  <li class="flex items-start gap-2.5">
                    <span aria-hidden="true" class="mt-0.5 flex-shrink-0 text-brand-blue">
                      <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </span>
                    <span>{signal}</span>
                  </li>
                ))}
              </ul>
              {(easierList || harderList) && (
                <p class="mt-4 text-base leading-relaxed text-ink-soft">
                  {easierList && (
                    <>
                      Too much too soon?{' '}
                      <a
                        href={listLink(easierList)}
                        class="font-semibold text-brand-blue hover:underline"
                      >
                        {easierList.data.title}
                      </a>{' '}
                      is a gentler starting point.{' '}
                    </>
                  )}
                  {harderList && (
                    <>
                      Moving through it easily?{' '}
                      <a
                        href={listLink(harderList)}
                        class="font-semibold text-brand-blue hover:underline"
                      >
                        {harderList.data.title}
                      </a>{' '}
                      is a natural next step.
                    </>
                  )}
                </p>
              )}
            </div>
          </div>
        </section>
      )
    }

    <!-- Word list -->
    <section class="px-5 py-10 sm:px-6 md:py-14" aria-labelledby="word-list-heading">
      <div class="mx-auto max-w-2xl md:max-w-3xl">
        <h2 id="word-list-heading" class="mb-4 font-display text-lg font-semibold text-ink">
          All {data.words.length} words in this list
        </h2>
        <WordListPreview words={playWords} accentClass={cardAccent.bg} />
      </div>
    </section>

    <!-- Why these words were chosen / what children learn (markdown body) -->
    <section class="px-5 py-10 sm:px-6 md:py-14" aria-labelledby="why-heading">
      <div class="mx-auto max-w-2xl md:max-w-3xl">
        <div class="overflow-hidden rounded-3xl border border-line bg-cream-deep/60 px-6 py-9 sm:px-10 sm:py-12">
          <div class={`border-l-[3px] pl-5 sm:pl-6 ${cardAccent.border}`}>
            <h2 class="text-display-md">Why these words — and what they teach</h2>
            <div
              class="text-body-lg [&_strong]:font-semibold [&_strong]:text-ink mt-4 max-w-2xl space-y-5 text-ink-soft sm:space-y-6"
            >
              <Content />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    {
      data.faq.length > 0 && (
        <section class="px-5 py-10 sm:px-6 md:py-14" aria-labelledby="faq-heading">
          <div class="mx-auto max-w-2xl md:max-w-3xl">
            <h2 id="faq-heading" class="mb-4 font-display text-lg font-semibold text-ink">
              Frequently asked questions
            </h2>
            <div class="overflow-hidden rounded-3xl border border-line bg-white shadow-card-lg">
              <div class="divide-y divide-line/60 px-6 sm:px-7">
                {data.faq.map((item) => (
                  <div class="py-6">
                    <h3 class="font-display text-base font-semibold text-ink sm:text-lg">
                      {item.question}
                    </h3>
                    <p class="mt-2 text-base leading-relaxed text-ink-soft">{item.answer}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>
      )
    }

    <!-- Learning progression -->
    {
      (prerequisites.length > 0 || related.length > 0 || next.length > 0) && (
        <section class="px-5 py-10 sm:px-6 md:py-14" aria-labelledby="progression-heading">
          <div class="mx-auto max-w-2xl md:max-w-3xl">
            <div class="rounded-3xl border border-line bg-white px-6 py-9 shadow-card sm:px-9 sm:py-11">
              <h2 id="progression-heading" class="text-display-md">
                What's next
              </h2>
              {(listCollection || listPath) && (
                <p class="mt-2 text-base text-ink-soft">
                  {listCollection && (
                    <>
                      Part of the{' '}
                      <a
                        href={`/spelling-lists/collections/${listCollection.data.urlSlug}`}
                        class="font-semibold text-brand-blue hover:underline"
                      >
                        {listCollection.data.title}
                      </a>{' '}
                      collection.
                    </>
                  )}
                  {listPath && (
                    <>
                      {' '}
                      Part of the{' '}
                      <a
                        href={`/learning-paths/${listPath.id}`}
                        class="font-semibold text-brand-blue hover:underline"
                      >
                        {listPath.title}
                      </a>
                      .
                    </>
                  )}
                </p>
              )}
              <div class="mt-8 space-y-8">
                <RelatedListCards
                  heading="Review first"
                  items={prerequisites}
                  listLink={listLink}
                  accent="previous"
                />
                <RelatedListCards
                  heading="Also worth practicing"
                  items={related}
                  listLink={listLink}
                />
                <RelatedListCards
                  heading="Ready for next"
                  items={next}
                  listLink={listLink}
                  accent="forward"
                />
              </div>
            </div>
          </div>
        </section>
      )
    }

    {
      data.canonicalSource && (
        <div class="mx-auto max-w-2xl px-5 py-8 sm:px-6 md:max-w-3xl">
          <SourceAttribution source={data.canonicalSource} />
        </div>
      )
    }
  </main>

  <SiteFooter />
</Layout>

<script>
  import { encodeWordList } from '@/lib/words';

  interface SpellingWordData {
    word: string;
    hint?: string;
    exampleSentence?: string;
    phonicsPattern?: string[];
  }

  const statusEl = document.getElementById('start-test-status');

  function getSpellingWords(button: HTMLButtonElement): SpellingWordData[] {
    try {
      const parsed: unknown = JSON.parse(button.dataset.words ?? '[]');
      if (!Array.isArray(parsed)) return [];
      return parsed.filter(
        (e): e is SpellingWordData =>
          typeof e === 'object' && e !== null && typeof (e as SpellingWordData).word === 'string',
      );
    } catch {
      return [];
    }
  }

  function handleStart(event: Event): void {
    const button = event.currentTarget as HTMLButtonElement;
    const words = getSpellingWords(button);
    if (words.length === 0) return;

    const result = encodeWordList(words.map((w) => w.word));
    if (!result.ok) {
      if (statusEl) {
        statusEl.textContent =
          result.code === 'payload_too_long'
            ? 'There are too many words to start automatically. Please try a shorter list.'
            : 'Could not start this spelling test. Please try again.';
      }
      return;
    }

    // Persist rich word data (with exampleSentence etc.) so play.astro can read it.
    const listTitle = button.dataset.listTitle ?? '';
    try {
      sessionStorage.setItem(`sw:words:${result.payload}`, JSON.stringify(words));
      if (listTitle) sessionStorage.setItem(`sw:title:${result.payload}`, listTitle);
    } catch {
      /* quota exceeded or private browsing — non-fatal */
    }

    window.location.href = `/play?list=${result.payload}`;
  }

  document.getElementById('btn-practice')?.addEventListener('click', handleStart);
</script>
