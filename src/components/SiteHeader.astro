---
interface Props {
  variant?: 'discovery' | 'practice';
  currentPath?: string;
}

const { variant = 'discovery', currentPath = '' } = Astro.props;

const isActive = (path: string) => currentPath.startsWith(path);
---

{variant === 'discovery' ? (
  <header class="sticky top-0 z-10 border-b border-line bg-app-paper/95 backdrop-blur-sm">
    <div class="mx-auto flex max-w-content-xl items-center justify-between px-6 py-3.5">

      <a
        href="/"
        class="flex items-center gap-1.5 font-display text-[21px] font-semibold text-ink tracking-tight transition-colors hover:text-ink"
        aria-label="spellingwords home"
      >
        <span
          class="inline-block h-2 w-2 flex-shrink-0 rounded-full bg-brand-red"
          style="position: relative; top: 1px;"
          aria-hidden="true"
        ></span>
        spelling<span class="text-brand-red">words</span>
      </a>

      <nav aria-label="Site navigation">
        <ul class="flex items-center gap-0.5 list-none m-0 p-0">
          <li>
            <a
              href="/spelling-lists"
              class={`rounded-full px-4 py-2 text-sm font-bold transition hover:bg-app-cloud ${isActive('/spelling-lists') ? 'text-ink' : 'text-ink-soft hover:text-ink'}`}
              aria-current={isActive('/spelling-lists') ? 'page' : undefined}
            >
              Spelling Lists
            </a>
          </li>
          <li>
            <a
              href="/#how-it-works"
              class="rounded-full px-4 py-2 text-sm font-bold text-ink-soft transition hover:bg-app-cloud hover:text-ink"
            >
              How it Works
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </header>
) : (
  <header class="sticky top-0 z-10 border-b border-line bg-app-paper/95 backdrop-blur-sm">
    <div class="mx-auto flex max-w-content-lg items-center justify-between px-6 py-3">
      <a
        href="/"
        class="flex items-center gap-1.5 font-display text-sm font-semibold text-ink-soft tracking-tight transition-colors hover:text-ink"
        aria-label="spellingwords home"
      >
        <span
          class="inline-block h-1.5 w-1.5 flex-shrink-0 rounded-full bg-brand-red opacity-60"
          aria-hidden="true"
        ></span>
        spelling<span class="text-ink-faint">words</span>
      </a>
      <a
        href="/"
        class="rounded-full px-3 py-2 text-xs font-semibold text-ink-soft/70 transition hover:bg-app-cloud hover:text-ink-soft min-h-[36px] flex items-center"
      >
        ← New list
      </a>
    </div>
  </header>
)}
