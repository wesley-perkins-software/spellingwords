    display: flex;
    gap: 1.5rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .site-head nav a {
    text-decoration: none;
    color: var(--ink-soft);
    border-bottom: 2px solid transparent;
    padding-bottom: 0.2rem;
  }
  .site-head nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent-text);
  }

  .breadcrumb {
    padding-block: 1.25rem 0.25rem;
