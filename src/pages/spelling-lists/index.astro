---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getListsByGrade, isPublished, resolveListRefs, groupByCategory } from '@/lib/content/spellingLists';
import { categoryLabels } from '@/lib/content/categoryMeta';
import { gradeConfig } from '@/lib/content/gradeConfig';

const entries = (await getCollection('spelling-lists')).filter(isPublished);
const totalCount = entries.length;

const gradeTiles = gradeConfig.map((gc) => ({
  ...gc,
  count: getListsByGrade(gc.grade, entries).length,
}));

const byCategory = groupByCategory(entries);

const skillFamilies = [
  {
    label: 'Phonics Patterns',
    description: 'Consonants, vowels, blends, and digraphs — the building blocks of reading.',
    href: '/spelling-lists/phonics',
    count: byCategory.get('phonics')?.length ?? 0,
  },
  {
    label: 'Sight Words',
    description: 'The words that appear most often in print. Dolch and Fry sequences, K–Grade 3.',
    href: '/spelling-lists/sight-words',
    count: byCategory.get('sight-words')?.length ?? 0,
  },
  {
    label: 'Grade-Level Vocabulary',
    description: 'Words matched to what most schools teach each year, kindergarten through 5th grade.',
    href: '/spelling-lists/grade-level',
    count: byCategory.get('grade-level')?.length ?? 0,
  },
  {
    label: 'Challenge & Spelling Bee',
    description: 'Greek and Latin roots, advanced patterns, and spelling bee preparation.',
    href: '/spelling-lists/challenge',
    count: byCategory.get('challenge')?.length ?? 0,
  },
];

const featuredListIds = ['kindergarten-first-words', 'silent-e-long-a', 'grade-2-list-01'] as const;
const featuredLists = resolveListRefs([...featuredListIds], entries);

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Spelling Lists' }];

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://spellingwords.app');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};
---

<Layout
  title="Spelling Lists Library — Free, Curated Spelling Words for Grades K–5"
  description="Browse free spelling lists for kindergarten through 5th grade. Organized by grade level and skill — phonics, sight words, grade-level vocabulary, and challenge. Audio-supported, no account required."
  jsonLd={breadcrumbJsonLd}
>
  <SiteHeader variant="discovery" currentPath="/spelling-lists" />

  <main id="main-content">

    <!-- ── Opening Moment ──────────────────────────── app-paper ── -->
    <!-- Strong display headline, dark readable stat line           -->
    <div class="bg-app-paper">
      <div class="mx-auto max-w-3xl px-6 pt-8">
        <Breadcrumbs items={breadcrumbItems} />
      </div>
      <div class="mx-auto max-w-3xl px-6 pb-14 pt-10">
        <h1 class="text-display-lg">
          Spelling Lists by Grade and Skill
        </h1>
        <p class="mt-5 max-w-lg text-body font-medium text-ink">
          {totalCount} hand-curated spelling lists — organized by grade and skill.
          Every list is free, audio-supported, and ready to practice in seconds.
        </p>
      </div>
    </div>

    <!-- ── Grade Chapter ───────────────────────────── cream-deep ── -->
    <!-- Deepest warm surface creates clear visual break.            -->
    <!-- Paper-colored tiles on the deeper ground = workbook pages   -->
    <!-- on a warm desk. Grade numbers large enough to land on.      -->
    <section class="bg-cream-deep" aria-labelledby="grade-chapter-heading">
      <h2 id="grade-chapter-heading" class="sr-only">Browse by Grade</h2>
      <div class="mx-auto max-w-3xl px-6 py-14">
        <div class="grid grid-cols-3 gap-3 md:grid-cols-6">
          {gradeTiles.map((gc) => (
            <a
              href={gc.hubHref}
              class="group flex flex-col items-center gap-2 rounded-2xl border border-transparent bg-app-paper px-2 py-10 text-center shadow-[0_2px_8px_-2px_rgba(43,35,24,0.10)] transition hover:-translate-y-1 hover:border-brand-blue/30 hover:shadow-[0_8px_24px_-6px_rgba(43,35,24,0.18)]"
            >
              <span class="font-display text-5xl font-bold leading-none text-ink transition group-hover:text-brand-blue md:text-6xl">
                {gc.grade}
              </span>
              <span class="text-sm font-bold leading-tight text-ink transition group-hover:text-brand-blue">{gc.shortLabel}</span>
              <span class="text-xs text-ink">{gc.count} lists</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Skill Chapter ──────────────────────────── app-paper ── -->
    <!-- Visible h2 with blue accent signals section identity.      -->
    <!-- Left rule at full opacity reads as intentional.            -->
    <!-- Descriptions in dark ink — these are functional text.      -->
    <section class="bg-app-paper" aria-labelledby="skill-chapter-heading">
      <div class="mx-auto max-w-3xl px-6 py-16">
        <h2
          id="skill-chapter-heading"
          class="mb-8 font-display text-xs font-semibold uppercase tracking-widest text-brand-blue"
        >
          Browse by skill
        </h2>
        <div class="border-l-[3px] border-brand-blue/40 pl-6">
          <nav aria-label="Browse by skill">
            {skillFamilies.map((sf, i) => (
              <a
                href={sf.href}
                class={`group flex items-start justify-between gap-6 py-5 transition${i < skillFamilies.length - 1 ? ' border-b border-line' : ''}`}
              >
                <div>
                  <div class="font-display text-lg font-semibold text-ink transition group-hover:text-brand-blue">
                    {sf.label}
                  </div>
                  <div class="mt-1 text-sm leading-relaxed text-ink">{sf.description}</div>
                </div>
                <div class="mt-1 flex shrink-0 items-center gap-2">
                  <span class="text-sm text-ink">{sf.count} lists</span>
                  <span class="text-sm font-semibold text-brand-blue opacity-0 transition group-hover:opacity-100">
                    →
                  </span>
                </div>
              </a>
            ))}
          </nav>
        </div>
      </div>
    </section>

    <!-- ── Editorial Picks ──────────────────────────────── white ── -->
    <!-- Pure white breaks the cream sequence — signals a curated    -->
    <!-- moment set apart from the navigation sections.              -->
    <!-- Cloud cards on white surface read with strong contrast.     -->
    <!-- Intro sentence at text-lg italic text-ink — it earns weight -->
    {featuredLists.length > 0 && (
      <section class="bg-white" aria-labelledby="editorial-picks-heading">
        <div class="mx-auto max-w-3xl px-6 py-16">
          <h2 id="editorial-picks-heading" class="sr-only">Good Places to Start</h2>
          <p class="mb-8 max-w-lg text-lg italic leading-relaxed text-ink">
            Not sure where to begin? These are well-loved starting points for most families.
          </p>
          <div class="grid gap-4 sm:grid-cols-3">
            {featuredLists.map((entry) => (
              <a
                href={`/spelling-lists/${entry.data.category}/${entry.data.urlSlug}`}
                class="group flex flex-col gap-3 rounded-2xl bg-app-cloud p-6 transition hover:-translate-y-0.5 hover:shadow-card-md"
              >
                <span class="text-xs font-semibold uppercase tracking-wide text-ink">
                  {categoryLabels[entry.data.category] ?? entry.data.category}
                  {entry.data.grade
                    ? ` · ${entry.data.grade === 'K' ? 'Kindergarten' : `Grade ${entry.data.grade}`}`
                    : ''}
                </span>
                <h3 class="font-display text-base font-semibold leading-snug text-ink transition group-hover:text-brand-blue">
                  {entry.data.title}
                </h3>
                <span class="mt-auto text-sm text-ink">{entry.data.words.length} words</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ── Library Chapter ─────────────────────────── app-cloud ── -->
    <!-- Cloud background reads as a reference panel — recessed,     -->
    <!-- informational, contained. Stronger heading and body text    -->
    <!-- communicate that this section has substance.                -->
    <section class="bg-app-cloud" aria-labelledby="library-chapter-heading">
      <div class="mx-auto max-w-3xl px-6 py-16">
        <h2 id="library-chapter-heading" class="font-display text-2xl font-semibold text-ink">
          The full collection
        </h2>
        <p class="mt-2 max-w-xl text-base leading-relaxed text-ink">
          {totalCount} spelling lists, organized by grade and skill. Every list hand-curated,
          every example sentence written by a human.
        </p>

        <div class="mt-10 grid gap-10 border-t border-line pt-8 sm:grid-cols-2">
          <!-- By grade -->
          <div>
            <h3 class="mb-4 text-xs font-semibold uppercase tracking-widest text-ink">
              By grade
            </h3>
            <div>
              {gradeTiles.map((gc) => (
                <a
                  href={gc.hubHref}
                  class="group flex items-center justify-between border-b border-line py-3 transition last:border-0"
                >
                  <span class="text-sm font-semibold text-ink transition group-hover:text-brand-blue">
                    {gc.shortLabel}
                  </span>
                  <div class="flex items-center gap-2">
                    <span class="text-sm text-ink">{gc.count} lists</span>
                    <span class="text-xs font-semibold text-brand-blue opacity-0 transition group-hover:opacity-100">→</span>
                  </div>
                </a>
              ))}
            </div>
          </div>

          <!-- By skill -->
          <div>
            <h3 class="mb-4 text-xs font-semibold uppercase tracking-widest text-ink">
              By skill
            </h3>
            <div>
              {skillFamilies.map((sf) => (
                <a
                  href={sf.href}
                  class="group flex items-center justify-between border-b border-line py-3 transition last:border-0"
                >
                  <span class="text-sm font-semibold text-ink transition group-hover:text-brand-blue">
                    {sf.label}
                  </span>
                  <div class="flex items-center gap-2">
                    <span class="text-sm text-ink">{sf.count} lists</span>
                    <span class="text-xs font-semibold text-brand-blue opacity-0 transition group-hover:opacity-100">→</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>

        <p class="mt-14 border-t border-line pt-6 text-sm leading-relaxed text-ink">
          Or practice any words you choose —{' '}
          <a href="/" class="link font-semibold">enter your own list on the homepage</a>.
        </p>
      </div>
    </section>

  </main>

  <SiteFooter />
</Layout>
