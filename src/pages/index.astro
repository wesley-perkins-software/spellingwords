---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Button from '@/components/direction-a/Button.astro';
import CustomWordEntry from '@/components/CustomWordEntry.astro';
import { SKILLS_INDEX_PATH } from '@/lib/content/canonicalSkillRoutes';
import { gradeConfig } from '@/lib/content/gradeConfig';
import {
  GRADE_ACCENT,
  ACCENT_BG_CLASS,
  ACCENT_INK_CLASS,
  ACCENT_TINT_BG_CLASS,
  ACCENT_BORDER_CLASS,
  STRAND_ACCENT,
  SKILL_FAMILY_ACCENT,
} from '@/lib/content/pilotContent';
import {
  homepageGradeHubs,
  homepageJsonLd,
  homepageFaqJsonLd,
  HOMEPAGE_SKILL_COUNT,
  HOMEPAGE_SKILL_FAMILY_COUNT,
  HOMEPAGE_SKILL_FAMILIES,
  HOMEPAGE_STRANDS,
  HOMEPAGE_CLOSING_STATEMENT,
  HOMEPAGE_FAQ,
} from '@/lib/content/homepage';

const gradeCards = homepageGradeHubs.map((hub, index) => ({
  ...hub,
  numeral: gradeConfig[index].grade,
  accent: GRADE_ACCENT[gradeConfig[index].grade],
}));

const [coreStrand, hfwStrand, themedStrand] = HOMEPAGE_STRANDS;
const strandAccents = {
  [coreStrand.href]: STRAND_ACCENT['core-spelling'],
  [hfwStrand.href]: STRAND_ACCENT['high-frequency-words'],
  [themedStrand.href]: STRAND_ACCENT['themed-spelling-practice'],
} as const;

const skillFamilyRows = HOMEPAGE_SKILL_FAMILIES.map((title, index) => ({
  number: String(index + 1).padStart(2, '0'),
  title,
  accent: SKILL_FAMILY_ACCENT[title] ?? 'brand',
}));
---

<Layout
  title="Free K–5 Spelling Practice by Grade or Skill, No Account | SpellingWords.app"
  description="Free spelling practice for K–5 students, with no account required. Practice your own words, or find structured curriculum practice by grade or spelling skill."
  jsonLd={[...homepageJsonLd, homepageFaqJsonLd]}
>
  <SiteHeader currentPath="/" />

  <main id="main-content">
    <!-- ═══ HERO ════════════════════════════════════════════════ -->
    <section
      class="bg-gradient-to-b from-da-brand-tint to-da-canvas px-5 py-12 sm:px-6 md:py-16"
      aria-labelledby="hero-heading"
    >
      <div
        class="mx-auto grid max-w-content-xl items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16"
      >
        <div>
          <h1
            id="hero-heading"
            class="font-quicksand text-[clamp(2.1rem,4.6vw,3.4rem)] font-bold leading-[1.08] tracking-tight text-da-ink"
          >
            Practice <span class="text-da-coral-strong">spelling</span> your way.
          </h1>
          <p class="mt-5 max-w-[46ch] text-[1.1rem] leading-relaxed text-da-ink-soft">
            Use your own words, follow a structured K–5 spelling curriculum, or explore a library of
            focused spelling skills. Free to use, with no account or login required.
          </p>
        </div>

        <div id="practice" class="scroll-mt-24">
          <CustomWordEntry variant="compact" headingId="hero-word-input-label" />
        </div>
      </div>
    </section>

    <!-- ═══ BROWSE BY GRADE ═══════════════════════════════════════ -->
    <section
      id="grades"
      class="scroll-mt-[72px] bg-da-surface-home px-5 py-14 sm:px-6 md:py-20"
      aria-labelledby="grade-heading"
    >
      <div class="mx-auto max-w-content-xl">
        <div class="mb-9 max-w-2xl">
          <h2
            id="grade-heading"
            class="font-quicksand text-[clamp(1.7rem,3vw,2.15rem)] font-bold text-da-ink"
          >
            Browse by Grade
          </h2>
          <p class="mt-2.5 text-[1.05rem] leading-relaxed text-da-ink-soft">
            Follow an organized Kindergarten–5th Grade spelling path built around Core Spelling,
            High-Frequency Words, and Themed Spelling Practice.
          </p>
        </div>

        <div
          class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
          role="list"
          aria-label="Grade levels"
        >
          {
            gradeCards.map(({ href, label, teaser, focus, numeral, accent }) => (
              <a
                href={href}
                class="relative flex flex-col gap-1.5 overflow-hidden rounded-2xl border border-da-border bg-da-canvas-raised p-6 pt-7 shadow-sm transition hover:-translate-y-1 hover:shadow-md"
                role="listitem"
              >
                <span
                  class:list={['absolute inset-x-0 top-0 h-2', ACCENT_BG_CLASS[accent]]}
                  aria-hidden="true"
                />
                <span
                  class:list={[
                    'font-quicksand text-4xl font-bold leading-none',
                    ACCENT_INK_CLASS[accent],
                  ]}
                  aria-hidden="true"
                >
                  {numeral}
                </span>
                <span class="mt-1 font-quicksand text-lg font-bold text-da-ink">{label}</span>
                <span class="text-sm leading-relaxed text-da-ink-soft">{teaser}</span>
                <span class:list={['mt-1 text-[0.8rem] font-bold', ACCENT_INK_CLASS[accent]]}>
                  {focus}
                </span>
              </a>
            ))
          }
        </div>
        <p class="mt-7 text-center">
          <a href="/grades" class="font-bold text-da-brand-strong no-underline hover:underline">
            See how spelling develops across K–5 <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </section>

    <!-- ═══ HOW THE K-5 CURRICULUM IS ORGANIZED ══════════════════ -->
    <section class="px-5 py-14 sm:px-6 md:py-20" aria-labelledby="curriculum-org-heading">
      <div class="mx-auto max-w-content-xl">
        <div class="mb-9 max-w-2xl">
          <p
            class="mb-2 font-quicksand text-[0.78rem] font-bold uppercase tracking-[0.08em] text-da-brand-strong"
          >
            How it's structured
          </p>
          <h2
            id="curriculum-org-heading"
            class="font-quicksand text-[clamp(1.7rem,3vw,2.15rem)] font-bold text-da-ink"
          >
            How the K–5 curriculum is organized
          </h2>
          <p class="mt-2.5 max-w-[62ch] text-[1.05rem] leading-relaxed text-da-ink-soft">
            Each grade combines three complementary types of practice — one required sequence, and
            two kinds of practice alongside it.
          </p>
        </div>

        <div
          class="overflow-hidden rounded-3xl border border-da-border bg-da-canvas-raised shadow-sm"
        >
          <!-- Core Spelling — the main sequence, given the strongest visual weight. -->
          <div
            class:list={[
              'border-b border-da-border p-7 sm:p-9',
              ACCENT_TINT_BG_CLASS[strandAccents[coreStrand.href]],
            ]}
          >
            <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-start lg:gap-12">
              <div>
                <p
                  class:list={[
                    'font-quicksand text-[0.78rem] font-bold uppercase tracking-[0.08em]',
                    ACCENT_INK_CLASS[strandAccents[coreStrand.href]],
                  ]}
                >
                  <span aria-hidden="true">01 · </span>The main sequence
                </p>
                <h3 class="mt-1.5">
                  <a
                    href={coreStrand.href}
                    class="font-quicksand text-[clamp(1.4rem,2.4vw,1.75rem)] font-bold text-da-ink hover:underline"
                  >
                    {coreStrand.name}
                  </a>
                </h3>
                <p class="mt-2.5 max-w-[58ch] text-[1.02rem] leading-relaxed text-da-ink-soft">
                  {coreStrand.description}
                </p>
              </div>

              <ul
                class="flex flex-wrap gap-2 lg:max-w-[16rem] lg:justify-end"
                aria-label={`Example ${coreStrand.name} concepts`}
              >
                {
                  coreStrand.examples.map((example) => (
                    <li
                      class:list={[
                        'rounded-full border-[1.5px] bg-da-canvas-raised px-3.5 py-1.5 text-sm font-bold leading-none text-da-ink',
                        ACCENT_BORDER_CLASS[strandAccents[coreStrand.href]],
                      ]}
                    >
                      {example}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>

          <!-- High-Frequency Words and Themed Spelling Practice — coequal companions, quieter treatment. -->
          <div class="grid grid-cols-1 sm:grid-cols-2">
            {
              [hfwStrand, themedStrand].map((strand, index) => (
                <div
                  class:list={[
                    'p-6 sm:p-8',
                    ACCENT_TINT_BG_CLASS[strandAccents[strand.href]],
                    index === 0 && 'border-b border-da-border sm:border-b-0 sm:border-r',
                  ]}
                >
                  <p
                    class:list={[
                      'font-quicksand text-[0.72rem] font-bold uppercase tracking-[0.08em]',
                      ACCENT_INK_CLASS[strandAccents[strand.href]],
                    ]}
                  >
                    <span aria-hidden="true">{index === 0 ? '02' : '03'} · </span>
                    {index === 0 ? 'Alongside the sequence' : 'Optional extra practice'}
                  </p>
                  <h3 class="mt-1.5">
                    <a
                      href={strand.href}
                      class="font-quicksand text-lg font-bold text-da-ink hover:underline"
                    >
                      {strand.name}
                    </a>
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-da-ink-soft">{strand.description}</p>

                  <ul class="mt-4 flex flex-wrap gap-2" aria-label={`Example ${strand.name}`}>
                    {strand.examples.map((example) => (
                      <li
                        class:list={[
                          'rounded-full border-[1.5px] bg-da-canvas-raised px-3 py-1 text-[0.82rem] font-bold leading-none text-da-ink',
                          strand.href === hfwStrand.href && 'font-word',
                          ACCENT_BORDER_CLASS[strandAccents[strand.href]],
                        ]}
                      >
                        {example}
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>

        <p class="mt-7">
          <a
            href="/curriculum"
            class="inline-flex min-h-[44px] items-center font-bold text-da-brand-strong underline decoration-2 underline-offset-4 hover:text-da-brand"
          >
            Read about our spelling curriculum <span class="ml-1" aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </section>

    <!-- ═══ BROWSE BY SKILL ═══════════════════════════════════════ -->
    <section
      id="skills"
      class="scroll-mt-[72px] bg-da-teal-tint px-5 py-14 sm:px-6 md:py-20"
      aria-labelledby="skill-heading"
    >
      <div class="mx-auto max-w-content-xl">
        <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end lg:justify-between lg:gap-16">
          <div>
            <h2
              id="skill-heading"
              class="font-quicksand text-[clamp(1.7rem,3vw,2.15rem)] font-bold text-da-ink"
            >
              Browse by Skill
            </h2>
            <p class="mt-2.5 max-w-[56ch] text-[1.05rem] leading-relaxed text-da-ink-soft">
              Already know what to work on? Explore {HOMEPAGE_SKILL_COUNT} spelling skills across
              {' '}
              {HOMEPAGE_SKILL_FAMILY_COUNT} skill families spanning foundational sound patterns to advanced
              word structure — go straight to the specific concept your student needs.
            </p>
          </div>
          <Button href={SKILLS_INDEX_PATH} variant="outline" class="lg:mb-1">
            Browse Spelling Skills <span aria-hidden="true">→</span>
          </Button>
        </div>

        <div
          class="mt-9 rounded-3xl border border-da-border bg-da-canvas-raised px-6 py-2 shadow-sm sm:px-8"
        >
          <ol
            class="grid grid-cols-1 sm:grid-cols-2 sm:gap-x-8 lg:grid-cols-3 lg:gap-x-10"
            aria-label="All twelve canonical spelling skill families"
          >
            {
              skillFamilyRows.map(({ number, title, accent }) => (
                <li class="flex items-baseline gap-3 border-b border-da-border py-3.5 last:border-b-0 sm:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0">
                  <span
                    class="font-quicksand text-xs font-bold tabular-nums text-da-ink-faint"
                    aria-hidden="true"
                  >
                    {number}
                  </span>
                  <span
                    class:list={['h-1.5 w-1.5 shrink-0 rounded-full', ACCENT_BG_CLASS[accent]]}
                    aria-hidden="true"
                  />
                  <span class="text-[0.95rem] font-bold leading-snug text-da-ink">{title}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <!-- ═══ TRUST / POSITIONING ══════════════════════════════════ -->
    <section
      id="how-it-works"
      class="scroll-mt-[72px] bg-da-surface-home px-5 py-14 sm:px-6 md:py-20"
      aria-labelledby="audience-heading"
    >
      <div class="mx-auto max-w-content-lg">
        <h2
          id="audience-heading"
          class="text-center font-quicksand text-[clamp(1.7rem,3vw,2.15rem)] font-bold text-da-ink"
        >
          Built for students, parents, and teachers
        </h2>

        <div
          class="mx-auto mt-8 max-w-content-lg rounded-2xl border border-da-brand bg-da-brand-tint px-6 py-8 text-center shadow-sm sm:px-10"
        >
          <p class="text-[1.02rem] leading-relaxed text-da-ink-soft">
            {HOMEPAGE_CLOSING_STATEMENT}
          </p>
        </div>

        <p class="mt-6 text-center text-[0.95rem] text-da-ink-soft">
          <a href="/about" class="font-bold text-da-brand-strong no-underline hover:underline">
            More about SpellingWords <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </section>

    <!-- ═══ FAQ ═══════════════════════════════════════════════════ -->
    <section class="bg-da-surface-home px-5 py-14 sm:px-6 md:py-20" aria-labelledby="faq-heading">
      <div class="mx-auto max-w-content-md">
        <h2
          id="faq-heading"
          class="font-quicksand text-[clamp(1.7rem,3vw,2.15rem)] font-bold text-da-ink"
        >
          Frequently asked questions
        </h2>

        <div class="mt-8 flex flex-col gap-7">
          {
            HOMEPAGE_FAQ.map(({ question, answer }) => (
              <div>
                <h3 class="font-quicksand text-base font-bold text-da-ink">{question}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-da-ink-soft">{answer}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
