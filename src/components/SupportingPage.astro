---
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  currentPath: string;
}

const { eyebrow, title, intro, currentPath } = Astro.props;
---

<main id="main-content">
  <div class="mx-auto max-w-content-lg px-5 pt-8 sm:px-6 md:pt-10">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: title }]} />
  </div>

  <header class="px-5 pb-10 pt-8 sm:px-6 md:pb-14 md:pt-12">
    <div class="mx-auto max-w-content-lg">
      <p class="font-quicksand text-sm font-bold uppercase tracking-[0.08em] text-da-brand-strong">
        {eyebrow}
      </p>
      <h1
        class="mt-3 max-w-[18ch] font-quicksand text-[clamp(2.15rem,5vw,3.4rem)] font-bold leading-[1.08] tracking-tight text-da-ink"
      >
        {title}
      </h1>
      <p class="mt-5 max-w-[65ch] text-[1.12rem] leading-relaxed text-da-ink-soft">{intro}</p>
    </div>
  </header>

  <div class="bg-da-surface-home px-5 py-12 sm:px-6 md:py-16">
    <article class="supporting-prose mx-auto max-w-content-lg" data-supporting-page={currentPath}>
      <slot />
    </article>
  </div>
</main>

<style>
  .supporting-prose :global(section + section) {
    margin-top: 3.5rem;
    padding-top: 3.5rem;
    border-top: 1px solid theme('colors.da.border');
  }

  .supporting-prose :global(h2) {
    max-width: 28ch;
    font-family: theme('fontFamily.quicksand');
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
    color: theme('colors.da.ink');
  }

  .supporting-prose :global(h3) {
    margin-top: 1.75rem;
    font-family: theme('fontFamily.quicksand');
    font-size: 1.12rem;
    font-weight: 700;
    color: theme('colors.da.ink');
  }

  .supporting-prose :global(p),
  .supporting-prose :global(li) {
    max-width: 68ch;
    font-size: 1rem;
    line-height: 1.75;
    color: theme('colors.da.ink-soft');
  }

  .supporting-prose :global(p) {
    margin-top: 1rem;
  }

  .supporting-prose :global(ul),
  .supporting-prose :global(ol) {
    margin-top: 1rem;
    padding-left: 1.35rem;
  }

  .supporting-prose :global(li + li) {
    margin-top: 0.55rem;
  }

  .supporting-prose :global(a) {
    color: theme('colors.da.brand-strong');
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .supporting-prose :global(.supporting-cards) {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .supporting-prose :global(.supporting-card) {
    padding: 1.5rem;
    border: 1px solid theme('colors.da.border');
    border-radius: 1rem;
    background: theme('colors.da.canvas-raised');
  }

  .supporting-prose :global(.supporting-card h3) {
    margin-top: 0;
  }

  @media (min-width: 768px) {
    .supporting-prose :global(.supporting-cards) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
