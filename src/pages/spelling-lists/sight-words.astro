---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SpellingListCard from '@/components/SpellingListCard.astro';
import { isPublished, getMemberListIds } from '@/lib/content/spellingLists';
import { getGradesWithLists } from '@/lib/content/gradeConfig';

const allCollections = (await getCollection('spelling-collections')).filter(
  (c) => c.data.status === 'published',
);
const memberIds = getMemberListIds(allCollections);
const entries = (await getCollection('spelling-lists')).filter(isPublished);

const sightWordCollections = allCollections.filter((c) => c.data.category === 'sight-words');
const sightWordLists = entries
  .filter((e) => e.data.category === 'sight-words' && !memberIds.has(e.data.id))
  .sort((a, b) => a.data.order - b.data.order);

const totalItems = sightWordCollections.length + sightWordLists.length;

const gradesPresent = getGradesWithLists([
  ...sightWordLists.map((e) => e.data.grade),
  ...sightWordCollections.map((c) => c.data.grade),
]);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Spelling Lists Library', href: '/spelling-lists' },
  { label: 'Sight Words' },
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://spellingwords.app');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Sight Word Spelling Lists',
  numberOfItems: totalItems,
  itemListElement: [
    ...sightWordCollections.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/spelling-lists/collections/${c.data.urlSlug}`, canonicalURL.origin).toString(),
      name: c.data.title,
    })),
    ...sightWordLists.map((e, i) => ({
      '@type': 'ListItem',
      position: sightWordCollections.length + i + 1,
      url: new URL(`/spelling-lists/sight-words/${e.data.urlSlug}`, canonicalURL.origin).toString(),
      name: e.data.title,
    })),
  ],
};
---

<Layout
  title="Sight Word Spelling Lists | spellingwords.app"
  description="Free Dolch sight word spelling lists for kindergarten through third grade — high-frequency words for reading fluency and spelling confidence. Calm, audio-supported practice."
  jsonLd={[breadcrumbJsonLd, itemListJsonLd]}
>
  <SiteHeader variant="discovery" currentPath="/spelling-lists" />

  <main id="main-content">
    <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
      <div class="mb-6">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <!-- Hero -->
      <div class="mb-10 flex flex-col gap-4">
        <h1 class="font-display text-2xl font-semibold text-ink md:text-3xl">
          Sight Word Spelling Lists
        </h1>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">
          Sight word lists focus on high-frequency words that children see often in reading and
          writing. These words are useful for building fluency and confidence, especially in early
          grades. Because many sight words do not follow regular phonics patterns, they benefit from
          direct practice and repetition.
        </p>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">
          The lists here are organized around the Dolch word list, one of the most widely used
          collections of high-frequency words in early literacy instruction. The Dolch list is
          arranged by level — Pre-Primer through Third Grade — and covers the words children are
          most likely to encounter in early readers and their own writing. Each list includes audio
          support so children can hear the word before they type it.
        </p>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">
          Sight word practice works best in short, regular sessions. Five to ten minutes a day is
          more effective than one long session per week.
        </p>
      </div>

      <!-- Lists -->
      {totalItems === 0 ? (
        <div class="rounded-2xl border border-line bg-app-cloud p-8 text-center">
          <p class="text-base text-ink-soft">
            Sight word lists are being prepared. Check back soon, or{' '}
            <a href="/spelling-lists" class="font-semibold text-brand-blue hover:underline">
              browse the full library
            </a>{' '}
            in the meantime.
          </p>
        </div>
      ) : (
        <section aria-labelledby="lists-heading" class="mb-12">
          <h2 id="lists-heading" class="mb-4 font-display text-lg font-semibold text-ink">
            All Sight Word Lists
            <span class="ml-2 text-sm font-normal text-ink-faint">
              {totalItems} {totalItems === 1 ? 'item' : 'items'}
            </span>
          </h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {sightWordCollections.map((c) => (
              <a
                href={`/spelling-lists/collections/${c.data.urlSlug}`}
                class="flex flex-col gap-3 rounded-2xl border border-line bg-white p-5 shadow-[0_4px_16px_-6px_rgba(31,41,55,0.06)] transition hover:-translate-y-0.5 hover:shadow-[0_8px_22px_-8px_rgba(47,111,237,0.25)]"
              >
                <div class="flex flex-col gap-1">
                  <div class="flex items-center gap-2">
                    <span class="rounded-md bg-app-cloud px-2 py-0.5 text-xs font-medium text-ink-soft">
                      Sight Words
                    </span>
                    <span class="rounded-md bg-brand-blue/8 px-2 py-0.5 text-xs font-semibold text-brand-blue">
                      {c.data.listIds.length}-part collection
                    </span>
                  </div>
                  <h3 class="mt-1 font-display text-base font-semibold text-ink">{c.data.title}</h3>
                  <p class="text-sm leading-relaxed text-ink-soft">{c.data.description}</p>
                </div>
              </a>
            ))}
            {sightWordLists.map((entry) => (
              <SpellingListCard
                href={`/spelling-lists/${entry.data.category}/${entry.data.urlSlug}`}
                category={entry.data.category}
                title={entry.data.title}
                description={entry.data.description}
                difficulty={entry.data.difficulty}
                durationMinutes={entry.data.estimatedDurationMinutes}
                wordCount={entry.data.words.length}
              />
            ))}
          </div>
        </section>
      )}

      <!-- Guidance -->
      {totalItems > 1 && (
        <section aria-labelledby="guidance-heading" class="mb-12 rounded-2xl border border-line bg-app-cloud p-6">
          <h2 id="guidance-heading" class="mb-2 font-display text-base font-semibold text-ink">
            How to choose a sight word list
          </h2>
          <p class="text-sm leading-relaxed text-ink-soft">
            Start with the <strong class="font-semibold text-ink">Pre-Primer</strong> list if your
            child is in kindergarten or just beginning to read. Move to{' '}
            <strong class="font-semibold text-ink">Primer</strong> once those words feel automatic.
            The First Grade, Second Grade, and Third Grade Dolch lists continue the progression,
            each introducing new words common at that reading level. If your child already knows
            some of the words in a list, it's fine to skip ahead — the goal is confident,
            automatic recognition, not checking every box in order.
          </p>
        </section>
      )}

      <!-- Browse by grade -->
      {gradesPresent.length > 0 && (
        <nav aria-label="Browse sight word lists by grade" class="mb-10">
          <p class="mb-3 text-sm font-semibold text-ink">Browse by grade</p>
          <div class="flex flex-wrap gap-3">
            {gradesPresent.map((g) => (
              <a
                href={g.hubHref}
                class="inline-flex items-center rounded-xl border border-line bg-white px-4 py-2 text-sm font-medium text-ink-soft transition hover:border-brand-blue/40 hover:text-brand-blue"
              >
                {g.shortLabel}
              </a>
            ))}
          </div>
        </nav>
      )}

      <!-- Related categories -->
      <nav aria-label="Related spelling list categories" class="mb-10">
        <p class="mb-3 text-sm font-semibold text-ink">Explore other categories</p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/spelling-lists/phonics"
            class="inline-flex items-center rounded-xl border border-line bg-white px-4 py-2 text-sm font-medium text-ink-soft transition hover:border-brand-blue/40 hover:text-brand-blue"
          >
            Phonics
          </a>
          <a
            href="/spelling-lists/grade-level"
            class="inline-flex items-center rounded-xl border border-line bg-white px-4 py-2 text-sm font-medium text-ink-soft transition hover:border-brand-blue/40 hover:text-brand-blue"
          >
            Grade-Level
          </a>
          <a
            href="/spelling-lists/challenge"
            class="inline-flex items-center rounded-xl border border-line bg-white px-4 py-2 text-sm font-medium text-ink-soft transition hover:border-brand-blue/40 hover:text-brand-blue"
          >
            Challenge
          </a>
        </div>
      </nav>

      <!-- Back to library -->
      <p>
        <a
          href="/spelling-lists"
          class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
        >
          ← Back to the Spelling Lists Library
        </a>
      </p>
    </div>
  </main>

  <SiteFooter />
</Layout>
