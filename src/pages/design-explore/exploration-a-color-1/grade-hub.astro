---
import Proto from './_shared/Proto.astro';
import Header from './_shared/Header.astro';
import Footer from './_shared/Footer.astro';

// Mirrors src/pages/[gradeSlug].astro's structure, using real 3rd-grade content
// (src/lib/content/gradeHubCopy.ts, gradeHubModel.ts, and grade-level/high-frequency-words entries).
const coreUnits = [
  { title: 'Prefix Words', order: 4 },
  { title: 'Suffix Words', order: 5 },
  { title: 'Spelling Rules for Adding Suffixes', order: 6 },
  { title: 'Possessive Words', order: 8.5 },
  { title: 'Multisyllabic Words', order: 9 },
  { title: 'Homophones and Commonly Confused Words', order: 10 },
  { title: 'Root Word Families', order: 11 },
];

const hfwSets = ['Set 1', 'Set 2', 'Set 3', 'Set 4', 'Set 5'];

const themedSets = [
  'Time Words',
  'Map and Globe Words',
  'Life Cycle Words',
  'Multiplication and Division Words',
];
---

<Proto
  title="3rd Grade Spelling Words — Exploration A1"
  description="Design exploration A: grade hub page for 3rd grade spelling practice."
>
  <Header currentPath="/design-explore/exploration-a-color-1/grade-hub.html" />

  <main id="main">
    <div class="wrap page">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/design-explore/exploration-a-color-1/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">3rd Grade</span>
      </nav>

      <header class="hub-hero">
        <p class="eyebrow">Grade 3</p>
        <h1>3rd Grade Spelling Words</h1>
        <p class="hub-lede">
          In 3rd Grade, spelling begins to move beyond a mainly phonics-based focus. Students
          still use sound and pattern knowledge from earlier grades, while paying more attention
          to prefixes, suffixes, and the structure of longer words.
        </p>
        <p class="hub-lede">
          They also learn how word parts can affect spelling and meaning, and how meaning can
          distinguish words that sound alike. This work builds toward using roots, word families,
          and other meaningful parts to spell more complex words in later grades.
        </p>
      </header>

      <div class="strand-list">
        <section class="strand-card" aria-labelledby="strand-core">
          <div class="strand-card-head">
            <span class="strand-tag tint-teal">Core Spelling</span>
            <h2 id="strand-core">The main systematic path</h2>
          </div>
          <p class="strand-summary">
            Core Spelling is the main systematic path. Its {coreUnits.length} ordered units build
            from prefixes and suffixes into spelling changes, possessives, multisyllabic spelling,
            homophones, and word families.
          </p>
          <ul class="strand-units">
            {
              coreUnits.map((unit) => (
                <li>
                  <a href="#">{unit.title}</a>
                </li>
              ))
            }
          </ul>
          <a class="text-link" href="#">Explore Core Spelling →</a>
        </section>

        <section class="strand-card" aria-labelledby="strand-hfw">
          <div class="strand-card-head">
            <span class="strand-tag tint-gold">High-Frequency Words</span>
            <h2 id="strand-hfw">Everyday words, grouped for practice</h2>
          </div>
          <p class="strand-summary">
            High-frequency words appear constantly in reading and writing but don't always follow
            predictable spelling patterns. These {hfwSets.length} sets provide practice with 150
            grade-level words.
          </p>
          <ul class="strand-units strand-units-inline">
            {
              hfwSets.map((set) => (
                <li>
                  <a href="#">Grade 3 High-Frequency Words — {set}</a>
                </li>
              ))
            }
          </ul>
          <a class="text-link" href="#">Explore High-Frequency Words →</a>
        </section>

        <section class="strand-card" aria-labelledby="strand-themed">
          <div class="strand-card-head">
            <span class="strand-tag tint-coral">Themed Spelling Practice</span>
            <h2 id="strand-themed">Optional, curriculum-connected sets</h2>
          </div>
          <p class="strand-summary">
            Themed Spelling Practice connects spelling to what students are studying elsewhere —
            math, science, and social studies vocabulary drawn from a typical 3rd grade year.
          </p>
          <ul class="strand-units">
            {
              themedSets.map((set) => (
                <li>
                  <a href="#">{set}</a>
                </li>
              ))
            }
          </ul>
          <a class="text-link" href="#">Explore Themed Spelling Practice →</a>
        </section>
      </div>

      <section class="guidance" aria-labelledby="guidance-heading">
        <h2 id="guidance-heading">Where to begin</h2>
        <p>
          Most 3rd graders should start with Core Spelling, in order — it's built to introduce
          prefixes and suffixes before the homophones and word-family units that depend on them.
          High-Frequency Words can run alongside Core Spelling at any point. Themed Spelling
          Practice is optional and works well as a change of pace or a tie-in to a current unit in
          another subject.
        </p>
      </section>

      <nav class="adjacent-nav" aria-label="Adjacent grade levels">
        <a href="#">← 2nd Grade Spelling Words</a>
        <a href="#">4th Grade Spelling Words →</a>
      </nav>

      <p><a class="text-link" href="/design-explore/exploration-a-color-1/#grades">← Back to all grades</a></p>
    </div>
  </main>

  <Footer />

  <style>
    .page {
      padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 6vw, 5rem);
      max-width: 880px;
    }

    .breadcrumbs {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      font-size: 0.85rem;
      color: var(--ink-faint);
      margin-bottom: 2rem;
    }

    .breadcrumbs a {
      color: var(--ink-soft);
      text-decoration: none;
      font-weight: 600;
    }
    .breadcrumbs a:hover {
      color: var(--brand);
    }
    .breadcrumbs [aria-current='page'] {
      color: var(--ink);
      font-weight: 600;
    }

    .hub-hero {
      margin-bottom: 2.75rem;
      max-width: 68ch;
    }

    .eyebrow {
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--brand);
      margin-bottom: 0.75rem;
    }

    .hub-hero h1 {
      font-size: clamp(1.9rem, 4vw, 2.6rem);
      margin-bottom: 1.1rem;
    }

    .hub-lede {
      font-size: 1.03rem;
      line-height: 1.65;
      color: var(--ink-soft);
      margin-bottom: 0.9rem;
    }

    .strand-list {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      margin-bottom: 2.5rem;
    }

    .strand-card {
      background: var(--canvas-raised);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: clamp(1.5rem, 3vw, 2rem);
      box-shadow: var(--shadow-sm);
    }

    .strand-card-head {
      margin-bottom: 0.9rem;
    }

    .strand-tag {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      padding: 0.3rem 0.7rem;
      border-radius: var(--radius-pill);
      margin-bottom: 0.65rem;
    }
    .strand-tag.tint-teal {
      background: var(--teal-tint);
      color: var(--teal);
    }
    .strand-tag.tint-gold {
      background: var(--gold-tint);
      color: var(--gold);
    }
    .strand-tag.tint-coral {
      background: var(--coral-tint);
      color: var(--coral);
    }

    .strand-card h2 {
      font-size: 1.2rem;
    }

    .strand-summary {
      font-size: 0.95rem;
      line-height: 1.6;
      color: var(--ink-soft);
      margin-bottom: 1.1rem;
      max-width: 68ch;
    }

    .strand-units {
      list-style: none;
      margin: 0 0 1.1rem;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.4rem 1.5rem;
    }

    .strand-units-inline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .strand-units li {
      border-top: 1px solid var(--border);
      padding-top: 0.5rem;
    }

    .strand-units a {
      font-size: 0.9rem;
      color: var(--ink);
      text-decoration: none;
      font-weight: 600;
    }
    .strand-units a:hover {
      color: var(--brand);
      text-decoration: underline;
    }

    .text-link {
      display: inline-block;
      font-weight: 700;
      font-size: 0.9rem;
      color: var(--brand);
      text-decoration: none;
    }
    .text-link:hover {
      text-decoration: underline;
    }

    .guidance {
      background: var(--canvas-sunken);
      border-radius: var(--radius-lg);
      padding: clamp(1.5rem, 3vw, 2rem);
      margin-bottom: 2.5rem;
    }

    .guidance h2 {
      font-size: 1.05rem;
      margin-bottom: 0.6rem;
    }

    .guidance p {
      font-size: 0.92rem;
      line-height: 1.6;
      color: var(--ink-soft);
    }

    .adjacent-nav {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 2rem;
      flex-wrap: wrap;
    }

    .adjacent-nav a {
      font-weight: 700;
      font-size: 0.9rem;
      color: var(--brand);
      text-decoration: none;
    }
    .adjacent-nav a:hover {
      text-decoration: underline;
    }

    @media (max-width: 640px) {
      .strand-units {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Proto>
