---
import type { WorldKitId } from '@/lib/theme/worldKits';

interface Props {
  kitId: WorldKitId;
}

const { kitId } = Astro.props;

const bird = (top: string, left: string, scale = 1, opacity = 0.4) =>
  `top:${top}; left:${left}; transform:scale(${scale}); opacity:${opacity};`;
---

<div class="world-scene" aria-hidden="true">
  {
    kitId === 'morning-blue' && (
      <>
        <div class="cloud" style="top:10%; left:14%;" />
        <div class="cloud" style="top:22%; left:66%; transform:scale(0.75);" />
        <div class="bird" style={bird('7%', '40%')}>
          <svg viewBox="0 0 24 10" width="22" height="10">
            <path
              d="M0 8 Q6 0 12 8 Q18 0 24 8"
              fill="none"
              stroke="var(--world-ink)"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </svg>
        </div>
        <div class="bird" style={bird('14%', '48%', 0.75, 0.32)}>
          <svg viewBox="0 0 24 10" width="22" height="10">
            <path
              d="M0 8 Q6 0 12 8 Q18 0 24 8"
              fill="none"
              stroke="var(--world-ink)"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </svg>
        </div>
      </>
    )
  }

  {kitId === 'soft-sage' && <div class="cloud" style="top:14%; left:60%;" />}

  {
    kitId === 'warm-peach' && (
      <>
        <div class="balloon">
          <svg viewBox="0 0 40 60" width="40" height="60">
            <ellipse cx="20" cy="20" rx="18" ry="20" fill="var(--world-accent)" opacity="0.85" />
            <path d="M10 38 L14 50 M30 38 L26 50 M20 40 L20 50" stroke="var(--world-ink)" stroke-width="1.2" opacity="0.5" />
            <rect x="14" y="50" width="12" height="8" rx="2" fill="var(--world-ink)" opacity="0.45" />
          </svg>
        </div>
        <div class="cloud" style="top:16%; left:16%; transform:scale(0.8);" />
      </>
    )
  }

  {
    kitId === 'lavender' && (
      <>
        <div class="flower" style="left:16%;" />
        <div class="flower" style="left:80%; transform:scale(0.85);" />
      </>
    )
  }

  {
    kitId === 'golden-meadow' && (
      <>
        <div class="sun" />
        <div class="bird" style={bird('6%', '62%')}>
          <svg viewBox="0 0 24 10" width="22" height="10">
            <path
              d="M0 8 Q6 0 12 8 Q18 0 24 8"
              fill="none"
              stroke="var(--world-ink)"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </svg>
        </div>
        <div class="bird" style={bird('11%', '70%', 0.75, 0.35)}>
          <svg viewBox="0 0 24 10" width="22" height="10">
            <path
              d="M0 8 Q6 0 12 8 Q18 0 24 8"
              fill="none"
              stroke="var(--world-ink)"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </svg>
        </div>

        <div class="landscape-strip">
          <div class="hill hill-back" />
          <div class="hill hill-front" />
          <div class="tree" style="left:14%;">
            <div class="trunk" />
            <div class="canopy c1" />
            <div class="canopy c2" />
            <div class="canopy c3" />
          </div>
          <div class="tree tree-small" style="left:82%;">
            <div class="trunk" />
            <div class="canopy c1" />
            <div class="canopy c2" />
          </div>
        </div>
      </>
    )
  }

  {
    kitId === 'forest-green' && (
      <div class="landscape-strip">
        <div class="hill hill-front" />
        <div class="tree" style="left:10%;">
          <div class="trunk" />
          <div class="canopy c1" />
          <div class="canopy c2" />
          <div class="canopy c3" />
        </div>
        <div class="tree tree-small" style="left:46%;">
          <div class="trunk" />
          <div class="canopy c1" />
          <div class="canopy c2" />
        </div>
        <div class="tree" style="left:84%; transform:scale(0.8);">
          <div class="trunk" />
          <div class="canopy c1" />
          <div class="canopy c2" />
          <div class="canopy c3" />
        </div>
      </div>
    )
  }

  {
    kitId === 'sunset' && (
      <>
        <div class="sun sun-low" />
        <div class="bird" style={bird('20%', '30%', 0.9, 0.35)}>
          <svg viewBox="0 0 24 10" width="22" height="10">
            <path
              d="M0 8 Q6 0 12 8 Q18 0 24 8"
              fill="none"
              stroke="var(--world-ink)"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </svg>
        </div>
        <div class="landscape-strip">
          <div class="peak peak-back" />
          <div class="peak peak-front" />
        </div>
      </>
    )
  }

  {
    kitId === 'soft-coral' && (
      <>
        <div class="bird" style={bird('8%', '58%')}>
          <svg viewBox="0 0 24 10" width="22" height="10">
            <path
              d="M0 8 Q6 0 12 8 Q18 0 24 8"
              fill="none"
              stroke="var(--world-ink)"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </svg>
        </div>
        <div class="bird" style={bird('14%', '66%', 0.75, 0.32)}>
          <svg viewBox="0 0 24 10" width="22" height="10">
            <path
              d="M0 8 Q6 0 12 8 Q18 0 24 8"
              fill="none"
              stroke="var(--world-ink)"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </svg>
        </div>
        <div class="flower" style="left:78%;" />
      </>
    )
  }
</div>

<style>
  .world-scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  /* Distant horizon glimpse — anchored near the top of the hero, well above
     where the word field renders, so ground elements never compete for
     space with the practice words below. Shallow and fixed-height by design:
     a previous version of this scene pinned tall silhouettes to the bottom
     of the hero, which both crowded the words and forced 130px+ of reserved
     padding beneath them just to make room. */
  .landscape-strip {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 130px;
    overflow: hidden;
  }

  /* ---------- shared primitives ---------- */

  .sun {
    position: absolute;
    top: 8%;
    right: 10%;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: radial-gradient(circle, #fff3d1, var(--world-accent-soft) 70%);
    box-shadow: 0 0 70px 22px color-mix(in srgb, var(--world-accent) 35%, transparent);
  }
  /* A low, near-horizon sun for dusk-leaning kits — stays tucked beside the
     landscape strip at the top of the hero, never drifting down toward the
     word field the way a bottom-anchored glow would. */
  .sun-low {
    top: 64px;
    right: 12%;
    width: 60px;
    height: 60px;
    box-shadow: 0 0 46px 14px color-mix(in srgb, var(--world-accent) 35%, transparent);
  }
  @media (max-width: 640px) {
    .sun {
      top: 4%;
      right: 6%;
      width: 52px;
      height: 52px;
      box-shadow: 0 0 40px 14px color-mix(in srgb, var(--world-accent) 30%, transparent);
    }
    .sun-low {
      top: 40px;
      width: 44px;
      height: 44px;
    }
  }

  .cloud {
    position: absolute;
    width: 90px;
    height: 34px;
  }
  .cloud::before,
  .cloud::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    background: #fff;
    opacity: 0.85;
  }
  .cloud::before {
    width: 60px;
    height: 34px;
    left: 0;
    top: 0;
  }
  .cloud::after {
    width: 40px;
    height: 40px;
    left: 30px;
    top: -10px;
  }

  .bird {
    position: absolute;
  }

  .balloon {
    position: absolute;
    top: 22%;
    left: 74%;
    animation: bobBalloon 5s ease-in-out infinite;
  }
  @keyframes bobBalloon {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .flower {
    position: absolute;
    top: 10%;
    width: 26px;
    height: 34px;
  }
  .flower::before {
    /* stem */
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 3px;
    height: 18px;
    background: var(--world-accent);
    opacity: 0.55;
    transform: translateX(-50%);
    border-radius: 2px;
  }
  .flower::after {
    /* bloom: a center dot with four petals set around it via box-shadow */
    content: '';
    position: absolute;
    top: 8px;
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--world-accent-soft);
    transform: translateX(-50%);
    box-shadow:
      0 -10px 0 -1px var(--world-accent),
      0 10px 0 -1px var(--world-accent),
      -10px 0 0 -1px var(--world-accent),
      10px 0 0 -1px var(--world-accent);
  }

  .hill {
    position: absolute;
    left: 50%;
    border-radius: 50%;
    transform: translateX(-50%);
  }
  .hill-back {
    bottom: -170px;
    width: 1300px;
    height: 220px;
    background: var(--world-ground-back);
    opacity: 0.9;
  }
  .hill-front {
    bottom: -155px;
    width: 1150px;
    height: 200px;
    background: var(--world-ground);
  }

  .tree {
    position: absolute;
    bottom: 6px;
    width: 44px;
    height: 66px;
    transform: scale(0.62);
    transform-origin: bottom center;
  }
  .tree-small {
    transform: scale(0.46);
  }
  .tree .trunk {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 8px;
    height: 34px;
    border-radius: 2px;
    background: var(--world-ground-back);
    opacity: 0.9;
  }
  .tree .canopy {
    position: absolute;
    border-radius: 50%;
    background: var(--world-ground);
  }
  .tree .c1 {
    width: 48px;
    height: 48px;
    left: 6px;
    bottom: 28px;
  }
  .tree .c2 {
    width: 34px;
    height: 34px;
    left: -6px;
    bottom: 40px;
    opacity: 0.9;
  }
  .tree .c3 {
    width: 34px;
    height: 34px;
    left: 30px;
    bottom: 44px;
    opacity: 0.9;
  }

  /* Jagged range via clip-path, not a border-triangle — keeps visible height
     small and predictable. Lives inside .landscape-strip near the top of the
     hero, nowhere near the word field, so it can never collide with a
     wrapped, multi-row word list regardless of how many rows it wraps to. */
  .peak {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
  }
  .peak-back {
    height: 78px;
    background: var(--world-ground-back);
    opacity: 0.85;
    clip-path: polygon(
      0% 100%,
      0% 62%,
      16% 22%,
      30% 50%,
      46% 10%,
      62% 46%,
      78% 18%,
      100% 55%,
      100% 100%
    );
  }
  .peak-front {
    height: 56px;
    background: var(--world-ground);
    clip-path: polygon(0% 100%, 8% 45%, 24% 72%, 40% 25%, 56% 60%, 72% 20%, 88% 50%, 100% 35%, 100% 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .balloon {
      animation: none !important;
    }
  }
</style>
