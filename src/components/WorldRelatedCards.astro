---
import type { SpellingListEntry } from '@/lib/content/spellingLists';

interface Props {
  heading: string;
  items: SpellingListEntry[];
  listLink: (entry: SpellingListEntry) => string;
}

const { heading, items, listLink } = Astro.props;
---

{
  items.length > 0 && (
    <div class="related-block">
      <h3 class="related-heading">{heading}</h3>
      <div class="related-row">
        {items.map((item) => (
          <a href={listLink(item)} class="related-card">
            <span class="related-title">{item.data.title}</span>
            <span class="related-count">{item.data.words.length} words →</span>
          </a>
        ))}
      </div>
    </div>
  )
}

<style>
  .related-block {
    margin-bottom: 26px;
  }
  .related-block:last-child {
    margin-bottom: 0;
  }
  .related-heading {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--world-ink);
    opacity: 0.55;
    margin: 0 0 10px;
  }
  .related-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .related-card {
    position: relative;
    flex: 1 1 15rem;
    overflow: hidden;
    border-radius: 14px;
    background: #ffffff;
    border: 1px solid color-mix(in srgb, var(--world-ink) 12%, transparent);
    padding: 14px 18px 14px 20px;
    text-decoration: none;
    color: var(--world-ink);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .related-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    background: var(--world-accent);
  }
  .related-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 22px -12px color-mix(in srgb, var(--world-ink) 40%, transparent);
  }
  .related-title {
    display: block;
    font-family: 'Baloo 2', sans-serif;
    font-weight: 600;
    font-size: 16px;
  }
  .related-count {
    display: block;
    margin-top: 4px;
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 13px;
    color: var(--world-accent);
  }
</style>
