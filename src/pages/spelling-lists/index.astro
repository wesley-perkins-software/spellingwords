---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ListMetadataBadges from '@/components/ListMetadataBadges.astro';
import { groupByCategory, isPublished } from '@/lib/content/spellingLists';
import { categoryDescriptions, categoryLabels, categoryOrder } from '@/lib/content/categoryMeta';

const entries = (await getCollection('spelling-lists')).filter(isPublished);
const groups = groupByCategory(entries);

const orderedCategories = [
  ...categoryOrder,
  ...[...groups.keys()].filter((category) => !(categoryOrder as readonly string[]).includes(category)),
].filter((category) => groups.has(category));

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Spelling Lists Library' },
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://spellingwords.app');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};
---

<Layout
  title="Spelling Lists Library — spellingwords"
  description="Browse curated, ready-to-use spelling lists organized by sight words, phonics, grade level, and challenge tiers."
  jsonLd={breadcrumbJsonLd}
>
  <header class="sticky top-0 z-10 border-b border-classroom-blue/10 bg-white/90 backdrop-blur-sm">
    <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
      <a
        href="/"
        class="flex items-center gap-2 font-display text-lg font-bold text-app-charcoal tracking-tight"
        aria-label="spellingwords home"
      >
        <span
          aria-hidden="true"
          class="flex h-7 w-7 items-center justify-center rounded-xl bg-classroom-blue text-white"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M11.5 2.5l2 2-8 8H3.5v-2l8-8z" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9.5 4.5l2 2" stroke="white" stroke-width="1.75" stroke-linecap="round"/>
          </svg>
        </span>
        spelling<span class="text-classroom-blue">words</span>
      </a>
    </div>
  </header>

  <main id="main-content">
    <section class="mx-auto max-w-3xl px-6 py-12 md:py-16" aria-labelledby="library-heading">
      <div class="mb-4">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <div class="flex flex-col gap-3">
        <h1 id="library-heading" class="font-display text-2xl font-bold text-app-charcoal md:text-3xl">
          The Spelling Lists Library
        </h1>
        <p class="max-w-2xl text-base leading-relaxed text-app-charcoal/60">
          Curated, ready-to-go spelling lists organized by sight words, phonics patterns, grade level, and
          challenge tiers. Pick one and start practicing right away — or head back home to paste in your
          own words instead. Both are first-class ways to use spellingwords.
        </p>
        <p class="max-w-2xl text-sm leading-relaxed text-app-charcoal/50">
          <strong class="font-semibold text-app-charcoal/70">Custom lists</strong> let you paste in any words
          you choose and start practicing immediately — perfect for this week's spelling homework.
          <strong class="font-semibold text-app-charcoal/70">Library lists</strong> are pre-built, structured
          progressions — complete with prerequisites and recommended next steps — for students working
          through a skill over time.
        </p>
        <p>
          <a
            href="/"
            class="inline-flex items-center gap-1 text-sm font-semibold text-classroom-blue hover:underline"
          >
            ← Back to paste your own words
          </a>
        </p>
      </div>

      <div class="mt-10 flex flex-col gap-12">
        {
          orderedCategories.map((category) => {
            const lists = groups.get(category) ?? [];
            return (
              <section aria-labelledby={`category-${category}-heading`} class="flex flex-col gap-4">
                <div class="flex flex-col gap-1">
                  <h2
                    id={`category-${category}-heading`}
                    class="font-display text-lg font-bold text-app-charcoal"
                  >
                    {categoryLabels[category] ?? category}
                  </h2>
                  {categoryDescriptions[category] && (
                    <p class="max-w-2xl text-sm leading-relaxed text-app-charcoal/50">
                      {categoryDescriptions[category]}
                    </p>
                  )}
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                  {lists.map((entry) => (
                    <a
                      href={`/spelling-lists/${entry.data.category}/${entry.data.urlSlug}`}
                      class="flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-classroom-blue/30 hover:shadow-md"
                    >
                      <div class="flex flex-col gap-1">
                        <h3 class="font-display text-base font-bold text-app-charcoal">{entry.data.title}</h3>
                        <p class="text-sm leading-relaxed text-app-charcoal/60">{entry.data.description}</p>
                      </div>
                      <ListMetadataBadges
                        difficulty={entry.data.difficulty}
                        durationMinutes={entry.data.estimatedDurationMinutes}
                        wordCount={entry.data.words.length}
                      />
                    </a>
                  ))}
                </div>
              </section>
            );
          })
        }
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-100 bg-white/60">
    <div class="mx-auto max-w-3xl px-6 py-8 text-center text-xs text-app-charcoal/35">
      &copy; {new Date().getFullYear()} spellingwords.app &mdash; Free spelling practice for every classroom.
    </div>
  </footer>
</Layout>
