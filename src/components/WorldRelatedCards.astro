---
import type { SpellingListEntry } from '@/lib/content/spellingLists';
import { getRelationshipCardModel } from '@/lib/content/relationshipCard';

interface Props {
  heading: string;
  items: SpellingListEntry[];
  listLink: (entry: SpellingListEntry) => string;
}

const { heading, items, listLink } = Astro.props;
---

{
  items.length > 0 && (
    <div class="related-block">
      <h3 class="related-heading">{heading}</h3>
      <div class="related-row">
        {items.map((item) => {
          const card = getRelationshipCardModel(item);
          return (
            <a href={listLink(item)} class="related-card">
              {card.gradeLabel && <span class="related-grade">{card.gradeLabel}</span>}
              <span class="related-title">{card.canonicalTitle}</span>
              <span class="related-count">{card.wordCount} words →</span>
            </a>
          );
        })}
      </div>
    </div>
  )
}

<style>
  .related-block {
    margin-bottom: 26px;
  }
  .related-block:last-child {
    margin-bottom: 0;
  }
  .related-heading {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--world-ink);
    opacity: 0.55;
    margin: 0 0 10px;
  }
  .related-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .related-card {
    position: relative;
    flex: 1 1 15rem;
    overflow: hidden;
    border-radius: 14px;
    background: #ffffff;
    border: 1px solid color-mix(in srgb, var(--world-ink) 10%, transparent);
    box-shadow: 0 2px 8px -3px color-mix(in srgb, var(--world-ink) 14%, transparent);
    padding: 15px 18px 15px 20px;
    text-decoration: none;
    color: var(--world-ink);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      border-color 0.15s ease;
  }
  .related-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: var(--world-accent);
  }
  .related-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--world-ink) 16%, transparent);
    box-shadow: 0 10px 22px -12px color-mix(in srgb, var(--world-ink) 40%, transparent);
  }
  .related-card:focus-visible {
    outline: 2px solid var(--world-accent);
    outline-offset: 2px;
  }
  .related-title {
    display: block;
    font-family: 'Baloo 2', sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 1.3;
  }
  .related-grade {
    display: block;
    margin-bottom: 3px;
    font-family: 'Nunito', sans-serif;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--world-ink);
    opacity: 0.55;
  }
  .related-count {
    display: block;
    margin-top: 5px;
    font-family: 'Nunito', sans-serif;
    font-weight: 700;
    font-size: 13px;
    color: var(--world-accent);
  }
</style>
