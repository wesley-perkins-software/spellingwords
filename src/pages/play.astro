---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Spelling Test — spellingwords"
  description="Take your custom spelling test. Hear each word spoken aloud and type your answer."
>
  <!-- Site header -->
  <header class="sticky top-0 z-10 border-b border-line bg-white/90 backdrop-blur-sm">
    <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
      <a
        href="/"
        class="flex items-center gap-2 font-display text-lg font-semibold text-ink tracking-tight"
        aria-label="spellingwords home"
      >
        <span
          aria-hidden="true"
          class="flex h-7 w-7 items-center justify-center rounded-2xl bg-brand-blue text-white"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M11.5 2.5l2 2-8 8H3.5v-2l8-8z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9.5 4.5l2 2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
          </svg>
        </span>
        spelling<span class="text-brand-blue">words</span>
      </a>
      <a
        href="/"
        class="rounded-full px-4 py-2 text-sm font-semibold text-ink-soft transition-colors hover:bg-app-cloud hover:text-brand-blue"
      >
        ← New list
      </a>
    </div>
  </header>

  <main id="main-content">
    <div class="mx-auto max-w-xl px-6 py-12 md:py-16">

      <!-- Error screen -->
      <section id="screen-error" class="hidden text-center" aria-labelledby="error-heading">
        <div class="flex flex-col items-center gap-6">
          <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-feedback-incorrect/10 text-3xl text-feedback-incorrect" aria-hidden="true">✗</div>
          <div class="flex flex-col gap-2">
            <h1 id="error-heading" class="font-display text-2xl font-semibold text-ink">
              No word list found
            </h1>
            <p id="error-message" class="text-base text-ink-soft"></p>
          </div>
          <a
            href="/"
            class="rounded-full bg-brand-blue px-6 py-3 text-sm font-bold text-white shadow-[0_8px_20px_-8px_rgba(47,111,237,0.45)] transition hover:bg-brand-blue-deep"
          >
            ← Enter new words
          </a>
        </div>
      </section>

      <!-- Unsupported browser screen -->
      <section id="screen-unsupported" class="hidden text-center" aria-labelledby="unsupported-heading">
        <div class="flex flex-col items-center gap-6">
          <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-chip-sun/15 text-3xl" aria-hidden="true">🔇</div>
          <div class="flex flex-col gap-2">
            <h1 id="unsupported-heading" class="font-display text-2xl font-semibold text-ink">
              Audio not supported
            </h1>
            <p class="text-base text-ink-soft">
              Audio spelling tests are not supported in this browser.<br />
              Please try a modern browser with speech support.
            </p>
          </div>
          <a
            href="/"
            class="rounded-full bg-brand-blue px-6 py-3 text-sm font-bold text-white shadow-[0_8px_20px_-8px_rgba(47,111,237,0.45)] transition hover:bg-brand-blue-deep"
          >
            ← Go back
          </a>
        </div>
      </section>

      <!-- Begin screen -->
      <section id="screen-begin" class="hidden text-center" aria-labelledby="begin-heading">
        <div class="flex flex-col items-center gap-8">
          <div class="flex flex-col items-center gap-3">
            <h1 id="begin-heading" class="font-display text-3xl font-semibold text-ink">
              Ready to spell?
            </h1>
            <p id="begin-word-count" class="text-base text-ink-soft"></p>
            <p class="text-sm text-ink-soft">Each word will be spoken aloud. Take your time, and type what you hear.</p>
          </div>
          <button
            id="btn-begin"
            type="button"
            class="rounded-full bg-brand-blue px-8 py-4 text-base font-bold text-white shadow-[0_8px_24px_-8px_rgba(47,111,237,0.45)] transition hover:bg-brand-blue-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue active:scale-[0.97]"
          >
            Begin Test
          </button>
        </div>

        <!-- Voice settings — tucked away for parents & teachers, not part of the child's task -->
        <div class="mt-10 border-t border-line pt-6 text-left">
          <button
            id="btn-voice-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="voice-settings-panel"
            class="text-xs text-ink-soft transition-colors hover:text-ink-soft"
          >
            For parents &amp; teachers: voice settings ▾
          </button>
          <div
            id="voice-settings-panel"
            class="hidden mt-3 rounded-2xl border border-line bg-white p-4 flex flex-col gap-3"
            role="group"
            aria-label="Voice settings"
          >
            <!-- Auto-selected voice status -->
            <p class="text-xs text-ink-soft">
              Voice: <span id="voice-name-display">best available</span>
            </p>

            <!-- Speed slider -->
            <div class="flex items-center gap-3">
              <label for="speed-range" class="text-xs font-medium text-ink-soft whitespace-nowrap w-10">Speed</label>
              <input
                id="speed-range"
                type="range"
                min="0.5"
                max="1.1"
                step="0.05"
                value="0.5"
                class="flex-1 accent-brand-blue"
                aria-label="Speech speed"
              />
              <span id="speed-label" class="text-xs font-medium text-ink-soft w-10 text-right">0.50×</span>
            </div>

            <!-- Test voice -->
            <button
              id="btn-test-voice"
              type="button"
              class="self-start rounded-full border border-line bg-white px-4 py-2 text-xs font-semibold text-ink-soft transition-colors hover:border-brand-blue/40 hover:text-brand-blue"
            >
              Test voice
            </button>

            <!-- Helper text -->
            <p class="text-xs italic leading-relaxed text-ink-soft">
              These settings are saved for this session. Children won't see this panel during practice.
            </p>
          </div>
        </div>
      </section>

      <!-- Question screen -->
      <section id="screen-question" class="hidden" aria-labelledby="question-heading">
        <div class="flex flex-col gap-8">
          <!-- Progress -->
          <div class="flex items-center justify-between">
            <p
              id="progress"
              class="font-mono text-sm font-medium tracking-wide text-ink-soft"
              aria-live="polite"
              aria-atomic="true"
            ></p>
            <button
              id="btn-repeat"
              type="button"
              class="flex items-center gap-2 rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold text-ink-soft transition hover:border-brand-blue/40 hover:bg-app-cloud hover:text-brand-blue focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-blue"
              aria-label="Repeat the word"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
              </svg>
              Repeat Word
            </button>
          </div>

          <!-- Instruction and answer area -->
          <div class="flex flex-col gap-5">
            <h1 id="question-heading" class="sr-only">Type the word you hear</h1>
            <p id="question-instruction" class="min-h-[3rem] text-base leading-relaxed text-ink-soft"></p>
            <div class="flex flex-col gap-2">
              <input
                id="answer-input"
                type="text"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                placeholder="Type the word…"
                class="w-full rounded-2xl border-2 border-line bg-white px-5 py-4 text-lg font-medium text-ink placeholder:text-ink-soft/50 transition focus:border-brand-blue focus:outline-none"
                aria-label="Your answer"
              />
              <p
                id="answer-error"
                class="min-h-[1.25rem] px-1 text-sm text-feedback-incorrect"
                aria-live="polite"
                role="alert"
              ></p>
            </div>
            <button
              id="btn-submit"
              type="button"
              class="w-full rounded-full bg-brand-blue px-6 py-3.5 text-sm font-bold text-white shadow-[0_8px_20px_-8px_rgba(47,111,237,0.4)] transition hover:bg-brand-blue-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue active:scale-[0.97]"
            >
              Submit Answer
            </button>
          </div>
        </div>
      </section>

      <!-- Feedback screen -->
      <section id="screen-feedback" class="hidden text-center" aria-labelledby="feedback-heading" aria-live="assertive">
        <div class="flex flex-col items-center gap-8">
          <div id="feedback-icon" class="flex h-20 w-20 items-center justify-center rounded-2xl text-4xl" aria-hidden="true"></div>
          <div class="flex flex-col gap-2">
            <h1 id="feedback-heading" class="font-display text-2xl font-semibold text-ink"></h1>
            <p id="feedback-detail" class="text-base text-ink-soft"></p>
          </div>
          <button
            id="btn-next"
            type="button"
            class="rounded-full bg-brand-blue px-8 py-3.5 text-sm font-bold text-white shadow-[0_8px_20px_-8px_rgba(47,111,237,0.4)] transition hover:bg-brand-blue-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue active:scale-[0.97]"
          >
            Next Word →
          </button>
        </div>
      </section>

      <!-- Results screen -->
      <section id="screen-results" class="hidden" aria-labelledby="results-heading">
        <div class="flex flex-col gap-8">
          <div class="text-center">
            <h1 id="results-heading" class="font-display text-3xl font-semibold text-ink">
              Nice work today.
            </h1>
            <p id="results-summary" class="mt-3 text-lg font-medium text-ink"></p>
            <p id="results-missed-summary" class="mt-1 text-base text-ink-soft"></p>
            <p id="results-score" class="mt-4 text-sm text-ink-soft/70"></p>
          </div>

          <!-- Missed words — the heart of the results screen; hidden when nothing was missed -->
          <div id="results-missed-section" class="hidden rounded-3xl border border-line bg-white p-6 shadow-[0_4px_16px_-6px_rgba(31,41,55,0.08)]">
            <h2 class="mb-1 text-base font-semibold text-ink">
              Let's look at these together
            </h2>
            <p class="mb-3 text-sm text-ink-soft">A little more time with these, and they'll feel easy.</p>
            <ul id="results-missed-list" class="flex flex-wrap gap-2" aria-label="Words to practice again"></ul>
          </div>

          <!-- Actions — the most useful next step leads -->
          <div class="flex flex-col gap-3">
            <button
              id="btn-review-missed"
              type="button"
              class="hidden w-full rounded-full bg-brand-blue px-6 py-3.5 text-sm font-bold text-white shadow-[0_8px_20px_-8px_rgba(47,111,237,0.4)] transition hover:bg-brand-blue-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue active:scale-[0.97]"
            >
              Practice the tricky words
            </button>
            <button
              id="btn-retry"
              type="button"
              class="w-full rounded-full border-2 border-brand-blue bg-white px-6 py-3.5 text-sm font-bold text-brand-blue transition hover:bg-app-cloud focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue active:scale-[0.97]"
            >
              Start this list again
            </button>
            <a
              href="/"
              class="w-full rounded-full px-6 py-3.5 text-center text-sm font-semibold text-ink-soft transition hover:bg-app-cloud hover:text-ink"
            >
              Enter New Words
            </a>
          </div>
        </div>
      </section>

    </div>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto max-w-3xl px-6 py-8 text-center text-xs text-ink-soft">
      &copy; {new Date().getFullYear()} spellingwords.app &mdash; Free spelling practice for every classroom.
    </div>
  </footer>
</Layout>

<script>
  import { decodeWordList } from '@/lib/words';
  import { createSpeechController, selectPreferredVoice } from '@/modules/speech';
  import type { SpeechSynthesisVoiceAdapter } from '@/modules/speech';
  import {
    spellingTestReducer,
    createInitialState,
    initializeTest,
    startTest,
    submitAnswer,
    nextWord,
    resetTest,
    reviewMissed,
  } from '@/modules/spellingTest/stateMachine';
  import type { TestState } from '@/modules/spellingTest/types';

  // --- DOM refs ---
  const $ = (id: string) => document.getElementById(id)!;

  const screenError = $('screen-error');
  const screenUnsupported = $('screen-unsupported');
  const screenBegin = $('screen-begin');
  const screenQuestion = $('screen-question');
  const screenFeedback = $('screen-feedback');
  const screenResults = $('screen-results');

  const allScreens = [screenError, screenUnsupported, screenBegin, screenQuestion, screenFeedback, screenResults];

  const beginWordCount = $('begin-word-count');
  const progressEl = $('progress');
  const questionInstruction = $('question-instruction');
  const answerInput = $('answer-input') as HTMLInputElement;
  const answerError = $('answer-error');
  const feedbackIcon = $('feedback-icon');
  const feedbackHeading = $('feedback-heading');
  const feedbackDetail = $('feedback-detail');
  const resultsSummary = $('results-summary');
  const resultsMissedSummary = $('results-missed-summary');
  const resultsScore = $('results-score');
  const resultsMissedSection = $('results-missed-section');
  const resultsMissedList = $('results-missed-list');
  const btnBegin = $('btn-begin') as HTMLButtonElement;
  const btnRepeat = $('btn-repeat') as HTMLButtonElement;
  const btnSubmit = $('btn-submit') as HTMLButtonElement;
  const btnNext = $('btn-next') as HTMLButtonElement;
  const btnRetry = $('btn-retry') as HTMLButtonElement;
  const btnReviewMissed = $('btn-review-missed') as HTMLButtonElement;
  const errorMessage = $('error-message');

  // Voice controls
  const btnVoiceToggle = $('btn-voice-toggle') as HTMLButtonElement;
  const voiceSettingsPanel = $('voice-settings-panel');
  const voiceNameDisplay = $('voice-name-display');
  const speedRange = $('speed-range') as HTMLInputElement;
  const speedLabel = $('speed-label');
  const btnTestVoice = $('btn-test-voice') as HTMLButtonElement;

  // --- Module state ---
  const speech = createSpeechController();
  let state: TestState = createInitialState();
  let originalWords: string[] = [];

  // Voice settings state — no persistence; resets on page load
  let selectedVoice: SpeechSynthesisVoiceAdapter | null = null;
  let currentRate = 0.5;

  // --- Warm, varied feedback copy ---
  // A calm adult helping a child — not a scoreboard. We rotate through these
  // so the same phrase doesn't land twice in a row and start to feel canned.
  const CORRECT_PHRASES = ['Nice work.', 'Good listening.', "That's it exactly.", 'Well spelled.', "You've got it."];
  const INCORRECT_PHRASES = ['A good attempt.', "That's a tricky one.", 'Close — good effort.', 'Good try.', "Let's come back to this one."];

  let lastCorrectPhrase = -1;
  let lastIncorrectPhrase = -1;

  function pickPhrase(pool: string[], lastIndex: number, remember: (i: number) => void): string {
    let i = Math.floor(Math.random() * pool.length);
    if (pool.length > 1 && i === lastIndex) i = (i + 1) % pool.length;
    remember(i);
    return pool[i];
  }

  // --- Progressive instructions ---
  // Full guidance up front; as the child settles in, the screen quietly
  // steps back rather than repeating itself on every single word.
  function instructionForIndex(index: number): string {
    if (index === 0) {
      return "Listen carefully, then type the word you hear. Take your time — there's no rush.";
    }
    if (index === 1) {
      return 'Type the word you hear, whenever you feel ready.';
    }
    return "You've got this.";
  }

  // --- Screen management ---
  function showScreen(target: HTMLElement): void {
    for (const screen of allScreens) {
      screen.classList.toggle('hidden', screen !== target);
    }
  }

  function showError(message: string): void {
    errorMessage.textContent = message;
    showScreen(screenError);
  }

  // --- Voice controls setup ---
  async function initVoiceControls(): Promise<void> {
    const allVoices = await speech.loadVoices();
    selectedVoice = selectPreferredVoice(allVoices);
    if (selectedVoice) {
      voiceNameDisplay.textContent = selectedVoice.name;
    }
  }

  // --- Initialization ---
  function init(): void {
    const params = new URLSearchParams(window.location.search);
    const payload = params.get('list');

    if (!payload) {
      showError('No word list found. Please go back and enter your words.');
      return;
    }

    const decoded = decodeWordList(payload);
    if (!decoded.ok) {
      showError('The word list could not be loaded. Please go back and try again.');
      return;
    }

    if (!speech.isSpeechSupported()) {
      showScreen(screenUnsupported);
      return;
    }

    originalWords = decoded.words;
    state = spellingTestReducer(createInitialState(), initializeTest(originalWords));

    const count = originalWords.length;
    beginWordCount.textContent = `${count} ${count === 1 ? 'word' : 'words'} loaded`;
    showScreen(screenBegin);

    // Load voices in the background — does not require a user gesture
    initVoiceControls();
  }

  // --- Render helpers ---
  function speechOptions() {
    return { voice: selectedVoice, rate: currentRate };
  }

  function renderQuestion(): void {
    const current = state.words[state.currentIndex];
    const total = state.words.length;
    const pos = state.currentIndex + 1;

    progressEl.textContent = `Word ${pos} of ${total}`;
    questionInstruction.textContent = instructionForIndex(state.currentIndex);
    answerInput.value = '';
    answerError.textContent = '';

    showScreen(screenQuestion);
    requestAnimationFrame(() => answerInput.focus());

    speech.speakWord(current.word, speechOptions());
  }

  function renderFeedback(): void {
    const correct = state.lastAnswerCorrect;
    const currentWord = state.words[state.currentIndex].word;

    if (correct) {
      feedbackIcon.textContent = '✓';
      feedbackIcon.className = 'flex h-20 w-20 items-center justify-center rounded-xl bg-feedback-correct/12 text-4xl text-feedback-correct';
      feedbackHeading.textContent = pickPhrase(CORRECT_PHRASES, lastCorrectPhrase, (i) => (lastCorrectPhrase = i));
      feedbackHeading.className = 'font-display text-2xl font-semibold text-feedback-correct';
      feedbackDetail.textContent = '';
    } else {
      feedbackIcon.textContent = '✗';
      feedbackIcon.className = 'flex h-20 w-20 items-center justify-center rounded-2xl bg-feedback-incorrect/10 text-4xl text-feedback-incorrect';
      feedbackHeading.textContent = pickPhrase(INCORRECT_PHRASES, lastIncorrectPhrase, (i) => (lastIncorrectPhrase = i));
      feedbackHeading.className = 'font-display text-2xl font-semibold text-feedback-incorrect';
      feedbackDetail.textContent = `It's spelled ${currentWord}.`;
    }

    const isLast = state.currentIndex === state.words.length - 1;
    btnNext.textContent = isLast ? 'See Results →' : 'Next Word →';

    showScreen(screenFeedback);
  }

  function renderResults(): void {
    const result = state.result!;
    const missedCount = result.missedWords.length;

    // Lead with what the child did, not a grade.
    resultsSummary.textContent = `You practiced ${result.total} ${result.total === 1 ? 'word' : 'words'}.`;

    if (missedCount > 0) {
      resultsMissedSummary.textContent = `${missedCount} ${missedCount === 1 ? 'word needs' : 'words need'} a little more practice.`;
      resultsMissedList.textContent = '';
      for (const w of result.missedWords) {
        const li = document.createElement('li');
        li.textContent = w.word;
        li.className = 'rounded-full bg-feedback-incorrect/10 px-3 py-1.5 text-sm font-semibold text-feedback-incorrect';
        resultsMissedList.appendChild(li);
      }
      resultsMissedSection.classList.remove('hidden');

      // The most useful next step — practicing the words that need it — leads.
      btnReviewMissed.classList.remove('hidden');
      btnReviewMissed.className = 'w-full rounded-full bg-brand-blue px-6 py-3.5 text-sm font-bold text-white shadow-[0_8px_20px_-8px_rgba(47,111,237,0.4)] transition hover:bg-brand-blue-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue active:scale-[0.97]';
      btnRetry.className = 'w-full rounded-full border-2 border-brand-blue bg-white px-6 py-3.5 text-sm font-bold text-brand-blue transition hover:bg-app-cloud focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue active:scale-[0.97]';
    } else {
      resultsMissedSummary.textContent = 'Every word was spelled correctly.';
      resultsMissedSection.classList.add('hidden');

      // Nothing to review — starting again becomes the one clear option.
      btnReviewMissed.classList.add('hidden');
      btnRetry.className = 'w-full rounded-full bg-brand-blue px-6 py-3.5 text-sm font-bold text-white shadow-[0_8px_20px_-8px_rgba(47,111,237,0.4)] transition hover:bg-brand-blue-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue active:scale-[0.97]';
    }

    // Score is kept available, but quiet — a footnote, not the headline.
    resultsScore.textContent = `${result.correct} of ${result.total} correct · ${result.percentage}%`;

    showScreen(screenResults);
  }

  // --- Event handlers ---
  function handleSubmit(): void {
    const answer = answerInput.value.trim();

    if (!answer) {
      answerError.textContent = 'Please type your answer.';
      answerInput.focus();
      return;
    }

    state = spellingTestReducer(state, submitAnswer(answer, Date.now()));
    renderFeedback();
  }

  btnBegin.addEventListener('click', () => {
    state = spellingTestReducer(state, startTest(Date.now()));
    renderQuestion();
  });

  btnRepeat.addEventListener('click', () => {
    speech.repeatWord(speechOptions());
  });

  answerInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') handleSubmit();
  });

  btnSubmit.addEventListener('click', handleSubmit);

  btnNext.addEventListener('click', () => {
    state = spellingTestReducer(state, nextWord(Date.now()));
    if (state.status === 'awaitingAnswer') {
      renderQuestion();
    } else if (state.status === 'complete') {
      renderResults();
    }
  });

  btnRetry.addEventListener('click', () => {
    state = spellingTestReducer(resetTest(), initializeTest(originalWords));
    const count = originalWords.length;
    beginWordCount.textContent = `${count} ${count === 1 ? 'word' : 'words'} loaded`;
    showScreen(screenBegin);
  });

  btnReviewMissed.addEventListener('click', () => {
    // reviewMissed transitions directly to awaitingAnswer — call in click handler (iOS-safe)
    state = spellingTestReducer(state, reviewMissed());
    renderQuestion();
  });

  // Voice settings toggle
  btnVoiceToggle.addEventListener('click', () => {
    const open = voiceSettingsPanel.classList.toggle('hidden') === false;
    btnVoiceToggle.setAttribute('aria-expanded', String(open));
    btnVoiceToggle.textContent = open
      ? 'For parents & teachers: voice settings ▴'
      : 'For parents & teachers: voice settings ▾';
  });

  speedRange.addEventListener('input', () => {
    currentRate = parseFloat(speedRange.value);
    speedLabel.textContent = `${currentRate.toFixed(2).replace(/0$/, '')}×`;
  });

  btnTestVoice.addEventListener('click', () => {
    speech.speakWord('because', speechOptions());
  });

  // --- Boot ---
  init();
</script>
