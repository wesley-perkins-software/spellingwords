---
import Proto from './_shared/Proto.astro';
import Header from './_shared/Header.astro';
import Footer from './_shared/Footer.astro';

const words = ['cat', 'hat', 'bed', 'red', 'pig', 'sit', 'hot', 'dog', 'bug', 'run'];
---

<Proto
  title="Short Vowels: CVC Words — Direction B prototype"
  description="Design exploration: soft tinted surfaces, gentle shape, tactile warmth."
>
  <Header currentPath="/design-explore/direction-b/skill" />

  <main id="main">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/design-explore/direction-b/">Home</a></li>
          <li><a href="/design-explore/direction-b/grade-hub">Grade 1 Spelling Words</a></li>
          <li><a href="/design-explore/direction-b/skill">Core Spelling</a></li>
          <li aria-current="page">Short Vowels: CVC Words</li>
        </ol>
      </nav>

      <!-- ============ HERO CARD ============ -->
      <section class="hero-card">
        <ul class="chip-row" aria-label="List details">
          <li class="chip tint-mint">Grade 1</li>
          <li class="chip tint-sky">Phonics</li>
          <li class="chip tint-peach">Beginner</li>
        </ul>
        <h1>Short Vowels: CVC Words</h1>
        <a class="cta-primary" href="/design-explore/direction-b/practice">Practice these words →</a>
      </section>

      <div class="content-grid">
        <div class="content-main">
          <!-- ============ WHAT ARE ============ -->
          <section class="prose-section">
            <h2>What are Short Vowels: CVC Words?</h2>
            <p>
              This list practices short-vowel CVC words such as cat, hot, and bug — a
              foundational phonics pattern from the early-elementary curriculum.
            </p>
          </section>

          <!-- ============ READINESS ============ -->
          <section class="prose-section">
            <h2>These spelling words are a good fit for students who...</h2>
            <p>
              can identify beginning and ending consonant sounds, and are ready to blend a single
              short-vowel sound in the middle of a three-letter word.
            </p>
          </section>

          <!-- ============ WORD LIST ============ -->
          <section class="prose-section">
            <h2>Word list</h2>
            <ul class="word-list">
              {words.map((word) => <li>{word}</li>)}
            </ul>
          </section>

          <!-- ============ BODY ============ -->
          <section class="prose-section">
            <h2>About this pattern</h2>
            <p>
              Consonant-vowel-consonant (CVC) words are the first words most students decode and
              spell independently. Practicing one short-vowel sound at a time — and then mixing
              them — builds the pattern recognition that later phonics work depends on.
            </p>
          </section>

          <!-- ============ FAQ ============ -->
          <section class="prose-section">
            <h2>Frequently asked questions</h2>
            <dl class="faq">
              <div class="faq-item">
                <dt>What are short-vowel CVC words?</dt>
                <dd>
                  This list practices short-vowel CVC words such as cat, hot, and bug — a
                  foundational phonics pattern from the early-elementary curriculum.
                </dd>
              </div>
            </dl>
          </section>

          <p class="source-line">Curated by the SpellingWords.app editorial team.</p>
        </div>

        <!-- ============ GO DEEPER ============ -->
        <aside class="deeper-panel tint-lilac" aria-labelledby="deeper-heading">
          <h2 id="deeper-heading">Go deeper</h2>
          <a class="deeper-link" href="#">
            <span class="deeper-title">Silent E: Long A Words</span>
            <span class="deeper-teaser">
              The next step after short vowels: words where a silent e changes the vowel sound.
            </span>
          </a>
        </aside>
      </div>
    </div>
  </main>

  <Footer />
</Proto>

<style>
  main {
    padding-block: clamp(1.5rem, 4vw, 2.5rem) clamp(3rem, 6vw, 5rem);
  }

  /* ---------- Breadcrumbs ---------- */
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    font-size: 0.9rem;
    color: var(--ink-faint);
  }

  .breadcrumbs li:not(:last-child)::after {
    content: '/';
    margin-left: 0.4rem;
    color: var(--ink-faint);
  }

  .breadcrumbs a {
    text-decoration: none;
    color: var(--ink-soft);
    font-weight: 700;
  }

  .breadcrumbs a:hover {
    color: var(--brand-strong);
  }

  .breadcrumbs li[aria-current='page'] {
    color: var(--ink);
    font-weight: 700;
  }

  /* ---------- Hero card ---------- */
  .hero-card {
    background: var(--cream);
    border: 1px solid var(--cream-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
    padding: clamp(1.75rem, 4vw, 2.75rem);
    margin-bottom: 2.5rem;
  }

  .chip-row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0;
  }

  .chip {
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--canvas-raised);
    box-shadow: var(--shadow-sm);
  }

  .chip.tint-mint {
    color: var(--mint-ink);
  }
  .chip.tint-sky {
    color: var(--sky-ink);
  }
  .chip.tint-peach {
    color: var(--peach-ink);
  }

  .hero-card h1 {
    font-size: clamp(2rem, 4vw, 2.6rem);
    line-height: 1.15;
    color: var(--cream-ink);
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 1.5rem;
    background: var(--brand);
    color: var(--ink-on-brand);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    padding: 0.8rem 1.5rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    transition:
      background 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .cta-primary:hover {
    background: var(--brand-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  /* ---------- Content grid ---------- */
  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
    gap: clamp(2rem, 4vw, 3rem);
    align-items: start;
  }

  .content-main {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .prose-section h2 {
    font-size: 1.35rem;
  }

  .prose-section p {
    margin-top: 0.85rem;
    font-size: 1.04rem;
    line-height: 1.68;
    color: var(--ink-soft);
    max-width: 68ch;
  }

  /* ---------- Word list ---------- */
  .word-list {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .word-list li {
    background: var(--sky);
    border: 1px solid var(--sky-border);
    color: var(--sky-ink);
    border-radius: var(--radius-md);
    padding: 0.85rem 0.5rem;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    box-shadow: var(--shadow-sm);
  }

  /* ---------- FAQ ---------- */
  .faq {
    margin: 1rem 0 0;
  }

  .faq-item {
    background: var(--canvas-sunken);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.4rem;
  }

  .faq-item dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--ink);
  }

  .faq-item dd {
    margin: 0.6rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .source-line {
    font-size: 0.88rem;
    color: var(--ink-faint);
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }

  /* ---------- Go deeper ---------- */
  .deeper-panel {
    border-radius: var(--radius-lg);
    padding: 1.6rem 1.5rem;
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 5.5rem;
  }

  .tint-lilac {
    background: var(--lilac);
    border: 1px solid var(--lilac-border);
  }

  .deeper-panel h2 {
    font-size: 1.15rem;
    color: var(--lilac-ink);
  }

  .deeper-link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1rem;
    text-decoration: none;
    background: var(--canvas-raised);
    border-radius: var(--radius-md);
    padding: 1rem 1.1rem;
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .deeper-link:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .deeper-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--lilac-ink);
  }

  .deeper-teaser {
    font-size: 0.9rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--lilac-ink) 82%, var(--ink-soft));
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .content-grid {
      grid-template-columns: 1fr;
    }

    .deeper-panel {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .word-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 420px) {
    .word-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cta-primary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
