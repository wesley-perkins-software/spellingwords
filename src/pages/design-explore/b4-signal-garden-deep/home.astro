---
import Layout from './_Layout.astro';

const grades = [
  { g: 'K', color: 'var(--grade-k)', desc: 'First sounds, letters, and three-letter words.' },
  { g: '1', color: 'var(--grade-1)', desc: 'Silent e, letter teams, everyday high-frequency words.' },
  { g: '2', color: 'var(--grade-2)', desc: 'Blends, digraphs, and longer word families.' },
  { g: '3', color: 'var(--grade-3)', desc: 'Prefixes, suffixes, and multi-syllable patterns.' },
  { g: '4', color: 'var(--grade-4)', desc: 'Latin roots and more demanding spelling patterns.' },
  { g: '5', color: 'var(--grade-5)', desc: 'Advanced patterns getting students ready for middle school.' },
];

const skills = ['Short A Words', 'Long A Silent E Words', 'Soft C and Soft G', 'Consonant Blends', 'Silent Letters'];
---

<Layout title="Home" env="var(--brand)">
  <header class="explore-b4__header">
    <div class="explore-b4__header-inner">
      <span class="explore-b4__wordmark">spelling<span class="accent">words</span></span>
      <nav class="explore-b4__nav">
        <a href="#grades">Grades</a>
        <a href="#skills">Skills</a>
        <a href="#">How it works</a>
      </nav>
    </div>
  </header>

  <div class="scoop" style="padding: 48px 24px 68px;">
    <div class="wrap wrap--narrow" style="text-align: center; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 16px;">
      <span class="badge">Practice · Any List</span>
      <h1 style="font-size: clamp(30px, 4.4vw, 48px); line-height: 1.08;">
        One color, arriving with intention.
      </h1>
      <p style="opacity: 0.92; font-size: 16.5px; max-width: 46ch; line-height: 1.6;">
        Paste your own list or follow a grade-level path. Hear each word, then type it.
        Color shows up where it matters, then gets out of the way.
      </p>
    </div>
  </div>

  <div class="wrap wrap--narrow" style="margin-top: -40px; position: relative; z-index: 2; padding: 0 24px;">
    <div class="panel" style="overflow: hidden; box-shadow: 0 20px 40px -20px rgba(214, 51, 108, 0.28);">
      <div style="display: flex; align-items: center; justify-content: space-between; padding: 16px 22px; background: var(--brand); color: #fff;">
        <span style="font-family: var(--font-display); font-weight: 800; font-size: 13px; text-transform: uppercase; letter-spacing: 0.04em;">Your Words</span>
        <span style="font-size: 12px; font-weight: 800; background: #fff; color: var(--brand); padding: 4px 11px; border-radius: 999px;">0</span>
      </div>
      <textarea
        rows="3"
        placeholder="Type or paste your words here, one per line"
        style="width: 100%; border: none; resize: none; padding: 20px 22px; font-family: var(--font-word); font-size: 18px; color: var(--ink); background: transparent;"
      ></textarea>
      <div style="padding: 16px 22px; border-top: 1px solid var(--border); display: flex; justify-content: flex-end;">
        <button type="button" class="btn btn--primary">Start Practicing</button>
      </div>
    </div>
  </div>

  <main>
    <section id="grades" class="wrap" style="padding: 64px 24px 20px;">
      <h2 style="font-size: 26px; margin-bottom: 8px;">Browse by Grade</h2>
      <p style="color: var(--ink-soft); max-width: 60ch; margin-bottom: 26px;">
        A Kindergarten&ndash;5th grade path across Core Spelling, High-Frequency Words, and Themed Practice —
        each grade carries its own color, used only for that grade's own pages.
      </p>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 16px;">
        {grades.map((item) => (
          <a href="#" class="scoop scoop--tile" style={`background: ${item.color}; padding: 22px 20px 26px; text-decoration: none; display: block;`}>
            <span style="font-family: var(--font-display); font-weight: 800; font-size: 36px; line-height: 1;">{item.g}</span>
            <p style="margin-top: 10px; font-size: 13.5px; opacity: 0.95; line-height: 1.5;">{item.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="skills" style="margin-top: 56px;">
      <div class="scoop" style="padding: 40px 0 56px;">
        <div class="wrap" style="text-align: center;">
          <h2 style="color: #fff; font-size: 26px; margin-bottom: 8px;">Browse by Skill</h2>
          <p style="opacity: 0.9; max-width: 60ch; margin: 0 auto;">
            Already know what to work on? Explore 41 spelling skills, each with its own practice bank.
          </p>
        </div>
      </div>
      <div class="wrap" style="margin-top: -32px; position: relative; z-index: 2; padding-bottom: 60px;">
        <div class="panel" style="overflow: hidden; box-shadow: 0 20px 40px -20px rgba(214, 51, 108, 0.22); max-width: 700px; margin: 0 auto;">
          {skills.map((s, i) => (
            <a href="#" style={`display: flex; align-items: center; justify-content: space-between; padding: 17px 22px; text-decoration: none; color: inherit; ${i < skills.length - 1 ? 'border-bottom: 1px solid var(--border);' : ''}`}>
              <span style="font-family: var(--font-display); font-weight: 700; font-size: 16px;">{s}</span>
              <span style="color: var(--brand); font-weight: 800;">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="explore-b4__footer">
    <div class="wrap">No accounts. No timers. Just spelling.</div>
  </footer>
</Layout>
