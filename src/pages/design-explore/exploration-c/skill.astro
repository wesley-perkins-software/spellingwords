      font-size: 1.15rem;
      margin-top: 2.25rem;
      margin-bottom: 0.75rem;
    }

    .prose p {
      font-size: 0.98rem;
      line-height: 1.7;
      color: var(--ink-soft);
      margin-bottom: 1rem;
      max-width: 68ch;
    }

    .prose ul,
    .prose ol {
      color: var(--ink-soft);
      font-size: 0.98rem;
      line-height: 1.7;
      margin: 0 0 1rem;
      padding-left: 1.4rem;
      max-width: 68ch;
    }

    .prose li {
      margin-bottom: 0.35rem;
    }

    .prose em {
      color: var(--ink);
      font-style: normal;
      font-weight: 600;
    }

