---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
---

<Layout
  title="Spelling Test — spellingwords"
  description="Take your custom spelling test. Hear each word spoken aloud and type your answer."
  theme="direction-a"
>
  <SiteHeader variant="practice" theme="direction-a" />

  <main id="main-content">
    <!-- Narrow container: error / unsupported / begin screens -->
    <div class="mx-auto max-w-xl px-6 py-12 md:py-16">
      <!-- Error screen -->
      <section id="screen-error" class="hidden text-center" aria-labelledby="error-heading">
        <div class="flex flex-col items-center gap-6">
          <div
            class="flex h-16 w-16 items-center justify-center rounded-2xl bg-da-incorrect-bg text-da-incorrect"
            aria-hidden="true"
          >
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"
              ></line></svg
            >
          </div>
          <div class="flex flex-col gap-2">
            <h1 id="error-heading" class="font-quicksand text-2xl font-bold text-da-ink">
              No word list found
            </h1>
            <p id="error-message" class="text-base text-da-ink-soft"></p>
          </div>
          <a
            href="/"
            class="rounded-xl bg-da-brand px-6 py-3 font-quicksand text-sm font-bold text-white no-underline transition hover:bg-da-brand-strong"
          >
            ← Enter new words
          </a>
        </div>
      </section>

      <!-- Unsupported browser screen -->
      <section
        id="screen-unsupported"
        class="hidden text-center"
        aria-labelledby="unsupported-heading"
      >
        <div class="flex flex-col items-center gap-6">
          <div
            class="flex h-16 w-16 items-center justify-center rounded-2xl bg-da-sun-tint text-da-ink-soft"
            aria-hidden="true"
          >
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line
                x1="23"
                y1="9"
                x2="17"
                y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg
            >
          </div>
          <div class="flex flex-col gap-2">
            <h1 id="unsupported-heading" class="font-quicksand text-2xl font-bold text-da-ink">
              Audio not supported
            </h1>
            <p class="text-base text-da-ink-soft">
              Audio spelling tests are not supported in this browser.<br />
              Please try a modern browser with speech support.
            </p>
          </div>
          <a
            href="/"
            class="rounded-xl bg-da-brand px-6 py-3 font-quicksand text-sm font-bold text-white no-underline transition hover:bg-da-brand-strong"
          >
            ← Go back
          </a>
        </div>
      </section>

      <!-- Begin screen -->
      <section id="screen-begin" class="hidden" aria-labelledby="begin-heading">
        <div class="flex flex-col items-center gap-8 text-center">
          <!-- Readiness phrase + session identity, grouped tightly -->
          <div class="flex flex-col items-center gap-3">
            <p class="font-mulish text-base font-bold text-da-ink-soft tracking-wide">Let's begin.</p>
            <h1 id="begin-heading" class="font-quicksand text-3xl font-bold text-da-ink leading-snug">
            </h1>
            <p id="begin-word-count" class="font-mulish text-base text-da-ink-soft"></p>
          </div>

          <!-- Instructional line -->
          <p class="font-mulish text-base text-da-ink-soft">Listen carefully and type what you hear.</p>

          <!-- Primary CTA -->
          <button
            id="btn-begin"
            type="button"
            class="w-full min-h-[44px] rounded-xl bg-da-coral px-10 py-4 font-quicksand text-[19px] font-bold text-white tracking-[0.01em] shadow-[0_8px_20px_-8px_rgba(255,138,91,0.55)] transition hover:bg-da-coral-strong hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-da-coral active:translate-y-0"
          >
            Start Practice <span aria-hidden="true">→</span>
          </button>

          <!-- Hidden session meta slot for future chunking -->
          <span id="begin-session-meta" class="hidden"></span>
        </div>
      </section>
    </div>

    <!-- Practice stage — a restrained, full-bleed cool-blue band gives the
         active question/feedback/results states their own environmental
         identity as a distinct mode, rather than floating on the same
         canvas as the editorial pages. -->
    <div id="practice-stage" class="hidden bg-da-brand-tint py-10 md:py-14">
      <div class="mx-auto max-w-xl md:max-w-content-md px-6">
        <!-- Shared session progress — visible during question AND feedback, hidden otherwise -->
        <div id="session-progress" class="hidden mb-5 flex flex-col gap-2">
          <p
            id="progress"
            class="font-quicksand text-sm font-bold text-da-ink-soft"
            aria-live="polite"
            aria-atomic="true"
          >
          </p>
          <div class="h-3 rounded-full bg-da-canvas-sunken overflow-hidden">
            <div
              id="progress-bar"
              class="h-full rounded-full bg-da-brand transition-[width] duration-400"
              style="width: 0%"
            >
            </div>
          </div>
        </div>

        <!-- Question screen
             Uses CSS grid (1fr auto) with a shared min-height so the Check Spelling button
             always occupies a consistent vertical slot. -->
        <section
          id="screen-question"
          class="hidden grid grid-rows-[1fr_auto] gap-4 min-h-[420px]"
          aria-labelledby="question-heading"
        >
          <!-- White interaction surface — the focused workbook card inside the cool stage -->
          <div
            class="rounded-2xl border border-da-border bg-da-canvas-raised shadow-md px-7 py-8 md:px-8 md:py-9 flex flex-col gap-7"
          >
            <h1 id="question-heading" class="sr-only">Type the word you hear</h1>

            <!-- Hear Word / Hear Sentence controls — large, primary listening action -->
            <div class="flex flex-col items-center gap-3 rounded-xl bg-da-canvas-sunken px-4 py-7">
              <button
                id="btn-repeat"
                type="button"
                class="flex h-28 w-28 items-center justify-center rounded-full bg-da-brand text-white shadow-[0_10px_24px_-8px_rgba(46,125,209,0.55),0_0_0_6px_theme(colors.da.canvas-raised),0_0_0_8px_theme(colors.da.brand-tint)] transition hover:bg-da-brand-strong hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-da-brand active:translate-y-0"
                aria-label="Hear the word again"
                aria-describedby="hear-word-caption"
              >
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 10v4h3.5L12 17.5v-11L7.5 10H4z"></path>
                  <path d="M15.5 9a3.5 3.5 0 010 6"></path>
                  <path d="M18 6.5a7 7 0 010 11"></path>
                </svg>
              </button>
              <p id="hear-word-caption" class="font-quicksand text-lg font-bold text-da-ink">Hear Word</p>

              <button
                id="btn-sentence"
                type="button"
                class="hidden mt-1 items-center gap-2 rounded-full border-[1.5px] border-da-border-strong bg-da-canvas-sunken px-5 py-2.5 font-mulish text-sm font-bold text-da-ink-soft transition hover:bg-da-brand-tint hover:text-da-brand-strong focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-da-brand"
                aria-label="Hear the word used in a sentence again"
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
                Hear Sentence
              </button>

              <!-- Shown only when no example sentence exists for this word -->
              <p id="no-sentence-note" class="hidden mt-1 font-mulish text-sm font-semibold text-da-ink-soft" aria-live="polite">
                No sentence available for this word.
              </p>
            </div>

            <!-- Answer input -->
            <div class="flex flex-col gap-2">
              <p id="question-instruction" class="text-center text-base font-bold text-da-ink"></p>
              <input
                id="answer-input"
                type="text"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                placeholder="Type the word"
                class="w-full rounded-xl border-[2.5px] border-da-border-strong bg-da-canvas px-5 py-4 text-center font-word text-3xl font-semibold text-da-ink tracking-wide placeholder:font-mulish placeholder:font-normal placeholder:text-da-ink-faint/60 transition focus:border-da-brand focus:outline-none"
                aria-label="Your answer"
              />
              <p
                id="answer-error"
                class="min-h-[1.25rem] px-1 text-center text-sm font-semibold text-da-incorrect"
                aria-live="polite"
                role="alert"
              >
              </p>
            </div>
          </div>

          <!-- Primary action — grid row 2, same slot as Continue button on feedback screen -->
          <button
            id="btn-submit"
            type="button"
            class="w-full min-h-[44px] rounded-xl bg-da-coral px-6 py-4 font-quicksand text-xl font-bold text-white shadow-[0_8px_20px_-8px_rgba(255,138,91,0.55)] transition hover:bg-da-coral-strong hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-da-coral active:translate-y-0"
          >
            Check Spelling
          </button>
        </section>

        <!-- Feedback screen — mirrors question screen grid so content centers between progress and button -->
        <section
          id="screen-feedback"
          class="hidden grid grid-rows-[1fr_auto] gap-4 min-h-[420px] text-center"
          aria-labelledby="feedback-heading"
          aria-live="assertive"
        >
          <!-- Visually hidden heading updated for screen readers -->
          <h1 id="feedback-heading" class="sr-only"></h1>

          <!-- Content zone — centered vertically in the 1fr row -->
          <div class="flex flex-col items-center justify-center gap-4 rounded-2xl px-6 py-8 md:px-8">
            <!-- Correct answer: icon + word, calm phrase below -->
            <div id="feedback-correct-layout" class="hidden w-full flex-col items-center gap-4 rounded-2xl border border-da-correct-border bg-da-correct-bg px-6 py-8 md:px-8">
              <span class="flex h-14 w-14 items-center justify-center rounded-full bg-da-correct text-white" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M8 12.5l2.5 2.5L16 9"></path>
                </svg>
              </span>
              <div class="flex flex-col items-center gap-1">
                <p id="feedback-correct-phrase" class="font-quicksand text-xl font-bold text-da-correct">
                </p>
                <p
                  id="feedback-correct-word"
                  class="font-word text-5xl font-bold tracking-tight leading-none text-da-ink mt-1"
                >
                </p>
              </div>
            </div>

            <!-- Incorrect answer: icon + phrase, then a you-wrote/correct-spelling comparison -->
            <div id="feedback-incorrect-layout" class="hidden w-full flex-col items-center gap-3 rounded-2xl border border-da-incorrect-border bg-da-incorrect-bg px-6 py-8 md:px-8">
              <span class="flex h-14 w-14 items-center justify-center rounded-full bg-da-incorrect text-white" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M12 8v5"></path>
                  <circle cx="12" cy="16" r="0.75" fill="currentColor" stroke="none"></circle>
                </svg>
              </span>
              <p
                id="feedback-incorrect-phrase"
                class="font-quicksand text-xl font-bold text-da-incorrect"
              >
              </p>
              <dl class="mt-1 flex flex-col gap-2">
                <div class="flex items-baseline justify-center gap-2.5">
                  <dt class="font-mulish text-sm font-bold text-da-ink-soft">You wrote:</dt>
                  <dd id="feedback-attempt" class="font-word text-2xl font-bold text-da-incorrect line-through decoration-2"></dd>
                </div>
                <div class="flex items-baseline justify-center gap-2.5">
                  <dt class="font-mulish text-sm font-bold text-da-ink-soft">Correct spelling:</dt>
                  <dd
                    id="feedback-incorrect-word"
                    class="font-word text-4xl font-bold tracking-tight leading-none text-da-correct"
                  >
                  </dd>
                </div>
              </dl>
              <p id="feedback-detail" class="mt-1 font-mulish text-sm font-semibold text-da-ink-soft"></p>
            </div>
          </div>

          <!-- Continue button — auto row, anchors at bottom like Check Spelling on question screen -->
          <button
            id="btn-next"
            type="button"
            aria-label="Continue to next word"
            class="w-full min-h-[44px] rounded-xl bg-da-coral px-8 py-4 font-quicksand text-xl font-bold text-white shadow-[0_8px_20px_-8px_rgba(255,138,91,0.55)] transition hover:bg-da-coral-strong hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-da-coral active:translate-y-0 disabled:opacity-40 disabled:cursor-default disabled:translate-y-0"
          >
            Continue →
          </button>
        </section>

        <!-- Results screen -->
        <section id="screen-results" class="hidden" aria-labelledby="results-heading">
          <div
            id="results-content"
            class="flex flex-col items-center gap-6 rounded-2xl border border-da-brand border-t-4 bg-da-canvas-raised px-6 py-9 shadow-md text-center md:px-9"
          >
            <!-- Outcome zone -->
            <div>
              <h1
                id="results-heading"
                class="font-quicksand text-3xl font-bold text-da-brand-strong leading-tight"
              >
              </h1>
              <p id="results-summary" class="mt-3 text-lg font-semibold text-da-ink-soft"></p>
              <!-- Shown only for difficult sessions -->
              <p id="results-reassurance" class="hidden mt-2 text-sm text-da-ink-soft">
                Some words take a few tries to stick.
              </p>
            </div>

            <!-- Missed words section — chips only, no button inside; hidden for perfect sessions -->
            <div
              id="results-missed-section"
              class="hidden w-full flex flex-col items-center gap-3"
            >
              <p id="results-missed-heading" class="font-quicksand text-sm font-bold uppercase tracking-[0.05em] text-da-ink-faint"></p>
              <ul
                id="results-missed-list"
                class="flex flex-wrap justify-center gap-2.5"
                aria-label="Words to practice again"
              >
              </ul>
              <p id="results-missed-overflow" class="hidden font-mulish text-sm font-bold text-da-ink-soft">
              </p>
            </div>

            <!-- Action zone — populated and ordered by renderResults() -->
            <div id="results-action-zone" class="flex w-full flex-col gap-3 sm:flex-row sm:flex-wrap sm:justify-center">
              <!-- Perfect session primary -->
              <a
                id="btn-choose-list"
                href="/#grades"
                class="hidden w-full rounded-xl bg-da-coral px-6 py-4 text-center font-quicksand text-lg font-bold text-white no-underline shadow-[0_8px_20px_-8px_rgba(255,138,91,0.55)] transition hover:bg-da-coral-strong hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-da-coral active:translate-y-0 sm:w-auto"
              >
                Choose another list
              </a>

              <!-- Retry full list — role (primary/secondary) and label set by JS -->
              <button
                id="btn-retry"
                type="button"
                class="w-full min-h-[44px] rounded-xl border-2 border-da-brand bg-da-canvas-raised px-6 py-3.5 font-quicksand text-base font-bold text-da-brand-strong transition hover:bg-da-brand-tint focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-da-brand active:scale-[0.98] sm:w-auto"
              >
                Practice these words again
              </button>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <div id="site-footer">
    <SiteFooter theme="direction-a" />
  </div>
</Layout>

<script>
  import { decodeWordList } from '@/lib/words';
  import { getSentenceBankEntry } from '@/lib/sentenceBank';
  import { createSpeechController, selectPreferredVoice } from '@/modules/speech';
  import type { SpeechSynthesisVoiceAdapter } from '@/modules/speech';
  import {
    spellingTestReducer,
    createInitialState,
    initializeTest,
    startTest,
    submitAnswer,
    nextWord,
    resetTest,
  } from '@/modules/spellingTest/stateMachine';
  import type { TestState } from '@/modules/spellingTest/types';

  // --- DOM refs ---
  const $ = (id: string) => document.getElementById(id)!;

  const screenError = $('screen-error');
  const screenUnsupported = $('screen-unsupported');
  const screenBegin = $('screen-begin');
  const screenQuestion = $('screen-question');
  const screenFeedback = $('screen-feedback');
  const screenResults = $('screen-results');
  const practiceStage = $('practice-stage');

  const allScreens = [
    screenError,
    screenUnsupported,
    screenBegin,
    screenQuestion,
    screenFeedback,
    screenResults,
  ];

  const beginHeading = $('begin-heading');
  const beginWordCount = $('begin-word-count');
  const progressEl = $('progress');
  const questionInstruction = $('question-instruction');
  const answerInput = $('answer-input') as HTMLInputElement;
  const answerError = $('answer-error');
  const feedbackHeading = $('feedback-heading');
  const feedbackCorrectLayout = $('feedback-correct-layout');
  const feedbackCorrectWord = $('feedback-correct-word');
  const feedbackCorrectPhrase = $('feedback-correct-phrase');
  const feedbackIncorrectLayout = $('feedback-incorrect-layout');
  const feedbackIncorrectPhrase = $('feedback-incorrect-phrase');
  const feedbackAttempt = $('feedback-attempt');
  const feedbackIncorrectWord = $('feedback-incorrect-word');
  const feedbackDetail = $('feedback-detail');
  const progressBar = $('progress-bar') as HTMLElement;
  const sessionProgress = $('session-progress');
  const resultsReassurance = $('results-reassurance');
  const resultsSummary = $('results-summary');
  const resultsMissedSection = $('results-missed-section');
  const resultsMissedHeading = $('results-missed-heading');
  const resultsMissedList = $('results-missed-list');
  const resultsMissedOverflow = $('results-missed-overflow');
  const btnChooseList = $('btn-choose-list') as HTMLAnchorElement;
  const btnBegin = $('btn-begin') as HTMLButtonElement;
  const btnRepeat = $('btn-repeat') as HTMLButtonElement;
  const btnSentence = $('btn-sentence') as HTMLButtonElement;
  const noSentenceNote = $('no-sentence-note');
  const btnSubmit = $('btn-submit') as HTMLButtonElement;
  const btnNext = $('btn-next') as HTMLButtonElement;
  const btnRetry = $('btn-retry') as HTMLButtonElement;
  const errorMessage = $('error-message');

  // --- Module state ---
  const speech = createSpeechController();
  let state: TestState = createInitialState();
  let originalWords: string[] = [];
  let originalRichWords: { word: string; exampleSentence?: string }[] = [];

  let selectedVoice: SpeechSynthesisVoiceAdapter | null = null;
  const currentRate = 1.0;

  // Pending auto-sentence timeout handle — cancelled whenever we move to a new word
  let sentenceTimeout: ReturnType<typeof setTimeout> | null = null;

  function cancelPendingSentence(): void {
    if (sentenceTimeout !== null) {
      clearTimeout(sentenceTimeout);
      sentenceTimeout = null;
    }
  }

  // --- Warm, varied feedback copy ---
  // A calm adult helping a child — not a scoreboard. We rotate through these
  // so the same phrase doesn't land twice in a row and start to feel canned.
  const CORRECT_PHRASES = [
    'Well spelled.',
    'Good listening.',
    "That's it exactly.",
    'Correct.',
    'Just right.',
    "You've got it.",
  ];
  const INCORRECT_PHRASES = [
    'A good attempt.',
    "That's a tricky one.",
    'Close — good effort.',
    'Worth another look.',
    'Nearly there.',
  ];
  const NOT_PERFECT_HEADLINES = [
    'Good practice today.',
    'Worth another pass.',
    'Nice effort today.',
    'Good effort today.',
    'Keep going.',
    "That's the way.",
  ];

  let lastCorrectPhrase = -1;
  let lastIncorrectPhrase = -1;
  let lastNotPerfectHeadline = -1;

  // Delay before the Continue button becomes active on incorrect answers —
  // enforces a brief reading moment without auto-advancing.
  let nextWordDelayTimeout: ReturnType<typeof setTimeout> | null = null;

  function pickPhrase(pool: string[], lastIndex: number, remember: (i: number) => void): string {
    let i = Math.floor(Math.random() * pool.length);
    if (pool.length > 1 && i === lastIndex) i = (i + 1) % pool.length;
    remember(i);
    return pool[i];
  }

  // --- Screen management ---
  const siteFooter = document.getElementById('site-footer');
  const immersiveScreens = [screenQuestion, screenFeedback, screenResults];

  const practiceScreens = [screenQuestion, screenFeedback];

  function showScreen(target: HTMLElement): void {
    for (const screen of allScreens) {
      screen.classList.toggle('hidden', screen !== target);
      screen.classList.remove('screen-entering');
    }
    practiceStage.classList.toggle('hidden', !immersiveScreens.includes(target));
    siteFooter?.classList.toggle('hidden', immersiveScreens.includes(target));
    sessionProgress.classList.toggle('hidden', !practiceScreens.includes(target));
    // Trigger reflow so the animation restarts each time
    void (target as HTMLElement).offsetHeight;
    target.classList.add('screen-entering');
  }

  function showError(message: string): void {
    errorMessage.textContent = message;
    showScreen(screenError);
  }

  // --- Voice setup ---
  async function initVoiceControls(): Promise<void> {
    const allVoices = await speech.loadVoices();
    selectedVoice = selectPreferredVoice(allVoices);
  }

  // --- Initialization ---
  function init(): void {
    const params = new URLSearchParams(window.location.search);
    const payload = params.get('list');

    if (!payload) {
      showError('No word list found. Please go back and enter your words.');
      return;
    }

    const decoded = decodeWordList(payload);
    if (!decoded.ok) {
      showError('The word list could not be loaded. Please go back and try again.');
      return;
    }

    if (!speech.isSpeechSupported()) {
      showScreen(screenUnsupported);
      return;
    }

    originalWords = decoded.words;

    // Try to recover rich SpellingWord data (with exampleSentence) stored by curated list pages.
    let richWords: { word: string; exampleSentence?: string }[] | null = null;
    try {
      const stored = sessionStorage.getItem(`sw:words:${payload}`);
      if (stored) {
        const parsed: unknown = JSON.parse(stored);
        if (Array.isArray(parsed) && parsed.every((e) => typeof e?.word === 'string')) {
          richWords = parsed as { word: string; exampleSentence?: string }[];
        }
      }
    } catch {
      /* sessionStorage unavailable or parse failed — fall through to plain words */
    }

    // For custom lists (no sessionStorage entry), enrich words from the sentence bank.
    // Curated list words already carry their exampleSentence inside richWords — never overwrite those.
    if (!richWords) {
      richWords = originalWords.map((w) => {
        const entry = getSentenceBankEntry(w);
        return entry ? { word: w, exampleSentence: entry.exampleSentence } : { word: w };
      });
    }

    originalRichWords = richWords;
    state = spellingTestReducer(createInitialState(), initializeTest(richWords));

    const count = originalWords.length;

    // Resolve session title: curated list title from sessionStorage, else custom fallback
    let sessionTitle = 'Your Spelling Words';
    try {
      const stored = sessionStorage.getItem(`sw:title:${payload}`);
      if (stored) sessionTitle = stored;
    } catch {
      /* sessionStorage unavailable — use fallback */
    }

    beginHeading.textContent = sessionTitle;
    beginWordCount.textContent = `${count} ${count === 1 ? 'word' : 'words'}`;
    showScreen(screenBegin);

    // Load voices in the background — does not require a user gesture
    initVoiceControls();
  }

  // --- Render helpers ---
  function speechOptions() {
    return { voice: selectedVoice, rate: currentRate };
  }

  // --- Progressive instructions ---
  // Full guidance up front; as the child settles in, the screen quietly
  // steps back rather than repeating itself on every single word.
  function instructionForIndex(): string {
    return 'Listen, then type the word.';
  }

  function renderQuestion(): void {
    const current = state.words[state.currentIndex];
    const total = state.words.length;
    const pos = state.currentIndex + 1;

    progressEl.textContent = `Word ${pos} of ${total}`;
    progressBar.style.width = `${(pos / total) * 100}%`;
    questionInstruction.textContent = instructionForIndex();
    answerInput.value = '';
    answerError.textContent = '';

    // Show sentence button only when this word has an example sentence
    const hasSentence = Boolean(current.exampleSentence);
    btnSentence.classList.toggle('hidden', !hasSentence);
    btnSentence.classList.toggle('inline-flex', hasSentence);
    noSentenceNote.classList.toggle('hidden', hasSentence);

    showScreen(screenQuestion);
    requestAnimationFrame(() => answerInput.focus());

    // Cancel any pending sentence from the previous word, then speak this word.
    // After a short natural pause, auto-speak the sentence if one exists.
    cancelPendingSentence();
    speech.cancelSpeech();

    const result = speech.speakWord(current.word, speechOptions());
    if (!result.ok) {
      answerError.textContent =
        'Audio is not available right now. Try "Hear Word", or check your device sound.';
    } else if (hasSentence) {
      sentenceTimeout = setTimeout(() => {
        sentenceTimeout = null;
        speech.speakWord(current.exampleSentence!, speechOptions());
      }, 1000);
    }
  }

  function renderFeedback(): void {
    const correct = state.lastAnswerCorrect;
    const currentWord = state.words[state.currentIndex].word;
    const lastAttempt = state.attempts[state.attempts.length - 1];
    const submittedAnswer = lastAttempt?.answer ?? '';

    const isLast = state.currentIndex === state.words.length - 1;
    const continueLabel = isLast ? 'See results' : 'Continue to next word';
    btnNext.setAttribute('aria-label', continueLabel);

    // Update shared progress immediately when feedback renders
    const pos = state.currentIndex + 1;
    const total = state.words.length;
    progressEl.textContent = `Word ${pos} of ${total}`;
    progressBar.style.width = `${(pos / total) * 100}%`;

    if (correct) {
      // Correct: icon + phrase, word beneath.
      feedbackCorrectLayout.classList.remove('hidden');
      feedbackCorrectLayout.classList.add('flex');
      feedbackIncorrectLayout.classList.add('hidden');
      feedbackIncorrectLayout.classList.remove('flex');

      feedbackCorrectWord.textContent = currentWord;
      const phrase = pickPhrase(CORRECT_PHRASES, lastCorrectPhrase, (i) => (lastCorrectPhrase = i));
      feedbackCorrectPhrase.textContent = phrase;

      // SR label covers both the outcome and the word
      feedbackHeading.textContent = `Correct. ${currentWord}. ${phrase}`;

      showScreen(screenFeedback);
      btnNext.disabled = false;
      btnNext.textContent = isLast ? 'See Results →' : 'Continue →';
      requestAnimationFrame(() => btnNext.focus());
    } else {
      // Incorrect: icon + phrase, then a you-wrote/correct-spelling comparison —
      // never color alone: the wrong attempt is struck through as a non-color cue too.
      feedbackIncorrectLayout.classList.remove('hidden');
      feedbackIncorrectLayout.classList.add('flex');
      feedbackCorrectLayout.classList.add('hidden');
      feedbackCorrectLayout.classList.remove('flex');

      const phrase = pickPhrase(
        INCORRECT_PHRASES,
        lastIncorrectPhrase,
        (i) => (lastIncorrectPhrase = i),
      );
      feedbackIncorrectPhrase.textContent = phrase;
      feedbackAttempt.textContent = submittedAnswer || '—';
      feedbackIncorrectWord.textContent = currentWord;
      feedbackDetail.textContent = "We'll come back to this one.";

      // SR label covers outcome, attempt, and correct word
      feedbackHeading.textContent = `${phrase} You wrote ${submittedAnswer}. The correct spelling is ${currentWord}.`;

      showScreen(screenFeedback);

      // Disable Continue for 600ms — enforces a minimum reading moment
      btnNext.disabled = true;
      btnNext.textContent = isLast ? 'See Results →' : 'Continue →';
      if (nextWordDelayTimeout) clearTimeout(nextWordDelayTimeout);
      nextWordDelayTimeout = setTimeout(() => {
        nextWordDelayTimeout = null;
        btnNext.disabled = false;
        btnNext.focus();
      }, 600);
    }
  }

  // CSS class sets for primary vs secondary button styling
  const PRIMARY_BTN_CLS =
    'w-full min-h-[44px] rounded-xl bg-da-coral px-6 py-4 font-quicksand text-lg font-bold text-white shadow-[0_8px_20px_-8px_rgba(255,138,91,0.55)] transition hover:bg-da-coral-strong hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-da-coral active:translate-y-0 sm:w-auto';
  const SECONDARY_BTN_CLS =
    'w-full min-h-[44px] rounded-xl border-2 border-da-brand bg-da-canvas-raised px-6 py-3.5 font-quicksand text-base font-bold text-da-brand-strong transition hover:bg-da-brand-tint focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-da-brand active:scale-[0.98] sm:w-auto';
  const PRIMARY_LINK_CLS =
    'w-full rounded-xl bg-da-coral px-6 py-4 text-center font-quicksand text-lg font-bold text-white no-underline shadow-[0_8px_20px_-8px_rgba(255,138,91,0.55)] transition hover:bg-da-coral-strong hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-da-coral active:translate-y-0 sm:w-auto';

  function buildMissedChips(missedWords: { word: string }[], cap: number): void {
    resultsMissedList.textContent = '';
    const visible = missedWords.slice(0, cap);
    const overflow = missedWords.length - cap;
    for (const w of visible) {
      const li = document.createElement('li');
      li.textContent = w.word;
      li.className =
        'rounded-full border border-da-border-strong bg-da-canvas-raised px-4 py-2.5 font-word text-base font-semibold text-da-ink select-none';
      resultsMissedList.appendChild(li);
    }
    if (overflow > 0) {
      resultsMissedOverflow.textContent = `+${overflow} more`;
      resultsMissedOverflow.classList.remove('hidden');
    } else {
      resultsMissedOverflow.classList.add('hidden');
    }
  }

  function renderResults(): void {
    const result = state.result!;
    const missedCount = result.missedWords.length;
    const isPerfect = missedCount === 0;

    // Adaptive headline — perfect gets a fixed phrase; not-perfect rotates through
    // a pool so the same line doesn't land twice in a row across sessions.
    const resultsHeading = $('results-heading');
    if (isPerfect) {
      resultsHeading.textContent = 'You got every word.';
    } else {
      resultsHeading.textContent = pickPhrase(
        NOT_PERFECT_HEADLINES,
        lastNotPerfectHeadline,
        (i) => (lastNotPerfectHeadline = i),
      );
    }

    // Performance summary — no percentage, natural grammar
    if (isPerfect) {
      if (result.total === 1) {
        resultsSummary.textContent = 'You spelled the word correctly.';
      } else if (result.total === 2) {
        resultsSummary.textContent = 'You spelled both words correctly.';
      } else {
        resultsSummary.textContent = `You spelled all ${result.total} words correctly.`;
      }
    } else {
      const wordLabel = result.total === 1 ? 'word' : 'words';
      resultsSummary.textContent = `You spelled ${result.correct} of ${result.total} ${wordLabel} correctly.`;
    }

    // Reassurance line not used in the simplified two-state layout
    resultsReassurance.classList.add('hidden');

    // Rebuild action zone in the correct DOM order so keyboard and screen reader
    // order matches the visual primary-first hierarchy.
    const actionZone = $('results-action-zone');
    while (actionZone.firstChild) actionZone.removeChild(actionZone.firstChild);

    if (isPerfect) {
      resultsMissedSection.classList.add('hidden');

      btnChooseList.className = PRIMARY_LINK_CLS;
      btnRetry.className = SECONDARY_BTN_CLS;
      btnRetry.textContent = 'Practice these words again';

      actionZone.appendChild(btnChooseList);
      actionZone.appendChild(btnRetry);

      showScreen(screenResults);
      requestAnimationFrame(() => btnChooseList.focus());
    } else {
      buildMissedChips(result.missedWords, result.missedWords.length);
      resultsMissedSection.classList.remove('hidden');
      resultsMissedHeading.textContent = "Let's work on these words together.";

      btnRetry.className = PRIMARY_BTN_CLS;
      btnRetry.textContent = 'Practice these words again';
      btnChooseList.className = SECONDARY_BTN_CLS;

      actionZone.appendChild(btnRetry);
      actionZone.appendChild(btnChooseList);

      showScreen(screenResults);
      requestAnimationFrame(() => btnRetry.focus());
    }
  }

  // --- Event handlers ---
  function handleSubmit(): void {
    const answer = answerInput.value.trim();

    if (!answer) {
      answerError.textContent = 'Please type your answer.';
      answerInput.focus();
      return;
    }

    // Cancel any pending auto-sentence before showing feedback
    cancelPendingSentence();
    speech.cancelSpeech();

    state = spellingTestReducer(state, submitAnswer(answer, Date.now()));
    renderFeedback();
  }

  btnBegin.addEventListener('click', () => {
    state = spellingTestReducer(state, startTest(Date.now()));
    renderQuestion();
  });

  // Always re-speak the current word directly from state — never repeatWord(),
  // which would replay whatever was last spoken (could be a sentence).
  btnRepeat.addEventListener('click', () => {
    const word = state.words[state.currentIndex]?.word;
    if (word) {
      cancelPendingSentence();
      speech.cancelSpeech();
      speech.speakWord(word, speechOptions());
    }
  });

  btnSentence.addEventListener('click', () => {
    const sentence = state.words[state.currentIndex]?.exampleSentence;
    if (sentence) {
      cancelPendingSentence();
      speech.cancelSpeech();
      speech.speakWord(sentence, speechOptions());
    }
  });

  answerInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') handleSubmit();
  });

  btnSubmit.addEventListener('click', handleSubmit);

  function handleNext(): void {
    if (btnNext.disabled) return;
    if (nextWordDelayTimeout) {
      clearTimeout(nextWordDelayTimeout);
      nextWordDelayTimeout = null;
    }
    cancelPendingSentence();
    speech.cancelSpeech();
    state = spellingTestReducer(state, nextWord(Date.now()));
    if (state.status === 'awaitingAnswer') {
      renderQuestion();
    } else if (state.status === 'complete') {
      renderResults();
    }
  }

  btnNext.addEventListener('click', handleNext);

  // Right-arrow key advances from feedback screen — keeps hands on keyboard
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' && !screenFeedback.classList.contains('hidden')) {
      handleNext();
    }
  });

  btnRetry.addEventListener('click', () => {
    state = spellingTestReducer(resetTest(), initializeTest(originalRichWords));
    showScreen(screenBegin);
  });

  // --- Boot ---
  init();
</script>
