---
import { gradeConfig } from '@/lib/content/gradeConfig';

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-da-border bg-da-surface-neutral py-12">
  <div class="mx-auto max-w-content-xl px-5 sm:px-6">
    <div class="grid grid-cols-1 gap-9 sm:grid-cols-2 lg:grid-cols-4 lg:gap-12">
      <nav aria-labelledby="footer-spellingwords-heading">
        <h2
          id="footer-spellingwords-heading"
          class="font-quicksand text-sm font-bold uppercase tracking-[0.06em] text-da-ink"
        >
          SpellingWords
        </h2>
        <ul class="mt-3 flex list-none flex-col gap-1 p-0 text-sm font-bold text-da-ink-soft">
          <li>
            <a href="/about" class="flex min-h-[44px] items-center no-underline hover:text-da-brand"
              >About</a
            >
          </li>
          <li>
            <a
              href="/curriculum"
              class="flex min-h-[44px] items-center no-underline hover:text-da-brand"
              >Our Spelling Curriculum</a
            >
          </li>
          <li>
            <a
              href="/accessibility"
              class="flex min-h-[44px] items-center no-underline hover:text-da-brand"
              >Accessibility</a
            >
          </li>
        </ul>
      </nav>

      <nav aria-labelledby="footer-grades-heading">
        <h2
          id="footer-grades-heading"
          class="font-quicksand text-sm font-bold uppercase tracking-[0.06em] text-da-ink"
        >
          Grades
        </h2>
        <ul
          class="mt-3 grid list-none grid-cols-2 gap-x-4 gap-y-1 p-0 text-sm font-bold text-da-ink-soft lg:grid-cols-1"
        >
          <li>
            <a
              href="/grades"
              class="flex min-h-[44px] items-center no-underline hover:text-da-brand">All Grades</a
            >
          </li>
          {
            gradeConfig.map((grade) => (
              <li>
                <a
                  href={grade.hubHref}
                  class="flex min-h-[44px] items-center no-underline hover:text-da-brand"
                >
                  {grade.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-explore-heading">
        <h2
          id="footer-explore-heading"
          class="font-quicksand text-sm font-bold uppercase tracking-[0.06em] text-da-ink"
        >
          Explore
        </h2>
        <ul class="mt-3 flex list-none flex-col gap-1 p-0 text-sm font-bold text-da-ink-soft">
          <li>
            <a
              href="/core-spelling"
              class="flex min-h-[44px] items-center no-underline hover:text-da-brand"
              >Core Spelling</a
            >
          </li>
          <li>
            <a
              href="/high-frequency-words"
              class="flex min-h-[44px] items-center no-underline hover:text-da-brand"
              >High-Frequency Words</a
            >
          </li>
          <li>
            <a
              href="/themed-spelling-practice"
              class="flex min-h-[44px] items-center no-underline hover:text-da-brand"
              >Themed Spelling Practice</a
            >
          </li>
          <li>
            <a
              href="/skills"
              class="flex min-h-[44px] items-center no-underline hover:text-da-brand"
              >Spelling Skills</a
            >
          </li>
          <li>
            <a
              href="/practice-your-own-words"
              class="flex min-h-[44px] items-center no-underline hover:text-da-brand"
              >Practice Your Own Words</a
            >
          </li>
        </ul>
      </nav>

      <nav aria-labelledby="footer-legal-heading">
        <h2
          id="footer-legal-heading"
          class="font-quicksand text-sm font-bold uppercase tracking-[0.06em] text-da-ink"
        >
          Legal
        </h2>
        <ul class="mt-3 flex list-none flex-col gap-1 p-0 text-sm font-bold text-da-ink-soft">
          <li>
            <a
              href="/privacy"
              class="flex min-h-[44px] items-center no-underline hover:text-da-brand"
              >Privacy Policy</a
            >
          </li>
          <li>
            <a href="/terms" class="flex min-h-[44px] items-center no-underline hover:text-da-brand"
              >Terms of Use</a
            >
          </li>
        </ul>
      </nav>
    </div>

    <div class="mt-10 border-t border-da-border pt-7">
      <p class="max-w-[48ch] text-sm leading-relaxed text-da-ink-faint">
        SpellingWords.app — K–5 spelling curriculum and practice. &copy; {year}
      </p>
    </div>
  </div>
</footer>
