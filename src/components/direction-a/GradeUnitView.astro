---
// Direction A Grade Unit body — the unified visual template for pilot Grade
// Unit pages, used by BOTH the standard-template renderer
// ([gradeSlug]/[strand]/[slug].astro) and the Core Spelling renderer
// (GradeUnitWorldPage.astro), replacing the old gradient-sky "world kit"
// hero for pilot ids. Blush-neutral atmosphere, blue educational hero, coral
// Practice CTA. Adapts to whichever real content it's given — word notes,
// concept-skill callouts, related-list groups, and extra navigation
// (HFW set prev/next) are all optional and simply omitted when absent.
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import AtmosphereBand from './AtmosphereBand.astro';
import Chip from './Chip.astro';
import Button from './Button.astro';
import type { SpellingListEntry } from '@/lib/content/spellingLists';
import type { GradeRouteClassification } from '@/lib/content/canonicalGradeRoutes';
import { STRAND_ACCENT } from '@/lib/content/pilotContent';
import type { SpellingWord } from '@/types/spelling';

interface WordNoteItem {
  word: string;
  note: string;
  contextExample?: string;
  pronunciationNote?: string;
}

interface RelatedGroup {
  heading: string;
  items: SpellingListEntry[];
}

interface Props {
  title: string;
  description: string;
  Content: AstroComponentFactory;
  strand: GradeRouteClassification;
  strandLabel: string;
  gradeLabel?: string | null;
  roadmapPosition?: { step: number; total: number };
  gradeHubHref?: string;
  playWords: SpellingWord[];
  playWordsJson: string;
  buttonId: string;
  wordListHeading: string;
  showSentences: boolean;
  readinessSignals: readonly string[];
  bodyHeading: string;
  wordNotesHeading?: string;
  wordNotes?: readonly WordNoteItem[];
  conceptSkills: SpellingListEntry[];
  faq: readonly { question: string; answer: string }[];
  relatedGroups: RelatedGroup[];
  listLink: (entry: SpellingListEntry) => string;
  extraNav?: { heading: string; items: { label: string; href: string }[] };
}

const {
  title,
  description,
  Content,
  strand,
  strandLabel,
  gradeLabel,
  roadmapPosition,
  gradeHubHref,
  playWords,
  playWordsJson,
  buttonId,
  wordListHeading,
  showSentences,
  readinessSignals,
  bodyHeading,
  wordNotesHeading,
  wordNotes = [],
  conceptSkills,
  faq,
  relatedGroups,
  listLink,
  extraNav,
} = Astro.props;

const accent = STRAND_ACCENT[strand];
const chipTone = accent === 'brand' ? 'brand' : accent;

// Written as literal strings (not template-built) so Tailwind's JIT scanner
// can detect them — see the same convention in RelatedListCards.astro.
const accentBgClass: Record<typeof accent, string> = {
  brand: 'bg-da-brand',
  coral: 'bg-da-coral',
  sun: 'bg-da-sun',
  teal: 'bg-da-teal',
  pink: 'bg-da-pink',
  periwinkle: 'bg-da-periwinkle',
};
const accentBorderClass: Record<typeof accent, string> = {
  brand: 'border-da-brand',
  coral: 'border-da-coral',
  sun: 'border-da-sun',
  teal: 'border-da-teal',
  pink: 'border-da-pink',
  periwinkle: 'border-da-periwinkle',
};
---

<!-- Hero: blue educational hero, unit atmosphere underneath -->
<section class="px-5 pb-8 pt-6 sm:px-6 md:pb-10 md:pt-8">
  <div class="mx-auto max-w-2xl md:max-w-3xl">
    <div class="relative overflow-hidden rounded-3xl border border-da-brand bg-da-brand-tint px-6 py-8 sm:px-10 sm:py-10">
      {roadmapPosition && gradeHubHref && gradeLabel && (
        <p class="mb-3 text-sm font-bold text-da-brand-strong">
          <a href={gradeHubHref} class="hover:underline">{gradeLabel} Spelling</a>
          <span aria-hidden="true"> · </span>
          <span>Step {roadmapPosition.step} of {roadmapPosition.total}</span>
        </p>
      )}

      <div class="flex flex-wrap items-center gap-2">
        {gradeLabel && <Chip tone="neutral">{gradeLabel}</Chip>}
        <Chip tone={chipTone}>{strandLabel}</Chip>
      </div>

      <h1 class="mt-3 font-quicksand text-[clamp(1.9rem,4vw,2.5rem)] font-bold leading-[1.15] text-da-ink">{title}</h1>
      <p class="mt-3 max-w-2xl text-[1.05rem] leading-relaxed text-da-ink-soft">{description}</p>

      <div class="mt-7">
        <Button
          id={buttonId}
          type="button"
          data-words={playWordsJson}
          data-list-title={title}
          size="lg"
          aria-label={`Practice these ${playWords.length} words in ${title}`}
        >
          Practice these words
        </Button>
        <p id={`${buttonId}-status`} class="mt-3 text-sm text-da-incorrect" aria-live="polite" aria-atomic="true" />
      </div>
    </div>
  </div>
</section>

{readinessSignals.length > 0 && (
  <AtmosphereBand tone="unit" ariaLabel="Is this the right list?">
    <h2 class="font-quicksand text-xl font-bold text-da-ink">These spelling words are a good fit for students who...</h2>
    <ul class="mt-4 space-y-3 text-base leading-relaxed text-da-ink-soft">
      {readinessSignals.map((signal) => (
        <li class="flex items-start gap-2.5">
          <span aria-hidden="true" class="mt-0.5 flex-shrink-0 text-da-brand">✓</span>
          <span>{signal}</span>
        </li>
      ))}
    </ul>
  </AtmosphereBand>
)}

<!-- Word list -->
<section class="px-5 py-10 sm:px-6 md:py-14" aria-labelledby="word-list-heading">
  <div class="mx-auto max-w-2xl md:max-w-3xl">
    <h2 id="word-list-heading" class="mb-4 font-quicksand text-xl font-bold text-da-ink">{wordListHeading}</h2>
    <div class="overflow-hidden rounded-3xl border border-da-border bg-da-canvas-raised shadow-sm">
      <div class:list={['h-1.5', accentBgClass[accent]]} aria-hidden="true"></div>
      {showSentences ? (
        <ul class="px-6 py-3 sm:px-8 sm:py-4" aria-label="Words in this list">
          {playWords.map((word) => (
            <li class="flex flex-col gap-0.5 border-b border-da-border py-3 last:border-b-0 sm:flex-row sm:items-baseline sm:gap-5">
              <span class="w-20 shrink-0 font-quicksand text-lg font-semibold leading-snug text-da-ink sm:text-xl">{word.word}</span>
              {word.exampleSentence && <span class="text-sm leading-relaxed text-da-ink-soft sm:text-base">{word.exampleSentence}</span>}
            </li>
          ))}
        </ul>
      ) : (
        <ul class="grid grid-cols-2 gap-x-6 gap-y-3 px-6 py-7 sm:grid-cols-3 sm:gap-x-8 sm:gap-y-4 sm:px-8 sm:py-8" aria-label="Words in this list">
          {playWords.map((word) => (
            <li class="font-quicksand text-lg font-semibold leading-snug text-da-ink sm:text-xl">{word.word}</li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

<!-- Explanation -->
<AtmosphereBand tone="cool" ariaLabel={bodyHeading}>
  <div class:list={['border-l-[3px] pl-5 sm:pl-6', accentBorderClass[accent]]}>
    <h2 class="font-quicksand text-2xl font-bold text-da-ink">{bodyHeading}</h2>
    <div class="mt-4 max-w-2xl space-y-5 text-[1.05rem] leading-relaxed text-da-ink-soft [&_strong]:font-semibold [&_strong]:text-da-ink [&_table]:block [&_table]:max-w-full [&_table]:overflow-x-auto">
      <Content />
    </div>
  </div>
</AtmosphereBand>

{wordNotes.length > 0 && (
  <section class="px-5 py-10 sm:px-6 md:py-14" aria-labelledby="word-notes-heading">
    <div class="mx-auto max-w-2xl md:max-w-3xl">
      <h2 id="word-notes-heading" class="font-quicksand text-xl font-bold text-da-ink">{wordNotesHeading ?? 'Notes for particular words'}</h2>
      <div class="mt-4 space-y-4">
        {wordNotes.map((item) => (
          <article class="rounded-2xl border border-da-border bg-da-canvas-raised px-6 py-5 shadow-sm">
            <h3 class="font-quicksand text-lg font-semibold text-da-ink">{item.word}</h3>
            <p class="mt-1 text-base leading-relaxed text-da-ink-soft">{item.note}</p>
            {item.contextExample && (
              <p class="mt-2 text-base leading-relaxed text-da-ink-soft">
                <strong class="font-semibold text-da-ink">In a sentence:</strong> {item.contextExample}
              </p>
            )}
            {item.pronunciationNote && (
              <p class="mt-2 text-sm leading-relaxed text-da-ink-soft">
                <strong class="font-semibold text-da-ink">Pronunciation note:</strong> {item.pronunciationNote}
              </p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{conceptSkills.length > 0 && (
  <AtmosphereBand tone="unit" ariaLabel="Go deeper">
    <h2 class="mb-3 font-quicksand text-xl font-bold text-da-ink">
      {conceptSkills.length > 1 ? 'Go deeper on these patterns' : 'Go deeper on this pattern'}
    </h2>
    <div class="flex flex-col gap-3">
      {conceptSkills.map((skill) => (
        <a href={listLink(skill)} class="relative block overflow-hidden rounded-2xl border border-da-border bg-da-canvas-raised px-6 py-5 shadow-sm transition before:absolute before:inset-y-0 before:left-0 before:w-1.5 before:bg-da-brand before:content-[''] hover:-translate-y-0.5 hover:shadow-md">
          <span class="block font-quicksand text-lg font-bold text-da-brand-strong">
            Learn more about {skill.data.title.replace(/ Words$/i, '')} →
          </span>
          <span class="mt-1 block text-sm leading-relaxed text-da-ink-soft sm:text-base">
            {skill.data.title} is the full guide to this pattern — how it works, what trips children up, and where else it's taught.
          </span>
        </a>
      ))}
    </div>
  </AtmosphereBand>
)}

{faq.length > 0 && (
  <section class="px-5 py-10 sm:px-6 md:py-14" aria-labelledby="faq-heading">
    <div class="mx-auto max-w-2xl md:max-w-3xl">
      <h2 id="faq-heading" class="mb-4 font-quicksand text-xl font-bold text-da-ink">Frequently asked questions</h2>
      <div class="overflow-hidden rounded-3xl border border-da-border bg-da-canvas-raised shadow-sm">
        <div class="divide-y divide-da-border px-6 sm:px-7">
          {faq.map((item) => (
            <div class="py-5">
              <h3 class="font-quicksand text-base font-bold text-da-ink">{item.question}</h3>
              <p class="mt-2 text-base leading-relaxed text-da-ink-soft">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

{relatedGroups.some((group) => group.items.length > 0) && (
  <AtmosphereBand tone="unit" ariaLabel="Where to go from here">
    <h2 class="mb-4 font-quicksand text-xl font-bold text-da-ink">Where to go from here</h2>
    {relatedGroups.map((group) => group.items.length > 0 && (
      <div class="mt-6 first:mt-0">
        <h3 class="mb-3 font-quicksand text-base font-bold text-da-ink">{group.heading}</h3>
        <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap">
          {group.items.map((item) => (
            <a href={listLink(item)} class="relative flex-1 overflow-hidden rounded-2xl border border-da-border bg-da-canvas-raised py-3 pl-5 pr-4 text-sm shadow-sm transition before:absolute before:inset-y-0 before:left-0 before:w-1.5 before:bg-da-brand before:content-[''] hover:-translate-y-0.5 hover:shadow-md sm:flex-none sm:min-w-[14rem] sm:max-w-sm">
              <span class="mt-0.5 block font-quicksand text-base font-bold text-da-ink">{item.data.title}</span>
              <span class="mt-1 block text-sm font-semibold text-da-ink-soft">{item.data.words.length} words →</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </AtmosphereBand>
)}

{extraNav && extraNav.items.length > 0 && (
  <nav class="px-5 py-10 sm:px-6 md:py-14" aria-label={extraNav.heading}>
    <div class="mx-auto max-w-2xl md:max-w-3xl">
      <h2 class="font-quicksand text-xl font-bold text-da-ink">{extraNav.heading}</h2>
      <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        {extraNav.items.map((item) => (
          <a href={item.href} class="rounded-2xl border border-da-border bg-da-canvas-raised px-6 py-4 font-bold text-da-brand-strong shadow-sm hover:underline">
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
)}

<script>
  import { encodeWordList } from '@/lib/words';

  interface SpellingWordData {
    word: string;
    hint?: string;
    exampleSentence?: string;
    phonicsPattern?: string[];
  }

  function getSpellingWords(button: HTMLButtonElement): SpellingWordData[] {
    try {
      const parsed: unknown = JSON.parse(button.dataset.words ?? '[]');
      if (!Array.isArray(parsed)) return [];
      return parsed.filter(
        (e): e is SpellingWordData =>
          typeof e === 'object' && e !== null && typeof (e as SpellingWordData).word === 'string',
      );
    } catch {
      return [];
    }
  }

  function handleStart(event: Event): void {
    const button = event.currentTarget as HTMLButtonElement;
    const statusEl = document.getElementById(`${button.id}-status`);
    const words = getSpellingWords(button);
    if (words.length === 0) return;

    const result = encodeWordList(words.map((w) => w.word));
    if (!result.ok) {
      if (statusEl) {
        statusEl.textContent =
          result.code === 'payload_too_long'
            ? 'There are too many words to start automatically. Please try a shorter list.'
            : 'Could not start this spelling test. Please try again.';
      }
      return;
    }

    const listTitle = button.dataset.listTitle ?? '';
    try {
      sessionStorage.setItem(`sw:words:${result.payload}`, JSON.stringify(words));
      if (listTitle) sessionStorage.setItem(`sw:title:${result.payload}`, listTitle);
    } catch {
      /* quota exceeded or private browsing — non-fatal */
    }

    window.location.href = `/play?list=${result.payload}`;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-words]').forEach((btn) => {
    btn.addEventListener('click', handleStart);
  });
</script>
