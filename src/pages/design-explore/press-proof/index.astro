---
import Proto from './_shared/Proto.astro';
import Header from './_shared/Header.astro';
import Footer from './_shared/Footer.astro';
import Stamp from './_shared/Stamp.astro';

const grades = [
  { label: 'Kindergarten', href: '#', tint: 'cobalt', blurb: 'Letter sounds and first sight words' },
  { label: '1st Grade', href: '#', tint: 'marigold', blurb: 'Blends, digraphs, and short vowels' },
  { label: '2nd Grade', href: '#', tint: 'mint', blurb: 'Silent e, vowel teams, and contractions' },
  { label: '3rd Grade', href: '/design-explore/press-proof/grade-hub.html', tint: 'berry', blurb: 'Prefixes, suffixes, and homophones' },
  { label: '4th Grade', href: '#', tint: 'cobalt', blurb: 'Advanced affixes and multisyllabic words' },
  { label: '5th Grade', href: '#', tint: 'marigold', blurb: 'Greek and Latin word parts' },
];

const skills = [
  { label: 'Short Vowels', href: '#' },
  { label: 'Silent E', href: '#' },
  { label: 'Soft C and Soft G', href: '/design-explore/press-proof/skill.html' },
  { label: 'Prefixes', href: '#' },
  { label: 'Suffixes', href: '#' },
  { label: 'Greek and Latin Roots', href: '#' },
  { label: 'Homophones', href: '#' },
];
---

<Proto
  title="SpellingWords.app — Press Proof"
  description="Design exploration: Press Proof, a print-shop stamp and proof-sheet system for K-5 spelling practice."
>
  <Header currentPath="/design-explore/press-proof/" />

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Free · No account needed</p>
          <h1 class="hero-title">
            Hear the word.
            <span class="hero-title-stamped">Spell it.</span>
            Get your stamp.
          </h1>
          <p class="hero-sub">
            SpellingWords.app is calm, focused spelling practice for kids in kindergarten through
            5th grade — read aloud, typed by hand, checked like a proof sheet. No timers, points,
            or streaks to chase.
          </p>
          <div class="hero-actions">
            <a class="btn btn-flame" href="/design-explore/press-proof/grade-hub.html">Browse by grade</a>
            <a class="btn btn-ghost" href="/design-explore/press-proof/skill.html">Browse by skill</a>
          </div>
          <ul class="hero-trust">
            <li>K–5 curriculum, built by grade</li>
            <li>Works with your own word list</li>
            <li>No login, no ads, no data games</li>
          </ul>
        </div>

        <div class="hero-panel-wrap">
          <div class="hero-panel-shadow" aria-hidden="true"></div>
          <div class="hero-panel">
            <p class="hero-panel-eyebrow">Practice your own words</p>
            <label class="hero-panel-label" for="word-input"
              >Type or paste a list — one word per line</label
            >
            <textarea
              id="word-input"
              class="hero-textarea"
              rows="4"
              placeholder={'lighthouse\nbeneath\nharvest'}></textarea>
            <div class="hero-panel-row">
              <button type="button" class="btn btn-cobalt">Start this list</button>
              <span class="hero-panel-count">3 words ready</span>
            </div>
            <div class="hero-panel-divider" role="presentation"></div>
            <div class="hero-preview">
              <p class="hero-preview-label">Sounds like this:</p>
              <div class="hero-preview-word">
                <button type="button" class="hero-audio-btn" aria-label="Play the word harvest">
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <path d="M4 9v6h4l5 5V4L8 9H4z" fill="currentColor" /><path
                      d="M16.5 8.5a5 5 0 0 1 0 7"
                      stroke="currentColor"
                      stroke-width="1.8"
                      fill="none"
                      stroke-linecap="round"
                    /></svg
                  >
                </button>
                <span class="hero-preview-word-text">harvest</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ BROWSE BY GRADE ============ -->
    <section class="section" id="grades" aria-labelledby="grades-heading">
      <div class="wrap">
        <div class="section-head">
          <h2 id="grades-heading">Browse by grade</h2>
          <p class="section-sub">
            Every grade combines a core spelling sequence, high-frequency word sets, and optional
            themed practice tied to what kids are learning in class.
          </p>
        </div>
        <ul class="grade-grid">
          {
            grades.map((grade) => (
              <li>
                <a class={`grade-ticket tint-${grade.tint}`} href={grade.href}>
                  <span class="grade-ticket-label">{grade.label}</span>
                  <span class="grade-ticket-blurb">{grade.blurb}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ============ BROWSE BY SKILL ============ -->
    <section class="section section-tinted" id="skills" aria-labelledby="skills-heading">
      <div class="wrap">
        <div class="section-head">
          <h2 id="skills-heading">Browse by skill</h2>
          <p class="section-sub">
            Prefer to practice a specific pattern instead of a full grade? Jump straight to a
            phonics or spelling-rule skill.
          </p>
        </div>
        <ul class="skill-chip-row">
          {
            skills.map((skill) => (
              <li>
                <a class="skill-chip" href={skill.href}>
                  {skill.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="text-link" href="/design-explore/press-proof/skill.html">See all spelling skills →</a>
      </div>
    </section>

    <!-- ============ WHY IT WORKS ============ -->
    <section class="section" aria-labelledby="why-heading">
      <div class="wrap why-grid">
        <div class="why-copy">
          <h2 id="why-heading">Built for how kids actually learn to spell</h2>
          <p class="section-sub">
            No timers ticking down, no points to chase, no streak to protect. Just a word, spoken
            clearly, and a quiet place to write it — as many times as it takes.
          </p>
        </div>
        <ul class="why-list">
          <li>
            <span class="why-seal">1</span>
            <div>
              <h3>Hear it, clearly</h3>
              <p>Every word is read aloud on request, as many times as needed.</p>
            </div>
          </li>
          <li>
            <span class="why-seal">2</span>
            <div>
              <h3>Write it, calmly</h3>
              <p>One word at a time, with gentle, specific feedback — never a red flood.</p>
            </div>
          </li>
          <li>
            <span class="why-seal">3</span>
            <div>
              <h3>No pressure, ever</h3>
              <p>No timers, points, or streaks. Practice ends when the words are done.</p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- ============ STAMP PREVIEW ============ -->
    <section class="section stamp-strip" aria-labelledby="stamp-heading">
      <div class="wrap stamp-strip-inner">
        <h2 id="stamp-heading" class="visually-hidden">What a correct answer looks like</h2>
        <Stamp text="Correct" color="mint" rotate={-5} size="lg" />
        <p class="stamp-strip-copy">
          Every word you spell right earns a real stamp — not a point, not a streak. Just proof
          you got it.
        </p>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    /* ============ HERO ============ */
    .hero {
      padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 6rem);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(2rem, 5vw, 4.5rem);
      align-items: center;
    }

    .eyebrow {
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--cobalt);
      margin-bottom: 1rem;
    }

    .hero-title {
      font-size: clamp(2.2rem, 4.4vw, 3.2rem);
      line-height: 1.14;
      letter-spacing: -0.01em;
      color: var(--ink);
    }

    .hero-title-stamped {
      display: inline-block;
      position: relative;
      color: var(--ink);
      padding: 0 0.15em;
    }
    .hero-title-stamped::before {
      content: '';
      position: absolute;
      inset: -0.02em -0.1em;
      border: 3px solid var(--flame);
      border-radius: var(--radius-md);
      transform: rotate(-2deg);
      z-index: -1;
    }

    .hero-sub {
      margin-top: 1.5rem;
      font-size: 1.08rem;
      line-height: 1.6;
      color: var(--ink-soft);
      max-width: 46ch;
    }

    .hero-actions {
      margin-top: 2rem;
      display: flex;
      gap: 0.9rem;
      flex-wrap: wrap;
    }

    .hero-trust {
      margin: 2.25rem 0 0;
      padding: 0;
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }

    .hero-trust li {
      font-size: 0.88rem;
      color: var(--ink-soft);
      padding-left: 1.4rem;
      position: relative;
    }

    .hero-trust li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.5rem;
      width: 8px;
      height: 8px;
      background: var(--mint);
    }

    /* ---- hero panel: proof-sheet card, offset for depth via hard shadow ---- */
    .hero-panel-wrap {
      position: relative;
      justify-self: end;
      width: 100%;
      max-width: 420px;
    }

    .hero-panel-shadow {
      position: absolute;
      inset: 10px -10px -10px 10px;
      background: var(--ink);
      border-radius: var(--radius-lg);
      z-index: 0;
    }

    .hero-panel {
      position: relative;
      z-index: 1;
      background: var(--canvas-raised);
      border: 2px solid var(--ink);
      border-radius: var(--radius-lg);
      padding: clamp(1.5rem, 3vw, 2.1rem);
      clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 0 100%);
    }

    .hero-panel-eyebrow {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--marigold-text);
      margin-bottom: 0.5rem;
    }

    .hero-panel-label {
      display: block;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--ink);
      margin-bottom: 0.7rem;
    }

    .hero-textarea {
      width: 100%;
      resize: vertical;
      min-height: 6.5rem;
      background: var(--canvas-sunken);
      border: 2px solid var(--border);
      border-radius: var(--radius-md);
      color: var(--ink);
      font-family: var(--font-word);
      font-size: 1rem;
      padding: 0.85rem 1rem;
      line-height: 1.6;
    }

    .hero-textarea:focus-visible {
      border-color: var(--cobalt);
    }

    .hero-panel-row {
      margin-top: 1.1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .hero-panel-row .btn {
      font-size: 0.9rem;
      padding: 0.7rem 1.2rem;
    }

    .hero-panel-count {
      font-size: 0.82rem;
      color: var(--ink-faint);
      font-weight: 600;
      font-family: var(--font-proof);
    }

    .hero-panel-divider {
      height: 2px;
      background: var(--border);
      margin: 1.4rem 0 1.2rem;
    }

    .hero-preview-label {
      font-size: 0.78rem;
      color: var(--ink-faint);
      margin-bottom: 0.65rem;
      font-weight: 600;
    }

    .hero-preview-word {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .hero-audio-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.6rem;
      height: 2.6rem;
      border-radius: 50%;
      background: var(--cobalt-tint);
      border: 2px solid var(--cobalt);
      color: var(--cobalt-deep);
      cursor: pointer;
      flex-shrink: 0;
    }

    .hero-preview-word-text {
      font-family: var(--font-word);
      font-size: 1.4rem;
      font-weight: 500;
      letter-spacing: 0.02em;
      color: var(--ink-faint);
    }

    /* ============ SECTION SHELL ============ */
    .section {
      padding-block: clamp(3rem, 6vw, 4.5rem);
    }

    .section-tinted {
      background: var(--canvas-sunken);
      border-block: 2px solid var(--border);
    }

    .section-head {
      max-width: 62ch;
      margin-bottom: 2.25rem;
    }

    .section-head h2 {
      font-size: clamp(1.5rem, 2.6vw, 1.9rem);
      margin-bottom: 0.65rem;
    }

    .section-sub {
      color: var(--ink-soft);
      font-size: 1rem;
      line-height: 1.6;
    }

    /* ============ GRADE TICKETS ============ */
    .grade-grid {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .grade-ticket {
      --tint: var(--cobalt);
      --tint-bg: var(--cobalt-tint);
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      align-items: flex-start;
      text-decoration: none;
      background: var(--tint-bg);
      border: 2px solid var(--ink);
      border-radius: var(--radius-md);
      padding: 1.1rem 1.3rem 1.25rem;
      box-shadow: var(--shadow-hard-sm);
      clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 0 100%);
      transition:
        transform 0.08s ease,
        box-shadow 0.08s ease;
    }

    .grade-ticket:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 var(--ink);
    }

    .grade-ticket.tint-cobalt {
      --tint: var(--cobalt);
      --tint-bg: var(--cobalt-tint);
    }
    .grade-ticket.tint-marigold {
      --tint: var(--marigold-text);
      --tint-bg: var(--marigold-tint);
    }
    .grade-ticket.tint-mint {
      --tint: var(--mint-text);
      --tint-bg: var(--mint-tint);
    }
    .grade-ticket.tint-berry {
      --tint: var(--berry-text);
      --tint-bg: var(--berry-tint);
    }

    .grade-ticket-label {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--tint);
    }

    .grade-ticket-blurb {
      font-size: 0.88rem;
      color: var(--ink-soft);
      line-height: 1.5;
    }

    /* ============ SKILL CHIPS ============ */
    .skill-chip-row {
      list-style: none;
      margin: 0 0 1.5rem;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
    }

    .skill-chip {
      display: inline-flex;
      align-items: center;
      text-decoration: none;
      background: var(--canvas-raised);
      color: var(--ink);
      border: 2px solid var(--ink);
      border-radius: var(--radius-sm);
      padding: 0.55rem 1.05rem;
      font-size: 0.9rem;
      font-weight: 600;
      transition: background 0.12s ease;
    }

    .skill-chip:hover {
      background: var(--cobalt-tint);
    }

    .text-link {
      display: inline-block;
      font-weight: 700;
      font-size: 0.92rem;
      color: var(--cobalt);
      text-decoration: none;
    }
    .text-link:hover {
      text-decoration: underline;
    }

    /* ============ WHY GRID ============ */
    .why-grid {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }

    .why-copy h2 {
      font-size: clamp(1.5rem, 2.6vw, 1.9rem);
      margin-bottom: 0.9rem;
    }

    .why-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
    }

    .why-list li {
      display: flex;
      gap: 1.1rem;
      align-items: flex-start;
    }

    .why-seal {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.3rem;
      height: 2.3rem;
      border-radius: 50%;
      border: 2px solid var(--ink);
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1rem;
      color: var(--ink);
    }

    .why-list h3 {
      font-size: 1.05rem;
      margin-bottom: 0.3rem;
    }

    .why-list p {
      font-size: 0.92rem;
      color: var(--ink-soft);
      line-height: 1.55;
    }

    /* ============ STAMP STRIP ============ */
    .stamp-strip-inner {
      display: flex;
      align-items: center;
      gap: 2rem;
      flex-wrap: wrap;
      justify-content: center;
      text-align: center;
    }

    .stamp-strip-copy {
      max-width: 32ch;
      font-size: 1rem;
      color: var(--ink-soft);
      line-height: 1.5;
    }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 980px) {
      .hero-grid {
        grid-template-columns: 1fr;
      }
      .hero-panel-wrap {
        justify-self: stretch;
        max-width: none;
      }
      .why-grid {
        grid-template-columns: 1fr;
      }
      .grade-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 640px) {
      .hero-panel-shadow {
        display: none;
      }
      .grade-grid {
        grid-template-columns: 1fr;
      }
      .hero-actions .btn {
        flex: 1 1 auto;
      }
      .hero-panel-row {
        flex-direction: column;
        align-items: stretch;
        gap: 0.7rem;
      }
      .hero-panel-count {
        text-align: center;
      }
    }
  </style>
</Proto>
