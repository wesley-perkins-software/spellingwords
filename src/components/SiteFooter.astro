---
const year = new Date().getFullYear();
---

<!-- Promoted from design-explore/direction-a/_shared/Footer.astro: one lean
     row (tagline + nav), not a repeated wordmark/tagline/copyright stack. -->
<footer class="mt-20 border-t border-da-border bg-da-surface-neutral py-10">
  <div class="mx-auto flex max-w-content-xl flex-wrap items-center justify-between gap-5 px-6">
    <p class="max-w-[34ch] text-sm text-da-ink-faint">
      SpellingWords.app — free K–5 spelling practice by grade or skill, no account required. &copy; {year}
    </p>
    <nav aria-label="Footer navigation">
      <ul class="m-0 flex list-none flex-wrap items-center gap-x-6 gap-y-2 p-0 text-sm font-bold text-da-ink-soft">
        <li><a href="/#grades" class="no-underline hover:text-da-brand">Grades</a></li>
        <li><a href="/skills" class="no-underline hover:text-da-brand">Skills</a></li>
        <li><a href="/#how-it-works" class="no-underline hover:text-da-brand">How it Works</a></li>
        <li><a href="/privacy" class="no-underline hover:text-da-brand">Privacy</a></li>
      </ul>
    </nav>
  </div>
</footer>
