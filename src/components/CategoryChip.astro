---
interface Props {
  label: string;
  variant?: 'blue' | 'yellow' | 'coral' | 'green' | 'sage';
}

const { label, variant = 'blue' } = Astro.props;

const variantClasses: Record<NonNullable<Props['variant']>, string> = {
  blue: 'bg-chip-sky text-white shadow-[0_4px_14px_-4px_rgba(63,182,232,0.55)] hover:shadow-[0_6px_18px_-4px_rgba(63,182,232,0.6)]',
  yellow: 'bg-chip-sun text-white shadow-[0_4px_14px_-4px_rgba(255,179,71,0.55)] hover:shadow-[0_6px_18px_-4px_rgba(255,179,71,0.6)]',
  coral: 'bg-chip-berry text-white shadow-[0_4px_14px_-4px_rgba(239,93,168,0.55)] hover:shadow-[0_6px_18px_-4px_rgba(239,93,168,0.6)]',
  green: 'bg-chip-grass text-white shadow-[0_4px_14px_-4px_rgba(76,175,109,0.55)] hover:shadow-[0_6px_18px_-4px_rgba(76,175,109,0.6)]',
  sage: 'bg-brand-blue text-white shadow-[0_4px_14px_-4px_rgba(47,111,237,0.55)] hover:shadow-[0_6px_18px_-4px_rgba(47,111,237,0.6)]',
};
---

<button
  type="button"
  class={`inline-flex cursor-pointer items-center rounded-full px-5 py-2 text-sm font-bold transition-all hover:scale-[1.03] active:scale-[0.98] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue ${variantClasses[variant]}`}
>
  {label}
</button>
