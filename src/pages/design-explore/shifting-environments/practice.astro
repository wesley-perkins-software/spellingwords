---
// Design exploration — Direction 3: "Shifting Environments"
// Practice / focused environment — enclosed, concentrated, low-chrome.
// Static mockup: multiple states shown stacked on one page.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Practice (Design exploration)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,560;0,9..144,650&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="proto-badge" aria-hidden="true">Design exploration — Shifting Environments</div>

    <div class="env-practice">
      <header class="topline">
        <a class="wordmark" href="/design-explore/shifting-environments/">
          <span class="wordmark-mark">sw</span>spellingwords
        </a>
        <nav class="topnav" aria-label="Prototype navigation">
          <a href="/design-explore/shifting-environments/">Home</a>
          <a href="/design-explore/shifting-environments/grade-hub">Grade Hub</a>
          <a href="/design-explore/shifting-environments/skill">Skill page</a>
        </nav>
      </header>

      <p class="mockup-note">
        Static mockup &mdash; the four states below normally occur one at a time, full-screen.
        They&rsquo;re stacked here only so every state can be reviewed at once.
      </p>

      <main>
        <section class="state-block" aria-label="State: Question">
          <p class="state-label">State: Question</p>
          <div class="stage">
            <div class="stage-glow" aria-hidden="true"></div>
            <div class="stage-inner">
              <p class="progress">Word 3 of 10</p>
              <p class="instruction">Listen, then type the word.</p>
              <button type="button" class="audio-btn">
                <span aria-hidden="true">🔊</span> Hear word again
              </button>
              <div class="answer-wrap">
                <label class="sr-only" for="answer">Type the word you hear</label>
                <input id="answer" type="text" class="answer-input" value="backpack" autocomplete="off" />
              </div>
              <button type="button" class="btn-submit">Submit Answer</button>
            </div>
          </div>
        </section>

        <section class="state-block" aria-label="State: Correct feedback">
          <p class="state-label">State: Correct feedback</p>
          <div class="stage stage-correct">
            <div class="stage-glow stage-glow-correct" aria-hidden="true"></div>
            <div class="stage-inner">
              <p class="feedback-word">sunshine</p>
              <p class="feedback-line feedback-line-correct">
                <span class="feedback-mark" aria-hidden="true">&check;</span> That&rsquo;s right.
              </p>
              <button type="button" class="btn-continue">Continue</button>
            </div>
          </div>
        </section>

        <section class="state-block" aria-label="State: Incorrect feedback">
          <p class="state-label">State: Incorrect feedback</p>
          <div class="stage stage-incorrect">
            <div class="stage-glow stage-glow-incorrect" aria-hidden="true"></div>
            <div class="stage-inner">
              <p class="feedback-word">birthday</p>
              <p class="you-wrote">You wrote: <span>berthday</span></p>
              <p class="correct-shows">
                <span class="correct-shows-label">Correct spelling</span>
                <span class="correct-shows-word">birthday</span>
              </p>
              <p class="feedback-line feedback-line-incorrect">Close &mdash; take another look, then keep going.</p>
              <button type="button" class="btn-continue">Continue</button>
            </div>
          </div>
        </section>

        <section class="state-block" aria-label="State: Results">
          <p class="state-label">State: Results</p>
          <div class="stage stage-results">
            <div class="stage-inner">
              <p class="results-summary">You spelled 8 of 10 words correctly.</p>
              <div class="results-missed">
                <p class="results-missed-label">Worth another look</p>
                <ul>
                  <li>birthday</li>
                  <li>neighbor</li>
                </ul>
              </div>
              <div class="results-actions">
                <button type="button" class="btn-submit">Practice these words again</button>
                <button type="button" class="btn-ghost">Choose another list</button>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <style>
      :global(html, body) {
        margin: 0;
        padding: 0;
      }
      * {
        box-sizing: border-box;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .proto-badge {
        position: fixed;
        bottom: 10px;
        right: 10px;
        z-index: 50;
        background: rgba(24, 18, 46, 0.85);
        color: #f1ecff;
        font: 500 11px/1.4 'Inter', sans-serif;
        padding: 6px 10px;
        border-radius: 6px;
        pointer-events: none;
      }

      .env-practice {
        --env-a: #d9cff2;
        --env-b: #eae4f9;
        --ink: #241c3e;
        --ink-soft: #4e4470;
        --ink-faint: #7b6f9c;
        --accent: #5a3fa6;
        --accent-ink: #3f2a80;
        --focus-ring: #f4b942;
        --correct: #2f6b4f;
        --correct-bg: #e3f2e8;
        --incorrect: #9a4b2f;
        --incorrect-bg: #fbeee7;

        min-height: 100vh;
        background:
          radial-gradient(60% 46% at 50% 30%, rgba(255, 255, 255, 0.55), transparent 68%),
          radial-gradient(140% 100% at 50% -10%, #efe9fb 0%, #cabbe9 62%, #a98fd6 100%);
        font-family: 'Inter', system-ui, sans-serif;
        color: var(--ink);
        padding: 0 clamp(0px, 5vw, 64px) 96px;
      }
      a {
        color: inherit;
      }
      button {
        font-family: inherit;
      }
      *:focus-visible {
        outline: 3px solid var(--focus-ring);
        outline-offset: 3px;
        border-radius: 4px;
      }

      .topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 28px 20px 4px;
        max-width: 720px;
        margin: 0 auto;
        flex-wrap: wrap;
        gap: 12px;
      }
      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: 'Fraunces', serif;
        font-weight: 650;
        font-size: 20px;
        text-decoration: none;
        color: var(--ink);
      }
      .wordmark-mark {
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 9px;
        background: var(--accent);
        color: #fff;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 13px;
        font-weight: 600;
      }
      .topnav {
        display: flex;
        gap: 22px;
        font-size: 14px;
        font-weight: 500;
      }
      .topnav a {
        text-decoration: none;
        color: var(--ink-soft);
      }
      .topnav a:hover {
        text-decoration: underline;
      }

      .mockup-note {
        max-width: 640px;
        margin: 8px auto 36px;
        padding: 0 20px;
        font-size: 13px;
        color: var(--ink-soft);
        text-align: center;
      }

      main {
        max-width: 620px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 58px;
      }

      .state-label {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-soft);
        margin: 0 0 10px 24px;
      }

      /* The "stage" is deliberately NOT a card: no bounding rectangle,
         no fill, no drop shadow around the content. Each state's content
         sits directly on the ambient environment, centered inside a soft
         atmospheric light pool (a blurred radial glow with no hard edge)
         so the moment feels lit, not boxed. The only literal "surface" in
         the whole screen is the answer input itself — a functional text
         field earns a surface; the surrounding content does not. This is
         the deliberate departure from the tinted-background + white-card
         vocabulary used by the browsing/reading environments. */
      .stage {
        position: relative;
        margin: 0 auto;
        max-width: 560px;
        padding: clamp(28px, 6vw, 48px) clamp(16px, 4vw, 32px);
      }
      .stage-glow {
        position: absolute;
        inset: -10% -6%;
        border-radius: 999px;
        background: radial-gradient(closest-side, rgba(255, 255, 255, 0.55), transparent 72%);
        filter: blur(2px);
        pointer-events: none;
        z-index: 0;
      }
      .stage-glow-correct {
        background: radial-gradient(closest-side, rgba(178, 255, 214, 0.45), transparent 72%);
      }
      .stage-glow-incorrect {
        background: radial-gradient(closest-side, rgba(255, 202, 168, 0.4), transparent 72%);
      }
      .stage-inner {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .progress {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: var(--accent-ink);
        margin: 0 0 18px;
      }
      .instruction {
        font-family: 'Fraunces', serif;
        font-weight: 560;
        font-size: clamp(22px, 3.4vw, 28px);
        margin: 0 0 26px;
        color: var(--ink);
      }
      .audio-btn {
        border: 1.5px solid rgba(90, 63, 166, 0.35);
        background: rgba(255, 255, 255, 0.6);
        color: var(--accent-ink);
        font-weight: 600;
        font-size: 14px;
        padding: 10px 18px;
        border-radius: 999px;
        cursor: pointer;
        margin-bottom: 34px;
      }
      .audio-btn:hover {
        background: #fff;
      }
      .answer-wrap {
        width: 100%;
        max-width: 340px;
        margin-bottom: 26px;
      }
      .answer-input {
        width: 100%;
        text-align: center;
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(26px, 5vw, 34px);
        font-weight: 600;
        letter-spacing: 0.02em;
        color: var(--ink);
        background: #fff;
        border: 2px solid rgba(90, 63, 166, 0.3);
        border-radius: 18px;
        padding: 16px 20px;
      }
      .answer-input:focus-visible {
        outline: 3px solid var(--focus-ring);
        outline-offset: 2px;
      }
      .btn-submit {
        background: var(--accent);
        color: #fff;
        border: none;
        font-weight: 600;
        font-size: 15px;
        padding: 14px 30px;
        border-radius: 999px;
        cursor: pointer;
        box-shadow: 0 12px 22px -12px rgba(90, 63, 166, 0.55);
      }
      .btn-submit:hover {
        background: var(--accent-ink);
      }

      .feedback-word {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(28px, 5vw, 36px);
        font-weight: 600;
        margin: 0 0 16px;
      }
      .feedback-line {
        font-size: 16px;
        font-weight: 500;
        margin: 0 0 30px;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .feedback-line-correct {
        color: var(--correct);
      }
      .feedback-mark {
        display: inline-grid;
        place-items: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: var(--correct-bg);
        color: var(--correct);
        font-size: 13px;
      }
      .feedback-line-incorrect {
        color: var(--incorrect);
      }
      .you-wrote {
        font-size: 15px;
        color: var(--ink-faint);
        margin: 0 0 6px;
      }
      .you-wrote span {
        text-decoration: line-through;
        text-decoration-color: rgba(154, 75, 47, 0.5);
        color: var(--incorrect);
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
      }
      .correct-shows {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin: 0 0 20px;
      }
      .correct-shows-label {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--ink-faint);
        font-weight: 600;
      }
      .correct-shows-word {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(24px, 4.4vw, 30px);
        font-weight: 600;
        color: var(--ink);
      }
      .btn-continue {
        background: #fff;
        color: var(--accent-ink);
        border: 1.5px solid rgba(90, 63, 166, 0.35);
        font-weight: 600;
        font-size: 15px;
        padding: 12px 28px;
        border-radius: 999px;
        cursor: pointer;
      }
      .btn-continue:hover {
        background: #f4f1fc;
      }

      .results-summary {
        font-family: 'Fraunces', serif;
        font-weight: 560;
        font-size: clamp(22px, 3.6vw, 27px);
        margin: 0 0 30px;
        text-align: center;
      }
      /* No panel here either — a labeled row under a hairline rule,
         directly on the environment, matching the rest of the state. */
      .results-missed {
        width: 100%;
        max-width: 380px;
        border-top: 1.5px solid rgba(90, 63, 166, 0.22);
        padding-top: 18px;
        margin: 0 0 34px;
      }
      .results-missed-label {
        margin: 0 0 10px;
        font-size: 12.5px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink-faint);
      }
      .results-missed ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        justify-content: center;
      }
      .results-missed li {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
        font-size: 17px;
      }
      .results-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
      }
      .btn-ghost {
        background: transparent;
        color: var(--ink-soft);
        border: 1.5px solid rgba(90, 63, 166, 0.3);
        font-weight: 600;
        font-size: 15px;
        padding: 14px 26px;
        border-radius: 999px;
        cursor: pointer;
      }
      .btn-ghost:hover {
        background: rgba(90, 63, 166, 0.06);
      }

      @media (max-width: 480px) {
        .state-label {
          margin-left: 8px;
        }
        .results-actions {
          flex-direction: column;
        }
        .btn-ghost,
        .results-actions .btn-submit {
          width: 100%;
        }
      }
    </style>
  </body>
</html>
