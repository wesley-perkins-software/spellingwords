---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ListMetadataBadges from '@/components/ListMetadataBadges.astro';
import { getListsByGrade, isPublished, resolveListRefs, getMemberListIds } from '@/lib/content/spellingLists';
import { categoryLabels } from '@/lib/content/categoryMeta';
import { LEARNING_PATHS } from '@/lib/content/learningPaths';

const allCollections = (await getCollection('spelling-collections')).filter((c) => c.data.status === 'published');
const memberIds = getMemberListIds(allCollections);

const entries = (await getCollection('spelling-lists')).filter(isPublished);

// Grade-first sections — only show grades that have published content
const gradeConfig = [
  { grade: 'K', label: 'Kindergarten' },
  { grade: '1', label: '1st Grade' },
  { grade: '2', label: '2nd Grade' },
  { grade: '3', label: '3rd Grade' },
  { grade: '4', label: '4th Grade' },
  { grade: '5', label: '5th Grade' },
];

// For each grade, build items: collections for that grade first, then standalone lists
// (lists that belong to a collection are suppressed)
type GradeItem =
  | { kind: 'collection'; entry: (typeof allCollections)[number] }
  | { kind: 'list'; entry: (typeof entries)[number] };

const gradeSections = gradeConfig
  .map(({ grade, label }) => {
    const gradeLists = getListsByGrade(grade, entries);
    const gradeCollections = allCollections.filter((c) => c.data.grade === grade);
    const items: GradeItem[] = [
      ...gradeCollections.map((c) => ({ kind: 'collection' as const, entry: c })),
      ...gradeLists
        .filter((e) => !memberIds.has(e.data.id))
        .map((e) => ({ kind: 'list' as const, entry: e })),
    ];
    return { grade, label, items };
  })
  .filter(({ items }) => items.length > 0);

// Lists without a grade (e.g. Challenge) shown in a separate section
const ungradedLists = entries.filter((e) => !e.data.grade && !memberIds.has(e.data.id));

// Learning path data — resolve list entries for each path
const resolvedPaths = LEARNING_PATHS.map((path) => ({
  path,
  lists: resolveListRefs([...path.listIds], entries),
})).filter(({ lists }) => lists.length > 0);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Spelling Lists Library' },
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://spellingwords.app');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};
---

<Layout
  title="Spelling Lists Library — spellingwords"
  description="Curated spelling lists for every grade — from Dolch sight words and phonics patterns to grade-level vocabulary and challenge tiers. No timers, no pressure."
  jsonLd={breadcrumbJsonLd}
>
  <SiteHeader variant="discovery" currentPath="/spelling-lists" />

  <main id="main-content">
    <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
      <div class="mb-6">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <!-- Page intro -->
      <div class="mb-12 flex flex-col gap-3">
        <h1 id="library-heading" class="font-display text-2xl font-semibold text-ink md:text-3xl">
          The Spelling Lists Library
        </h1>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">
          Curated, ready-to-practice spelling lists for every grade. Pick a list and start — no setup
          required. Or go back to the homepage to paste in your own words for this week's homework.
        </p>
        <p>
          <a
            href="/"
            class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
          >
            ← Enter your own word list instead
          </a>
        </p>
      </div>

      <!-- Grade navigation chips -->
      <section aria-labelledby="browse-by-grade-heading" class="mb-14">
        <h2 id="browse-by-grade-heading" class="mb-4 font-display text-lg font-semibold text-ink">
          Browse by Grade
        </h2>
        <div class="flex flex-wrap gap-2" role="list">
          {gradeConfig.map(({ grade, label }) => {
            const hasContent = gradeSections.some((s) => s.grade === grade);
            const anchor = `#grade-${grade}`;
            return hasContent ? (
              <a
                href={anchor}
                role="listitem"
                class="inline-flex items-center rounded-xl border border-brand-blue/30 bg-brand-blue/5 px-4 py-2 text-sm font-semibold text-brand-blue transition hover:bg-brand-blue/10 hover:border-brand-blue/50"
              >
                {label}
              </a>
            ) : (
              <span
                role="listitem"
                title="Coming soon"
                class="inline-flex items-center rounded-xl border border-line bg-app-cloud px-4 py-2 text-sm font-medium text-ink-faint cursor-default select-none"
              >
                {label}
              </span>
            );
          })}
        </div>
      </section>

      <!-- Learning paths -->
      {resolvedPaths.length > 0 && (
        <section aria-labelledby="learning-paths-heading" class="mb-14">
          <h2 id="learning-paths-heading" class="mb-1 font-display text-lg font-semibold text-ink">
            Learning Paths
          </h2>
          <p class="mb-6 max-w-2xl text-sm leading-relaxed text-ink-soft">
            Not sure where to start? These curated sequences guide students through a skill step by step.
          </p>
          <div class="flex flex-col gap-6">
            {resolvedPaths.map(({ path, lists }) => (
              <div class="rounded-2xl border border-line bg-app-cloud p-5">
                <h3 class="mb-1 font-display text-base font-semibold text-ink">
                  <a href={`/learning-paths/${path.id}`} class="hover:text-brand-blue hover:underline">{path.title}</a>
                </h3>
                <p class="mb-4 text-sm leading-relaxed text-ink-soft">{path.description}</p>
                <ol class="flex flex-wrap items-center gap-2" aria-label={`${path.title} steps`}>
                  {lists.map((entry, i) => (
                    <>
                      <li class="flex items-center">
                        <a
                          href={`/spelling-lists/${entry.data.category}/${entry.data.urlSlug}`}
                          class="rounded-lg border border-line bg-white px-3 py-1.5 text-sm font-medium text-ink shadow-sm transition hover:border-brand-blue/40 hover:text-brand-blue"
                        >
                          {entry.data.title}
                        </a>
                      </li>
                      {i < lists.length - 1 && (
                        <li aria-hidden="true" class="text-ink-faint text-sm select-none">→</li>
                      )}
                    </>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- All lists — organized by grade -->
      <section aria-labelledby="all-lists-heading" class="flex flex-col gap-12">
        <h2 id="all-lists-heading" class="sr-only">All Spelling Lists</h2>

        {gradeSections.map(({ grade, label, items }) => (
          <section id={`grade-${grade}`} aria-labelledby={`grade-${grade}-heading`} class="flex flex-col gap-4 scroll-mt-20">
            <div class="flex items-baseline gap-3">
              <h2
                id={`grade-${grade}-heading`}
                class="font-display text-lg font-semibold text-ink"
              >
                {label}
              </h2>
              <span class="text-sm text-ink-faint">{items.length} {items.length === 1 ? 'item' : 'items'}</span>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              {items.map((item) => item.kind === 'collection' ? (
                <a
                  href={`/spelling-lists/collections/${item.entry.data.urlSlug}`}
                  class="flex flex-col gap-3 rounded-2xl border border-line bg-white p-5 shadow-[0_4px_16px_-6px_rgba(31,41,55,0.06)] transition hover:-translate-y-0.5 hover:shadow-[0_8px_22px_-8px_rgba(47,111,237,0.25)]"
                >
                  <div class="flex flex-col gap-1">
                    <div class="flex items-center gap-2">
                      <span class="rounded-md bg-app-cloud px-2 py-0.5 text-xs font-medium text-ink-soft">
                        {categoryLabels[item.entry.data.category] ?? item.entry.data.category}
                      </span>
                      <span class="rounded-md bg-brand-blue/8 px-2 py-0.5 text-xs font-semibold text-brand-blue">
                        {item.entry.data.listIds.length}-part collection
                      </span>
                    </div>
                    <h3 class="font-display text-base font-semibold text-ink mt-1">{item.entry.data.title}</h3>
                    <p class="text-sm leading-relaxed text-ink-soft">{item.entry.data.description}</p>
                  </div>
                </a>
              ) : (
                <a
                  href={`/spelling-lists/${item.entry.data.category}/${item.entry.data.urlSlug}`}
                  class="flex flex-col gap-3 rounded-2xl border border-line bg-white p-5 shadow-[0_4px_16px_-6px_rgba(31,41,55,0.06)] transition hover:-translate-y-0.5 hover:shadow-[0_8px_22px_-8px_rgba(47,111,237,0.25)]"
                >
                  <div class="flex flex-col gap-1">
                    <div class="flex items-center gap-2">
                      <span class="rounded-md bg-app-cloud px-2 py-0.5 text-xs font-medium text-ink-soft">
                        {categoryLabels[item.entry.data.category] ?? item.entry.data.category}
                      </span>
                    </div>
                    <h3 class="font-display text-base font-semibold text-ink mt-1">{item.entry.data.title}</h3>
                    <p class="text-sm leading-relaxed text-ink-soft">{item.entry.data.description}</p>
                  </div>
                  <ListMetadataBadges
                    difficulty={item.entry.data.difficulty}
                    durationMinutes={item.entry.data.estimatedDurationMinutes}
                    wordCount={item.entry.data.words.length}
                  />
                </a>
              ))}
            </div>
          </section>
        ))}

        {ungradedLists.length > 0 && (
          <section id="challenge" aria-labelledby="challenge-heading" class="flex flex-col gap-4 scroll-mt-20">
            <div class="flex items-baseline gap-3">
              <h2 id="challenge-heading" class="font-display text-lg font-semibold text-ink">
                Challenge &amp; Advanced
              </h2>
              <span class="text-sm text-ink-faint">{ungradedLists.length} {ungradedLists.length === 1 ? 'list' : 'lists'}</span>
            </div>
            <p class="max-w-2xl text-sm leading-relaxed text-ink-soft">
              Advanced lists for strong spellers — built around Greek and Latin roots and tricky patterns, for spelling-bee prep or students ready to go further.
            </p>
            <div class="grid gap-4 sm:grid-cols-2">
              {ungradedLists.map((entry) => (
                <a
                  href={`/spelling-lists/${entry.data.category}/${entry.data.urlSlug}`}
                  class="flex flex-col gap-3 rounded-2xl border border-line bg-white p-5 shadow-[0_4px_16px_-6px_rgba(31,41,55,0.06)] transition hover:-translate-y-0.5 hover:shadow-[0_8px_22px_-8px_rgba(47,111,237,0.25)]"
                >
                  <div class="flex flex-col gap-1">
                    <h3 class="font-display text-base font-semibold text-ink">{entry.data.title}</h3>
                    <p class="text-sm leading-relaxed text-ink-soft">{entry.data.description}</p>
                  </div>
                  <ListMetadataBadges
                    difficulty={entry.data.difficulty}
                    durationMinutes={entry.data.estimatedDurationMinutes}
                    wordCount={entry.data.words.length}
                  />
                </a>
              ))}
            </div>
          </section>
        )}
      </section>
    </div>
  </main>

  <SiteFooter />
</Layout>
