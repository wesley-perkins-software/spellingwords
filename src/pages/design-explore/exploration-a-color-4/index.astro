---
import Proto from './_shared/Proto.astro';
import Header from './_shared/Header.astro';
import Footer from './_shared/Footer.astro';

const grades = [
  { label: 'Kindergarten', href: '#', tint: 'coral', blurb: 'Letter sounds and first sight words' },
  { label: '1st Grade', href: '#', tint: 'gold', blurb: 'Blends, digraphs, and short vowels' },
  { label: '2nd Grade', href: '#', tint: 'teal', blurb: 'Silent e, vowel teams, and contractions' },
  { label: '3rd Grade', href: '#', tint: 'plum', blurb: 'Prefixes, suffixes, and homophones' },
  { label: '4th Grade', href: '#', tint: 'coral', blurb: 'Advanced affixes and multisyllabic words' },
  { label: '5th Grade', href: '#', tint: 'gold', blurb: 'Greek and Latin word parts' },
];

const skills = [
  { label: 'Short Vowels', href: '#' },
  { label: 'Silent E', href: '/design-explore/exploration-a-color-4/skill.html' },
  { label: 'Soft C and Soft G', href: '/design-explore/exploration-a-color-4/skill.html' },
  { label: 'Prefixes', href: '#' },
  { label: 'Suffixes', href: '#' },
  { label: 'Greek and Latin Roots', href: '#' },
  { label: 'Homophones', href: '#' },
  { label: 'R-Controlled Vowels', href: '#' },
];
---

<Proto
  title="SpellingWords.app — Exploration A4"
  description="Design exploration A: homepage for calm K-5 spelling practice."
>
  <Header currentPath="/design-explore/exploration-a-color-4/" />

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Free · No account needed</p>
          <h1 class="hero-title">
            Hear the word.<br />
            Write it down.<br />
            <span class="hero-title-accent">That's the whole idea.</span>
          </h1>
          <p class="hero-sub">
            SpellingWords.app is calm, focused spelling practice for kids in kindergarten through
            5th grade — read aloud, typed by hand, with no timers, points, or streaks to chase.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="/design-explore/exploration-a-color-4/grade-hub.html"
              >Browse by grade</a
            >
            <a class="btn btn-ghost" href="/design-explore/exploration-a-color-4/skill.html"
              >Browse by skill</a
            >
          </div>
          <ul class="hero-trust">
            <li>K–5 curriculum, built by grade</li>
            <li>Works with your own word list</li>
            <li>No login, no ads, no data games</li>
          </ul>
        </div>

        <div class="hero-panel-wrap">
          <div class="hero-panel">
            <p class="hero-panel-eyebrow">Practice your own words</p>
            <label class="hero-panel-label" for="word-input"
              >Type or paste a list — one word per line</label
            >
            <textarea
              id="word-input"
              class="hero-textarea"
              rows="4"
              placeholder={'lighthouse\nbeneath\nharvest'}></textarea>
            <div class="hero-panel-row">
              <button type="button" class="btn btn-stage-primary">Start this list</button>
              <span class="hero-panel-count">3 words ready</span>
            </div>
            <div class="hero-panel-divider" role="presentation"></div>
            <div class="hero-preview">
              <p class="hero-preview-label">Sounds like this:</p>
              <div class="hero-preview-word">
                <button type="button" class="hero-audio-btn" aria-label="Play the word harvest">
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <path
                      d="M4 9v6h4l5 5V4L8 9H4z"
                      fill="currentColor"
                    /><path
                      d="M16.5 8.5a5 5 0 0 1 0 7"
                      stroke="currentColor"
                      stroke-width="1.8"
                      fill="none"
                      stroke-linecap="round"
                    /><path
                      d="M19 6.5a8.5 8.5 0 0 1 0 11"
                      stroke="currentColor"
                      stroke-width="1.8"
                      fill="none"
                      stroke-linecap="round"
                      opacity="0.6"
                    /></svg
                  >
                </button>
                <span class="hero-preview-blank" aria-hidden="true">harvest</span>
              </div>
            </div>
          </div>
          <div class="hero-panel-shadow" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <!-- ============ BROWSE BY GRADE ============ -->
    <section class="section" id="grades" aria-labelledby="grades-heading">
      <div class="wrap">
        <div class="section-head">
          <h2 id="grades-heading">Browse by grade</h2>
          <p class="section-sub">
            Every grade combines a core spelling sequence, high-frequency word sets, and optional
            themed practice tied to what kids are learning in class.
          </p>
        </div>
        <ul class="grade-grid">
          {
            grades.map((grade) => (
              <li>
                <a class={`grade-card tint-${grade.tint}`} href={grade.href}>
                  <span class="grade-card-label">{grade.label}</span>
                  <span class="grade-card-blurb">{grade.blurb}</span>
                  <span class="grade-card-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ============ BROWSE BY SKILL ============ -->
    <section class="section section-tinted" id="skills" aria-labelledby="skills-heading">
      <div class="wrap">
        <div class="section-head">
          <h2 id="skills-heading">Browse by skill</h2>
          <p class="section-sub">
            Prefer to practice a specific pattern instead of a full grade? Jump straight to a
            phonics or spelling-rule skill.
          </p>
        </div>
        <ul class="skill-chip-row">
          {
            skills.map((skill) => (
              <li>
                <a class="skill-chip" href={skill.href}>
                  {skill.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="text-link" href="/design-explore/exploration-a-color-4/skill.html"
          >See all spelling skills →</a
        >
      </div>
    </section>

    <!-- ============ WHY IT WORKS ============ -->
    <section class="section" aria-labelledby="why-heading">
      <div class="wrap why-grid">
        <div class="why-copy">
          <h2 id="why-heading">Built for how kids actually learn to spell</h2>
          <p class="section-sub">
            No timers ticking down, no points to chase, no streak to protect. Just a word, spoken
            clearly, and a quiet place to write it — as many times as it takes.
          </p>
        </div>
        <ul class="why-list">
          <li>
            <span class="why-icon tint-teal" aria-hidden="true">1</span>
            <div>
              <h3>Hear it, clearly</h3>
              <p>Every word is read aloud on request, as many times as needed.</p>
            </div>
          </li>
          <li>
            <span class="why-icon tint-coral" aria-hidden="true">2</span>
            <div>
              <h3>Write it, calmly</h3>
              <p>One word at a time, with gentle, specific feedback — never a red flood.</p>
            </div>
          </li>
          <li>
            <span class="why-icon tint-gold" aria-hidden="true">3</span>
            <div>
              <h3>No pressure, ever</h3>
              <p>No timers, points, or streaks. Practice ends when the words are done.</p>
            </div>
          </li>
        </ul>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    /* ============ HERO ============ */
    .hero {
      padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 6rem);
      overflow: hidden;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(2rem, 5vw, 4.5rem);
      align-items: center;
    }

    .eyebrow {
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--brand);
      margin-bottom: 1rem;
    }

    .hero-title {
      font-size: clamp(2.3rem, 4.6vw, 3.4rem);
      line-height: 1.09;
      letter-spacing: -0.01em;
      color: var(--ink);
    }

    .hero-title-accent {
      color: var(--brand);
      font-style: italic;
    }

    .hero-sub {
      margin-top: 1.5rem;
      font-size: 1.08rem;
      line-height: 1.6;
      color: var(--ink-soft);
      max-width: 46ch;
    }

    .hero-actions {
      margin-top: 2rem;
      display: flex;
      gap: 0.9rem;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
      padding: 0.85rem 1.6rem;
      border-radius: var(--radius-pill);
      border: 2px solid transparent;
      cursor: pointer;
      transition:
        background 0.15s ease,
        border-color 0.15s ease,
        transform 0.1s ease;
    }

    .btn-primary {
      background: var(--brand);
      color: #fff;
    }
    .btn-primary:hover {
      background: var(--brand-strong);
    }

    .btn-ghost {
      background: transparent;
      color: var(--ink);
      border-color: var(--border-interactive);
    }
    .btn-ghost:hover {
      border-color: var(--brand);
      color: var(--brand);
    }

    .hero-trust {
      margin: 2.25rem 0 0;
      padding: 0;
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }

    .hero-trust li {
      font-size: 0.88rem;
      color: var(--ink-soft);
      padding-left: 1.4rem;
      position: relative;
    }

    .hero-trust li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.42rem;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--teal);
    }

    /* ---- hero panel: word stage surface, offset for asymmetry ---- */
    .hero-panel-wrap {
      position: relative;
      justify-self: end;
      width: 100%;
      max-width: 420px;
    }

    .hero-panel-shadow {
      position: absolute;
      inset: 14px -14px -14px 14px;
      background: var(--stage-edge);
      border-radius: var(--radius-lg);
      opacity: 0.35;
      z-index: 0;
    }

    .hero-panel {
      position: relative;
      z-index: 1;
      background: var(--stage);
      color: var(--ink-on-stage);
      border-radius: var(--radius-lg);
      padding: clamp(1.5rem, 3vw, 2.1rem);
      box-shadow: var(--shadow-stage);
    }

    .hero-panel-eyebrow {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--gold-on-stage);
      margin-bottom: 0.5rem;
    }

    .hero-panel-label {
      display: block;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--ink-on-stage);
      margin-bottom: 0.7rem;
    }

    .hero-textarea {
      width: 100%;
      resize: vertical;
      min-height: 6.5rem;
      background: rgba(255, 255, 255, 0.07);
      border: 1.5px solid rgba(255, 255, 255, 0.22);
      border-radius: var(--radius-md);
      color: var(--ink-on-stage);
      font-family: var(--font-word);
      font-size: 1rem;
      padding: 0.85rem 1rem;
      line-height: 1.6;
    }

    .hero-textarea::placeholder {
      color: var(--ink-on-stage-soft);
    }

    .hero-textarea:focus-visible {
      outline-color: var(--gold-on-stage);
      border-color: transparent;
    }

    .hero-panel-row {
      margin-top: 1.1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .btn-stage-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--gold-on-stage);
      color: var(--stage-deep);
      font-weight: 700;
      font-size: 0.92rem;
      padding: 0.75rem 1.4rem;
      border-radius: var(--radius-pill);
      border: none;
      cursor: pointer;
      transition: background 0.15s ease;
    }
    .btn-stage-primary:hover {
      background: var(--gold-on-stage-hover);
    }

    .hero-panel-count {
      font-size: 0.82rem;
      color: var(--ink-on-stage-soft);
      font-weight: 600;
    }

    .hero-panel-divider {
      height: 1px;
      background: rgba(255, 255, 255, 0.16);
      margin: 1.4rem 0 1.2rem;
    }

    .hero-preview-label {
      font-size: 0.78rem;
      color: var(--ink-on-stage-soft);
      margin-bottom: 0.65rem;
      font-weight: 600;
    }

    .hero-preview-word {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .hero-audio-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.6rem;
      height: 2.6rem;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      border: 1.5px solid rgba(255, 255, 255, 0.28);
      color: var(--ink-on-stage);
      cursor: pointer;
      flex-shrink: 0;
      transition: background 0.15s ease;
    }
    .hero-audio-btn:hover {
      background: rgba(255, 255, 255, 0.2);
    }

    .hero-preview-blank {
      font-family: var(--font-word);
      font-size: 1.4rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      color: transparent;
      -webkit-text-stroke: 1.4px var(--ink-on-stage-soft);
      user-select: none;
    }

    /* ============ SECTION SHELL ============ */
    .section {
      padding-block: clamp(3rem, 6vw, 4.5rem);
    }

    .section-tinted {
      background: var(--canvas-sunken);
    }

    .section-head {
      max-width: 62ch;
      margin-bottom: 2.25rem;
    }

    .section-head h2 {
      font-size: clamp(1.5rem, 2.6vw, 1.9rem);
      margin-bottom: 0.65rem;
    }

    .section-sub {
      color: var(--ink-soft);
      font-size: 1rem;
      line-height: 1.6;
    }

    /* ============ GRADE GRID ============ */
    .grade-grid {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .grade-card {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      text-decoration: none;
      background: var(--canvas-raised);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.35rem 1.4rem 1.5rem;
      position: relative;
      box-shadow: var(--shadow-sm);
      transition:
        transform 0.15s ease,
        box-shadow 0.15s ease,
        border-color 0.15s ease;
      border-top: 4px solid var(--card-tint, var(--brand));
    }

    .grade-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
      border-color: var(--border-strong);
    }

    .grade-card.tint-coral {
      --card-tint: var(--coral);
    }
    .grade-card.tint-gold {
      --card-tint: var(--gold);
    }
    .grade-card.tint-teal {
      --card-tint: var(--teal);
    }
    .grade-card.tint-plum {
      --card-tint: var(--plum);
    }

    .grade-card-label {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.15rem;
      color: var(--ink);
    }

    .grade-card-blurb {
      font-size: 0.88rem;
      color: var(--ink-soft);
      line-height: 1.5;
    }

    .grade-card-arrow {
      position: absolute;
      top: 1.3rem;
      right: 1.3rem;
      color: var(--ink-faint);
      font-size: 1.1rem;
    }

    /* ============ SKILL CHIPS ============ */
    .skill-chip-row {
      list-style: none;
      margin: 0 0 1.5rem;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
    }

    .skill-chip {
      display: inline-flex;
      align-items: center;
      text-decoration: none;
      background: var(--canvas-raised);
      color: var(--ink);
      border: 1.5px solid var(--border-interactive);
      border-radius: var(--radius-pill);
      padding: 0.55rem 1.15rem;
      font-size: 0.9rem;
      font-weight: 600;
      transition:
        border-color 0.15s ease,
        color 0.15s ease,
        background 0.15s ease;
    }

    .skill-chip:hover {
      border-color: var(--brand);
      color: var(--brand);
      background: var(--brand-tint);
    }

    .text-link {
      display: inline-block;
      font-weight: 700;
      font-size: 0.92rem;
      color: var(--brand);
      text-decoration: none;
    }
    .text-link:hover {
      text-decoration: underline;
    }

    /* ============ WHY GRID ============ */
    .why-grid {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }

    .why-copy h2 {
      font-size: clamp(1.5rem, 2.6vw, 1.9rem);
      margin-bottom: 0.9rem;
    }

    .why-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
    }

    .why-list li {
      display: flex;
      gap: 1.1rem;
      align-items: flex-start;
    }

    .why-icon {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.4rem;
      height: 2.4rem;
      border-radius: 50%;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1rem;
    }
    .why-icon.tint-teal {
      background: var(--teal-tint);
      color: var(--teal);
    }
    .why-icon.tint-coral {
      background: var(--coral-tint);
      color: var(--coral);
    }
    .why-icon.tint-gold {
      background: var(--gold-tint);
      color: var(--gold);
    }

    .why-list h3 {
      font-size: 1.05rem;
      margin-bottom: 0.3rem;
    }

    .why-list p {
      font-size: 0.92rem;
      color: var(--ink-soft);
      line-height: 1.55;
    }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 980px) {
      .hero-grid {
        grid-template-columns: 1fr;
      }
      .hero-panel-wrap {
        justify-self: stretch;
        max-width: none;
      }
      .why-grid {
        grid-template-columns: 1fr;
      }
      .grade-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 640px) {
      .hero-panel-shadow {
        display: none;
      }
      .grade-grid {
        grid-template-columns: 1fr;
      }
      .hero-actions .btn {
        flex: 1 1 auto;
      }
      .hero-panel-row {
        flex-direction: column;
        align-items: stretch;
        gap: 0.7rem;
      }
      .hero-panel-row .btn-stage-primary {
        width: 100%;
      }
      .hero-panel-count {
        text-align: center;
      }
    }
  </style>
</Proto>
