---
import Proto from './_shared/Proto.astro';
import Header from './_shared/Header.astro';
import Footer from './_shared/Footer.astro';

const strands = [
  {
    numeral: '01',
    mark: 'coral',
    title: 'Core Spelling',
    body: 'Grade 1 core spelling patterns build on phonics fundamentals — short vowels, consonant blends, and simple long-vowel patterns like silent e.',
    href: '/design-explore/direction-c/skill',
    cta: 'Explore Grade 1 Core Spelling →',
  },
  {
    numeral: '02',
    mark: 'grass',
    title: 'High-Frequency Words',
    body: 'The most common words Grade 1 readers and writers need to know by sight, organized into manageable practice sets.',
    href: '#',
    cta: 'Explore Grade 1 High-Frequency Words →',
  },
  {
    numeral: '03',
    mark: 'peri',
    title: 'Themed Spelling Practice',
    body: 'Grade-level word lists organized around themes and topics young learners are excited to write about.',
    href: '#',
    cta: 'Explore Grade 1 Themed Spelling Practice →',
  },
];
---

<Proto
  title="Grade 1 Spelling Words — Direction C prototype"
  description="Design exploration prototype: Grade 1 spelling words hub."
>
  <Header currentPath="/design-explore/direction-c/grade-hub" />

  <main id="main">
    <div class="wrap">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/design-explore/direction-c/">Home</a></li>
          <li aria-current="page">Grade 1 Spelling Words</li>
        </ol>
      </nav>
    </div>

    <!-- HERO -->
    <section class="hub-hero">
      <div class="wrap">
        <h1>Grade 1 Spelling Words</h1>
        <p class="hero-sub">
          Grade 1 spelling builds directly on phonics fundamentals — short vowels, consonant
          blends, and the earliest long-vowel patterns like silent e — alongside the
          high-frequency words first-grade readers and writers use every day.
        </p>
      </div>
    </section>

    <!-- STRANDS -->
    <section class="strand-section">
      <div class="wrap">
        <ul class="strand-list">
          {
            strands.map((strand) => (
              <li>
                <article class={`strand-card mark-${strand.mark}`}>
                  <span class="strand-numeral" aria-hidden="true">
                    {strand.numeral}
                  </span>
                  <h2>{strand.title}</h2>
                  <p>{strand.body}</p>
                  <a class="strand-link" href={strand.href}>
                    {strand.cta}
                  </a>
                </article>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- WHERE TO BEGIN -->
    <section class="begin-section">
      <div class="wrap">
        <div class="begin-card">
          <h2>Where to begin</h2>
          <p>
            Most Grade 1 students are ready to start with Core Spelling, especially short-vowel
            CVC words like the ones in <a href="/design-explore/direction-c/skill">Short Vowels: CVC Words</a>.
            If your student already reads short-vowel words comfortably, High-Frequency Words is a
            good next step.
          </p>
        </div>
      </div>
    </section>

    <!-- GRADE NAV -->
    <nav class="grade-pager" aria-label="Adjacent grades">
      <div class="wrap grade-pager-inner">
        <a class="pager-link pager-prev" href="#">
          <span class="pager-label">← Kindergarten Spelling Words</span>
        </a>
        <a class="pager-link pager-next" href="#">
          <span class="pager-label">Grade 2 Spelling Words →</span>
        </a>
      </div>
    </nav>

    <div class="wrap back-all">
      <a class="back-link" href="/design-explore/direction-c/">← Back to all grades</a>
    </div>
  </main>

  <Footer />
</Proto>

<style>
  /* ---------- BREADCRUMB ---------- */
  .breadcrumb {
    padding-top: 1.75rem;
  }

  .breadcrumb ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    font-size: 0.88rem;
    color: var(--ink-faint);
  }

  .breadcrumb li:not(:last-child)::after {
    content: '/';
    margin-left: 0.4rem;
    color: var(--ink-faint);
  }

  .breadcrumb a {
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 600;
  }

  .breadcrumb a:hover {
    color: var(--accent-strong);
  }

  .breadcrumb li[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }

  /* ---------- HERO ---------- */
  .hub-hero {
    padding-block: clamp(1.75rem, 4vw, 2.75rem) clamp(2rem, 4vw, 3rem);
  }

  .hub-hero h1 {
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .hero-sub {
    margin-top: 1.25rem;
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    color: var(--ink-soft);
    max-width: 66ch;
    line-height: 1.65;
  }

  /* ---------- STRANDS ---------- */
  .strand-section {
    padding-block: clamp(1rem, 3vw, 2rem);
  }

  .strand-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .strand-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--canvas-raised);
    border: 1.5px solid var(--border);
    border-top-width: 4px;
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.6rem 2rem;
  }

  .mark-coral {
    border-top-color: var(--coral);
  }
  .mark-grass {
    border-top-color: var(--grass);
  }
  .mark-peri {
    border-top-color: var(--peri);
  }

  .strand-numeral {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
  }

  .strand-card h2 {
    margin-top: 0.6rem;
    font-size: 1.4rem;
  }

  .strand-card p {
    margin-top: 0.75rem;
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.6;
    flex: 1;
  }

  .strand-link {
    margin-top: 1.4rem;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--accent-strong);
    text-decoration: none;
    min-height: 44px;
  }

  .strand-link:hover {
    color: var(--accent);
  }

  /* ---------- WHERE TO BEGIN ---------- */
  .begin-section {
    padding-block: clamp(1rem, 3vw, 2rem);
  }

  .begin-card {
    background: var(--accent-tint);
    border: 1.5px solid var(--accent);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2.1rem);
    max-width: 74ch;
  }

  .begin-card h2 {
    font-size: 1.3rem;
    color: var(--accent-strong);
  }

  .begin-card p {
    margin-top: 0.75rem;
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.65;
  }

  .begin-card a {
    color: var(--accent-strong);
    font-weight: 700;
    text-decoration: underline;
  }

  /* ---------- GRADE PAGER ---------- */
  .grade-pager {
    padding-block: clamp(2.25rem, 4vw, 3.25rem);
  }

  .grade-pager-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding-block: 1.25rem;
  }

  .pager-link {
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.25rem 0.4rem;
    border-radius: var(--radius-sm);
  }

  .pager-link:hover {
    color: var(--accent-strong);
  }

  .pager-next {
    margin-left: auto;
  }

  /* ---------- BACK LINK ---------- */
  .back-all {
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--accent-strong);
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 900px) {
    .strand-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .grade-pager-inner {
      flex-direction: column;
      gap: 0.75rem;
    }
    .pager-next {
      margin-left: 0;
    }
  }
</style>
