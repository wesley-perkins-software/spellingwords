---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ListMetadataBadges from '@/components/ListMetadataBadges.astro';
import WordListPreview from '@/components/WordListPreview.astro';
import RelatedListCards from '@/components/RelatedListCards.astro';
import SourceAttribution from '@/components/SourceAttribution.astro';
import { isPublished, resolveListRefs, toPlayableWords } from '@/lib/content/spellingLists';
import { categoryLabels } from '@/lib/content/categoryMeta';
import { getListPath } from '@/lib/content/learningPaths';

export async function getStaticPaths() {
  const entries = (await getCollection('spelling-lists')).filter(isPublished);

  return entries.map((entry) => ({
    params: { category: entry.data.category, slug: entry.data.urlSlug },
    props: { entry, allEntries: entries },
  }));
}

const { entry, allEntries } = Astro.props;
const { data } = entry;

const { Content } = await entry.render();

const related = resolveListRefs(data.relatedLists, allEntries);
const prerequisites = resolveListRefs(data.prerequisiteLists, allEntries);
const next = resolveListRefs(data.nextLists, allEntries);

const playWords = toPlayableWords(entry);
const DEFAULT_SESSION_SIZE = 10;
const quickPracticeWords = playWords.slice(0, DEFAULT_SESSION_SIZE);
const quickPracticeWordsJson = JSON.stringify(quickPracticeWords);
const fullCollectionWordsJson = JSON.stringify(playWords);
const showFullCollectionOption = playWords.length > quickPracticeWords.length;

function listLink(e: (typeof allEntries)[number]) {
  return `/spelling-lists/${e.data.category}/${e.data.urlSlug}`;
}

const categoryLabel = categoryLabels[data.category] ?? data.category;
const listPath = getListPath(data.id);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Spelling Lists Library', href: '/spelling-lists' },
  { label: categoryLabel },
  { label: data.title },
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://spellingwords.app');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};
---

<Layout
  title={`${data.title} — spellingwords`}
  description={data.description}
  ogType="article"
  jsonLd={breadcrumbJsonLd}
>
  <header class="sticky top-0 z-10 border-b border-line bg-white/90 backdrop-blur-sm">
    <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
      <a
        href="/"
        class="flex items-center gap-2 font-display text-lg font-semibold text-ink tracking-tight"
        aria-label="spellingwords home"
      >
        <span
          aria-hidden="true"
          class="flex h-7 w-7 items-center justify-center rounded-2xl bg-brand-blue text-white"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M11.5 2.5l2 2-8 8H3.5v-2l8-8z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9.5 4.5l2 2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
          </svg>
        </span>
        spelling<span class="text-brand-blue">words</span>
      </a>
    </div>
  </header>

  <main id="main-content">
    <section class="mx-auto max-w-3xl px-6 py-12 md:py-16">
      <div class="mb-4">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <div class="flex flex-col gap-3">
        <h1 class="font-display text-2xl font-semibold text-ink md:text-3xl">{data.title}</h1>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">{data.description}</p>
        {data.shortAnswer && (
          <p class="max-w-2xl rounded-xl border border-brand-blue/20 bg-brand-blue/5 px-4 py-3 text-sm leading-relaxed text-ink-soft">
            {data.shortAnswer}
          </p>
        )}
      </div>

      <div class="mt-5">
        <ListMetadataBadges
          category={data.category}
          difficulty={data.difficulty}
          durationMinutes={data.estimatedDurationMinutes}
          wordCount={data.words.length}
          wordCountLabel={`${data.words.length} words in this collection`}
        />
      </div>

      <!-- Learning path indicator -->
      {listPath && (
        <div class="mt-5 inline-flex items-center gap-2 rounded-lg border border-line bg-app-cloud px-3 py-2 text-sm text-ink-soft">
          <span aria-hidden="true">↗</span>
          <span>Part of the <a href="/spelling-lists" class="font-semibold text-ink hover:text-brand-blue hover:underline">{listPath.title}</a></span>
        </div>
      )}

      <!-- Practice options -->
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:flex-wrap">
        <button
          id="btn-start-test"
          type="button"
          data-words={quickPracticeWordsJson}
          class="flex-1 rounded-full bg-brand-blue px-7 py-4 text-base font-bold text-white shadow-[0_8px_24px_-8px_rgba(47,111,237,0.45)] transition hover:bg-brand-blue-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue active:scale-[0.97] sm:flex-none"
          aria-label={`Start a ${quickPracticeWords.length}-word spelling practice session for ${data.title}`}
        >
          Start Spelling Test ({quickPracticeWords.length} words) →
        </button>
        {showFullCollectionOption && (
          <button
            id="btn-start-full-list"
            type="button"
            data-words={fullCollectionWordsJson}
            class="flex-1 rounded-full border-2 border-brand-blue bg-white px-7 py-4 text-base font-bold text-brand-blue transition hover:bg-brand-blue/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue active:scale-[0.97] sm:flex-none"
            aria-label={`Practice all ${playWords.length} words in ${data.title}`}
          >
            Practice all {playWords.length} words
          </button>
        )}
        <span
          class="flex-1 rounded-full px-7 py-4 text-center text-base font-semibold text-ink-soft/50 sm:flex-none"
          aria-hidden="true"
        >
          Print Worksheet
        </span>
      </div>
      <p class="mt-2 max-w-2xl text-sm text-ink-soft">
        This collection has {playWords.length} words total. A practice session is a shorter set of {quickPracticeWords.length} words — a more comfortable size for one sitting.
      </p>
      <p id="start-test-status" class="mt-2 text-xs text-feedback-incorrect" aria-live="polite" aria-atomic="true"></p>

      <!-- Word preview -->
      <div class="mt-10">
        <WordListPreview words={data.words} />
      </div>

      <!-- What this list practices -->
      {data.skillTags.length > 0 && (
        <div class="mt-8">
          <h2 class="mb-3 font-display text-base font-semibold text-ink">What this list practices</h2>
          <div class="flex flex-wrap gap-2">
            {data.skillTags.map((tag) => (
              <span class="rounded-full border border-line bg-app-cloud px-3 py-1 text-xs font-semibold text-ink-soft">
                {tag}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Why these words matter -->
      <div class="prose prose-sm mt-8 max-w-2xl text-ink-soft">
        <h2 class="mb-3 font-display text-base font-semibold text-ink">Why these words matter</h2>
        <Content />
      </div>

      <SourceAttribution source={data.canonicalSource} />

      <RelatedListCards heading="Prerequisite lists" items={prerequisites} listLink={listLink} />
      <RelatedListCards heading="Related lists" items={related} listLink={listLink} />
      <RelatedListCards heading="Where to go next" items={next} listLink={listLink} />
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto max-w-3xl px-6 py-8 text-center text-xs text-ink-soft">
      &copy; {new Date().getFullYear()} spellingwords.app &mdash; Free spelling practice for every classroom.
    </div>
  </footer>
</Layout>

<script>
  import { encodeWordList } from '@/lib/words';

  interface SpellingWordData { word: string; hint?: string; exampleSentence?: string; phonicsPattern?: string[] }

  const statusEl = document.getElementById('start-test-status');

  function getSpellingWords(button: HTMLButtonElement): SpellingWordData[] {
    try {
      const parsed: unknown = JSON.parse(button.dataset.words ?? '[]');
      if (!Array.isArray(parsed)) return [];
      return parsed.filter((e): e is SpellingWordData =>
        typeof e === 'object' && e !== null && typeof (e as SpellingWordData).word === 'string'
      );
    } catch {
      return [];
    }
  }

  function handleStart(event: Event): void {
    const button = event.currentTarget as HTMLButtonElement;
    const words = getSpellingWords(button);
    if (words.length === 0) return;

    const result = encodeWordList(words.map((w) => w.word));
    if (!result.ok) {
      if (statusEl) {
        statusEl.textContent =
          result.code === 'payload_too_long'
            ? 'This list is too long to start automatically. Please try a shorter list.'
            : 'Could not start this spelling test. Please try again.';
      }
      return;
    }

    // Persist rich word data (with exampleSentence etc.) so play.astro can read it.
    try {
      sessionStorage.setItem(`sw:words:${result.payload}`, JSON.stringify(words));
    } catch { /* quota exceeded or private browsing — non-fatal */ }

    window.location.href = `/play?list=${result.payload}`;
  }

  document.getElementById('btn-start-test')?.addEventListener('click', handleStart);
  document.getElementById('btn-start-full-list')?.addEventListener('click', handleStart);
</script>
