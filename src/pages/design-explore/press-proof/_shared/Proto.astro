---
// Shared layout + design-token system for "Press Proof" — a print-shop stamp/ticket/proof-sheet
// exploration. Self-contained: does NOT import production global.css or tailwind.config tokens,
// and does not share tokens with any other design-explore/* direction.
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@500;600;700&family=Karla:wght@400;500;600;700&family=Lexend:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* ============================================================
         PRESS PROOF — a print-shop stamp / ticket / proof-sheet system.
         Canvas philosophy: warm-neutral uncoated paper. No single saturated
         "stage" surface — the practice moment stays on the light canvas as
         a raised, ink-bordered proof sheet. Colour is spent in five
         SEMANTIC roles (trust/nav, action, wayfinding, correct, incorrect),
         never as decorative wash. No pill shapes, no blur/glow shadows —
         hard offset shadows and a small consistent radius scale instead.
         ============================================================ */
      :root {
        /* Canvas */
        --canvas: #f7f4ee;
        --canvas-raised: #ffffff;
        --canvas-sunken: #efeae0;

        /* Ink — warm carbon, not pure black */
        --ink: #17140f;
        --ink-soft: #4a463d;
        /* v2: darkened from #7a756a (4.18:1 on canvas, failed AA) to meet 4.5:1 for small text */
        --ink-faint: #635e53;

        /* Borders */
        --border: #ded7c8;
        --border-strong: var(--ink);

        /* Cobalt — nav / trust / links / structural throughline */
        --cobalt: #0f5fa6;
        --cobalt-deep: #0b4478;
        --cobalt-tint: #dcebf7;

        /* Flame — primary action / energy. Used as ink-outline + ink text,
           never white-on-flame (see accessibility note in Header/buttons). */
        --flame: #e8542a;
        --flame-deep: #c43f19;
        --flame-tint: #fbe2d8;

        /* Marigold — grade/skill wayfinding, tickets. The base hue is a fill/border
           color (3.78:1 on white — fine for non-text UI boundaries), not text; use
           --marigold-text (5.92:1) wherever marigold appears as small text/icons. */
        --marigold: #b5760a;
        --marigold-text: #8a5a08;
        --marigold-tint: #fbeed2;

        /* Mint — correct feedback. --mint is for large stamp lettering and non-text
           borders (>=3:1); --mint-text is the darker variant for small text/icons (>=4.5:1). */
        --mint: #0e8f76;
        --mint-text: #08715c;
        --mint-tint: #dbf0e9;

        /* Berry — incorrect feedback / error. Same large-vs-small-text split as mint. */
        --berry: #c22a63;
        --berry-text: #a81f55;
        --berry-tint: #f7dce7;

        --focus-ring: var(--cobalt);

        --font-display: 'Familjen Grotesk', system-ui, -apple-system, sans-serif;
        --font-body: 'Karla', system-ui, -apple-system, sans-serif;
        /* Word/answer typography: Lexend was chosen over Space Mono after comparison —
           see practice.astro note. Lexend keeps the pedagogical moment friendly and
           highly legible; Space Mono is reserved for compact reference contexts only. */
        --font-word: 'Lexend', system-ui, -apple-system, sans-serif;
        --font-proof: 'Space Mono', ui-monospace, 'SFMono-Regular', monospace;

        --radius-sm: 4px;
        --radius-md: 8px;
        --radius-lg: 12px;

        --shadow-offset: 4px;
        --shadow-hard: 4px 4px 0 var(--ink);
        --shadow-hard-sm: 3px 3px 0 var(--ink);

        color-scheme: light;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--canvas);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }

      img {
        max-width: 100%;
        display: block;
      }

      a {
        color: inherit;
      }

      h1,
      h2,
      h3,
      h4 {
        font-family: var(--font-display);
        margin: 0;
        color: var(--ink);
        font-weight: 700;
      }

      p {
        margin: 0;
      }

      button {
        font-family: inherit;
      }

      :focus-visible {
        outline: 3px solid var(--focus-ring);
        outline-offset: 3px;
        border-radius: 4px;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
      }

      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        background: var(--ink);
        color: var(--canvas);
        padding: 0.75rem 1.25rem;
        border-radius: var(--radius-sm);
        font-weight: 700;
        z-index: 100;
        transition: top 0.15s ease;
      }
      .skip-link:focus {
        top: 1rem;
      }

      .wrap {
        max-width: 1240px;
        margin-inline: auto;
        padding-inline: clamp(1.25rem, 4vw, 3rem);
      }

      /* Base button: rectangular, ink-bordered, hard-shadow "stamp press" */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        padding: 0.8rem 1.5rem;
        border-radius: var(--radius-md);
        border: 2px solid var(--ink);
        cursor: pointer;
        background: var(--canvas-raised);
        color: var(--ink);
        box-shadow: var(--shadow-hard);
        transition:
          transform 0.08s ease,
          box-shadow 0.08s ease;
      }
      .btn:hover {
        transform: translate(-1px, -1px);
        box-shadow: 5px 5px 0 var(--ink);
      }
      .btn:active {
        transform: translate(4px, 4px);
        box-shadow: none;
      }
      .btn-flame {
        background: var(--flame);
        color: var(--ink);
        border-color: var(--ink);
      }
      .btn-cobalt {
        background: var(--cobalt);
        color: #fff;
        border-color: var(--ink);
      }
      .btn-ghost {
        background: transparent;
      }

      /* Prototype corner badge */
      .proto-badge {
        position: fixed;
        bottom: 10px;
        right: 10px;
        z-index: 999;
        background: var(--ink);
        color: var(--canvas);
        font-family: var(--font-body);
        font-size: 9.5px;
        font-weight: 700;
        letter-spacing: 0.02em;
        padding: 4px 9px;
        border-radius: var(--radius-sm);
        opacity: 0.85;
        pointer-events: none;
        box-shadow: 0 1px 6px rgba(0, 0, 0, 0.3);
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <span class="proto-badge" aria-hidden="true">Design exploration — Press Proof</span>
  </body>
</html>
