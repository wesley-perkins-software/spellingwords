---
import Layout from './_Layout.astro';

const grades = [
  { g: 'K', field: 'var(--grade-core)', desc: 'First sounds, letters, and three-letter words.' },
  { g: '1', field: 'var(--phonics)', desc: 'Silent e, letter teams, everyday high-frequency words.' },
  { g: '2', field: 'var(--hfw)', desc: 'Blends, digraphs, and longer word families.' },
  { g: '3', field: 'var(--themed)', desc: 'Prefixes, suffixes, and multi-syllable patterns.' },
  { g: '4', field: 'var(--grade-core)', desc: 'Latin roots and more demanding spelling patterns.' },
  { g: '5', field: 'var(--phonics)', desc: 'Advanced patterns getting students ready for middle school.' },
];

const skills = ['Short A Words', 'Long A Silent E Words', 'Soft C and Soft G', 'Consonant Blends', 'Silent Letters'];
---

<Layout title="Home">
  <header class="explore-e__header">
    <div class="explore-e__header-inner">
      <span class="explore-e__wordmark">spelling<span class="accent">words</span></span>
      <nav class="explore-e__nav">
        <a href="#grades">Grades</a>
        <a href="#skills">Skills</a>
        <a href="#">How it works</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="wrap" style="padding: 64px 24px 52px; text-align: center;">
      <div class="wrap--narrow" style="margin: 0 auto; display: flex; flex-direction: column; gap: 20px; align-items: center;">
        <span class="badge" style="background: var(--phonics);">See the pattern, not just the word</span>
        <h1 style="font-size: clamp(32px, 4.6vw, 50px); line-height: 1.08;">
          Spelling practice that shows its work.
        </h1>
        <p style="font-size: 17px; color: var(--ink-soft); max-width: 46ch; line-height: 1.6;">
          Every word we show marks the letters doing the work — so the pattern is visible,
          not just the spelling. Paste your own list, or follow a grade-level path.
        </p>

        <div class="pword" style="font-size: clamp(48px, 9vw, 84px); margin: 12px 0;">
          c<span class="mark">a</span>k<span class="mark">e</span>
        </div>
        <p style="font-size: 13.5px; color: var(--ink-faint); margin-top: -8px;">The silent e makes the a say its name — long a.</p>

        <div class="card" style="width: 100%; max-width: 540px; text-align: left; overflow: hidden; margin-top: 16px;">
          <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; border-bottom: 1px solid var(--border);">
            <span style="font-size: 13px; font-weight: 700; color: var(--ink-soft); text-transform: uppercase; letter-spacing: 0.04em;">Your words</span>
            <span style="font-size: 12px; font-weight: 700; background: var(--mark); color: var(--mark-ink); padding: 4px 10px; border-radius: 999px;">0 words</span>
          </div>
          <textarea
            rows="4"
            placeholder="Type or paste your words here, one per line"
            style="width: 100%; border: none; resize: none; padding: 18px 20px; font-family: var(--font-word); font-size: 18px; color: var(--ink); background: transparent;"
          ></textarea>
        </div>

        <button type="button" class="btn btn--primary" style="margin-top: 4px;">Start Practicing</button>
      </div>
    </section>

    <section id="grades" class="wrap" style="padding: 44px 24px;">
      <h2 style="font-size: 26px; margin-bottom: 8px;">Browse by Grade</h2>
      <p style="color: var(--ink-soft); max-width: 60ch; margin-bottom: 26px;">
        A Kindergarten&ndash;5th grade path across Core Spelling, High-Frequency Words, and Themed Practice.
      </p>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 14px;">
        {grades.map((item) => (
          <a href="#" class="field" style={`background: ${item.field}; padding: 22px; text-decoration: none;`}>
            <span style="font-family: var(--font-display); font-weight: 700; font-size: 34px; line-height: 1;">{item.g}</span>
            <p style="margin-top: 10px; font-size: 14px; opacity: 0.9; line-height: 1.5;">{item.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="skills" class="wrap" style="padding: 20px 24px 64px;">
      <h2 style="font-size: 26px; margin-bottom: 8px;">Browse by Skill</h2>
      <p style="color: var(--ink-soft); max-width: 60ch; margin-bottom: 22px;">
        Already know what to work on? Explore 41 spelling skills, each with its own practice bank.
      </p>
      <div class="card">
        {skills.map((s, i) => (
          <a href="#" style={`display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; text-decoration: none; color: inherit; ${i < skills.length - 1 ? 'border-bottom: 1px solid var(--border);' : ''}`}>
            <span style="font-family: var(--font-display); font-weight: 600; font-size: 16px;">{s}</span>
            <span style="color: var(--mark); font-weight: 700;">→</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <footer class="explore-e__footer">
    <div class="wrap">No accounts. No timers. Just spelling.</div>
  </footer>
</Layout>
