---
import Layout from './_Layout.astro';
---

<Layout title="Practice">
  <header class="explore-b__header">
    <div class="explore-b__header-inner">
      <span class="explore-b__wordmark" style="font-size: 15px;">SPELLING<span class="accent">WORDS</span></span>
      <a href="#" style="font-size: 13px; font-weight: 800; text-transform: uppercase; color: var(--ink); text-decoration: none;">← New List</a>
    </div>
  </header>

  <main class="wrap wrap--narrow" style="padding: 32px 24px 64px; display: flex; flex-direction: column; gap: 36px;">
    <section style="display: flex; align-items: center; gap: 14px;">
      <span class="sign-badge" style="background: var(--ink);">Word 3 / 10</span>
      <div style="flex: 1; height: 6px; background: var(--rule-soft); border-radius: var(--radius); overflow: hidden;">
        <div style="width: 30%; height: 100%; background: var(--grade-2);"></div>
      </div>
    </section>

    <!-- The Sign Panel: signature practice object -->
    <section class="sign" style="background: var(--grade-2); padding: 40px 36px; display: flex; flex-direction: column; gap: 24px;">
      <p style="color: rgba(255,255,255,0.85); font-size: 15px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em;">
        Listen carefully and type what you hear.
      </p>

      <input
        type="text"
        class="answer-input"
        placeholder="Type the word"
        style="width: 100%; background: #fff; border: none; border-radius: var(--radius); padding: 18px 22px; font-family: var(--font-word); font-size: 28px; font-weight: 700; color: var(--ink);"
      />

      <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <button type="button" class="btn btn--outline" style="border-color: #fff; color: #fff; background: transparent;">
          🔊 Hear Word Again
        </button>
        <button type="button" class="btn btn--outline" style="border-color: #fff; color: #fff; background: transparent;">
          💬 Hear Sentence Again
        </button>
      </div>
    </section>

    <button type="button" class="btn btn--primary" style="width: 100%; justify-content: center; padding: 18px;">
      Submit Answer
    </button>

    <!-- Feedback state (correct) -->
    <section>
      <p style="font-size: 13px; font-weight: 800; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 14px;">Feedback state — correct</p>
      <div class="sign" style="background: var(--correct); padding: 40px 36px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px;">
        <span style="width: 44px; height: 44px; border-radius: var(--radius); background: #fff; display: flex; align-items: center; justify-content: center; color: var(--correct); font-weight: 900;">✓</span>
        <span style="font-family: var(--font-word); font-weight: 800; font-size: 40px; color: #fff;">cake</span>
        <p style="color: rgba(255,255,255,0.9); font-size: 15px; font-weight: 700;">Well spelled.</p>
      </div>
    </section>
  </main>
</Layout>
