---
import type { SpellingListEntry } from '@/lib/content/spellingLists';
import { getRelationshipCardModel } from '@/lib/content/relationshipCard';

interface Props {
  heading: string;
  items: SpellingListEntry[];
  listLink: (entry: SpellingListEntry) => string;
  /** "previous" tints the edge brand-blue (review/reinforce direction, matches
   *  categoryMeta.cardAccent). "forward" tints it amber (categoryMeta's
   *  journeyForwardAccent — the site's one supporting accent, reserved for
   *  progressing to the next list). "neutral" (default) renders a plain card
   *  with no accent edge, for lists that are simply related rather than part
   *  of the before/after progression.
   *  (Class names are written as full literal strings, not built from the
   *  categoryMeta constants, so Tailwind's JIT scanner can detect them.) */
  accent?: 'previous' | 'forward' | 'neutral';
}

const { heading, items, listLink, accent = 'neutral' } = Astro.props;
const edgeClass =
  accent === 'forward'
    ? 'before:bg-accent-gold-on-stage'
    : accent === 'previous'
      ? 'before:bg-brand'
      : 'before:bg-transparent';
---

{
  items.length > 0 && (
    <div class="mt-8">
      <h2 class="mb-3 font-display text-base font-semibold text-ink">{heading}</h2>
      <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap">
        {items.map((linked) => {
          const card = getRelationshipCardModel(linked);
          return (
            <a
              href={listLink(linked)}
              class={`relative flex-1 overflow-hidden rounded-3xl border border-border bg-white py-3 pl-5 pr-4 shadow-card text-sm transition before:absolute before:inset-y-0 before:left-0 before:w-1.5 before:content-[''] ${edgeClass} hover:-translate-y-0.5 hover:shadow-card-md sm:flex-none sm:min-w-[14rem] sm:max-w-sm`}
            >
              {card.gradeLabel && (
                <span class="block text-xs font-bold uppercase tracking-wide text-ink-faint">
                  {card.gradeLabel}
                </span>
              )}
              <span class="mt-0.5 block font-display text-base font-semibold text-ink">
                {card.canonicalTitle}
              </span>
              <span class="mt-1 block text-sm font-semibold text-ink-soft">
                {card.wordCount} words →
              </span>
            </a>
          );
        })}
      </div>
    </div>
  )
}
