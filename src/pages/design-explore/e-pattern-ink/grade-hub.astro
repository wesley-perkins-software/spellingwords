---
import Layout from './_Layout.astro';

const strands = [
  { title: 'Core Spelling', field: 'var(--phonics)', items: ['Short A Words', 'Long A Silent E Words', 'Soft C and Soft G'] },
  { title: 'High-Frequency Words', field: 'var(--hfw)', items: ['Set 1', 'Set 2', 'Set 3'] },
  { title: 'Themed Spelling Practice', field: 'var(--themed)', items: ['Animal Words', 'Weather Words'] },
];
---

<Layout title="Grade 1">
  <header class="explore-e__header">
    <div class="explore-e__header-inner">
      <span class="explore-e__wordmark">spelling<span class="accent">words</span></span>
      <nav class="explore-e__nav">
        <a href="#">Grades</a>
        <a href="#">Skills</a>
      </nav>
    </div>
  </header>

  <main class="wrap wrap--narrow" style="padding: 36px 24px 72px;">
    <p style="font-size: 13px; color: var(--ink-faint); margin-bottom: 18px;">Home / Grade 1</p>
    <h1 style="font-size: clamp(27px, 3.6vw, 36px); margin-bottom: 12px;">Grade 1 Spelling Words</h1>
    <p style="font-size: 15.5px; color: var(--ink-soft); line-height: 1.6; max-width: 62ch; margin-bottom: 34px;">
      A path through Core Spelling patterns, everyday High-Frequency Words, and Themed Practice —
      arranged so the first steps build the skills later ones depend on.
    </p>

    {strands.map((strand) => (
      <section style="margin-bottom: 28px;">
        <div style={`display: flex; align-items: center; gap: 10px; margin-bottom: 12px;`}>
          <span style={`width: 10px; height: 10px; border-radius: 50%; background: ${strand.field};`}></span>
          <h2 style="font-size: 14px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-soft);">{strand.title}</h2>
        </div>
        <div class="card">
          {strand.items.map((item, i) => (
            <a href="#" style={`display: flex; align-items: center; justify-content: space-between; padding: 15px 18px; text-decoration: none; color: inherit; ${i < strand.items.length - 1 ? 'border-bottom: 1px solid var(--border);' : ''}`}>
              <span style="font-family: var(--font-display); font-weight: 600; font-size: 15px;">{item}</span>
              <span style="color: var(--mark); font-weight: 700;">→</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <div class="field" style="background: var(--grade-core); padding: 18px 20px;">
      <p style="font-weight: 700; margin-bottom: 6px; font-size: 15px;">Where to begin</p>
      <p style="opacity: 0.9; font-size: 14.5px; line-height: 1.6;">
        Most Grade 1 students start with Core Spelling, then use High-Frequency Words alongside it each week.
      </p>
    </div>
  </main>

  <footer class="explore-e__footer">
    <div class="wrap">← Kindergarten &nbsp;&nbsp;&nbsp; Grade 2 →</div>
  </footer>
</Layout>
