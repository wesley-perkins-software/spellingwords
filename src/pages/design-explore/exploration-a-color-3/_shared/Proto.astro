---
// Shared layout + design-token system for "Exploration A" prototype.
// Self-contained: does NOT import production global.css or tailwind.config tokens.
// File is prefixed with an underscore so Astro excludes it from routing.
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Petrona:ital,wght@0,500;0,600;0,700;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Lexend:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* ============================================================
         EXPLORATION A3 — chromatic descendant of Exploration A (token system)
         Canvas philosophy: a nearly-white, faintly cool paper. Colour is
         spent on SURFACES (word stage, chips, actions, focus/feedback),
         never as a full-bleed background wash.
         ============================================================ */
      :root {
        /* Canvas — cool near-neutral, no warmth in the paper at all. An
           earlier pass tinted the paper/ink/stage warm-brown and, combined
           with the serif display face, read as coffeehouse/wine-label
           rather than a spelling app — so this revision keeps every
           SURFACE a true neutral graphite and puts the entire chromatic
           thesis into one confident accent hue instead. */
        --canvas: #f7f6f7;
        --canvas-raised: #ffffff;
        --canvas-sunken: #efedee;

        /* Ink — true neutral graphite, no hue bleed from the brand at all */
        --ink: #1c1a1d;
        --ink-soft: #514c50;
        --ink-faint: #837d81;
        --ink-on-stage: #f5eef1;
        --ink-on-stage-soft: #d3c3cb;

        /* Borders */
        --border: #e2dfe1;
        --border-strong: #c9c4c8;
        --border-interactive: #9c7086;

        /* Brand — deep raspberry/rose: a confident pink-red anchor, kept
           dark and muted (not bubblegum) so it reads sophisticated, and
           deliberately more magenta than the brick/orange of --coral or
           the incorrect-feedback red so it never doubles as an error cue. */
        --brand: #9c1f52;
        --brand-strong: #6f1339;
        --brand-tint: #fbe6ee;

        /* Word stage — kept a true neutral graphite-black rather than a
           tinted version of the brand hue: the raspberry appears only as
           the on-stage accent below, so colour still concentrates on one
           destination without the whole surface turning "pink app." */
        --stage: #221f22;
        --stage-deep: #141315;
        --stage-edge: #4a444a;

        /* Secondary accents — used in small, purposeful doses: chips,
           underlines, grade/skill wayfinding, illustrative dots. Unchanged
           from Exploration A; none collide with the new raspberry brand. */
        --coral: #c14a2b;
        --coral-tint: #fbe6df;
        --gold: #a8701e;
        --gold-tint: #f8ecd6;
        --teal: #146059;
        --teal-tint: #dcf0ec;
        --plum: #6a3f89;
        --plum-tint: #efe3f5;
        /* Bright raspberry-pink reserved for use ON the dark graphite stage
           only, where it needs to read as a confident highlight. */
        --gold-on-stage: #c73f75;
        --gold-on-stage-hover: #d65f8d;

        /* Feedback — calm, never the sole signal (paired with icon/text) */
        --correct-bg: #e3f3e4;
        --correct-ink: #1f6b34;
        --correct-border: #a9d9ae;
        --incorrect-bg: #fbe9e6;
        --incorrect-ink: #a13a24;
        --incorrect-border: #edb9ab;

        --focus-ring: #c73f75;

        --font-display: 'Petrona', 'Iowan Old Style', 'Georgia', serif;
        --font-body: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        --font-word: 'Lexend', system-ui, -apple-system, sans-serif;

        --radius-sm: 8px;
        --radius-md: 14px;
        --radius-lg: 22px;
        --radius-pill: 999px;

        --shadow-sm: 0 1px 2px rgba(23, 27, 46, 0.06), 0 1px 1px rgba(23, 27, 46, 0.04);
        --shadow-md: 0 8px 24px rgba(23, 27, 46, 0.09), 0 2px 6px rgba(23, 27, 46, 0.06);
        --shadow-stage: 0 24px 60px rgba(23, 22, 59, 0.28);

        color-scheme: light;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--canvas);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }

      img {
        max-width: 100%;
        display: block;
      }

      a {
        color: inherit;
      }

      h1,
      h2,
      h3,
      h4 {
        font-family: var(--font-display);
        margin: 0;
        color: var(--ink);
        font-weight: 600;
      }

      p {
        margin: 0;
      }

      button {
        font-family: inherit;
      }

      :focus-visible {
        outline: 3px solid var(--focus-ring);
        outline-offset: 3px;
        border-radius: 6px;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
      }

      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        background: var(--stage);
        color: var(--ink-on-stage);
        padding: 0.75rem 1.25rem;
        border-radius: var(--radius-sm);
        font-weight: 700;
        z-index: 100;
        transition: top 0.15s ease;
      }
      .skip-link:focus {
        top: 1rem;
      }

      .wrap {
        max-width: 1240px;
        margin-inline: auto;
        padding-inline: clamp(1.25rem, 4vw, 3rem);
      }

      /* Prototype corner badge — clearly marks this as design exploration */
      .proto-badge {
        position: fixed;
        bottom: 10px;
        right: 10px;
        z-index: 999;
        background: rgba(23, 22, 59, 0.72);
        backdrop-filter: blur(3px);
        color: #fff;
        font-family: var(--font-body);
        font-size: 9.5px;
        font-weight: 600;
        letter-spacing: 0.02em;
        padding: 4px 9px;
        border-radius: 999px;
        opacity: 0.8;
        pointer-events: none;
        box-shadow: 0 1px 6px rgba(0, 0, 0, 0.3);
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <span class="proto-badge" aria-hidden="true">Design exploration — Exploration A3 (color study)</span>
  </body>
</html>
