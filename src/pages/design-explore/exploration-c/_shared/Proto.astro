---
// Shared layout + design-token system for "Exploration C" prototype.
// Self-contained: does NOT import production global.css or tailwind.config tokens.
// File is prefixed with an underscore so Astro excludes it from routing.
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Readex+Pro:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* ============================================================
         EXPLORATION C — design token system (prototype-only)
         Canvas philosophy: conventional information architecture,
         executed with high craft. The canvas is a true neutral paper —
         not A's cool blue-white, not B's warm blush — restraint comes
         from typography and component weight, not a colour wash.
         Colour is spent ONLY on interactive/structural elements, tied
         to content type: cobalt for grade content, magenta for skill
         content, emerald for practice actions. Nothing large is tinted.
         ============================================================ */
      :root {
        /* Canvas — true neutral paper, warm-cool balanced */
        --canvas: #f7f7f5;
        --canvas-raised: #ffffff;
        --canvas-sunken: #eeeeec;

        /* Ink — near-black neutral, not blue-black, not warm-brown */
        --ink: #1a1b19;
        --ink-soft: #52534e;
        --ink-faint: #63645c;

        /* Borders */
        --border: #dcdcd8;
        --border-strong: #c3c3bd;

        /* Content-type hues — the ONLY place colour lives.
           Each has a vivid "-vivid" for small fills/icons/rings and an
           AA-safe "-strong" for text/links on the paper canvas. */
        --grade: #dde7fb;
        --grade-strong: #1d4ed8;
        --grade-vivid: #2f5fe0;
        --grade-ink: #17307a;

        --skill: #fbe0ee;
        --skill-strong: #9d1a63;
        --skill-vivid: #c22a80;
        --skill-ink: #6c1245;

        --practice: #d9f2e6;
        --practice-strong: #067a56;
        --practice-vivid: #0a9868;
        --practice-ink: #065c40;

        /* Focus — a warm amber, deliberately distinct from every content
           hue above so it always reads as "focus", never "grade" etc. */
        --focus-ring: #b8560c;

        /* Feedback — calm, never the sole signal (paired with icon/text) */
        --correct-bg: #e4f4e9;
        --correct-ink: #1c6b3c;
        --correct-border: #a9dab9;
        --incorrect-bg: #fbe8e6;
        --incorrect-ink: #a3341f;
        --incorrect-border: #edb6a9;

        --font-display: 'Sora', system-ui, -apple-system, sans-serif;
        --font-body: 'Public Sans', system-ui, -apple-system, sans-serif;
        --font-word: 'Readex Pro', system-ui, -apple-system, sans-serif;

        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 18px;
        --radius-pill: 999px;

        --shadow-sm: 0 1px 2px rgba(26, 27, 25, 0.06), 0 1px 1px rgba(26, 27, 25, 0.04);
        --shadow-md: 0 10px 26px rgba(26, 27, 25, 0.09), 0 3px 8px rgba(26, 27, 25, 0.05);
        --shadow-lg: 0 22px 48px rgba(26, 27, 25, 0.14), 0 4px 12px rgba(26, 27, 25, 0.06);

        color-scheme: light;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--canvas);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }

      img {
        max-width: 100%;
        display: block;
      }

      a {
        color: inherit;
      }

      h1,
      h2,
      h3,
      h4 {
        font-family: var(--font-display);
        margin: 0;
        color: var(--ink);
        font-weight: 700;
        letter-spacing: -0.01em;
      }

      p {
        margin: 0;
      }

      button {
        font-family: inherit;
      }

      :focus-visible {
        outline: 3px solid var(--focus-ring);
        outline-offset: 3px;
        border-radius: 6px;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
      }

      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        background: var(--ink);
        color: var(--canvas);
        padding: 0.75rem 1.25rem;
        border-radius: var(--radius-sm);
        font-weight: 700;
        z-index: 100;
        transition: top 0.15s ease;
      }
      .skip-link:focus {
        top: 1rem;
      }

      .wrap {
        max-width: 1240px;
        margin-inline: auto;
        padding-inline: clamp(1.25rem, 4vw, 3rem);
      }

      /* Prototype corner badge — clearly marks this as design exploration */
      .proto-badge {
        position: fixed;
        bottom: 10px;
        right: 10px;
        z-index: 999;
        background: rgba(26, 27, 25, 0.78);
        backdrop-filter: blur(3px);
        color: #fff;
        font-family: var(--font-body);
        font-size: 9.5px;
        font-weight: 600;
        letter-spacing: 0.02em;
        padding: 4px 9px;
        border-radius: 999px;
        opacity: 0.85;
        pointer-events: none;
        box-shadow: 0 1px 6px rgba(0, 0, 0, 0.3);
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <span class="proto-badge" aria-hidden="true">Design exploration — Exploration C</span>
  </body>
</html>
