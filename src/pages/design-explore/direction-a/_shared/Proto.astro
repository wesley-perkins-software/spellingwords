---
// Shared layout + design-token system for "Direction A" prototype.
// Self-contained: does NOT import production global.css or tailwind.config tokens.
// File is prefixed with an underscore so Astro excludes it from routing.
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@600;700&family=Mulish:ital,wght@0,400;0,500;0,600;0,700;0,800;1,600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* ============================================================
         DIRECTION A — design token system (prototype-only)
         Thesis: confident color blocking on a light warm-white canvas.
         Color lives on discrete blocked surfaces (nav, hero panel, grade
         card top-bands) — never a full-bleed wash across a whole page.
         ============================================================ */
      :root {
        /* Canvas — light warm-white, not stark white, not deep cream */
        --canvas: #fffbf5;
        --canvas-raised: #ffffff;
        --canvas-sunken: #fbf3e8;

        /* Ink */
        --ink: #2a2420;
        --ink-soft: #5c534b;
        --ink-faint: #8a8078;

        /* Borders */
        --border: #ece2d4;
        --border-strong: #ddcfba;

        /* Brand — confident cerulean blue */
        --brand: #2e7dd1;
        --brand-strong: #1f5fa8;
        --brand-tint: #e4f0fc;
        --brand-on-brand: #ffffff;

        /* Secondary — warm coral-orange */
        --coral: #ff8a5b;
        --coral-strong: #e06a3a;
        --coral-tint: #ffece2;
        --coral-ink: #9a3d17;

        /* Semantic accents for grade/strand wayfinding */
        --sun: #ffc24b;
        --sun-tint: #fff5df;
        --sun-ink: #7a5300;
        --teal: #2fb6a3;
        --teal-tint: #e2f7f4;
        --teal-ink: #0d5c50;
        --pink: #ff6b8a;
        --pink-tint: #ffe6ec;
        --pink-ink: #a01d3f;
        --periwinkle: #7c8cf8;
        --periwinkle-tint: #ecefff;
        --periwinkle-ink: #3b3fb0;

        /* Feedback — calm, muted, never the sole signal */
        --correct-bg: #e3f3e4;
        --correct-ink: #1f6b34;
        --correct-ink-strong: #17532a;
        --correct-border: #a9d9ae;
        --incorrect-bg: #fbe9e6;
        --incorrect-ink: #a13a24;
        --incorrect-ink-strong: #822c1a;
        --incorrect-border: #edb9ab;

        --focus-ring: #1f5fa8;

        --font-display: 'Quicksand', system-ui, -apple-system, sans-serif;
        --font-body: 'Mulish', system-ui, -apple-system, sans-serif;
        --font-word: var(--font-display);

        --radius-sm: 10px;
        --radius-md: 14px;
        --radius-lg: 16px;
        --radius-pill: 999px;

        --shadow-sm: 0 1px 2px rgba(42, 36, 32, 0.07), 0 1px 1px rgba(42, 36, 32, 0.05);
        --shadow-md: 0 10px 24px rgba(42, 36, 32, 0.1), 0 2px 6px rgba(42, 36, 32, 0.06);
        --shadow-lift: 0 18px 34px rgba(42, 36, 32, 0.14), 0 4px 10px rgba(42, 36, 32, 0.08);

        color-scheme: light;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--canvas);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }

      img {
        max-width: 100%;
        display: block;
      }

      a {
        color: inherit;
      }

      h1,
      h2,
      h3,
      h4 {
        font-family: var(--font-display);
        margin: 0;
        color: var(--ink);
        font-weight: 700;
      }

      p {
        margin: 0;
      }

      button {
        font-family: inherit;
      }

      :focus-visible {
        outline: 3px solid var(--focus-ring);
        outline-offset: 3px;
        border-radius: 6px;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
      }

      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        background: var(--brand);
        color: #fff;
        padding: 0.75rem 1.25rem;
        border-radius: var(--radius-sm);
        font-weight: 700;
        z-index: 100;
        transition: top 0.15s ease;
      }
      .skip-link:focus {
        top: 1rem;
      }

      .wrap {
        max-width: 1240px;
        margin-inline: auto;
        padding-inline: clamp(1.25rem, 4vw, 3rem);
      }

      /* ------------------------------------------------------------
         Small shared editorial primitives (used across 2+ pages).
         Kept intentionally minimal — composition tools, not a utility
         framework: an eyebrow label, a rule, and a left-accent note
         block for guidance/callout copy that shouldn't become a card.
         ------------------------------------------------------------ */
      .eyebrow {
        display: block;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-faint);
        margin-bottom: 0.6rem;
      }

      .rule {
        border: none;
        border-top: 1px solid var(--border);
        margin: 0;
      }

      .editorial-note {
        max-width: 60ch;
        padding-left: 1.35rem;
        border-left: 3px solid var(--brand);
      }

      .editorial-note .eyebrow {
        color: var(--brand-strong);
      }

      .editorial-note h2,
      .editorial-note h3 {
        font-size: 1.3rem;
        margin-bottom: 0.75rem;
      }

      .editorial-note p {
        color: var(--ink-soft);
        font-size: 1.05rem;
        line-height: 1.65;
      }

      .editorial-note ul {
        margin: 0.6rem 0 0;
        padding-left: 1.15rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .editorial-note li {
        color: var(--ink-soft);
        font-size: 1.02rem;
        line-height: 1.6;
      }

      /* Prototype corner badge — clearly marks this as design exploration */
      .proto-badge {
        position: fixed;
        bottom: 10px;
        right: 10px;
        z-index: 999;
        background: rgba(42, 36, 32, 0.75);
        backdrop-filter: blur(3px);
        color: #fff;
        font-family: var(--font-body);
        font-size: 9.5px;
        font-weight: 600;
        letter-spacing: 0.02em;
        padding: 4px 9px;
        border-radius: 999px;
        opacity: 0.85;
        pointer-events: none;
        box-shadow: 0 1px 6px rgba(0, 0, 0, 0.3);
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <span class="proto-badge" aria-hidden="true">Design exploration — Direction A</span>
  </body>
</html>
