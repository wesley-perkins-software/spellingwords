---
import { categoryLabels, difficultyLabels } from '@/lib/content/categoryMeta';
import type { SpellingListEntry } from '@/lib/content/spellingLists';

interface Props {
  category?: SpellingListEntry['data']['category'];
  difficulty: SpellingListEntry['data']['difficulty'];
  durationMinutes: number;
  wordCount: number;
}

const { category, difficulty, durationMinutes, wordCount } = Astro.props;
---

<div class="flex flex-wrap items-center gap-2 text-xs font-medium">
  {category && (
    <span class="rounded-md bg-accent-indigo/10 px-3 py-1 text-accent-indigo">
      {categoryLabels[category] ?? category}
    </span>
  )}
  <span class="rounded-md bg-accent-rust/10 px-3 py-1 text-accent-rust">
    {difficultyLabels[difficulty] ?? difficulty}
  </span>
  <span class="rounded-md bg-app-sage/10 px-3 py-1 text-app-sage">
    ~{durationMinutes} min
  </span>
  <span class="rounded-md bg-accent-plum/10 px-3 py-1 text-accent-plum">
    {wordCount} words
  </span>
</div>
