---
import type { SpellingListEntry } from '@/lib/content/spellingLists';

interface Props {
  heading: string;
  items: SpellingListEntry[];
  listLink: (entry: SpellingListEntry) => string;
  /** "forward" tints the accent edge amber (the site's one supporting
   *  accent, reserved for progressing to the next list). Defaults to the
   *  brand-blue family accent used everywhere else. */
  accent?: 'forward' | 'default';
}

const { heading, items, listLink, accent = 'default' } = Astro.props;
const edgeClass = accent === 'forward' ? 'before:bg-chip-sun' : 'before:bg-brand-blue';
---

{
  items.length > 0 && (
    <div class="mt-8">
      <h2 class="mb-3 font-display text-base font-semibold text-ink">{heading}</h2>
      <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap">
        {items.map((linked) => (
          <a
            href={listLink(linked)}
            class={`relative flex-1 overflow-hidden rounded-3xl border border-line bg-white py-3 pl-5 pr-4 shadow-card text-sm transition before:absolute before:inset-y-0 before:left-0 before:w-1.5 before:content-[''] ${edgeClass} hover:-translate-y-0.5 hover:shadow-card-md sm:flex-none sm:min-w-[14rem]`}
          >
            <span class="block font-display text-base font-semibold text-ink">
              {linked.data.title}
            </span>
            <span class="mt-1 block text-sm leading-relaxed text-ink-soft">
              {linked.data.description}
            </span>
          </a>
        ))}
      </div>
    </div>
  )
}
