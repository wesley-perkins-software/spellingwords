---
import Proto from './_shared/Proto.astro';
import ColorWord from './_shared/ColorWord.astro';
import WordDisplay from './_shared/WordDisplay.astro';
---

<Proto
  title="Practice Session — Word as Color Object exploration"
  description="Static mockup of the practice session interface across question, correct, incorrect, and results states."
>
  <header class="site-head">
    <div class="wrap site-head-row">
      <a href="/design-explore/word-as-color-object" class="wordmark">
        <ColorWord word="spelling" fill="sunflower" ghostFill="coral" size="1.5rem" ghost={false} as="span" />
        <span class="wordmark-rest">words.app</span>
      </a>
      <nav aria-label="Primary">
        <a href="/design-explore/word-as-color-object/grade-hub">Grades</a>
        <a href="/design-explore/word-as-color-object/skill">Skills</a>
        <a href="/design-explore/word-as-color-object/practice" aria-current="page">Practice</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <div class="wrap intro-row">
      <p class="proto-note">
        Static prototype &mdash; the four states below represent one practice session, shown stacked rather
        than wired to a real reducer.
      </p>
    </div>

    <!-- STATE: QUESTION -->
    <section class="state-block">
      <div class="wrap">
        <h2 class="state-label">State: Question</h2>
        <div class="session-card">
          <div class="session-top">
            <p class="progress" aria-live="off">Word 3 of 10</p>
            <div class="progress-track" role="progressbar" aria-valuenow="3" aria-valuemin="0" aria-valuemax="10" aria-label="Practice progress">
              <div class="progress-fill" style="width:30%;"></div>
            </div>
          </div>
          <p class="instruction">Listen, then type the word.</p>
          <button class="hear-btn" type="button">
            <span aria-hidden="true">&#128266;</span> Hear word again
          </button>
          <div class="answer-area">
            <label class="visually-hidden" for="q-answer">Type the word you heard</label>
            <div class="answer-box">
              <span class="typed-word">backpack</span><span class="caret" aria-hidden="true"></span>
            </div>
          </div>
          <button class="btn btn-primary submit-btn" type="button">Submit Answer</button>
        </div>
      </div>
    </section>

    <!-- STATE: CORRECT -->
    <section class="state-block">
      <div class="wrap">
        <h2 class="state-label">State: Correct feedback</h2>
        <div class="session-card feedback-card feedback-correct">
          <p class="feedback-eyebrow">Word 4 of 10</p>
          <div class="feedback-word-row">
            <WordDisplay word="sunshine" tone="correct" size="clamp(2rem, 5vw, 3rem)" />
          </div>
          <p class="feedback-phrase">Well spelled.</p>
          <button class="btn btn-primary" type="button">Continue</button>
        </div>
      </div>
    </section>

    <!-- STATE: INCORRECT -->
    <section class="state-block">
      <div class="wrap">
        <h2 class="state-label">State: Incorrect feedback</h2>
        <div class="session-card feedback-card feedback-incorrect">
          <p class="feedback-eyebrow">Word 5 of 10</p>
          <p class="wrote-label">You wrote:</p>
          <p class="wrote-word">berthday</p>
          <p class="correct-label">The word is:</p>
          <div class="feedback-word-row">
            <WordDisplay word="birthday" tone="incorrect" size="clamp(2rem, 5vw, 3rem)" />
          </div>
          <p class="feedback-phrase">We&rsquo;ll come back to this one.</p>
          <button class="btn btn-primary" type="button">Continue</button>
        </div>
      </div>
    </section>

    <!-- STATE: RESULTS -->
    <section class="state-block">
      <div class="wrap">
        <h2 class="state-label">State: Results</h2>
        <div class="session-card results-card">
          <p class="results-summary">You spelled 8 of 10 words correctly.</p>
          <div class="results-missed">
            <p class="results-missed-label">Worth another look:</p>
            <ul class="missed-list" role="list">
              <li><WordDisplay word="birthday" size="1.2rem" /></li>
              <li><WordDisplay word="calendar" size="1.2rem" /></li>
            </ul>
          </div>
          <div class="results-actions">
            <a class="btn btn-primary" href="/design-explore/word-as-color-object/practice">Practice these words again</a>
            <a class="btn btn-ghost" href="/design-explore/word-as-color-object">Choose another list</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-foot">
    <div class="wrap">
      <p>spellingwords.app &mdash; design exploration, not a live product.</p>
    </div>
  </footer>
</Proto>

<style>
  .site-head {
    background: var(--canvas-deeper);
    border-bottom: 1px solid var(--border);
  }
  .site-head-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    text-decoration: none;
    font-family: var(--font-display);
  }
  .wordmark-rest {
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 700;
  }
  .site-head nav {
    display: flex;
    gap: 1.5rem;
    font-weight: 600;
    font-size: 0.95rem;
    margin-right: 3.5rem;
  }
  .site-head nav a {
    text-decoration: none;
    color: var(--ink-soft);
    border-bottom: 2px solid transparent;
    padding-bottom: 0.2rem;
  }
  .site-head nav a[aria-current='page'] {
    color: var(--sunflower);
    border-bottom-color: var(--sunflower);
  }

  .intro-row {
    padding-block: 1.5rem 0.5rem;
  }
  .proto-note {
    color: var(--ink-faint);
    font-size: 0.9rem;
    max-width: 60ch;
    margin: 0;
    border-left: 3px solid var(--border-strong);
    padding-left: 0.9rem;
  }

  .state-block {
    padding-block: 1.75rem;
  }
  .state-label {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
    margin: 0 0 0.9rem;
  }

  .session-card {
    background: var(--canvas-deep);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    max-width: 640px;
  }

  .session-top {
    margin-bottom: 1.5rem;
  }
  .progress {
    margin: 0 0 0.5rem;
    font-weight: 700;
    color: var(--ink);
    font-size: 0.95rem;
  }
  .progress-track {
    height: 8px;
    border-radius: 999px;
    background: var(--canvas-deeper);
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: var(--sunflower);
    border-radius: 999px;
  }

  .instruction {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    color: var(--ink);
    margin: 0 0 1.25rem;
  }

  .hear-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: 1.5px solid var(--border-strong);
    color: var(--ink-soft);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    cursor: pointer;
    margin-bottom: 1.75rem;
  }
  .hear-btn:hover {
    border-color: var(--sunflower);
    color: var(--sunflower);
  }

  .answer-area {
    margin-bottom: 1.75rem;
  }
  .answer-box {
    background: var(--paper);
    border: 2px solid var(--paper-border);
    border-radius: var(--radius-md);
    padding: 1.1rem 1.4rem;
    min-height: 4.5rem;
    display: flex;
    align-items: center;
  }
  .typed-word {
    font-family: var(--font-word);
    font-weight: 700;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    color: var(--paper-ink);
    letter-spacing: 0.02em;
  }
  .caret {
    display: inline-block;
    width: 3px;
    height: clamp(1.6rem, 4vw, 2.2rem);
    background: var(--canvas-deep);
    margin-left: 0.15rem;
    animation: blink 1.1s step-end infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .submit-btn {
    width: 100%;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.9rem 1.6rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    border: 2px solid transparent;
    cursor: pointer;
    min-height: 48px;
  }
  .btn-primary {
    background: var(--sunflower);
    color: var(--canvas-deeper);
  }
  .btn-primary:hover {
    background: #ffd464;
  }
  .btn-ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--border-strong);
  }
  .btn-ghost:hover {
    border-color: var(--sunflower);
    color: var(--sunflower);
  }

  .feedback-card {
    text-align: left;
  }
  .feedback-eyebrow {
    margin: 0 0 1.25rem;
    color: var(--ink-faint);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .feedback-word-row {
    background: var(--paper);
    border-radius: var(--radius-md);
    padding: 1.4rem 1.6rem;
    margin-bottom: 1.25rem;
    display: inline-block;
  }
  .feedback-correct .feedback-word-row {
    border: 2px solid var(--status-correct-bg);
  }
  .feedback-incorrect .feedback-word-row {
    border: 2px solid var(--status-incorrect-bg);
  }
  .feedback-phrase {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--ink);
    margin: 0 0 1.5rem;
  }

  .wrote-label,
  .correct-label {
    margin: 0 0 0.35rem;
    color: var(--ink-faint);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .wrote-word {
    font-family: var(--font-word);
    font-size: 1.4rem;
    color: var(--ink-soft);
    text-decoration: line-through;
    text-decoration-color: var(--coral);
    text-decoration-thickness: 2px;
    margin: 0 0 1.25rem;
  }

  .results-card {
    text-align: left;
  }
  .results-summary {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 3.5vw, 1.9rem);
    color: var(--ink);
    margin: 0 0 1.75rem;
  }
  .results-missed {
    background: var(--canvas-deeper);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.75rem;
  }
  .results-missed-label {
    margin: 0 0 0.75rem;
    color: var(--ink-faint);
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .missed-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .missed-list li {
    background: var(--paper);
    border-radius: var(--radius-sm);
    padding: 0.5rem 1rem;
  }
  .results-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .site-foot {
    background: var(--canvas-deeper);
    padding-block: 1.5rem;
    margin-top: 1rem;
    color: var(--ink-faint);
    font-size: 0.85rem;
  }

  @media (max-width: 480px) {
    .results-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
