---
interface Props {
  words: Array<{ word: string; exampleSentence?: string }>;
  accentClass?: string;
  /** Grade Unit pages show each word with its example sentence (the same
   *  sentence read aloud in practice), so a parent can run the list on paper.
   *  Other pages keep the compact word grid. */
  showSentences?: boolean;
}

const { words, accentClass = 'bg-brand-blue', showSentences = false } = Astro.props;
---

<div class="overflow-hidden rounded-3xl border border-line bg-white shadow-card-lg">
  <div class={`h-1.5 ${accentClass}`} aria-hidden="true"></div>
  {
    showSentences ? (
      <ul class="px-6 py-3 sm:px-8 sm:py-4" aria-label="Words in this list">
        {words.map((word) => (
          <li class="flex flex-col gap-0.5 border-b border-line/60 py-3 last:border-b-0 sm:flex-row sm:items-baseline sm:gap-5">
            <span class="w-20 shrink-0 font-word text-lg font-semibold leading-snug text-ink sm:text-xl">
              {word.word}
            </span>
            {word.exampleSentence && (
              <span class="text-sm leading-relaxed text-ink-soft sm:text-base">
                {word.exampleSentence}
              </span>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <ul
        class="grid grid-cols-2 gap-x-6 gap-y-3 px-6 py-7 sm:grid-cols-3 sm:gap-x-8 sm:gap-y-4 sm:px-8 sm:py-8"
        aria-label="Words in this list"
      >
        {words.map((word) => (
          <li class="font-word text-lg font-semibold leading-snug text-ink sm:text-xl md:text-2xl">
            {word.word}
          </li>
        ))}
      </ul>
    )
  }
</div>
