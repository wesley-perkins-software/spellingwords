---
// Shared layout + design-token system for "Direction B" prototype.
// Self-contained: does NOT import production global.css or tailwind.config tokens.
// File is prefixed with an underscore so Astro excludes it from routing.
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* ============================================================
         DIRECTION B — design token system (prototype-only)
         Thesis: soft tinted surfaces, gentle organic shape, tactile
         warmth. Colour lives in low-saturation watercolor-wash panels,
         not saturated blocks. Depth comes from soft shadows, not hard
         borders. Warm, cozy, credible — not babyish, not sterile.
         ============================================================ */
      :root {
        /* Canvas — pale blush-cream base */
        --canvas: #fdf6ef;
        --canvas-raised: #fffdfa;
        --canvas-sunken: #f7ede1;

        /* Ink — warm soft-black, never pure black */
        --ink: #2b2620;
        --ink-soft: #5a5147;
        --ink-faint: #85786a;
        --ink-on-brand: #fffaf3;

        /* Borders */
        --border: #ecdfd0;
        --border-strong: #ddccb7;

        /* Brand — warm terracotta, the site's throughline accent */
        --brand: #c96a3f;
        --brand-strong: #a3532f;
        --brand-tint: #fbe4d8;

        /* Tinted surfaces — the coordinated pastel family used across
           grade cards / section panels. Each tone also ships a matching
           -ink shade tuned to pass AA text contrast on its own tint. */
        --mint: #e4f3ea;
        --mint-ink: #23604a;
        --mint-border: #c7e6d4;

        --cream: #fdf0d5;
        --cream-ink: #7a5a12;
        --cream-border: #f2ddac;

        --sky: #e4eefb;
        --sky-ink: #275383;
        --sky-border: #c7ddf5;

        --blush: #fce8ee;
        --blush-ink: #96375a;
        --blush-border: #f5cddb;

        --lilac: #ede5f7;
        --lilac-ink: #5a3d84;
        --lilac-border: #ddccec;

        --peach: #fbe6da;
        --peach-ink: #90492a;
        --peach-border: #f3d2b8;

        /* Feedback — calm, never the sole signal */
        --correct-bg: #e4f3ea;
        --correct-ink: #23604a;
        --correct-border: #b9e0c9;
        --incorrect-bg: #fce8ee;
        --incorrect-ink: #96375a;
        --incorrect-border: #f0bdcf;

        --focus-ring: #a3532f;

        --font-display: 'Baloo 2', 'Segoe UI Rounded', system-ui, sans-serif;
        --font-body: 'Nunito', system-ui, -apple-system, sans-serif;

        --radius-sm: 10px;
        --radius-md: 14px;
        --radius-lg: 20px;

        --shadow-sm: 0 1px 2px rgba(90, 65, 40, 0.07), 0 1px 1px rgba(90, 65, 40, 0.05);
        --shadow-md: 0 10px 24px rgba(90, 65, 40, 0.1), 0 2px 8px rgba(90, 65, 40, 0.06);
        --shadow-lift: 0 14px 30px rgba(90, 65, 40, 0.14), 0 4px 10px rgba(90, 65, 40, 0.08);

        color-scheme: light;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--canvas);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      img {
        max-width: 100%;
        display: block;
      }

      a {
        color: inherit;
      }

      h1,
      h2,
      h3,
      h4 {
        font-family: var(--font-display);
        margin: 0;
        color: var(--ink);
        font-weight: 700;
      }

      p {
        margin: 0;
      }

      button {
        font-family: inherit;
      }

      :focus-visible {
        outline: 3px solid var(--focus-ring);
        outline-offset: 3px;
        border-radius: 6px;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
      }

      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        background: var(--brand);
        color: var(--ink-on-brand);
        padding: 0.75rem 1.25rem;
        border-radius: var(--radius-sm);
        font-weight: 700;
        z-index: 100;
        transition: top 0.15s ease;
      }
      .skip-link:focus {
        top: 1rem;
      }

      .wrap {
        max-width: 1200px;
        margin-inline: auto;
        padding-inline: clamp(1.25rem, 4vw, 3rem);
      }

      /* Prototype corner badge — clearly marks this as design exploration */
      .proto-badge {
        position: fixed;
        bottom: 10px;
        right: 10px;
        z-index: 999;
        background: rgba(43, 38, 32, 0.75);
        backdrop-filter: blur(3px);
        color: #fff;
        font-family: var(--font-body);
        font-size: 9.5px;
        font-weight: 600;
        letter-spacing: 0.02em;
        padding: 4px 9px;
        border-radius: 999px;
        opacity: 0.82;
        pointer-events: none;
        box-shadow: 0 1px 6px rgba(0, 0, 0, 0.25);
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <span class="proto-badge" aria-hidden="true">Design exploration — Direction B</span>
  </body>
</html>
