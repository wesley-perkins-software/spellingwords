---
import Layout from '@/layouts/Layout.astro';
import { sampleLists } from '@/data/fixtures/sampleLists';

const exampleWords = sampleLists[2].words.slice(0, 5);
---

<Layout
  title="SpellingWords"
  description="Paste your spelling words and start practicing instantly — spelling tests, word practice, and printable worksheets."
>
  <div class="min-h-screen flex flex-col">

    <!-- ── Top bar ───────────────────────────────────────────────────────── -->
    <header class="border-b border-app-leather/15 px-6 py-4">
      <div class="max-w-4xl mx-auto flex items-center justify-between">
        <span class="font-display font-bold text-lg text-app-charcoal tracking-tight">
          Spelling<span class="text-app-sage">Words</span>
        </span>
        <span class="text-xs text-app-leather font-sans">Free. No account needed.</span>
      </div>
    </header>

    <!-- ── Main tool area ────────────────────────────────────────────────── -->
    <main class="flex-1 max-w-4xl mx-auto w-full px-6 py-12 md:py-16">

      <!-- Headline -->
      <div class="mb-8">
        <h1 class="font-display text-3xl md:text-4xl font-bold text-app-charcoal mb-2">
          Paste your spelling words
        </h1>
        <p class="text-app-charcoal/55 font-sans text-base">
          One word per line. Start a test, practice at your own pace, or print a worksheet.
        </p>
      </div>

      <!-- Input + actions layout -->
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-6 items-start">

        <!-- Textarea panel -->
        <div
          class="border border-app-leather/25 rounded bg-white shadow-sm
                 focus-within:border-app-sage focus-within:ring-1 focus-within:ring-app-sage
                 transition-colors duration-150"
        >
          <!-- Panel header -->
          <div class="flex items-center justify-between px-4 py-2.5 border-b border-app-leather/15">
            <span class="text-xs font-sans font-medium text-app-leather uppercase tracking-widest">
              Word List
            </span>
            <button
              type="button"
              class="text-xs font-sans text-app-leather/60 hover:text-app-charcoal
                     transition-colors duration-100 cursor-pointer"
              aria-label="Clear word list"
            >
              Clear
            </button>
          </div>

          <!-- The textarea itself -->
          <textarea
            id="word-input"
            name="words"
            rows="10"
            placeholder="always&#10;would&#10;people&#10;their&#10;where&#10;because&#10;different&#10;through"
            aria-label="Enter spelling words, one per line"
            class="w-full px-4 py-4 font-sans text-base text-app-charcoal
                   placeholder:text-app-leather/35 bg-transparent resize-none
                   focus:outline-none leading-relaxed"
          ></textarea>

          <!-- Word count footer -->
          <div class="px-4 py-2.5 border-t border-app-leather/10">
            <span
              id="word-count"
              class="text-xs font-sans text-app-leather/50"
              aria-live="polite"
            >
              0 words
            </span>
          </div>
        </div>

        <!-- Right column: actions + example chips -->
        <div class="flex flex-col gap-4">

          <!-- Primary CTA -->
          <button
            type="button"
            class="w-full bg-app-sage text-white font-sans font-semibold
                   px-6 py-3.5 rounded text-sm tracking-wide
                   hover:bg-app-sage/90 active:bg-app-sage/80
                   focus:outline-none focus:ring-2 focus:ring-app-sage focus:ring-offset-2
                   focus:ring-offset-app-cream transition-colors duration-150
                   flex items-center justify-center gap-2"
            aria-label="Start a spelling test"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            Start a Spelling Test
          </button>

          <!-- Secondary actions -->
          <div class="flex flex-col gap-2">
            <button
              type="button"
              class="w-full border border-app-leather/30 text-app-charcoal font-sans
                     font-medium px-6 py-3 rounded text-sm
                     hover:border-app-leather/60 hover:bg-app-charcoal/[0.03]
                     focus:outline-none focus:ring-2 focus:ring-app-charcoal/30
                     focus:ring-offset-1 transition-colors duration-150"
              aria-label="Practice words"
            >
              Practice Words
            </button>
            <button
              type="button"
              class="w-full border border-app-leather/30 text-app-charcoal font-sans
                     font-medium px-6 py-3 rounded text-sm
                     hover:border-app-leather/60 hover:bg-app-charcoal/[0.03]
                     focus:outline-none focus:ring-2 focus:ring-app-charcoal/30
                     focus:ring-offset-1 transition-colors duration-150
                     flex items-center justify-center gap-2"
              aria-label="Print worksheet"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                <rect x="6" y="14" width="12" height="8"></rect>
              </svg>
              Print Worksheet
            </button>
          </div>

          <!-- Divider -->
          <div class="flex items-center gap-3 py-1">
            <div class="h-px flex-1 bg-app-leather/15"></div>
            <span class="text-xs text-app-leather/40 font-sans">or try an example</span>
            <div class="h-px flex-1 bg-app-leather/15"></div>
          </div>

          <!-- Example word chips -->
          <div aria-label="Example word list: Dolch Sight Words">
            <p class="text-xs font-sans text-app-leather/60 mb-2.5 uppercase tracking-widest">
              Dolch Sight Words
            </p>
            <div class="flex flex-wrap gap-1.5">
              {exampleWords.map((w) => (
                <button
                  type="button"
                  data-word={w.word}
                  class="example-chip text-xs font-sans font-medium
                         text-app-charcoal/70 bg-app-leather/8 border border-app-leather/20
                         px-2.5 py-1 rounded-full
                         hover:border-app-sage/50 hover:text-app-sage hover:bg-app-sage/5
                         focus:outline-none focus:ring-1 focus:ring-app-sage
                         transition-colors duration-100 cursor-pointer"
                  aria-label={`Add example word: ${w.word}`}
                >
                  {w.word}
                </button>
              ))}
              <button
                type="button"
                id="load-example-list"
                class="text-xs font-sans font-medium text-app-leather/60
                       border border-dashed border-app-leather/25 px-2.5 py-1 rounded-full
                       hover:border-app-leather hover:text-app-leather
                       focus:outline-none focus:ring-1 focus:ring-app-leather
                       transition-colors duration-100 cursor-pointer"
                aria-label="Load full example list"
              >
                Load all →
              </button>
            </div>
          </div>

        </div>
      </div>
    </main>

    <!-- ── Footer ────────────────────────────────────────────────────────── -->
    <footer class="border-t border-app-leather/10 px-6 py-5">
      <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
        <p class="text-xs text-app-leather/40 font-sans">
          SpellingWords &mdash; free spelling practice for every learner
        </p>
        <nav aria-label="Footer links">
          <a
            href="/about"
            class="text-xs text-app-leather/40 font-sans hover:text-app-charcoal
                   transition-colors duration-100 underline underline-offset-2"
          >
            About
          </a>
        </nav>
      </div>
    </footer>

  </div>
</Layout>

<script>
  // Live word count
  const textarea = document.getElementById('word-input') as HTMLTextAreaElement | null;
  const counter = document.getElementById('word-count');

  function countWords(value: string): number {
    return value.split('\n').map((l) => l.trim()).filter((l) => l.length > 0).length;
  }

  function updateCount() {
    if (!textarea || !counter) return;
    const n = countWords(textarea.value);
    counter.textContent = n === 1 ? '1 word' : `${n} words`;
  }

  textarea?.addEventListener('input', updateCount);

  // Example word chips — append the word to the textarea
  document.querySelectorAll<HTMLButtonElement>('.example-chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!textarea) return;
      const word = btn.dataset.word ?? '';
      const lines = textarea.value.split('\n').map((l) => l.trim()).filter((l) => l.length > 0);
      if (!lines.includes(word)) {
        textarea.value = lines.length > 0 ? lines.join('\n') + '\n' + word : word;
        updateCount();
        textarea.focus();
      }
    });
  });

  // Load all example words at once
  const loadBtn = document.getElementById('load-example-list');
  loadBtn?.addEventListener('click', () => {
    if (!textarea) return;
    const allWords = Array.from(document.querySelectorAll<HTMLButtonElement>('.example-chip'))
      .map((b) => b.dataset.word ?? '')
      .filter(Boolean);
    textarea.value = allWords.join('\n');
    updateCount();
    textarea.focus();
  });
</script>
