    <style>
      :global(html, body) {
        margin: 0;
        padding: 0;
      }
      * {
        box-sizing: border-box;
      }

      .proto-badge {
        position: fixed;
        bottom: 10px;
        right: 10px;
        z-index: 50;
        background: rgba(58, 34, 22, 0.82);
        color: #fdece0;
        font: 500 11px/1.4 'Inter', sans-serif;
        padding: 6px 10px;
        border-radius: 6px;
        pointer-events: none;
      }

      /* "Clay" reading environment — terracotta, not cream/beige: the
         warmth comes from orange-red saturation, not a neutral tan. */
      .env-skill {
        --env-a: #e8bfa4;
        --env-b: #f1d6c2;
        --page: #f7e6d8;
        --ink: #3a2216;
        --ink-soft: #6b4a34;
        --ink-faint: #99755a;
        --accent: #a34a26;
        --accent-soft: #c06a3f;
        --focus-ring: #1c4f8c;

        position: relative;
        min-height: 100vh;
        background: var(--env-a);
        font-family: 'Inter', system-ui, sans-serif;
        color: var(--ink);
      }
      a {
        color: inherit;
      }
      *:focus-visible {
        outline: 3px solid var(--focus-ring);
        outline-offset: 3px;
        border-radius: 4px;
      }

      .topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 28px clamp(20px, 5vw, 64px) 8px;
        max-width: 1000px;
        margin: 0 auto;
        flex-wrap: wrap;
        gap: 12px;
        position: relative;
        z-index: 2;
      }
      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: 'Fraunces', serif;
        font-weight: 650;
        font-size: 20px;
        text-decoration: none;
        color: var(--ink);
      }
      .wordmark-mark {
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 9px;
        background: var(--accent);
        color: #fff;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 13px;
        font-weight: 600;
      }
      .topnav {
        display: flex;
        gap: 22px;
        font-size: 14px;
        font-weight: 500;
      }
      .topnav a {
        text-decoration: none;
        color: var(--ink-soft);
      }
      .topnav a:hover {
        text-decoration: underline;
      }

      .page-fade {
        position: absolute;
        top: 140px;
        left: 0;
        right: 0;
        height: 260px;
        background: linear-gradient(180deg, transparent, var(--page));
        pointer-events: none;
      }
      main {
        position: relative;
        z-index: 1;
        max-width: 760px;
        margin: 0 auto;
        padding: 0 clamp(20px, 5vw, 64px) 100px;
        background: var(--page);
      }

      .crumb {
        font-size: 13px;
        color: var(--ink-faint);
        margin: 0 0 28px;
        padding-top: 28px;
      }
      .crumb a {
        text-decoration: none;
        color: var(--ink-faint);
      }
      .crumb a:hover {
        text-decoration: underline;
      }

      .hero h1 {
        font-family: 'Fraunces', serif;
        font-weight: 650;
        font-size: clamp(32px, 5vw, 48px);
        margin: 0 0 16px;
        letter-spacing: -0.01em;
      }
      .hero-desc {
        font-size: 17px;
        line-height: 1.65;
        color: var(--ink-soft);
        max-width: 62ch;
        margin: 0 0 40px;
      }

      section {
        margin-bottom: 44px;
      }
      h2 {
        font-family: 'Fraunces', serif;
        font-weight: 560;
        font-size: 21px;
        margin: 0 0 14px;
      }

      .answer-block {
        border-left: 3px solid var(--accent-soft);
        padding-left: 20px;
      }
      .answer-block p {
        margin: 0;
        font-size: 16px;
        line-height: 1.7;
        color: var(--ink-soft);
        max-width: 60ch;
      }

      .word-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0 40px;
        border-top: 1px solid rgba(58, 34, 22, 0.18);
        border-bottom: 1px solid rgba(58, 34, 22, 0.18);
        padding: 6px 0;
      }
      .word-list li {
        padding: 10px 0;
      }
      .word {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
        font-size: 19px;
        letter-spacing: 0.01em;
      }

      .prose p {
        font-size: 16px;
        line-height: 1.75;
        color: var(--ink-soft);
        max-width: 64ch;
        margin: 0 0 18px;
      }
      .prose p:last-child {
        margin-bottom: 0;
      }

      .compare-intro {
        margin: 0 0 18px;
        font-size: 15px;
        color: var(--ink-soft);
        max-width: 62ch;
      }
      .table-wrap {
        overflow-x: auto;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14.5px;
      }
      thead th {
        text-align: left;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
        font-size: 12.5px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--ink-faint);
        padding: 0 14px 10px 0;
        border-bottom: 2px solid rgba(58, 34, 22, 0.2);
      }
      tbody td {
        padding: 12px 14px 12px 0;
        border-bottom: 1px solid rgba(58, 34, 22, 0.1);
        color: var(--ink);
      }
      tbody tr:nth-child(odd) {
        background: rgba(163, 74, 38, 0.06);
      }

      .faq-item {
        border-top: 1px solid rgba(58, 34, 22, 0.14);
        padding-top: 18px;
        margin-bottom: 18px;
      }
      .faq-item h3 {
        font-family: 'Fraunces', serif;
        font-weight: 560;
        font-size: 17px;
        margin: 0 0 8px;
      }
      .faq-item p {
        margin: 0;
        font-size: 15px;
        line-height: 1.7;
        color: var(--ink-soft);
        max-width: 62ch;
      }

      .cta-block {
        background: linear-gradient(135deg, #a34a26, #c06a3f);
        border-radius: 6px 26px 6px 26px;
        padding: 2px;
      }
      .cta-inner {
        background: rgba(255, 255, 255, 0.08);
        border-radius: 5px 25px 5px 25px;
        padding: 26px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
      }
      .cta-eyebrow {
        margin: 0 0 4px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.75);
      }
      .cta-inner h2 {
        color: #fff;
        margin: 0 0 4px;
      }
      .cta-inner > div > p {
        margin: 0;
        color: rgba(255, 255, 255, 0.85);
        font-size: 14px;
      }
      .cta-btn {
        text-decoration: none;
        font-weight: 600;
        font-size: 15px;
        color: #a34a26;
        background: #fff;
        padding: 12px 22px;
        border-radius: 999px;
        white-space: nowrap;
      }

      .related {
        margin-top: 44px;
        margin-bottom: 20px;
      }
      .related ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 8px 22px;
      }
      .related a {
        text-decoration: none;
        font-size: 14.5px;
        font-weight: 500;
        color: var(--accent);
        border-bottom: 1.5px solid rgba(163, 74, 38, 0.35);
        padding-bottom: 2px;
      }
      .related a:hover {
        border-color: var(--accent);
      }

      @media (max-width: 560px) {
        .cta-inner {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </body>
</html>
