---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { gradeConfig } from '@/lib/content/gradeConfig';

const chapters = [
  {
    marker: 'K', title: 'Kindergarten', step: 'Starting point', kicker: 'Build the alphabetic foundation',
    copy: 'Kindergarten begins with first words and short-vowel spelling, then brings the five short vowels together and introduces consonant digraphs. High-frequency word sets and familiar themes give children more places to notice letters, sounds, and complete written words.',
    transition: 'The starting point: connect spoken sounds to letters and hold a whole word in mind.'
  },
  {
    marker: '1', title: '1st Grade', step: 'Step 2 of 6', kicker: 'Consolidate patterns and extend the code',
    copy: 'First grade strengthens short-vowel spelling through the C/K and FLOSS rules, then extends into digraphs, blends, silent-e words, vowel teams, inflectional endings, r-controlled vowels, and reliable endings like tch and dge.',
    transition: 'Compared with Kindergarten, students now work across a wider range of patterns and start choosing among several spellings for the same sound.'
  },
  {
    marker: '2', title: '2nd Grade', step: 'Step 3 of 6', kicker: 'Broaden patterns and word complexity',
    copy: 'Second grade widens the vowel system with long e, long i, oi/oy, ou/ow, oo, and au/aw, and adds soft c and g, two-syllable words, final stable le, silent letters, compound words, and contractions.',
    transition: 'The shift from Grade 1 is from mostly one-syllable pattern work to longer words and a wider range of spelling choices.'
  },
  {
    marker: '3', title: '3rd Grade', step: 'Step 4 of 6', kicker: 'Move from patterns into word structure',
    copy: 'Third grade makes word parts explicit: prefixes, suffixes, suffix spelling changes, possessives, multisyllabic words, homophones, and root-word families like act, form, port, and sign.',
    transition: 'Building on Grade 2’s broader code, students now analyze how a word is put together, not just how it sounds.'
  },
  {
    marker: '4', title: '4th Grade', step: 'Step 5 of 6', kicker: 'Deepen morphology and academic spelling',
    copy: 'Fourth grade develops multisyllabic academic spelling alongside advanced prefixes and suffixes, Latin roots such as port, dict, spect, rupt, and struct, commonly confused words, and derived words.',
    transition: 'Compared with Grade 3, morphology goes deeper — students connect stable Latin word parts to longer, more academic words.'
  },
  {
    marker: '5', title: '5th Grade', step: 'Step 6 of 6', kicker: 'Integrate knowledge across complex words',
    copy: 'Fifth grade brings everything together through multisyllabic academic words, combined prefix-and-suffix work, Greek and Latin word parts such as photo, graph, tele, and scope, commonly confused words, and spelling changes across related word families.',
    transition: 'The capstone: use sound, pattern, syllable, and meaning together to spell increasingly sophisticated words.'
  },
].map((chapter, index) => ({ ...chapter, href: gradeConfig[index].hubHref }));

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Grades' }];
const breadcrumbJsonLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem', position: index + 1, name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site ?? 'https://spellingwords.app').toString() } : {}),
  })),
};
---

<Layout title="Spelling Words by Grade: Kindergarten–5th Grade | SpellingWords.app" description="Compare how spelling develops from Kindergarten through 5th Grade, then choose a grade for Core Spelling, High-Frequency Words, and themed practice." jsonLd={breadcrumbJsonLd}>
  <SiteHeader currentPath="/grades" />
  <main id="main-content">
    <div class="mx-auto max-w-content-xl px-5 pt-8 sm:px-6"><Breadcrumbs items={breadcrumbItems} /></div>
    <section class="border-b border-da-border bg-gradient-to-b from-da-brand-tint to-da-canvas px-5 pb-14 pt-10 sm:px-6 md:pb-20 md:pt-14">
      <div class="mx-auto max-w-content-xl">
        <p class="font-quicksand text-sm font-bold uppercase tracking-[.12em] text-da-brand-strong">K–5 spelling</p>
        <h1 class="mt-3 max-w-4xl font-quicksand text-[clamp(2.35rem,6vw,4.5rem)] font-bold leading-[1.04] tracking-tight text-da-ink">Spelling Words by Grade</h1>
        <p class="mt-6 max-w-3xl text-[1.15rem] leading-relaxed text-da-ink">Kindergarten starts by matching sounds to letters. By 5th grade, students are spelling multisyllabic academic words built from Greek and Latin word parts. This page walks through what changes at each grade in between — and links you to the grade you need.</p>
      </div>
    </section>

    <section class="bg-da-canvas px-5 py-12 sm:px-6 md:py-16" aria-labelledby="arc-heading">
      <div class="mx-auto grid max-w-content-xl gap-7 md:grid-cols-[.7fr_1.3fr] md:gap-16">
        <h2 id="arc-heading" class="font-quicksand text-3xl font-bold text-da-ink">One connected progression</h2>
        <div class="space-y-4 text-[1.05rem] leading-relaxed text-da-ink">
          <p>The early grades build and expand the alphabetic code: matching sounds to letters, then layering in digraphs, blends, and vowel patterns. The middle grades add word structure — prefixes, suffixes, syllables, and word parts that carry meaning as well as sound. The later grades bring all of it together in longer, more academic words, including word parts drawn from Greek and Latin.</p>
          <p>At every grade, this comes together through Core Spelling, High-Frequency Words, and Themed Spelling Practice — grade labels organize the curriculum, but learners can move to whatever grade fits.</p>
        </div>
      </div>
    </section>

    <section class="border-y border-da-border bg-da-surface-home px-5 py-14 sm:px-6 md:py-20">
      <h2 class="sr-only">Grade-by-grade progression, Kindergarten through 5th Grade</h2>
      <ol class="mx-auto max-w-5xl list-none p-0">
        {chapters.map((chapter) => (
          <li class="relative grid grid-cols-1 gap-5 border-l-2 border-da-brand/30 pb-14 pl-7 last:pb-0 sm:pl-8 md:grid-cols-[10rem_1fr] md:gap-12 md:pl-12">
            <div aria-hidden="true" class="absolute -left-[1.2rem] top-0 flex h-9 w-9 items-center justify-center rounded-full bg-da-brand-strong font-quicksand text-base font-bold text-da-canvas ring-4 ring-da-canvas sm:-left-[1.35rem] sm:h-11 sm:w-11 sm:text-lg">{chapter.marker}</div>
            <div><p class="text-sm font-bold uppercase tracking-[.08em] text-da-ink-faint">{chapter.step}</p><h3 class="mt-1 font-quicksand text-[1.7rem] font-bold text-da-ink">{chapter.title}</h3></div>
            <article>
              <h4 class="font-quicksand text-xl font-bold text-da-ink">{chapter.kicker}</h4>
              <p class="mt-3 text-[1.05rem] leading-relaxed text-da-ink">{chapter.copy}</p>
              <p class="mt-3 border-l-4 border-da-coral pl-4 text-[1.02rem] font-semibold leading-relaxed text-da-ink">{chapter.transition}</p>
              <a href={chapter.href} class="mt-5 inline-flex min-h-[44px] items-center font-bold text-da-brand-strong no-underline hover:underline">Explore {chapter.title} spelling <span aria-hidden="true">→</span></a>
            </article>
          </li>
        ))}
      </ol>
    </section>

    <section class="border-t border-da-border bg-da-canvas-sunken px-5 py-14 sm:px-6 md:py-20" aria-labelledby="synthesis-heading">
      <div class="mx-auto max-w-3xl text-center">
        <h2 id="synthesis-heading" class="font-quicksand text-3xl font-bold text-da-ink">Six grades, one system</h2>
        <p class="mt-4 text-[1.05rem] leading-relaxed text-da-ink">No grade stands alone. The sound-and-letter work from Kindergarten still underlies the Greek and Latin word parts students spell in 5th grade — each grade adds a layer without replacing the one before it. Grade levels show where each topic appears in the SpellingWords curriculum, and students can review earlier material or explore other grades when that practice is useful.</p>
        <div class="mt-8">
          <a href="/curriculum" class="font-bold text-da-brand-strong no-underline hover:underline">See how the full curriculum is organized <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>
