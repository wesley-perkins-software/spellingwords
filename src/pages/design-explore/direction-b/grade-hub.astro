---
import Proto from './_shared/Proto.astro';
import Header from './_shared/Header.astro';
import Footer from './_shared/Footer.astro';

const strands = [
  {
    tint: 'mint',
    title: 'Core Spelling',
    body: 'Grade 1 core spelling patterns build on phonics fundamentals — short vowels, consonant blends, and simple long-vowel patterns like silent e.',
    href: '/design-explore/direction-b/skill',
    linkLabel: 'Explore Grade 1 Core Spelling →',
  },
  {
    tint: 'sky',
    title: 'High-Frequency Words',
    body: 'The most common words Grade 1 readers and writers need to know by sight, organized into manageable practice sets.',
    href: '#',
    linkLabel: 'Explore Grade 1 High-Frequency Words →',
  },
  {
    tint: 'cream',
    title: 'Themed Spelling Practice',
    body: 'Grade-level word lists organized around themes and topics young learners are excited to write about.',
    href: '#',
    linkLabel: 'Explore Grade 1 Themed Spelling Practice →',
  },
];
---

<Proto
  title="Grade 1 Spelling Words — Direction B prototype"
  description="Design exploration: soft tinted surfaces, gentle shape, tactile warmth."
>
  <Header currentPath="/design-explore/direction-b/grade-hub" />

  <main id="main">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/design-explore/direction-b/">Home</a></li>
          <li aria-current="page">Grade 1 Spelling Words</li>
        </ol>
      </nav>

      <header class="hub-hero">
        <h1>Grade 1 Spelling Words</h1>
        <p>
          Grade 1 spelling builds directly on phonics fundamentals — short vowels, consonant
          blends, and the earliest long-vowel patterns like silent e — alongside the
          high-frequency words first-grade readers and writers use every day.
        </p>
      </header>

      <!-- ============ STRANDS ============ -->
      <ul class="strand-grid">
        {
          strands.map((strand) => (
            <li class={`strand-card tint-${strand.tint}`}>
              <h2>{strand.title}</h2>
              <p>{strand.body}</p>
              <a class="strand-link" href={strand.href}>
                {strand.linkLabel}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- ============ WHERE TO BEGIN ============ -->
      <div class="begin-panel tint-lilac">
        <h2>Where to begin</h2>
        <p>
          Most Grade 1 students are ready to start with Core Spelling, especially short-vowel CVC
          words like the ones in <a href="/design-explore/direction-b/skill">Short Vowels: CVC
            Words</a>. If your student already reads short-vowel words comfortably,
          High-Frequency Words is a good next step.
        </p>
      </div>

      <!-- ============ GRADE NAV ============ -->
      <nav class="grade-nav" aria-label="Adjacent grades">
        <a class="grade-nav-link prev" href="#">← Kindergarten Spelling Words</a>
        <a class="grade-nav-link next" href="#">Grade 2 Spelling Words →</a>
      </nav>

      <a class="back-link" href="/design-explore/direction-b/">← Back to all grades</a>
    </div>
  </main>

  <Footer />
</Proto>

<style>
  main {
    padding-block: clamp(1.5rem, 4vw, 2.5rem) clamp(3rem, 6vw, 5rem);
  }

  /* ---------- Breadcrumbs ---------- */
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    font-size: 0.9rem;
    color: var(--ink-faint);
  }

  .breadcrumbs li:not(:last-child)::after {
    content: '/';
    margin-left: 0.4rem;
    color: var(--ink-faint);
  }

  .breadcrumbs a {
    text-decoration: none;
    color: var(--ink-soft);
    font-weight: 700;
  }

  .breadcrumbs a:hover {
    color: var(--brand-strong);
  }

  .breadcrumbs li[aria-current='page'] {
    color: var(--ink);
    font-weight: 700;
  }

  /* ---------- Hero ---------- */
  .hub-hero {
    max-width: 68ch;
    margin-bottom: 2.5rem;
  }

  .hub-hero h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.15;
  }

  .hub-hero p {
    margin-top: 1rem;
    font-size: 1.08rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }

  /* ---------- Strand grid ---------- */
  .strand-grid {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .strand-card {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: 1.6rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition:
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .strand-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .strand-card h2 {
    font-size: 1.2rem;
  }

  .strand-card p {
    font-size: 0.96rem;
    line-height: 1.55;
    flex: 1;
  }

  .strand-link {
    text-decoration: none;
    font-weight: 700;
    font-size: 0.94rem;
    margin-top: 0.25rem;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .strand-link:hover {
    text-decoration: underline;
  }

  .tint-mint {
    background: var(--mint);
    border: 1px solid var(--mint-border);
  }
  .tint-mint h2,
  .tint-mint .strand-link {
    color: var(--mint-ink);
  }
  .tint-mint p {
    color: color-mix(in srgb, var(--mint-ink) 82%, var(--ink-soft));
  }

  .tint-sky {
    background: var(--sky);
    border: 1px solid var(--sky-border);
  }
  .tint-sky h2,
  .tint-sky .strand-link {
    color: var(--sky-ink);
  }
  .tint-sky p {
    color: color-mix(in srgb, var(--sky-ink) 82%, var(--ink-soft));
  }

  .tint-cream {
    background: var(--cream);
    border: 1px solid var(--cream-border);
  }
  .tint-cream h2,
  .tint-cream .strand-link {
    color: var(--cream-ink);
  }
  .tint-cream p {
    color: color-mix(in srgb, var(--cream-ink) 82%, var(--ink-soft));
  }

  /* ---------- Where to begin ---------- */
  .begin-panel {
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    box-shadow: var(--shadow-sm);
    margin-bottom: 3rem;
  }

  .tint-lilac {
    background: var(--lilac);
    border: 1px solid var(--lilac-border);
  }

  .begin-panel h2 {
    font-size: 1.3rem;
    color: var(--lilac-ink);
  }

  .begin-panel p {
    margin-top: 0.75rem;
    font-size: 1.02rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--lilac-ink) 82%, var(--ink-soft));
    max-width: 68ch;
  }

  .begin-panel a {
    color: var(--brand-strong);
    font-weight: 700;
    text-decoration: underline;
  }

  /* ---------- Grade nav ---------- */
  .grade-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--border);
    padding-top: 1.75rem;
    margin-bottom: 1.5rem;
  }

  .grade-nav-link {
    text-decoration: none;
    font-weight: 700;
    color: var(--ink-soft);
    font-size: 0.98rem;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.4rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .grade-nav-link:hover {
    color: var(--brand-strong);
    background: var(--canvas-sunken);
  }

  .grade-nav-link.next {
    margin-left: auto;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    color: var(--ink-faint);
    font-weight: 700;
    font-size: 0.92rem;
  }

  .back-link:hover {
    color: var(--brand-strong);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 860px) {
    .strand-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .grade-nav {
      flex-direction: column;
      align-items: flex-start;
    }
    .grade-nav-link.next {
      margin-left: 0;
    }
  }
</style>
