---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
---

<Layout
  title="Spelling Test — spellingwords"
  description="Take your custom spelling test. Hear each word spoken aloud and type your answer."
>
  <SiteHeader variant="practice" />

  <main id="main-content">

    <!-- Narrow container: error / unsupported / begin / results -->
    <div class="mx-auto max-w-xl px-6 py-12 md:py-16">

      <!-- Error screen -->
      <section id="screen-error" class="hidden text-center" aria-labelledby="error-heading">
        <div class="flex flex-col items-center gap-6">
          <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-feedback-incorrect/10 text-3xl text-feedback-incorrect" aria-hidden="true">✗</div>
          <div class="flex flex-col gap-2">
            <h1 id="error-heading" class="font-display text-2xl font-semibold text-ink">
              No word list found
            </h1>
            <p id="error-message" class="text-base text-ink-soft"></p>
          </div>
          <a
            href="/"
            class="rounded-full bg-brand-blue px-6 py-3 text-sm font-bold text-white shadow-[0_8px_20px_-8px_rgba(47,111,237,0.45)] transition hover:bg-brand-blue-deep"
          >
            ← Enter new words
          </a>
        </div>
      </section>

      <!-- Unsupported browser screen -->
      <section id="screen-unsupported" class="hidden text-center" aria-labelledby="unsupported-heading">
        <div class="flex flex-col items-center gap-6">
          <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-chip-sun/15 text-3xl" aria-hidden="true">🔇</div>
          <div class="flex flex-col gap-2">
            <h1 id="unsupported-heading" class="font-display text-2xl font-semibold text-ink">
              Audio not supported
            </h1>
            <p class="text-base text-ink-soft">
              Audio spelling tests are not supported in this browser.<br />
              Please try a modern browser with speech support.
            </p>
          </div>
          <a
            href="/"
            class="rounded-full bg-brand-blue px-6 py-3 text-sm font-bold text-white shadow-[0_8px_20px_-8px_rgba(47,111,237,0.45)] transition hover:bg-brand-blue-deep"
          >
            ← Go back
          </a>
        </div>
      </section>

      <!-- Begin screen -->
      <section id="screen-begin" class="hidden" aria-labelledby="begin-heading">

        <!-- Collection title slot — shown when coming from a curated list -->
        <p id="begin-collection-label" class="hidden mb-4 text-center text-sm font-semibold uppercase tracking-widest text-ink-soft"></p>

        <div class="flex flex-col gap-6">
          <!-- Session card -->
          <div class="rounded-2xl border border-line bg-app-cloud px-7 py-7">
            <h1 id="begin-heading" class="font-display text-2xl font-semibold text-ink mb-3">
              Ready to practice?
            </h1>
            <p id="begin-word-count-prose" class="text-base leading-relaxed text-ink mb-4"></p>
            <p class="text-base leading-relaxed text-ink">
              Each word will be spoken aloud — then used in a sentence.<br>
              Take your time and type what you hear.
            </p>
            <!-- Hidden word count for JS, session meta slot for future chunking -->
            <span id="begin-word-count" class="hidden"></span>
            <span id="begin-session-meta" class="hidden"></span>
          </div>

          <!-- Primary CTA -->
          <div class="flex justify-center">
            <button
              id="btn-begin"
              type="button"
              class="inline-flex items-center gap-2 rounded-full bg-brand-red px-10 py-4 font-display text-[19px] font-semibold text-white tracking-[0.01em] shadow-[0_8px_28px_-6px_rgba(201,64,48,0.22)] transition hover:bg-brand-red-deep hover:-translate-y-0.5 hover:shadow-[0_14px_32px_-6px_rgba(201,64,48,0.35)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red active:translate-y-0"
            >
              Start Practice <span aria-hidden="true">→</span>
            </button>
          </div>

          <!-- Session settings -->
          <div class="border-t border-line pt-5">
            <button
              id="btn-voice-toggle"
              type="button"
              aria-expanded="false"
              aria-controls="voice-settings-panel"
              class="text-left text-sm font-semibold text-ink-soft transition-colors hover:text-ink"
            >
              ▾ Session settings
            </button>
            <div
              id="voice-settings-panel"
              class="hidden mt-4 rounded-2xl border border-line bg-white p-5 flex flex-col gap-4"
              role="group"
              aria-label="Session settings"
            >
              <!-- Voice status -->
              <p class="text-sm text-ink">
                Voice: <span id="voice-name-display" class="font-semibold">best available</span>
              </p>

              <!-- Speed slider -->
              <div class="flex items-center gap-3">
                <label for="speed-range" class="text-sm font-medium text-ink whitespace-nowrap w-12">Speed</label>
                <input
                  id="speed-range"
                  type="range"
                  min="0.5"
                  max="1.1"
                  step="0.05"
                  value="1.0"
                  class="flex-1 accent-brand-red"
                  aria-label="Speech speed"
                />
                <span id="speed-label" class="text-sm font-semibold text-ink w-12 text-right">1.00×</span>
              </div>

              <!-- Preview voice -->
              <button
                id="btn-test-voice"
                type="button"
                class="self-start rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold text-ink-soft transition-colors hover:border-brand-red/40 hover:text-brand-red"
              >
                Preview voice
              </button>
            </div>
          </div>
        </div>
      </section>

    </div>

    <!-- Wider container: question + feedback screens (more workbook-page width on desktop) -->
    <div class="mx-auto max-w-xl md:max-w-content-md px-6 pb-12 md:pb-16">

      <!-- Question screen
           Uses CSS grid (1fr auto) with a shared min-height so the Submit Answer button
           always occupies the same vertical slot as the Next Word button in the feedback screen. -->
      <section id="screen-question" class="hidden grid grid-rows-[1fr_auto] gap-4 min-h-[520px]" aria-labelledby="question-heading">

        <!-- Practice Tray — the focused workbook surface -->
        <div class="rounded-3xl border border-line bg-app-cloud shadow-card px-6 py-10 md:px-10 md:py-12 flex flex-col gap-10">

          <!-- Progress — quiet positional label, not a score bar -->
          <div class="flex flex-col gap-1.5">
            <p
              id="progress"
              class="font-sans text-xs font-medium tracking-widest uppercase text-ink-faint"
              aria-live="polite"
              aria-atomic="true"
            ></p>
            <div class="h-px rounded-full bg-line overflow-hidden">
              <div id="progress-bar" class="h-full rounded-full bg-ink-faint/50 transition-[width] duration-500" style="width: 0%"></div>
            </div>
          </div>

          <!-- Practice area: instruction → ruled input → audio footnotes -->
          <div class="flex flex-col gap-6">
            <h1 id="question-heading" class="sr-only">Type the word you hear</h1>
            <p id="question-instruction" class="text-sm leading-relaxed text-ink-faint min-h-[1.25rem]"></p>

            <!-- Ruled-line input — the sentence strip -->
            <div class="flex flex-col gap-1">
              <input
                id="answer-input"
                type="text"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                placeholder="Type the word"
                class="w-full border-0 border-b-2 border-cream-deep bg-transparent px-1 py-3 font-word text-4xl font-semibold text-ink tracking-wide placeholder:text-ink-faint/40 transition-colors focus:border-ink-soft focus:outline-none focus-visible:ring-2 focus-visible:ring-ink-soft/20 focus-visible:ring-offset-2 focus-visible:ring-offset-app-cloud"
                aria-label="Your answer"
              />
              <p
                id="answer-error"
                class="min-h-[1.25rem] px-1 text-sm text-feedback-incorrect"
                aria-live="polite"
                role="alert"
              ></p>
            </div>

            <!-- Audio footnotes — secondary, borderless text actions -->
            <div class="flex items-center gap-4 flex-wrap pt-1">
              <!-- Hear word again — primary audio action -->
              <button
                id="btn-repeat"
                type="button"
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-ink-soft transition hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-ink/30 rounded"
                aria-label="Hear the word again"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                  <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                  <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                </svg>
                Hear word again
              </button>

              <!-- Hear sentence again — secondary; only shown when sentence exists -->
              <button
                id="btn-sentence"
                type="button"
                class="hidden items-center gap-1.5 text-sm font-medium text-ink-faint transition hover:text-ink-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-ink/30 rounded"
                aria-label="Hear the word used in a sentence again"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
                Hear sentence again
              </button>
            </div>
          </div>
        </div>

        <!-- Primary action — grid row 2, same slot as Next Word on feedback screen -->
        <button
          id="btn-submit"
          type="button"
          class="w-full rounded-full bg-brand-red px-6 py-4 font-display text-xl font-semibold text-white shadow-btn-red transition hover:bg-brand-red-deep hover:-translate-y-0.5 hover:shadow-[0_14px_32px_-6px_rgba(201,64,48,0.35)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red active:translate-y-0"
        >
          Submit Answer
        </button>
      </section>

      <!-- Feedback screen
           Shares the same grid layout and min-height as the question screen so Next Word
           lands at the same vertical position as Submit Answer. -->
      <section id="screen-feedback" class="hidden grid grid-rows-[1fr_auto] gap-4 min-h-[520px] text-center" aria-labelledby="feedback-heading" aria-live="assertive">
        <div class="flex flex-col items-center justify-center gap-6">
          <!-- Icon — shown for correct; hidden for incorrect so the word takes focus -->
          <div id="feedback-icon" class="flex h-20 w-20 items-center justify-center rounded-2xl text-4xl" aria-hidden="true"></div>
          <div class="flex flex-col items-center gap-4">
            <!-- Encouragement phrase — coral for incorrect, green for correct -->
            <h1 id="feedback-heading" class="font-display text-3xl font-semibold"></h1>
            <!-- Correct spelling — large and dominant for wrong-answer screen -->
            <p id="feedback-word" class="hidden font-word text-6xl font-bold tracking-tight text-ink leading-none"></p>
            <!-- Closing note — shown only for incorrect -->
            <p id="feedback-detail" class="text-base text-ink"></p>
          </div>
        </div>

        <!-- Primary action — grid row 2, same slot as Submit Answer on question screen -->
        <button
          id="btn-next"
          type="button"
          class="w-full rounded-full bg-brand-red px-6 py-4 font-display text-xl font-semibold text-white shadow-btn-red transition hover:bg-brand-red-deep hover:-translate-y-0.5 hover:shadow-[0_14px_32px_-6px_rgba(201,64,48,0.35)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red active:translate-y-0"
        >
          Next Word →
        </button>
      </section>

      <!-- Results screen -->
      <section id="screen-results" class="hidden" aria-labelledby="results-heading">
        <div class="flex flex-col gap-8">
          <div class="text-center">
            <h1 id="results-heading" class="font-display text-4xl font-semibold text-ink">
              Nice work today.
            </h1>
            <p id="results-summary" class="mt-4 text-xl font-medium text-ink"></p>
            <p id="results-missed-summary" class="mt-2 text-lg text-ink"></p>
            <p id="results-score" class="mt-4 text-sm text-ink-soft/70"></p>
          </div>

          <!-- Missed words — the heart of the results screen; hidden when nothing was missed -->
          <div id="results-missed-section" class="hidden rounded-3xl border border-line bg-white p-6 shadow-[0_4px_16px_-6px_rgba(31,41,55,0.08)]">
            <h2 class="mb-1 text-base font-semibold text-ink">
              Let's look at these together
            </h2>
            <p class="mb-3 text-sm text-ink">A little more time with these, and they'll feel easy.</p>
            <ul id="results-missed-list" class="flex flex-wrap gap-2" aria-label="Words to practice again"></ul>
          </div>

          <!-- Actions — the most useful next step leads -->
          <div class="flex flex-col gap-3">
            <button
              id="btn-review-missed"
              type="button"
              class="hidden w-full rounded-full bg-brand-red px-6 py-4 font-display text-lg font-semibold text-white shadow-[0_8px_28px_-6px_rgba(201,64,48,0.22)] transition hover:bg-brand-red-deep hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red active:translate-y-0"
            >
              Practice the tricky words
            </button>
            <button
              id="btn-retry"
              type="button"
              class="w-full rounded-full border-2 border-line bg-white px-6 py-3.5 text-base font-semibold text-ink transition hover:bg-app-cloud focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink active:scale-[0.97]"
            >
              Start this list again
            </button>
            <a
              href="/"
              class="w-full rounded-full px-6 py-3.5 text-center text-base font-semibold text-ink-soft transition hover:bg-app-cloud hover:text-ink"
            >
              Enter New Words
            </a>
          </div>
        </div>
      </section>

    </div>
  </main>

  <footer id="site-footer" class="border-t border-line">
    <div class="mx-auto max-w-3xl px-6 py-8 text-center text-xs text-ink-soft">
      &copy; {new Date().getFullYear()} spellingwords.app &mdash; Free spelling practice for every classroom.
    </div>
  </footer>
</Layout>

<script>
  import { decodeWordList } from '@/lib/words';
  import { getSentenceBankEntry } from '@/lib/sentenceBank';
  import { createSpeechController, selectPreferredVoice } from '@/modules/speech';
  import type { SpeechSynthesisVoiceAdapter } from '@/modules/speech';
  import {
    spellingTestReducer,
    createInitialState,
    initializeTest,
    startTest,
    submitAnswer,
    nextWord,
    resetTest,
    reviewMissed,
  } from '@/modules/spellingTest/stateMachine';
  import type { TestState } from '@/modules/spellingTest/types';

  // --- DOM refs ---
  const $ = (id: string) => document.getElementById(id)!;

  const screenError = $('screen-error');
  const screenUnsupported = $('screen-unsupported');
  const screenBegin = $('screen-begin');
  const screenQuestion = $('screen-question');
  const screenFeedback = $('screen-feedback');
  const screenResults = $('screen-results');

  const allScreens = [screenError, screenUnsupported, screenBegin, screenQuestion, screenFeedback, screenResults];

  const beginWordCount = $('begin-word-count');
  const progressEl = $('progress');
  const questionInstruction = $('question-instruction');
  const answerInput = $('answer-input') as HTMLInputElement;
  const answerError = $('answer-error');
  const feedbackIcon = $('feedback-icon');
  const feedbackHeading = $('feedback-heading');
  const feedbackWord = $('feedback-word');
  const feedbackDetail = $('feedback-detail');
  const progressBar = $('progress-bar') as HTMLElement;
  const resultsSummary = $('results-summary');
  const resultsMissedSummary = $('results-missed-summary');
  const resultsScore = $('results-score');
  const resultsMissedSection = $('results-missed-section');
  const resultsMissedList = $('results-missed-list');
  const btnBegin = $('btn-begin') as HTMLButtonElement;
  const btnRepeat = $('btn-repeat') as HTMLButtonElement;
  const btnSentence = $('btn-sentence') as HTMLButtonElement;
  const btnSubmit = $('btn-submit') as HTMLButtonElement;
  const btnNext = $('btn-next') as HTMLButtonElement;
  const btnRetry = $('btn-retry') as HTMLButtonElement;
  const btnReviewMissed = $('btn-review-missed') as HTMLButtonElement;
  const errorMessage = $('error-message');

  // Voice controls
  const btnVoiceToggle = $('btn-voice-toggle') as HTMLButtonElement;
  const voiceSettingsPanel = $('voice-settings-panel');
  const voiceNameDisplay = $('voice-name-display');
  const speedRange = $('speed-range') as HTMLInputElement;
  const speedLabel = $('speed-label');
  const btnTestVoice = $('btn-test-voice') as HTMLButtonElement;

  // --- Module state ---
  const speech = createSpeechController();
  let state: TestState = createInitialState();
  let originalWords: string[] = [];

  // Voice settings state — no persistence; resets on page load
  let selectedVoice: SpeechSynthesisVoiceAdapter | null = null;
  let currentRate = 1.0;

  // Pending auto-sentence timeout handle — cancelled whenever we move to a new word
  let sentenceTimeout: ReturnType<typeof setTimeout> | null = null;

  function cancelPendingSentence(): void {
    if (sentenceTimeout !== null) {
      clearTimeout(sentenceTimeout);
      sentenceTimeout = null;
    }
  }

  // --- Warm, varied feedback copy ---
  // A calm adult helping a child — not a scoreboard. We rotate through these
  // so the same phrase doesn't land twice in a row and start to feel canned.
  const CORRECT_PHRASES = ['Well spelled.', 'Good listening.', "That's it exactly.", 'Nice work.', "You've got it."];
  const INCORRECT_PHRASES = ['A good attempt.', "That's a tricky one.", 'Close — good effort.', 'Good try.', "Let's come back to this one."];

  let lastCorrectPhrase = -1;
  let lastIncorrectPhrase = -1;

  function pickPhrase(pool: string[], lastIndex: number, remember: (i: number) => void): string {
    let i = Math.floor(Math.random() * pool.length);
    if (pool.length > 1 && i === lastIndex) i = (i + 1) % pool.length;
    remember(i);
    return pool[i];
  }

  // --- Progressive instructions ---
  // Full guidance up front; as the child settles in, the screen quietly
  // steps back rather than repeating itself on every single word.
  function instructionForIndex(index: number): string {
    if (index === 0) {
      return "Listen, then type the word you hear.";
    }
    return '';
  }

  // --- Screen management ---
  const siteFooter = document.getElementById('site-footer');
  const immersiveScreens = [screenQuestion, screenFeedback, screenResults];

  function showScreen(target: HTMLElement): void {
    for (const screen of allScreens) {
      screen.classList.toggle('hidden', screen !== target);
    }
    siteFooter?.classList.toggle('hidden', immersiveScreens.includes(target));
  }

  function showError(message: string): void {
    errorMessage.textContent = message;
    showScreen(screenError);
  }

  // --- Voice controls setup ---
  async function initVoiceControls(): Promise<void> {
    const allVoices = await speech.loadVoices();
    selectedVoice = selectPreferredVoice(allVoices);
    if (selectedVoice) {
      voiceNameDisplay.textContent = selectedVoice.name;
    }
  }

  // --- Initialization ---
  function init(): void {
    const params = new URLSearchParams(window.location.search);
    const payload = params.get('list');

    if (!payload) {
      showError('No word list found. Please go back and enter your words.');
      return;
    }

    const decoded = decodeWordList(payload);
    if (!decoded.ok) {
      showError('The word list could not be loaded. Please go back and try again.');
      return;
    }

    if (!speech.isSpeechSupported()) {
      showScreen(screenUnsupported);
      return;
    }

    originalWords = decoded.words;

    // Try to recover rich SpellingWord data (with exampleSentence) stored by curated list pages.
    let richWords: { word: string; exampleSentence?: string }[] | null = null;
    try {
      const stored = sessionStorage.getItem(`sw:words:${payload}`);
      if (stored) {
        const parsed: unknown = JSON.parse(stored);
        if (Array.isArray(parsed) && parsed.every((e) => typeof e?.word === 'string')) {
          richWords = parsed as { word: string; exampleSentence?: string }[];
        }
      }
    } catch { /* sessionStorage unavailable or parse failed — fall through to plain words */ }

    // For custom lists (no sessionStorage entry), enrich words from the sentence bank.
    // Curated list words already carry their exampleSentence inside richWords — never overwrite those.
    if (!richWords) {
      richWords = originalWords.map((w) => {
        const entry = getSentenceBankEntry(w);
        return entry ? { word: w, exampleSentence: entry.exampleSentence } : { word: w };
      });
    }

    state = spellingTestReducer(createInitialState(), initializeTest(richWords));

    const count = originalWords.length;
    beginWordCount.textContent = `${count} ${count === 1 ? 'word' : 'words'}`;
    ($('begin-word-count-prose') as HTMLElement).textContent =
      `${count} ${count === 1 ? 'word' : 'words'} are waiting.`;
    showScreen(screenBegin);

    // Load voices in the background — does not require a user gesture
    initVoiceControls();
  }

  // --- Render helpers ---
  function speechOptions() {
    return { voice: selectedVoice, rate: currentRate };
  }

  function renderQuestion(): void {
    const current = state.words[state.currentIndex];
    const total = state.words.length;
    const pos = state.currentIndex + 1;

    progressEl.textContent = `Word ${pos} of ${total}`;
    progressBar.style.width = `${(pos / total) * 100}%`;
    questionInstruction.textContent = instructionForIndex(state.currentIndex);
    answerInput.value = '';
    answerError.textContent = '';

    // Show sentence button only when this word has an example sentence
    const hasSentence = Boolean(current.exampleSentence);
    btnSentence.classList.toggle('hidden', !hasSentence);
    btnSentence.classList.toggle('inline-flex', hasSentence);

    showScreen(screenQuestion);
    requestAnimationFrame(() => answerInput.focus());

    // Cancel any pending sentence from the previous word, then speak this word.
    // After a short natural pause, auto-speak the sentence if one exists.
    cancelPendingSentence();
    speech.cancelSpeech();

    const result = speech.speakWord(current.word, speechOptions());
    if (!result.ok) {
      answerError.textContent = 'Audio is not available right now. Try "Hear word again", or check your device sound.';
    } else if (hasSentence) {
      sentenceTimeout = setTimeout(() => {
        sentenceTimeout = null;
        speech.speakWord(current.exampleSentence!, speechOptions());
      }, 1000);
    }
  }

  function renderFeedback(): void {
    const correct = state.lastAnswerCorrect;
    const currentWord = state.words[state.currentIndex].word;

    if (correct) {
      // Large soft circular badge — calm and satisfying, not celebratory.
      // SVG check is bigger and more refined than an emoji glyph.
      feedbackIcon.innerHTML = `<svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
      feedbackIcon.className = 'flex h-32 w-32 items-center justify-center rounded-full bg-feedback-correct/25 text-feedback-correct';
      feedbackHeading.textContent = pickPhrase(CORRECT_PHRASES, lastCorrectPhrase, (i) => (lastCorrectPhrase = i));
      feedbackHeading.className = 'font-display text-3xl font-semibold text-feedback-correct';
      feedbackWord.textContent = '';
      feedbackWord.classList.add('hidden');
      feedbackDetail.textContent = '';
    } else {
      // For wrong answers: the correct spelling is the dominant visual element.
      // The icon steps back so the word can own the screen.
      feedbackIcon.textContent = '';
      feedbackIcon.className = 'hidden';
      feedbackHeading.textContent = pickPhrase(INCORRECT_PHRASES, lastIncorrectPhrase, (i) => (lastIncorrectPhrase = i));
      feedbackHeading.className = 'font-display text-xl font-semibold text-feedback-incorrect';
      feedbackWord.textContent = currentWord;
      feedbackWord.classList.remove('hidden');
      feedbackDetail.textContent = "We'll practice this one again later.";
    }

    const isLast = state.currentIndex === state.words.length - 1;
    btnNext.textContent = isLast ? 'See Results →' : 'Next Word →';

    showScreen(screenFeedback);
  }

  function renderResults(): void {
    const result = state.result!;
    const missedCount = result.missedWords.length;

    // Lead with what the child did, not a grade.
    resultsSummary.textContent = `You practiced ${result.total} ${result.total === 1 ? 'word' : 'words'}.`;

    if (missedCount > 0) {
      resultsMissedSummary.textContent = `${missedCount} ${missedCount === 1 ? 'word needs' : 'words need'} a little more practice.`;
      resultsMissedList.textContent = '';
      for (const w of result.missedWords) {
        const li = document.createElement('li');
        li.textContent = w.word;
        li.className = 'rounded-full bg-feedback-incorrect/10 px-3 py-1.5 text-sm font-semibold text-feedback-incorrect';
        resultsMissedList.appendChild(li);
      }
      resultsMissedSection.classList.remove('hidden');

      // The most useful next step — practicing the words that need it — leads.
      btnReviewMissed.classList.remove('hidden');
      btnReviewMissed.className = 'w-full rounded-full bg-brand-red px-6 py-4 font-display text-lg font-semibold text-white shadow-[0_8px_28px_-6px_rgba(201,64,48,0.22)] transition hover:bg-brand-red-deep hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red active:translate-y-0';
      btnRetry.className = 'w-full rounded-full border-2 border-line bg-white px-6 py-3.5 text-base font-semibold text-ink transition hover:bg-app-cloud focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink active:scale-[0.97]';
    } else {
      resultsMissedSummary.textContent = 'Every word was spelled correctly.';
      resultsMissedSection.classList.add('hidden');

      // Nothing to review — starting again becomes the one clear option.
      btnReviewMissed.classList.add('hidden');
      btnRetry.className = 'w-full rounded-full bg-brand-red px-6 py-4 font-display text-lg font-semibold text-white shadow-[0_8px_28px_-6px_rgba(201,64,48,0.22)] transition hover:bg-brand-red-deep hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-red active:translate-y-0';
    }

    // Score is kept available, but quiet — a footnote, not the headline.
    resultsScore.textContent = `${result.correct} of ${result.total} correct · ${result.percentage}%`;

    showScreen(screenResults);
  }

  // --- Event handlers ---
  function handleSubmit(): void {
    const answer = answerInput.value.trim();

    if (!answer) {
      answerError.textContent = 'Please type your answer.';
      answerInput.focus();
      return;
    }

    // Cancel any pending auto-sentence before showing feedback
    cancelPendingSentence();
    speech.cancelSpeech();

    state = spellingTestReducer(state, submitAnswer(answer, Date.now()));
    renderFeedback();
  }

  btnBegin.addEventListener('click', () => {
    state = spellingTestReducer(state, startTest(Date.now()));
    renderQuestion();
  });

  // Always re-speak the current word directly from state — never repeatWord(),
  // which would replay whatever was last spoken (could be a sentence).
  btnRepeat.addEventListener('click', () => {
    const word = state.words[state.currentIndex]?.word;
    if (word) {
      cancelPendingSentence();
      speech.cancelSpeech();
      speech.speakWord(word, speechOptions());
    }
  });

  btnSentence.addEventListener('click', () => {
    const sentence = state.words[state.currentIndex]?.exampleSentence;
    if (sentence) {
      cancelPendingSentence();
      speech.cancelSpeech();
      speech.speakWord(sentence, speechOptions());
    }
  });

  answerInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') handleSubmit();
  });

  btnSubmit.addEventListener('click', handleSubmit);

  btnNext.addEventListener('click', () => {
    cancelPendingSentence();
    speech.cancelSpeech();
    state = spellingTestReducer(state, nextWord(Date.now()));
    if (state.status === 'awaitingAnswer') {
      renderQuestion();
    } else if (state.status === 'complete') {
      renderResults();
    }
  });

  btnRetry.addEventListener('click', () => {
    state = spellingTestReducer(resetTest(), initializeTest(originalWords));
    const count = originalWords.length;
    beginWordCount.textContent = `${count} ${count === 1 ? 'word' : 'words'}`;
    ($('begin-word-count-prose') as HTMLElement).textContent =
      `${count} ${count === 1 ? 'word' : 'words'} are waiting.`;
    showScreen(screenBegin);
  });

  btnReviewMissed.addEventListener('click', () => {
    // reviewMissed transitions directly to awaitingAnswer — call in click handler (iOS-safe)
    state = spellingTestReducer(state, reviewMissed());
    renderQuestion();
  });

  // Session settings toggle
  btnVoiceToggle.addEventListener('click', () => {
    const open = voiceSettingsPanel.classList.toggle('hidden') === false;
    btnVoiceToggle.setAttribute('aria-expanded', String(open));
    btnVoiceToggle.textContent = open ? '▴ Session settings' : '▾ Session settings';
  });

  speedRange.addEventListener('input', () => {
    currentRate = parseFloat(speedRange.value);
    speedLabel.textContent = `${currentRate.toFixed(2).replace(/0$/, '')}×`;
  });

  btnTestVoice.addEventListener('click', () => {
    speech.speakWord('because', speechOptions());
  });

  // --- Boot ---
  init();
</script>
