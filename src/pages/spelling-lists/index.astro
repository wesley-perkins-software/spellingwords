---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getListsByGrade, isPublished, resolveListRefs, groupByCategory } from '@/lib/content/spellingLists';
import { categoryLabels } from '@/lib/content/categoryMeta';

const entries = (await getCollection('spelling-lists')).filter(isPublished);
const totalCount = entries.length;

const gradeConfig = [
  { grade: 'K', label: 'Kindergarten', href: '/spelling-lists/kindergarten' },
  { grade: '1', label: 'Grade 1', href: '/spelling-lists/1st-grade' },
  { grade: '2', label: 'Grade 2', href: '/spelling-lists/2nd-grade' },
  { grade: '3', label: 'Grade 3', href: '/spelling-lists/3rd-grade' },
  { grade: '4', label: 'Grade 4', href: '/spelling-lists/4th-grade' },
  { grade: '5', label: 'Grade 5', href: '/spelling-lists/5th-grade' },
].map((gc) => ({ ...gc, count: getListsByGrade(gc.grade, entries).length }));

const byCategory = groupByCategory(entries);

const skillFamilies = [
  {
    label: 'Phonics Patterns',
    description: 'Consonants, vowels, blends, and digraphs — the building blocks of reading.',
    href: '/spelling-lists/phonics',
    count: byCategory.get('phonics')?.length ?? 0,
  },
  {
    label: 'Sight Words',
    description: 'The words that appear most often in print. Dolch and Fry sequences, K–Grade 3.',
    href: '/spelling-lists/sight-words',
    count: byCategory.get('sight-words')?.length ?? 0,
  },
  {
    label: 'Grade-Level Vocabulary',
    description: 'Words matched to what most schools teach each year, kindergarten through 5th grade.',
    href: '/spelling-lists/grade-level',
    count: byCategory.get('grade-level')?.length ?? 0,
  },
  {
    label: 'Challenge & Spelling Bee',
    description: 'Greek and Latin roots, advanced patterns, and spelling bee preparation.',
    href: '/spelling-lists/challenge',
    count: byCategory.get('challenge')?.length ?? 0,
  },
];

const featuredListIds = ['kindergarten-first-words', 'silent-e-long-a', 'grade-2-list-01'] as const;
const featuredLists = resolveListRefs([...featuredListIds], entries);

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Spelling Lists' }];

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://spellingwords.app');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};
---

<Layout
  title="Spelling Lists Library — Free, Curated Spelling Words for Grades K–5"
  description="Browse free spelling lists for kindergarten through 5th grade. Organized by grade level and skill — phonics, sight words, grade-level vocabulary, and challenge. Audio-supported, no account required."
  jsonLd={breadcrumbJsonLd}
>
  <SiteHeader variant="discovery" currentPath="/spelling-lists" />

  <main id="main-content">

    <!-- ── Opening Moment ───────────────────────────── paper ── -->
    <div class="bg-app-paper">
      <div class="mx-auto max-w-3xl px-6 pt-8">
        <Breadcrumbs items={breadcrumbItems} />
      </div>
      <div class="mx-auto max-w-3xl px-6 pb-16 pt-10">
        <h1 class="font-display text-4xl font-semibold leading-tight text-ink md:text-5xl">
          What grade is your child in?
        </h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-soft">
          {totalCount} hand-curated spelling lists — organized by grade and skill.
          Every list is free, audio-supported, and ready to practice in seconds.
        </p>
      </div>
    </div>

    <!-- ── Grade Chapter ─────────────────────────────── cloud ── -->
    <section class="bg-app-cloud" aria-labelledby="grade-chapter-heading">
      <h2 id="grade-chapter-heading" class="sr-only">Browse by Grade</h2>
      <div class="mx-auto max-w-3xl px-6 py-14">
        <div class="grid grid-cols-3 gap-3 md:grid-cols-6">
          {gradeConfig.map((gc) => (
            <a
              href={gc.href}
              class="group flex flex-col items-center gap-1.5 rounded-2xl border border-line bg-white px-2 py-8 text-center transition hover:-translate-y-0.5 hover:border-brand-blue/40 hover:shadow-card-md"
            >
              <span class="font-display text-3xl font-bold text-ink transition group-hover:text-brand-blue md:text-4xl">
                {gc.grade}
              </span>
              <span class="text-xs font-medium leading-tight text-ink-soft">{gc.label}</span>
              <span class="text-xs text-ink-faint">{gc.count} lists</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Skill Chapter ─────────────────────────────── paper ── -->
    <section class="bg-app-paper" aria-labelledby="skill-chapter-heading">
      <div class="mx-auto max-w-3xl px-6 py-16">
        <p class="mb-7 text-xs font-semibold uppercase tracking-widest text-ink-faint">
          Or browse by skill
        </p>
        <h2 id="skill-chapter-heading" class="sr-only">Browse by Skill</h2>
        <div class="border-l-2 border-brand-blue/20 pl-6">
          <nav aria-label="Browse by skill">
            {skillFamilies.map((sf, i) => (
              <a
                href={sf.href}
                class={`group flex items-start justify-between gap-6 py-5 transition${i < skillFamilies.length - 1 ? ' border-b border-line' : ''}`}
              >
                <div>
                  <div class="font-display text-base font-semibold text-ink transition group-hover:text-brand-blue">
                    {sf.label}
                  </div>
                  <div class="mt-1 text-sm leading-relaxed text-ink-soft">{sf.description}</div>
                </div>
                <div class="mt-0.5 flex shrink-0 items-center gap-2">
                  <span class="text-sm text-ink-faint">{sf.count} lists</span>
                  <span class="text-sm font-medium text-brand-blue opacity-0 transition group-hover:opacity-100">
                    →
                  </span>
                </div>
              </a>
            ))}
          </nav>
        </div>
      </div>
    </section>

    <!-- ── Editorial Picks ───────────────────────────── cloud ── -->
    {featuredLists.length > 0 && (
      <section class="bg-app-cloud" aria-labelledby="editorial-picks-heading">
        <div class="mx-auto max-w-3xl px-6 py-14">
          <h2 id="editorial-picks-heading" class="sr-only">Good Places to Start</h2>
          <p class="mb-7 text-base italic text-ink-soft">
            Not sure where to begin? These are well-loved starting points for most families.
          </p>
          <div class="grid gap-4 sm:grid-cols-3">
            {featuredLists.map((entry) => (
              <a
                href={`/spelling-lists/${entry.data.category}/${entry.data.urlSlug}`}
                class="group flex flex-col gap-3 rounded-2xl border border-line bg-white p-5 transition hover:-translate-y-0.5 hover:shadow-card-md"
              >
                <span class="text-xs font-medium text-ink-faint">
                  {categoryLabels[entry.data.category] ?? entry.data.category}
                  {entry.data.grade
                    ? ` · ${entry.data.grade === 'K' ? 'Kindergarten' : `Grade ${entry.data.grade}`}`
                    : ''}
                </span>
                <h3 class="font-display text-sm font-semibold leading-snug text-ink transition group-hover:text-brand-blue">
                  {entry.data.title}
                </h3>
                <span class="mt-auto text-xs text-ink-faint">{entry.data.words.length} words</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ── Library Chapter ───────────────────────────── paper ── -->
    <section class="bg-app-paper" aria-labelledby="library-chapter-heading">
      <div class="mx-auto max-w-3xl px-6 py-16">
        <h2 id="library-chapter-heading" class="font-display text-xl font-semibold text-ink">
          The full collection
        </h2>
        <p class="mt-2 mb-10 max-w-xl text-sm leading-relaxed text-ink-soft">
          {totalCount} spelling lists, organized by grade and skill. Every list hand-curated,
          every example sentence written by a human.
        </p>

        <div class="grid gap-10 sm:grid-cols-2">
          <!-- By grade -->
          <div>
            <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-ink-faint">
              By grade
            </h3>
            <div>
              {gradeConfig.map((gc) => (
                <a
                  href={gc.href}
                  class="group flex items-center justify-between border-b border-line py-3 transition last:border-0"
                >
                  <span class="text-sm font-medium text-ink transition group-hover:text-brand-blue">
                    {gc.label}
                  </span>
                  <div class="flex items-center gap-2">
                    <span class="text-sm text-ink-faint">{gc.count} lists</span>
                    <span class="text-xs text-brand-blue opacity-0 transition group-hover:opacity-100">→</span>
                  </div>
                </a>
              ))}
            </div>
          </div>

          <!-- By skill -->
          <div>
            <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-ink-faint">
              By skill
            </h3>
            <div>
              {skillFamilies.map((sf) => (
                <a
                  href={sf.href}
                  class="group flex items-center justify-between border-b border-line py-3 transition last:border-0"
                >
                  <span class="text-sm font-medium text-ink transition group-hover:text-brand-blue">
                    {sf.label}
                  </span>
                  <div class="flex items-center gap-2">
                    <span class="text-sm text-ink-faint">{sf.count} lists</span>
                    <span class="text-xs text-brand-blue opacity-0 transition group-hover:opacity-100">→</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>

        <p class="mt-14 border-t border-line pt-6 text-sm leading-relaxed text-ink-soft">
          Or practice any words you choose —{' '}
          <a href="/" class="link font-medium">enter your own list on the homepage</a>.
        </p>
      </div>
    </section>

  </main>

  <SiteFooter />
</Layout>
