---
interface Props {
  variant?: 'discovery' | 'practice';
  currentPath?: string;
  /** 'direction-a' shows the new design system's header chrome. Behavior
   *  (active-state logic, hrefs, variant split) is identical either way —
   *  see src/lib/content/pilotContent.ts. */
  theme?: 'legacy' | 'direction-a';
}

const { variant = 'discovery', currentPath = '', theme = 'legacy' } = Astro.props;

const isActive = (path: string) => currentPath.startsWith(path);
const isDirectionA = theme === 'direction-a';
---

{variant === 'discovery' ? (
  <header
    class:list={[
      'sticky top-0 z-10 border-b backdrop-blur-sm',
      isDirectionA ? 'border-da-border bg-da-canvas/95' : 'border-line bg-app-paper/95',
    ]}
  >
    <div class="mx-auto flex max-w-content-xl items-center justify-between px-6 py-3.5">

      <a
        href="/"
        class:list={[
          'flex items-center gap-1.5 text-[21px] font-semibold tracking-tight transition-colors',
          isDirectionA ? 'font-quicksand text-da-ink' : 'font-display text-ink hover:text-ink',
        ]}
        aria-label="spellingwords home"
      >
        <span
          class:list={[
            'inline-block h-2 w-2 flex-shrink-0 rounded-full',
            isDirectionA ? 'bg-da-coral' : 'bg-brand-red',
          ]}
          style="position: relative; top: 1px;"
          aria-hidden="true"
        ></span>
        spelling<span class={isDirectionA ? 'text-da-coral' : 'text-brand-red'}>words</span>
      </a>

      <nav aria-label="Site navigation">
        <ul class="flex items-center gap-0.5 list-none m-0 p-0">
          <li>
            <a
              href="/#grades"
              class:list={[
                'rounded-full px-4 py-2 text-sm font-bold transition',
                isDirectionA
                  ? 'text-da-ink-soft hover:bg-da-surface-neutral hover:text-da-ink'
                  : 'text-ink-soft hover:bg-app-cloud hover:text-ink',
              ]}
            >
              Grades
            </a>
          </li>
          <li>
            <a
              href="/skills"
              class:list={[
                'rounded-full px-4 py-2 text-sm font-bold transition',
                isDirectionA
                  ? `hover:bg-da-surface-neutral ${isActive('/skills') ? 'text-da-ink' : 'text-da-ink-soft hover:text-da-ink'}`
                  : `hover:bg-app-cloud ${isActive('/skills') ? 'text-ink' : 'text-ink-soft hover:text-ink'}`,
              ]}
              aria-current={isActive('/skills') ? 'page' : undefined}
            >
              Skills
            </a>
          </li>
          <li>
            <a
              href="/#how-it-works"
              class:list={[
                'rounded-full px-4 py-2 text-sm font-bold transition',
                isDirectionA
                  ? 'text-da-ink-soft hover:bg-da-surface-neutral hover:text-da-ink'
                  : 'text-ink-soft hover:bg-app-cloud hover:text-ink',
              ]}
            >
              How it Works
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </header>
) : (
  <header
    class:list={[
      'sticky top-0 z-10 border-b backdrop-blur-sm',
      isDirectionA ? 'border-da-border bg-da-canvas/95' : 'border-line bg-app-paper/95',
    ]}
  >
    <div class="mx-auto flex max-w-content-lg items-center justify-between px-6 py-3">
      <a
        href="/"
        class:list={[
          'flex items-center gap-1.5 text-sm font-semibold tracking-tight transition-colors',
          isDirectionA ? 'font-quicksand text-da-ink-soft hover:text-da-ink' : 'font-display text-ink-soft hover:text-ink',
        ]}
        aria-label="spellingwords home"
      >
        <span
          class:list={[
            'inline-block h-1.5 w-1.5 flex-shrink-0 rounded-full opacity-60',
            isDirectionA ? 'bg-da-coral' : 'bg-brand-red',
          ]}
          aria-hidden="true"
        ></span>
        spelling<span class={isDirectionA ? 'text-da-ink-faint' : 'text-ink-faint'}>words</span>
      </a>
      <a
        href="/"
        class:list={[
          'rounded-full px-3 py-2 text-xs font-semibold transition min-h-[36px] flex items-center',
          isDirectionA
            ? 'text-da-ink-soft/70 hover:bg-da-surface-neutral hover:text-da-ink-soft'
            : 'text-ink-soft/70 hover:bg-app-cloud hover:text-ink-soft',
        ]}
      >
        ← New list
      </a>
    </div>
  </header>
)}
