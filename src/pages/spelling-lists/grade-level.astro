---
import { getCollection } from 'astro:content';
import { getCanonicalListPath } from '@/lib/content/canonicalGradeRoutes';
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SpellingListCard from '@/components/SpellingListCard.astro';
import { isPublished, getListsByGrade, getMemberListIds } from '@/lib/content/spellingLists';
import { gradeConfig } from '@/lib/content/gradeConfig';

const allCollections = (await getCollection('spelling-collections')).filter(
  (c) => c.data.status === 'published',
);
const memberIds = getMemberListIds(allCollections);
const entries = (await getCollection('spelling-lists')).filter(isPublished);

const gradeSections = gradeConfig
  .map(({ grade, label, hubHref }) => {
    const lists = getListsByGrade(grade, entries)
      .filter((e) => e.data.category === 'grade-level' && !memberIds.has(e.data.id));
    return { grade, label, hubHref, lists };
  })
  .filter(({ lists }) => lists.length > 0);

const totalLists = gradeSections.reduce((sum, s) => sum + s.lists.length, 0);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Spelling Lists Library', href: '/spelling-lists' },
  { label: 'Grade-Level' },
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://spellingwords.app');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};

let position = 0;
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Grade-Level Spelling Word Lists',
  numberOfItems: totalLists,
  itemListElement: gradeSections.flatMap(({ lists }) =>
    lists.map((e) => ({
      '@type': 'ListItem',
      position: ++position,
      url: new URL(`/spelling-lists/grade-level/${e.data.urlSlug}`, canonicalURL.origin).toString(),
      name: e.data.title,
    })),
  ),
};
---

<Layout
  title="Grade-Level Spelling Words | spellingwords.app"
  description="Free grade-level spelling word lists for kindergarten through 5th grade — organized by developmental stage, no timers, no pressure. Audio-supported practice for home and school."
  jsonLd={[breadcrumbJsonLd, itemListJsonLd]}
>
  <SiteHeader variant="discovery" currentPath="/spelling-lists" />

  <main id="main-content">
    <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
      <div class="mb-6">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <!-- Hero -->
      <div class="mb-10 flex flex-col gap-4">
        <h1 class="font-display text-2xl font-semibold text-ink md:text-3xl">
          Grade-Level Spelling Words
        </h1>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">
          Grade-level spelling lists are organized around the words children commonly practice in
          school at each stage. They are a good starting point when you know the child's grade but
          not the exact spelling pattern they need. These lists reflect the vocabulary and complexity
          that is typical for each year, from simple first words in kindergarten to multi-syllable
          vocabulary in 4th and 5th grade.
        </p>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">
          Grade is a helpful starting point, not a strict ceiling. If a child is comfortable with
          their grade-level lists, the{' '}
          <a href="/spelling-lists/challenge" class="font-semibold text-brand-blue hover:underline">
            Challenge lists
          </a>{' '}
          offer a next step. If the focus is on a specific spelling pattern rather than grade
          vocabulary, the{' '}
          <a href="/spelling-lists/phonics" class="font-semibold text-brand-blue hover:underline">
            Phonics lists
          </a>{' '}
          may be a better fit. All lists include audio support.
        </p>
      </div>

      <!-- Lists grouped by grade -->
      {totalLists === 0 ? (
        <div class="rounded-2xl border border-line bg-app-cloud p-8 text-center">
          <p class="text-base text-ink-soft">
            Grade-level lists are being prepared. Check back soon, or{' '}
            <a href="/spelling-lists" class="font-semibold text-brand-blue hover:underline">
              browse the full library
            </a>{' '}
            in the meantime.
          </p>
        </div>
      ) : (
        <div class="mb-12 flex flex-col gap-10">
          {gradeSections.map(({ label, hubHref, lists }) => (
            <section aria-labelledby={`grade-${label.replace(/\s+/g, '-').toLowerCase()}-heading`} class="flex flex-col gap-4">
              <div class="flex items-baseline gap-3">
                <h2
                  id={`grade-${label.replace(/\s+/g, '-').toLowerCase()}-heading`}
                  class="font-display text-lg font-semibold text-ink"
                >
                  <a href={hubHref} class="hover:text-brand-blue hover:underline">
                    {label}
                  </a>
                </h2>
                <span class="text-sm text-ink-faint">
                  {lists.length} {lists.length === 1 ? 'list' : 'lists'}
                </span>
              </div>
              <div class="grid gap-4 sm:grid-cols-2">
                {lists.map((entry) => (
                  <SpellingListCard
                    href={getCanonicalListPath(entry.data)}
                    category={entry.data.category}
                    title={entry.data.title}
                    description={entry.data.description}
                    difficulty={entry.data.difficulty}
                    durationMinutes={entry.data.estimatedDurationMinutes}
                    wordCount={entry.data.words.length}
                  />
                ))}
              </div>
            </section>
          ))}
        </div>
      )}

      <!-- Guidance -->
      {totalLists > 1 && (
        <section aria-labelledby="guidance-heading" class="mb-12 rounded-2xl border border-line bg-app-cloud p-6">
          <h2 id="guidance-heading" class="mb-2 font-display text-base font-semibold text-ink">
            How to choose a grade-level list
          </h2>
          <p class="text-sm leading-relaxed text-ink-soft">
            Start with the list that matches the child's current grade. If it feels too easy, move
            up a grade; if the words feel out of reach, try a grade below. Grade-level lists work
            well alongside school homework or as independent weekly practice. Each grade section
            also links to its full Grade Hub page, where you can find all lists — including sight
            word and phonics lists — for that grade.
          </p>
        </section>
      )}

      <!-- Related categories -->
      <nav aria-label="Related spelling list categories" class="mb-10">
        <p class="mb-3 text-sm font-semibold text-ink">Explore other categories</p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/spelling-lists/phonics"
            class="inline-flex items-center rounded-xl border border-line bg-white px-4 py-2 text-sm font-medium text-ink-soft transition hover:border-brand-blue/40 hover:text-brand-blue"
          >
            Phonics
          </a>
          <a
            href="/spelling-lists/sight-words"
            class="inline-flex items-center rounded-xl border border-line bg-white px-4 py-2 text-sm font-medium text-ink-soft transition hover:border-brand-blue/40 hover:text-brand-blue"
          >
            Sight Words
          </a>
          <a
            href="/spelling-lists/challenge"
            class="inline-flex items-center rounded-xl border border-line bg-white px-4 py-2 text-sm font-medium text-ink-soft transition hover:border-brand-blue/40 hover:text-brand-blue"
          >
            Challenge
          </a>
        </div>
      </nav>

      <!-- Back to library -->
      <p>
        <a
          href="/spelling-lists"
          class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
        >
          ← Back to the Spelling Lists Library
        </a>
      </p>
    </div>
  </main>

  <SiteFooter />
</Layout>
