---
// Cross-grade Core Spelling gateway — lateral "Browse by Strand" navigation, not a URL parent
// of the six grade-specific Core Spelling gateways. See docs/planning/
// LAUNCH_SUPPORTING_PAGES_AND_GLOBAL_NAVIGATION_PLAN.md (2026-08-21 amendment) and
// docs/content/CANONICAL_GRADE_HUB_STANDARD.md §6.1. Core emphasizes progression, so grade
// sections render as a connected vertical sequence (mirrors the same-grade Core Gateway's own
// progression treatment) rather than a card grid.
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import AtmosphereBand from '@/components/direction-a/AtmosphereBand.astro';
import Button from '@/components/direction-a/Button.astro';
import Chip from '@/components/direction-a/Chip.astro';
import WordSpecimen from '@/components/direction-a/WordSpecimen.astro';
import { STRAND_ACCENT } from '@/lib/content/pilotContent';
import { isPublished } from '@/lib/content/spellingLists';
import { buildCoreSpellingGatewayModel } from '@/lib/content/strandGatewayModel';
import { CORE_DEVELOPMENT_BRIDGE } from '@/lib/content/strandGatewayPreview';
import { getCanonicalUrl } from '@/lib/canonicalUrl';

const entries = (await getCollection('spelling-lists')).filter(isPublished);
const sections = buildCoreSpellingGatewayModel(entries);
const totalUnits = sections.reduce((total, section) => total + section.unitCount, 0);

const canonicalURL = getCanonicalUrl('/core-spelling', Astro.site);
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Core Spelling' },
];
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};
// The ItemList represents the page's six visible grade chapters (H2 sections), matching the
// page's actual primary organization — not the 51 individual unit links each chapter contains.
// Structured-data review (2026-08-21 refinement): a 51-item ItemList would be technically
// possible but noisier than the page's real information hierarchy communicates, and JSON-LD
// isn't the only signal available to a crawler here — every unit is a real, crawlable, anchor-
// texted <a> in the page body itself, which is the primary source of truth.
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'K–5 Core Spelling Gateways',
  numberOfItems: sections.length,
  itemListElement: sections.map((section, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(section.gatewayHref, canonicalURL.origin).toString(),
    name: `${section.label} Core Spelling`,
  })),
};
---

<Layout
  title="K–5 Core Spelling Curriculum | SpellingWords"
  description={`See every one of the ${totalUnits} Core Spelling units across Kindergarten–5th Grade, in curriculum order, with sample words and a direct link to each.`}
  jsonLd={[breadcrumbJsonLd, itemListJsonLd]}
>
  <SiteHeader variant="discovery" currentPath="/core-spelling" />

  <main id="main-content">
    <div class="mx-auto max-w-3xl px-5 pt-8 sm:px-6">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <AtmosphereBand tone={STRAND_ACCENT['core-spelling']} ariaLabel="Core Spelling across K–5" class="mt-6 rounded-3xl md:mt-8">
      <header class="max-w-2xl">
        <Chip tone={STRAND_ACCENT['core-spelling']} class="mb-3">Core Spelling</Chip>
        <h1 class="font-quicksand text-[clamp(2rem,4.2vw,2.75rem)] font-bold leading-[1.1] text-da-ink">
          K–5 Core Spelling Curriculum
        </h1>
        <p class="mt-4 text-[1.1rem] leading-relaxed text-da-ink-soft">
          Core Spelling is the main systematic grade-level spelling sequence — {totalUnits} units in
          all, ordered from Kindergarten through 5th Grade.
        </p>
        <ol class="mt-5 flex flex-col gap-2 text-[0.95rem] leading-relaxed text-da-ink-soft sm:flex-row sm:gap-6">
          {CORE_DEVELOPMENT_BRIDGE.map((stage, index) => (
            <li class="flex gap-2">
              <span class="font-quicksand font-bold text-da-brand-strong">{index + 1}.</span>
              <span>{stage}</span>
            </li>
          ))}
        </ol>
      </header>
    </AtmosphereBand>

    <div class="mx-auto max-w-2xl px-5 py-10 sm:px-6 md:max-w-3xl md:py-14">
      <p class="max-w-[64ch] text-[0.9rem] leading-relaxed text-da-ink-faint">
        Each Core unit below shows a few sample words from its full spelling list. Open a unit to
        see the complete word list, explanation, and practice.
      </p>

      <div class="relative mt-8 flex flex-col gap-10">
        <div class="pointer-events-none absolute bottom-8 left-[0.4rem] top-8 hidden w-0.5 bg-da-brand opacity-20 sm:block" aria-hidden="true" />
        {sections.map((section) => (
          <section class="relative sm:pl-6" aria-labelledby={`core-${section.grade}-heading`}>
            <span class="absolute left-0 top-1.5 hidden h-2.5 w-2.5 rounded-full bg-da-brand sm:block" aria-hidden="true" />
            <h2 id={`core-${section.grade}-heading`} class="font-quicksand text-xl font-bold text-da-ink">{section.label}</h2>
            <p class="mt-1 text-sm font-bold text-da-ink-faint">{section.unitCount} Core Spelling units</p>
            <p class="mt-2 max-w-[64ch] text-[0.95rem] leading-relaxed text-da-ink-soft">{section.summary}</p>

            <ol class="mt-4 divide-y divide-da-border rounded-2xl border border-da-border bg-da-canvas-raised shadow-sm">
              {section.units.map((unit, index) => (
                <li class="group relative flex items-start gap-3 rounded-2xl px-4 py-3 transition-colors first:rounded-t-2xl last:rounded-b-2xl hover:bg-da-sun-tint">
                  <span
                    class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-da-sun-tint text-xs font-bold text-da-sun-ink"
                    aria-hidden="true"
                  >
                    {index + 1}
                  </span>
                  <div class="min-w-0 flex-1">
                    <a
                      href={unit.href}
                      class="font-quicksand text-[0.98rem] font-bold text-da-sun-ink after:absolute after:inset-0 group-hover:underline"
                    >
                      {unit.title}
                    </a>
                    <p class="mt-1.5 text-[0.7rem] font-bold uppercase tracking-wide text-da-ink-faint">Sample words</p>
                    <WordSpecimen words={unit.sampleWords} class="mt-1" />
                  </div>
                  <span class="mt-1 shrink-0 text-da-sun-ink/40 transition group-hover:translate-x-0.5 group-hover:text-da-sun-ink" aria-hidden="true">
                    →
                  </span>
                </li>
              ))}
            </ol>

            <Button href={section.gatewayHref} variant="outline" size="md" class="mt-4">
              View {section.label} Core Spelling <span aria-hidden="true">→</span>
            </Button>
          </section>
        ))}
      </div>

      <p class="mt-10 max-w-[64ch] text-[0.95rem] leading-relaxed text-da-ink-faint">
        Each unit link goes straight to its full teaching page and word list. The grade-specific
        Core Spelling gateway above still owns sequence guidance and where to begin for that grade.
      </p>
      <p class="mt-4 max-w-[64ch] text-[0.98rem] leading-relaxed text-da-ink-soft">
        Read more about how the curriculum is designed on <a class="font-bold text-da-brand-strong underline decoration-2 underline-offset-4 hover:text-da-brand" href="/curriculum">Our Spelling Curriculum</a>,
        or look up a specific pattern on the <a class="font-bold text-da-brand-strong underline decoration-2 underline-offset-4 hover:text-da-brand" href="/skills">Spelling Skills</a> reference library.
      </p>
    </div>
  </main>

  <SiteFooter />
</Layout>
