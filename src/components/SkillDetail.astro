---
import Breadcrumbs from '@/components/Breadcrumbs.astro';

interface BreadcrumbItem {
  label: string;
  href?: string;
}
interface PlacementLink {
  title: string;
  href: string;
  gradeLabel?: string;
  step?: number;
  total?: number;
}
interface RelatedSkill {
  title: string;
  description: string;
  href: string;
}

interface Props {
  breadcrumbItems: BreadcrumbItem[];
  title: string;
  description: string;
  shortAnswer?: string;
  categoryLabel: string;
  words: Array<{ word: string; exampleSentence?: string }>;
  playWordsJson: string;
  readinessSignals: string[];
  faq: Array<{ question: string; answer: string }>;
  easierList?: { title: string; href: string };
  harderList?: { title: string; href: string };
  curriculumPlacements: PlacementLink[];
  relatedSkills: RelatedSkill[];
}

const {
  breadcrumbItems,
  title,
  description,
  shortAnswer,
  categoryLabel,
  words,
  playWordsJson,
  readinessSignals,
  faq,
  easierList,
  harderList,
  curriculumPlacements,
  relatedSkills,
} = Astro.props;

// Worked examples are derived generically from the word list itself (word →
// its letters), so this "sound it out" diagram works for any Skill without
// hardcoding a particular pattern's words.
const workedExamples = words
  .slice(0, 5)
  .map((w) => ({ word: w.word, letters: Array.from(w.word) }));
---

<!--
  SKILL — "Concept Guide"
  Single-column editorial reference: a definition-first lede, a prominent (but
  not hero-dominating) core practice module, editorial teaching, a worked-
  examples diagram, an FAQ, and concept cross-navigation. Reads as the
  definitive guide to a spelling pattern — approachable, not API-doc.
-->
<div class="mx-auto max-w-3xl px-5 pb-20 pt-8 sm:px-6">
  <Breadcrumbs items={breadcrumbItems} />

  {/* ── Definition-first hero (the lede) ───────────────────────────────── */}
  <header class="mt-7 border-b border-line pb-10">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-skill-accent">
      {categoryLabel} · Spelling Skill
    </p>
    <h1 class="text-display-xl mt-3">{title}</h1>

    {
      shortAnswer && (
        <div class="mt-6 border-l-[3px] border-skill-accent pl-5 sm:pl-6">
          <p class="font-sans text-xl leading-relaxed text-ink sm:text-2xl">{shortAnswer}</p>
        </div>
      )
    }

    <p class="mt-6 max-w-[62ch] text-base leading-relaxed text-ink-muted">{description}</p>

    <a
      href="#practice"
      class="mt-6 inline-flex items-center gap-1.5 text-sm font-bold text-skill-accent transition hover:text-skill-accent-deep hover:underline"
    >
      Jump to practice <span aria-hidden="true">↓</span>
    </a>
  </header>

  {/* ── Core practice module (prominent, right after the definition) ───── */}
  <section id="practice" class="scroll-mt-6 pt-10" aria-labelledby="practice-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 id="practice-heading" class="font-display text-xl font-semibold text-ink">
        Core {title}
      </h2>
      <span class="text-xs font-bold uppercase tracking-[0.12em] text-ink-muted">
        Starter practice set · {words.length} words
      </span>
    </div>

    <div class="mt-4 overflow-hidden rounded-3xl border border-skill-line bg-white shadow-card-md">
      <ul
        class="grid grid-cols-2 gap-x-6 gap-y-3 px-6 py-7 sm:grid-cols-3 sm:gap-x-8 sm:gap-y-4 sm:px-8 sm:py-8"
        aria-label={`Core ${title}`}
      >
        {
          words.map((w) => (
            <li class="font-word text-lg font-semibold leading-snug text-ink sm:text-xl md:text-2xl">
              {w.word}
            </li>
          ))
        }
      </ul>
      <div
        class="flex flex-col gap-3 border-t border-skill-line bg-skill-soft px-6 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-8"
      >
        <p class="text-sm leading-relaxed text-ink-muted">
          A curated starter set for this pattern — read aloud, then spell.
        </p>
        <button
          type="button"
          data-practice
          data-words={playWordsJson}
          data-list-title={title}
          class="btn-primary shrink-0 px-7 py-3"
          aria-label={`Practice these ${words.length} words in ${title}`}
        >
          Practice these words
        </button>
      </div>
    </div>
    <p
      data-practice-status
      class="mt-3 text-sm text-feedback-incorrect"
      aria-live="polite"
      aria-atomic="true"
    >
    </p>
  </section>

  {/* ── Who this pattern is for (readiness guidance) ───────────────────── */}
  {
    readinessSignals.length > 0 && (
      <section class="pt-12" aria-labelledby="readiness-heading">
        <h2 id="readiness-heading" class="font-display text-xl font-semibold text-ink">
          Who this practice is for
        </h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-1">
          {readinessSignals.map((signal) => (
            <li class="flex items-start gap-3 text-base leading-relaxed text-ink-muted">
              <span
                aria-hidden="true"
                class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-skill-soft text-skill-accent"
              >
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </span>
              <span>{signal}</span>
            </li>
          ))}
        </ul>
        {(easierList || harderList) && (
          <p class="mt-4 max-w-[62ch] text-sm leading-relaxed text-ink-muted">
            {easierList && (
              <>
                For an easier starting point, try{' '}
                <a href={easierList.href} class="font-semibold text-skill-accent hover:underline">
                  {easierList.title}
                </a>
                .{' '}
              </>
            )}
            {harderList && (
              <>
                Ready for more? Move on to{' '}
                <a href={harderList.href} class="font-semibold text-skill-accent hover:underline">
                  {harderList.title}
                </a>
                .
              </>
            )}
          </p>
        )}
      </section>
    )
  }

  {/* ── Teaching content (editorial prose from the markdown body) ──────── */}
  <section class="pt-14" aria-labelledby="teaching-heading">
    <div class="flex items-center gap-3">
      <span class="h-px w-8 bg-skill-accent" aria-hidden="true"></span>
      <h2
        id="teaching-heading"
        class="font-display text-xs font-bold uppercase tracking-[0.16em] text-skill-accent"
      >
        How to teach it
      </h2>
    </div>
    <div
      class="teaching-prose mt-5 max-w-[64ch] space-y-6 font-sans text-lg leading-[1.75] text-ink [&_em]:italic [&_strong]:font-semibold [&_strong]:text-ink"
    >
      <slot />
    </div>
  </section>

  {/* ── Worked examples: a subtle "sound it out" diagram ───────────────── */}
  {
    workedExamples.length > 0 && (
      <section class="pt-14" aria-labelledby="examples-heading">
        <h2 id="examples-heading" class="font-display text-xl font-semibold text-ink">
          Sound it out
        </h2>
        <p class="mt-2 max-w-[62ch] text-base leading-relaxed text-ink-muted">
          Every word here is spelled the way it sounds — say it slowly, one sound at a time, then
          write a letter for each sound.
        </p>
        <ul class="mt-5 flex flex-wrap gap-3">
          {workedExamples.map((ex) => (
            <li class="rounded-2xl border border-skill-line bg-white px-4 py-3 shadow-card">
              <span class="font-word text-lg font-semibold text-ink">{ex.word}</span>
              <span class="mx-2 text-skill-accent" aria-hidden="true">
                →
              </span>
              <span class="font-word text-base text-ink-muted">
                {ex.letters.map((letter, i) => (
                  <>
                    {i > 0 && <span class="text-skill-accent/50"> · </span>}
                    {letter}
                  </>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ── FAQ ────────────────────────────────────────────────────────────── */}
  {
    faq.length > 0 && (
      <section class="pt-14" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="font-display text-xl font-semibold text-ink">
          Frequently asked questions
        </h2>
        <dl class="mt-5 divide-y divide-line border-t border-line">
          {faq.map((item) => (
            <div class="py-6">
              <dt class="flex gap-3 font-display text-base font-semibold text-ink">
                <span class="text-skill-accent" aria-hidden="true">
                  Q.
                </span>
                {item.question}
              </dt>
              <dd class="mt-2 max-w-[64ch] pl-7 text-base leading-relaxed text-ink-muted">
                {item.answer}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  {/* ── Where this fits in the curriculum ──────────────────────────────── */}
  {
    curriculumPlacements.length > 0 && (
      <section class="pt-14" aria-labelledby="curriculum-heading">
        <h2 id="curriculum-heading" class="font-display text-xl font-semibold text-ink">
          Where this fits in the curriculum
        </h2>
        <p class="mt-2 max-w-[62ch] text-base leading-relaxed text-ink-muted">
          This guide is the reusable home for the pattern — for a first introduction, later review,
          or extra practice at any age. In the grade-by-grade progression, it is taught here:
        </p>
        <div class="mt-5 flex flex-col gap-2 sm:flex-row sm:flex-wrap">
          {curriculumPlacements.map((p) => (
            <a
              href={p.href}
              class="group flex-1 rounded-2xl border border-line bg-white px-5 py-4 shadow-card transition hover:-translate-y-0.5 hover:border-brand-blue/30 hover:shadow-card-md sm:flex-none sm:min-w-[15rem]"
            >
              {(p.gradeLabel || p.step) && (
                <span class="text-xs font-bold uppercase tracking-[0.1em] text-brand-blue">
                  {p.gradeLabel}
                  {p.gradeLabel && p.step && <span aria-hidden="true"> · </span>}
                  {p.step && p.total && `Step ${p.step} of ${p.total}`}
                </span>
              )}
              <span class="mt-0.5 block font-display text-base font-semibold text-ink group-hover:text-brand-blue">
                {p.title}
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {/* ── Related patterns (concept cross-navigation) ────────────────────── */}
  {
    relatedSkills.length > 0 && (
      <section class="pt-14" aria-labelledby="related-heading">
        <div class="flex items-center gap-3">
          <span class="h-px w-8 bg-skill-accent" aria-hidden="true" />
          <h2
            id="related-heading"
            class="font-display text-xs font-bold uppercase tracking-[0.16em] text-skill-accent"
          >
            Related patterns
          </h2>
        </div>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          {relatedSkills.map((s) => (
            <a
              href={s.href}
              class="group rounded-2xl border border-skill-line bg-white px-5 py-4 shadow-card transition hover:-translate-y-0.5 hover:border-skill-accent/40 hover:shadow-card-md"
            >
              <span class="block font-display text-base font-semibold text-ink group-hover:text-skill-accent-deep">
                {s.title}
                <span
                  class="ml-1 inline-block opacity-0 transition group-hover:translate-x-0.5 group-hover:opacity-100"
                  aria-hidden="true"
                >
                  →
                </span>
              </span>
              <span class="mt-1 block text-sm leading-relaxed text-ink-muted line-clamp-2">
                {s.description}
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</div>

<style>
  /* Editorial drop cap on the first paragraph of the teaching prose. Slotted
     content lives in the parent scope, so reach it with :global scoped under
     the wrapper class. */
  .teaching-prose > :global(p:first-of-type)::first-letter {
    float: left;
    font-family: 'Fredoka', ui-rounded, system-ui, sans-serif;
    font-weight: 600;
    font-size: 3.1rem;
    line-height: 0.82;
    padding: 0.05em 0.12em 0 0;
    color: #2e6b57;
  }
</style>
