---
interface Props {
  label: string;
  variant?: 'blue' | 'yellow' | 'coral' | 'green' | 'sage';
}

const { label, variant = 'blue' } = Astro.props;

const variantClasses: Record<NonNullable<Props['variant']>, string> = {
  blue: 'bg-accent-indigo/10 text-accent-indigo border-accent-indigo/20 hover:bg-accent-indigo/20',
  yellow: 'bg-accent-rust/10 text-accent-rust border-accent-rust/20 hover:bg-accent-rust/20',
  coral: 'bg-accent-plum/10 text-accent-plum border-accent-plum/20 hover:bg-accent-plum/20',
  green: 'bg-accent-moss/10 text-accent-moss border-accent-moss/20 hover:bg-accent-moss/20',
  sage: 'bg-app-sage/10 text-app-sage border-app-sage/20 hover:bg-app-sage/20',
};
---

<button
  type="button"
  class={`inline-flex cursor-pointer items-center rounded-lg border px-4 py-1.5 text-sm font-medium transition-colors ${variantClasses[variant]}`}
>
  {label}
</button>
