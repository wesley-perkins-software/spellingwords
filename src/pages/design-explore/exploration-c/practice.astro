---
import Proto from './_shared/Proto.astro';
import Header from './_shared/Header.astro';
import Footer from './_shared/Footer.astro';
---

<Proto
  title="Practice — Exploration C"
  description="Design exploration C: static visual mock of the spelling practice loop, including correct and incorrect feedback states."
>
  <Header currentPath="/design-explore/exploration-c/practice.html" />

  <main id="main">
    <div class="wrap page">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/design-explore/exploration-c/">Home</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <a href="/design-explore/exploration-c/skill.html">Soft C and Soft G</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <span aria-current="page">Practice</span>
      </nav>

      <!-- ============ ACTIVE QUESTION STATE ============ -->
      <section class="stage" aria-labelledby="stage-heading">
        <h1 id="stage-heading" class="visually-hidden">Spelling practice: Soft C and Soft G</h1>

        <div class="stage-head">
          <p class="stage-eyebrow">Soft C and Soft G</p>
          <div class="progress-row" role="group" aria-label="Progress: word 3 of 6">
            <ol class="progress-steps">
              <li class="is-done" aria-label="Word 1, answered correctly">
                <span aria-hidden="true">✓</span>
              </li>
              <li class="is-done" aria-label="Word 2, answered correctly">
                <span aria-hidden="true">✓</span>
              </li>
              <li class="is-current" aria-current="step" aria-label="Word 3, current">
                <span aria-hidden="true">3</span>
              </li>
              <li aria-label="Word 4, not yet answered"><span aria-hidden="true">4</span></li>
              <li aria-label="Word 5, not yet answered"><span aria-hidden="true">5</span></li>
              <li aria-label="Word 6, not yet answered"><span aria-hidden="true">6</span></li>
            </ol>
            <span class="progress-label">Word 3 of 6</span>
          </div>
        </div>

        <div class="stage-audio">
          <button type="button" class="audio-btn-primary" aria-label="Play the word">
            <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
              <path d="M5 9v6h4l5 5V4L9 9H5z" fill="currentColor" /><path
                d="M17.5 8.5a5 5 0 0 1 0 7"
                stroke="currentColor"
                stroke-width="1.9"
                fill="none"
                stroke-linecap="round"
              /><path
                d="M20 6.5a8.5 8.5 0 0 1 0 11"
                stroke="currentColor"
                stroke-width="1.9"
                fill="none"
                stroke-linecap="round"
                opacity="0.55"
              /></svg
            >
          </button>
          <p class="stage-audio-caption">Listen, then type the word you hear</p>
        </div>

        <form class="stage-form" aria-label="Type the word">
          <label class="visually-hidden" for="answer-input">Type the word you hear</label>
          <div class="stage-input-wrap">
            <input
              id="answer-input"
              class="stage-input"
              type="text"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              placeholder="Type what you hear"
              value="giant"
            />
            <span class="stage-input-rule" aria-hidden="true"></span>
          </div>
          <div class="stage-actions">
            <button type="button" class="btn btn-ghost-stage">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path
                  d="M4 9v6h4l5 5V4L8 9H4z"
                  fill="currentColor"
                /><path
                  d="M16.5 8.5a5 5 0 0 1 0 7"
                  stroke="currentColor"
                  stroke-width="1.8"
                  fill="none"
                  stroke-linecap="round"
                /></svg
              >
              Hear it again
            </button>
            <button type="submit" class="btn btn-primary-stage">Check my spelling</button>
          </div>
        </form>
      </section>

      <!-- ============ FEEDBACK STATE EXAMPLES ============ -->
      <section class="state-examples" aria-labelledby="state-examples-heading">
        <h2 id="state-examples-heading">Feedback states</h2>
        <p class="state-examples-note">
          Static examples of the two feedback states this stage can show, shown here side by side
          for review — feedback appears as a calm banner right below the word, never a
          full-screen color wash.
        </p>

        <div class="state-grid">
          <!-- CORRECT -->
          <div class="state-card">
            <p class="state-card-label">Correct</p>
            <div class="mini-stage">
              <div class="mini-audio-row">
                <span class="mini-audio-btn" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <path d="M5 9v6h4l5 5V4L9 9H5z" fill="currentColor" />
                  </svg>
                </span>
                <span class="mini-word">page</span>
              </div>
              <div class="mini-input-wrap">
                <input
                  class="mini-input is-correct"
                  type="text"
                  value="page"
                  readonly
                  aria-describedby="correct-feedback-msg"
                />
                <span class="mini-input-rule is-correct" aria-hidden="true"></span>
              </div>
              <p id="correct-feedback-msg" class="mini-feedback is-correct">
                <span class="mini-feedback-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="16" height="16">
                    <path
                      d="M5 13l4 4 10-10"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                <span><strong>Correct.</strong> Soft g, right before the silent e.</span>
              </p>
            </div>
          </div>

          <!-- INCORRECT -->
          <div class="state-card">
            <p class="state-card-label">Needs another look</p>
            <div class="mini-stage">
              <div class="mini-audio-row">
                <span class="mini-audio-btn" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <path d="M5 9v6h4l5 5V4L9 9H5z" fill="currentColor" />
                  </svg>
                </span>
                <span class="mini-word">gym</span>
              </div>
              <div class="mini-input-wrap">
                <input
                  class="mini-input is-incorrect"
                  type="text"
                  value="jim"
                  readonly
                  aria-describedby="incorrect-feedback-msg"
                />
                <span class="mini-input-rule is-incorrect" aria-hidden="true"></span>
              </div>
              <p id="incorrect-feedback-msg" class="mini-feedback is-incorrect">
                <span class="mini-feedback-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="16" height="16">
                    <path
                      d="M6 6l12 12M18 6L6 18"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                    />
                  </svg>
                </span>
                <span
                  ><strong>Not quite.</strong> The word is spelled <strong>gym</strong> — soft g
                  before y, spelled with a g, not a j.</span
                >
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />

  <style>
    .page {
      padding-block: clamp(2rem, 5vw, 3rem) clamp(3rem, 6vw, 5rem);
      max-width: 760px;
    }

    .breadcrumbs {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      font-size: 0.85rem;
      color: var(--ink-faint);
      margin-bottom: 1.75rem;
      flex-wrap: wrap;
    }
    .breadcrumbs a {
      color: var(--ink-soft);
      text-decoration: none;
      font-weight: 600;
    }
    .breadcrumbs a:hover {
      color: var(--practice-strong);
    }
    .crumb-sep {
      color: var(--practice-vivid);
      opacity: 0.55;
    }
    .breadcrumbs [aria-current='page'] {
      color: var(--ink);
      font-weight: 600;
    }

    /* ============ MAIN STAGE — light surface, own craft ============ */
    .stage {
      background: var(--canvas-raised);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: clamp(2rem, 5vw, 3rem) clamp(1.5rem, 5vw, 3.5rem);
      box-shadow: var(--shadow-lg);
      text-align: center;
    }

    .stage-head {
      margin-bottom: 2.25rem;
    }

    .stage-eyebrow {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--ink-faint);
      margin-bottom: 1rem;
    }

    .progress-row {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.6rem;
    }

    .progress-steps {
      display: flex;
      gap: 0.5rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .progress-steps li {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.9rem;
      height: 1.9rem;
      border-radius: 7px;
      background: var(--canvas-sunken);
      color: var(--ink-faint);
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 0.78rem;
      border: 1.5px solid var(--border);
    }

    .progress-steps li.is-done {
      background: var(--practice-strong);
      border-color: var(--practice-strong);
      color: #fff;
    }

    .progress-steps li.is-current {
      background: #fff;
      border-color: var(--practice-strong);
      color: var(--practice-strong);
      box-shadow: 0 0 0 3px var(--practice);
    }

    .progress-label {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--ink-faint);
    }

    .stage-audio {
      margin-bottom: 2.25rem;
    }

    .audio-btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 5.25rem;
      height: 5.25rem;
      border-radius: 50%;
      background: var(--practice-strong);
      color: #fff;
      border: none;
      cursor: pointer;
      transition:
        transform 0.12s ease,
        background 0.15s ease;
    }
    .audio-btn-primary:hover {
      background: var(--practice-ink);
      transform: scale(1.03);
    }

    .stage-audio-caption {
      margin-top: 1rem;
      font-size: 0.92rem;
      color: var(--ink-soft);
      font-weight: 500;
    }

    .stage-form {
      max-width: 420px;
      margin-inline: auto;
    }

    /* the "ruled baseline" is this direction's signature craft detail:
       a single writing-line under the word, echoing a workbook without
       resorting to a themed panel or full lined-paper texture */
    .stage-input-wrap {
      position: relative;
    }

    .stage-input {
      width: 100%;
      text-align: center;
      background: transparent;
      border: none;
      border-radius: 0;
      color: var(--ink);
      font-family: var(--font-word);
      font-size: 1.9rem;
      font-weight: 500;
      letter-spacing: 0.02em;
      padding: 0.6rem 1rem 0.9rem;
    }

    .stage-input-rule {
      display: block;
      height: 3px;
      border-radius: 3px;
      background: var(--border-strong);
      margin-inline: 1.5rem;
    }

    .stage-input:focus-visible {
      outline: 3px solid var(--focus-ring);
      outline-offset: 6px;
      border-radius: 8px;
    }

    .stage-input:focus-visible ~ .stage-input-rule {
      background: var(--focus-ring);
    }

    .stage-actions {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.9rem;
      margin-top: 1.75rem;
    }

    .btn {
      font-family: inherit;
      cursor: pointer;
    }

    .btn-ghost-stage {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: transparent;
      color: var(--ink-soft);
      border: none;
      font-weight: 600;
      font-size: 0.9rem;
      padding: 0.4rem;
    }
    .btn-ghost-stage:hover {
      color: var(--practice-strong);
    }

    .btn-primary-stage {
      background: var(--practice-strong);
      color: #fff;
      border: none;
      font-weight: 700;
      font-size: 1rem;
      padding: 0.9rem 2.5rem;
      border-radius: var(--radius-pill);
      transition: background 0.15s ease;
    }
    .btn-primary-stage:hover {
      background: var(--practice-ink);
    }

    /* ============ STATE EXAMPLES ============ */
    .state-examples {
      margin-top: 3.5rem;
    }

    .state-examples h2 {
      font-size: 1.15rem;
      margin-bottom: 0.5rem;
      text-align: center;
    }

    .state-examples-note {
      font-size: 0.9rem;
      color: var(--ink-faint);
      text-align: center;
      max-width: 56ch;
      margin: 0 auto 1.75rem;
      line-height: 1.55;
    }

    .state-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .state-card {
      background: var(--canvas-raised);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.25rem;
    }

    .state-card-label {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 0.9rem;
    }

    .mini-stage {
      background: var(--canvas-sunken);
      border-radius: var(--radius-md);
      padding: 1.25rem;
    }

    .mini-audio-row {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      margin-bottom: 1rem;
    }

    .mini-audio-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.1rem;
      height: 2.1rem;
      border-radius: 50%;
      background: var(--practice-strong);
      color: #fff;
      flex-shrink: 0;
    }

    .mini-word {
      font-family: var(--font-word);
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--ink-faint);
    }

    .mini-input-wrap {
      margin-bottom: 0.9rem;
    }

    .mini-input {
      width: 100%;
      text-align: center;
      background: transparent;
      border: none;
      font-family: var(--font-word);
      font-size: 1.3rem;
      font-weight: 500;
      padding: 0.4rem 0.5rem 0.6rem;
    }

    .mini-input-rule {
      display: block;
      height: 3px;
      border-radius: 3px;
      margin-inline: 1rem;
    }
    .mini-input-rule.is-correct {
      background: var(--correct-ink);
    }
    .mini-input-rule.is-incorrect {
      background: var(--incorrect-ink);
    }

    .mini-input.is-correct {
      color: var(--correct-ink);
    }

    .mini-input.is-incorrect {
      color: var(--incorrect-ink);
      text-decoration: line-through;
      text-decoration-thickness: 1.5px;
    }

    .mini-feedback {
      display: flex;
      align-items: flex-start;
      gap: 0.55rem;
      font-size: 0.86rem;
      line-height: 1.5;
      border-radius: var(--radius-sm);
      padding: 0.65rem 0.85rem;
      margin: 0;
      text-align: left;
    }
    .mini-feedback-icon {
      flex-shrink: 0;
      margin-top: 0.15rem;
    }
    .mini-feedback.is-correct {
      background: var(--correct-bg);
      color: var(--correct-ink);
    }
    .mini-feedback.is-incorrect {
      background: var(--incorrect-bg);
      color: var(--incorrect-ink);
    }

    @media (max-width: 640px) {
      .state-grid {
        grid-template-columns: 1fr;
      }
      .stage-input {
        font-size: 1.5rem;
      }
      .progress-steps li {
        width: 1.7rem;
        height: 1.7rem;
      }
    }
  </style>
</Proto>
