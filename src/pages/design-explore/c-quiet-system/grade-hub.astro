---
import Layout from './_Layout.astro';

const strands = [
  { title: 'Core Spelling', rail: 'var(--rail-green)', items: ['Short A Words', 'Long A Silent E Words', 'Soft C and Soft G'] },
  { title: 'High-Frequency Words', rail: 'var(--rail-blue)', items: ['Set 1', 'Set 2', 'Set 3'] },
  { title: 'Themed Spelling Practice', rail: 'var(--rail-amber)', items: ['Animal Words', 'Weather Words'] },
];
---

<Layout title="Grade 1">
  <header class="explore-c__header">
    <div class="explore-c__header-inner">
      <span class="explore-c__wordmark">spellingwords</span>
      <nav class="explore-c__nav">
        <a href="#">Grades</a>
        <a href="#">Skills</a>
      </nav>
    </div>
  </header>

  <main class="wrap wrap--narrow" style="padding: 36px 24px 72px;">
    <p style="font-size: 13px; color: var(--text-tertiary); margin-bottom: 18px;">Home / Grade 1</p>
    <h1 style="font-size: clamp(28px, 3.6vw, 38px); margin-bottom: 12px;">Grade 1 spelling words</h1>
    <p style="font-size: 15.5px; color: var(--text-secondary); line-height: 1.6; max-width: 62ch; margin-bottom: 36px;">
      A path through Core Spelling patterns, everyday High-Frequency Words, and Themed Practice —
      arranged so the first steps build the skills later ones depend on.
    </p>

    {strands.map((strand) => (
      <section style="margin-bottom: 30px;">
        <div class="rail" style={`border-left-color: ${strand.rail}; margin-bottom: 12px;`}>
          <span class="rail-label" style={`--rail-blue: ${strand.rail};`}>{strand.title}</span>
        </div>
        <div class="surface">
          {strand.items.map((item, i) => (
            <a href="#" style={`display: flex; align-items: center; justify-content: space-between; padding: 15px 18px; text-decoration: none; color: inherit; ${i < strand.items.length - 1 ? 'border-bottom: 1px solid var(--border);' : ''}`}>
              <span style="font-weight: 550; font-size: 15px;">{item}</span>
              <span style="color: var(--text-tertiary);">→</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <div class="surface" style="padding: 18px 20px; border-left: 3px solid var(--rail-violet);">
      <p style="font-weight: 650; margin-bottom: 6px; font-size: 15px;">Where to begin</p>
      <p style="color: var(--text-secondary); font-size: 14.5px; line-height: 1.6;">
        Most Grade 1 students start with Core Spelling, then use High-Frequency Words alongside it each week.
      </p>
    </div>
  </main>

  <footer class="explore-c__footer">
    <div class="wrap">← Kindergarten &nbsp;&nbsp;&nbsp; Grade 2 →</div>
  </footer>
</Layout>
