---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SpellingListCard from '@/components/SpellingListCard.astro';
import { isPublished } from '@/lib/content/spellingLists';
import { gradeConfig, type GradeConfigEntry } from '@/lib/content/gradeConfig';
import {
  GRADE_STRANDS,
  getCanonicalGradeRoutes,
  getGradeHubPath,
  type GradeRouteClassification,
} from '@/lib/content/canonicalGradeRoutes';
import { getCanonicalUrl } from '@/lib/canonicalUrl';

export async function getStaticPaths() {
  return gradeConfig.flatMap((gradeEntry) =>
    (Object.keys(GRADE_STRANDS) as GradeRouteClassification[]).map((strand) => ({
      params: { gradeSlug: gradeEntry.slug, strand },
      props: { gradeEntry, strand },
    })),
  );
}

const { gradeEntry, strand } = Astro.props as {
  gradeEntry: GradeConfigEntry;
  strand: GradeRouteClassification;
};
const descriptor = GRADE_STRANDS[strand];
const allEntries = (await getCollection('spelling-lists')).filter(isPublished);
const entriesById = new Map(allEntries.map((entry) => [entry.data.id, entry]));
const routes = getCanonicalGradeRoutes().filter(
  (route) => route.grade === gradeEntry.grade && route.classification === strand,
);
const resources = routes.map((route) => {
  const entry = entriesById.get(route.id);
  if (!entry) throw new Error(`Gateway could not resolve ${route.id}`);
  return { route, entry };
});
const wordCount = resources.reduce((total, resource) => total + resource.entry.data.words.length, 0);
const description = strand === 'core-spelling'
  ? `Explore the ${descriptor.label} sequence for ${gradeEntry.label} across ${resources.length} carefully ordered spelling units.`
  : strand === 'high-frequency-words'
    ? `Practice ${wordCount} ${gradeEntry.label} High-Frequency Words across ${resources.length} manageable spelling sets.`
    : `Choose from ${resources.length} optional ${gradeEntry.label} spelling lists organized around familiar themes.`;
const gatewayPath = `${getGradeHubPath(gradeEntry.grade)}/${descriptor.routeSegment}`;
const canonicalURL = getCanonicalUrl(gatewayPath, Astro.site);
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: gradeEntry.label, href: getGradeHubPath(gradeEntry.grade) },
  { label: descriptor.label },
];
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem', position: index + 1, name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};
const itemListJsonLd = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: `${gradeEntry.label} ${descriptor.label}`,
  numberOfItems: resources.length,
  itemListElement: resources.map(({ route, entry }, index) => ({
    '@type': 'ListItem', position: index + 1,
    url: new URL(route.canonicalPath, canonicalURL.origin).toString(), name: entry.data.title,
  })),
};
---

<Layout title={`${gradeEntry.label} ${descriptor.label} | spellingwords.app`} description={description} jsonLd={[breadcrumbJsonLd, itemListJsonLd]}>
  <SiteHeader variant="discovery" currentPath={gatewayPath} />
  <main id="main-content">
    <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
      <div class="mb-6"><Breadcrumbs items={breadcrumbItems} /></div>
      <header class="mb-10">
        <h1 class="font-display text-2xl font-semibold text-ink md:text-3xl">{gradeEntry.label} {descriptor.label}</h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-soft">{description}</p>
      </header>
      <ol class="flex flex-col gap-4">
        {resources.map(({ route, entry }, index) => (
          <li class="flex items-start gap-3">
            <span aria-hidden="true" class="mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-blue/10 text-sm font-semibold text-brand-blue">{index + 1}</span>
            <div class="flex-1"><SpellingListCard href={route.canonicalPath} category={entry.data.category} title={entry.data.title} description={entry.data.description} difficulty={entry.data.difficulty} durationMinutes={entry.data.durationMinutes} wordCount={entry.data.words.length} /></div>
          </li>
        ))}
      </ol>
    </div>
  </main>
  <SiteFooter />
</Layout>
