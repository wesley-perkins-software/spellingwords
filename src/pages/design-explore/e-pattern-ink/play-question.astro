---
import Layout from './_Layout.astro';
---

<Layout title="Practice">
  <header class="explore-e__header">
    <div class="explore-e__header-inner">
      <span class="explore-e__wordmark" style="font-size: 15px;">spelling<span class="accent">words</span></span>
      <a href="#" style="font-size: 14px; font-weight: 600; color: var(--ink-soft); text-decoration: none;">← New list</a>
    </div>
  </header>

  <main class="wrap wrap--narrow" style="padding: 32px 24px 64px; display: flex; flex-direction: column; gap: 34px;">
    <section style="display: flex; align-items: center; gap: 14px;">
      <span class="badge" style="background: var(--surface-raised); color: var(--ink);">Word 3 / 10</span>
      <div style="flex: 1; height: 6px; background: var(--border); border-radius: 999px; overflow: hidden;">
        <div style="width: 30%; height: 100%; background: var(--mark);"></div>
      </div>
    </section>

    <!-- Practice field: category color background, with the target pattern shown once revealed -->
    <section class="field" style="background: var(--phonics); padding: 38px 32px; display: flex; flex-direction: column; gap: 22px;">
      <p style="color: rgba(255,255,255,0.85); font-size: 15px;">Listen carefully and type what you hear.</p>

      <input
        type="text"
        class="answer-input"
        placeholder="Type the word"
        style="width: 100%; background: rgba(255,255,255,0.94); border: none; border-radius: 14px; padding: 17px 20px; font-family: var(--font-word); font-size: 27px; font-weight: 700; color: var(--bg);"
      />

      <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <button type="button" class="btn btn--on-color">🔊 Hear word again</button>
        <button type="button" class="btn btn--on-color">💬 Hear sentence again</button>
      </div>
    </section>

    <button type="button" class="btn btn--primary" style="width: 100%; padding: 17px;">
      Submit Answer
    </button>

    <!-- Feedback state (correct) — the pattern mark appears on reveal -->
    <section>
      <p style="font-size: 12.5px; font-weight: 700; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 14px;">Feedback state — correct</p>
      <div class="card" style="padding: 38px 32px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px;">
        <span style="width: 40px; height: 40px; border-radius: 50%; background: var(--correct); display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700;">✓</span>
        <span class="pword" style="font-size: 42px;">c<span class="mark">a</span>k<span class="mark">e</span></span>
        <p style="color: var(--ink-soft); font-size: 14.5px;">Well spelled — the silent e makes the a say its name.</p>
      </div>
    </section>
  </main>
</Layout>
