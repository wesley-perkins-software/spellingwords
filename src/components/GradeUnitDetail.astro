---
import Breadcrumbs from '@/components/Breadcrumbs.astro';

interface BreadcrumbItem {
  label: string;
  href?: string;
}
interface StepLink {
  title: string;
  href: string;
  step?: number;
  total?: number;
}
interface SiblingLink {
  label: string;
  href: string;
}

interface Props {
  breadcrumbItems: BreadcrumbItem[];
  title: string;
  description: string;
  words: Array<{ word: string; exampleSentence?: string }>;
  playWordsJson: string;
  gradeHubLabel?: string;
  gradeHubHref?: string;
  step?: number;
  total?: number;
  conceptSkillHref?: string;
  conceptSkillTitle?: string;
  prev?: StepLink;
  next?: StepLink;
  siblings?: SiblingLink[];
}

const {
  breadcrumbItems,
  title,
  description,
  words,
  playWordsJson,
  gradeHubLabel,
  gradeHubHref,
  step,
  total,
  conceptSkillHref,
  conceptSkillTitle,
  prev,
  next,
  siblings = [],
} = Astro.props;

// Segments for the progress rail (the defining "this is a step in a sequence" cue).
const segments = total ? Array.from({ length: total }, (_, i) => i + 1) : [];
---

<!--
  GRADE UNIT — "Lesson Sheet"
  Single narrow column, worksheet furniture: a segmented progress rail up top,
  a numbered word list as the centrepiece, one dominant practice action, and a
  prominent previous/next step bar. Reads as an assignment, not an article.
-->
<div class="mx-auto max-w-2xl px-5 pb-16 pt-8 sm:px-6">
  <Breadcrumbs items={breadcrumbItems} />

  {/* ── Progress rail: where this sits in the grade sequence ───────────── */}
  {
    step && total && (
      <div class="mt-7">
        <div class="flex items-center justify-between gap-3">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-brand-blue">
            {gradeHubHref ? (
              <a href={gradeHubHref} class="hover:underline">
                {gradeHubLabel} Spelling
              </a>
            ) : (
              <span>{gradeHubLabel} Spelling</span>
            )}
          </p>
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-ink-muted">
            Step {step} of {total}
          </p>
        </div>
        <div class="mt-2.5 flex gap-1.5" aria-hidden="true">
          {segments.map((n) => (
            <span
              class={`h-1.5 flex-1 rounded-full ${
                n < step ? 'bg-brand-blue/45' : n === step ? 'bg-brand-blue' : 'bg-brand-blue/10'
              }`}
            />
          ))}
        </div>
      </div>
    )
  }

  {/* ── Compact lesson header ──────────────────────────────────────────── */}
  <header class="mt-8">
    <span
      class="inline-flex items-center gap-1.5 rounded-full bg-brand-blue/10 px-3 py-1 text-xs font-bold uppercase tracking-[0.1em] text-brand-blue"
    >
      Lesson
    </span>
    <h1 class="text-display-lg mt-3">{title}</h1>
    <p class="mt-3 text-base leading-relaxed text-ink-muted">{description}</p>

    <div class="mt-6">
      <button
        type="button"
        data-practice
        data-words={playWordsJson}
        data-list-title={title}
        class="btn-primary w-full px-9 py-4 text-base sm:w-auto"
        aria-label={`Practice these ${words.length} words in ${title}`}
      >
        Practice these {words.length} words
      </button>
      <p
        data-practice-status
        class="mt-3 text-sm text-feedback-incorrect"
        aria-live="polite"
        aria-atomic="true"
      >
      </p>
    </div>
  </header>

  {/* ── The assignment: numbered word rows (the centrepiece) ───────────── */}
  <section class="mt-10" aria-labelledby="assignment-heading">
    <div class="flex items-baseline justify-between gap-3">
      <h2 id="assignment-heading" class="font-display text-base font-semibold text-ink">
        The {words.length} words to practice in this step
      </h2>
      <span class="text-xs font-semibold uppercase tracking-[0.1em] text-ink-muted"
        >Read · Say · Spell</span
      >
    </div>

    <ol class="mt-4 overflow-hidden rounded-3xl border border-line bg-white shadow-card">
      {
        words.map((w, i) => (
          <li class="flex items-baseline gap-4 border-b border-line/70 px-5 py-3.5 last:border-b-0 sm:px-6">
            <span
              class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-brand-blue/10 font-sans text-xs font-bold text-brand-blue"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <div class="flex flex-1 flex-col gap-0.5 sm:flex-row sm:items-baseline sm:gap-5">
              <span class="w-20 flex-shrink-0 font-word text-lg font-semibold leading-snug text-ink sm:text-xl">
                {w.word}
              </span>
              {w.exampleSentence && (
                <span class="text-sm leading-relaxed text-ink-muted">{w.exampleSentence}</span>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ── Short "why these words" note (deliberately minor) ──────────────── */}
  <section class="mt-8" aria-labelledby="note-heading">
    <div class="rounded-2xl border border-line bg-app-cloud/60 px-5 py-4 sm:px-6">
      <h2 id="note-heading" class="text-xs font-bold uppercase tracking-[0.1em] text-ink-muted">
        About this step
      </h2>
      <div
        class="mt-2 space-y-3 text-sm leading-relaxed text-ink-muted [&_strong]:font-semibold [&_strong]:text-ink"
      >
        <slot />
      </div>
    </div>
  </section>

  {/* ── Go deeper: one quiet link to the canonical Skill ───────────────── */}
  {
    conceptSkillHref && conceptSkillTitle && (
      <p class="mt-6 text-sm text-ink-muted">
        Want the full teaching guide to this pattern?{' '}
        <a href={conceptSkillHref} class="font-semibold text-brand-blue hover:underline">
          Go deeper on {conceptSkillTitle.replace(/ Words$/i, '')} →
        </a>
      </p>
    )
  }

  {/* ── Prev / Next step bar: the defining navigation ──────────────────── */}
  {
    (prev || next) && (
      <nav class="mt-12 border-t border-line pt-6" aria-label="Lesson steps">
        <div class="grid gap-3 sm:grid-cols-2">
          {prev ? (
            <a
              href={prev.href}
              class="group flex flex-col rounded-2xl border border-line bg-white px-5 py-4 shadow-card transition hover:-translate-y-0.5 hover:border-brand-blue/30 hover:shadow-card-md"
            >
              <span class="text-xs font-bold uppercase tracking-[0.12em] text-ink-muted">
                <span aria-hidden="true">←</span> Previous step
                {prev.step && prev.total && (
                  <span>
                    {' '}
                    · {prev.step} of {prev.total}
                  </span>
                )}
              </span>
              <span class="mt-1 font-display text-base font-semibold text-ink group-hover:text-brand-blue">
                {prev.title}
              </span>
            </a>
          ) : (
            <span aria-hidden="true" class="hidden sm:block" />
          )}
          {next && (
            <a
              href={next.href}
              class="group flex flex-col rounded-2xl border border-brand-blue/25 bg-brand-blue/[0.04] px-5 py-4 shadow-card transition hover:-translate-y-0.5 hover:border-brand-blue/40 hover:shadow-card-md sm:text-right"
            >
              <span class="text-xs font-bold uppercase tracking-[0.12em] text-brand-blue">
                Next step <span aria-hidden="true">→</span>
                {next.step && next.total && (
                  <span>
                    {' '}
                    · {next.step} of {next.total}
                  </span>
                )}
              </span>
              <span class="mt-1 font-display text-base font-semibold text-ink group-hover:text-brand-blue">
                {next.title}
              </span>
            </a>
          )}
        </div>

        {/* Sibling steps, deliberately secondary — a single quiet line. */}
        {siblings.length > 0 && (
          <p class="mt-5 text-sm text-ink-muted">
            <span class="font-semibold text-ink">Other steps:</span>{' '}
            {siblings.map((s, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                <a href={s.href} class="text-brand-blue hover:underline">
                  {s.label}
                </a>
              </>
            ))}
          </p>
        )}
      </nav>
    )
  }
</div>
