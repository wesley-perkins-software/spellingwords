---
import Layout from '@/layouts/Layout.astro';
import CategoryChip from '@/components/CategoryChip.astro';

const sampleWords = [
  'friend',
  'because',
  'different',
  'people',
  'every',
  'school',
  'always',
  'again',
];

const placeholderText = sampleWords.join('\n');
---

<Layout
  title="spellingwords — Create a spelling test in seconds"
  description="Paste your spelling words to create a spelling test, practice session, or printable worksheet. Free, no account needed."
>
  <!-- Site header -->
  <header class="sticky top-0 z-10 border-b border-app-hairline bg-app-cream/90 backdrop-blur-sm">
    <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
      <!-- Logo -->
      <a
        href="/"
        class="flex items-center gap-2 font-display text-lg font-semibold text-app-charcoal tracking-tight"
        aria-label="spellingwords home"
      >
        <span
          aria-hidden="true"
          class="flex h-7 w-7 items-center justify-center rounded-md bg-app-charcoal text-app-cream"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M11.5 2.5l2 2-8 8H3.5v-2l8-8z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9.5 4.5l2 2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
          </svg>
        </span>
        spelling<span class="text-app-sage">words</span>
      </a>

      <nav aria-label="Site navigation">
        <ul class="flex items-center gap-1 text-sm font-medium">
          <li>
            <a
              href="#"
              class="rounded-md px-3 py-1.5 text-app-charcoal/55 transition-colors hover:bg-app-sage/10 hover:text-app-sage"
            >
              How it works
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- Main content -->
  <main id="main-content">
    <section
      class="relative mx-auto max-w-3xl px-6 py-12 md:py-16"
      aria-labelledby="hero-heading"
    >
      <div class="relative flex flex-col gap-9">

        <!-- Headline block -->
        <div class="flex flex-col gap-3">
          <h1
            id="hero-heading"
            class="font-display text-3xl font-semibold text-app-charcoal md:text-4xl"
          >
            Create a spelling test in seconds
          </h1>
          <p class="text-base leading-relaxed text-app-charcoal/60">
            Paste your spelling words below. Practice, test, or print with no account.
          </p>
        </div>

        <!-- Word entry panel -->
        <div class="overflow-hidden rounded-xl border border-app-hairline bg-white">
          <!-- Label bar -->
          <div class="flex items-center justify-between border-b border-app-hairline px-5 py-3">
            <label
              for="word-input"
              class="text-xs font-semibold uppercase tracking-widest text-app-charcoal/40"
            >
              Enter one word per line
            </label>
            <span
              id="word-count"
              class="rounded-md bg-app-sage/10 px-3 py-0.5 font-mono text-xs font-medium text-app-sage"
              aria-live="polite"
              aria-atomic="true"
            >
              {sampleWords.length} words
            </span>
          </div>

          <!-- Textarea -->
          <textarea
            id="word-input"
            name="words"
            rows="9"
            class="w-full resize-none px-5 py-4 font-sans text-base text-app-charcoal placeholder:text-app-charcoal/25 focus:outline-none"
            autocomplete="off"
            spellcheck="false"
            aria-label="Spelling words, one per line"
          >{placeholderText}</textarea>

          <!-- Status footer -->
          <div class="border-t border-app-hairline px-5 py-2.5">
            <p
              id="word-status"
              class="text-xs text-app-charcoal/40"
              aria-live="polite"
              aria-atomic="true"
            >
              {sampleWords.length} words ready
            </p>
          </div>
        </div>

        <!-- Primary actions -->
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <button
            id="btn-start-test"
            type="button"
            class="flex-1 rounded-lg bg-app-charcoal px-6 py-3.5 text-sm font-semibold text-app-cream transition hover:bg-app-charcoal/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-app-sage active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-40 sm:flex-none"
            aria-label="Start a spelling test"
          >
            Start Spelling Test →
          </button>
          <button
            type="button"
            disabled
            class="flex-1 rounded-lg border border-app-sage/30 bg-app-sage/5 px-6 py-3.5 text-sm font-semibold text-app-sage opacity-50 sm:flex-none"
            aria-label="Practice words — coming soon"
          >
            Practice Words
          </button>
          <span
            class="flex-1 rounded-lg px-6 py-3.5 text-center text-sm font-medium text-app-charcoal/30 sm:flex-none"
            aria-hidden="true"
          >
            Print Worksheet
          </span>
        </div>

        <!-- Divider with label -->
        <div class="flex items-center gap-3">
          <div class="h-px flex-1 bg-app-hairline"></div>
          <span class="text-xs font-semibold uppercase tracking-widest text-app-charcoal/35">
            or try a built-in list
          </span>
          <div class="h-px flex-1 bg-app-hairline"></div>
        </div>

        <!-- Category chips -->
        <div
          class="flex flex-wrap gap-2"
          role="list"
          aria-label="Built-in word list categories"
        >
          <div role="listitem"><CategoryChip label="2nd Grade" variant="blue" /></div>
          <div role="listitem"><CategoryChip label="Sight Words" variant="green" /></div>
          <div role="listitem"><CategoryChip label="Silent E" variant="yellow" /></div>
          <div role="listitem"><CategoryChip label="Spelling Bee" variant="sage" /></div>
        </div>

        <!-- Library bridge -->
        <p class="text-sm text-app-charcoal/55">
          Looking for ready-made lists?
          <a href="/spelling-lists" class="font-semibold text-app-sage hover:underline">
            Browse the curated spelling lists library →
          </a>
        </p>

        <!-- Trust microcopy -->
        <div class="flex flex-wrap items-center gap-2 text-xs text-app-charcoal/40">
          <span aria-hidden="true" class="inline-block h-1.5 w-1.5 rounded-full bg-app-sage"></span>
          Free
          <span aria-hidden="true" class="text-app-charcoal/20">·</span>
          No account needed
          <span aria-hidden="true" class="text-app-charcoal/20">·</span>
          Works on Chromebooks &amp; iPads
        </div>

      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-app-hairline">
    <div class="mx-auto max-w-3xl px-6 py-8 text-center text-xs text-app-charcoal/35">
      &copy; {new Date().getFullYear()} spellingwords.app &mdash; Free spelling practice for every classroom.
    </div>
  </footer>
</Layout>

<script>
  import { parseWordInput, encodeWordList } from '@/lib/words';

  const textarea = document.getElementById('word-input') as HTMLTextAreaElement;
  const wordCountEl = document.getElementById('word-count')!;
  const statusEl = document.getElementById('word-status')!;
  const startBtn = document.getElementById('btn-start-test') as HTMLButtonElement;

  function getWords(): string[] {
    return parseWordInput(textarea.value);
  }

  function updateStatus(): void {
    const words = getWords();
    const count = words.length;

    if (count === 0) {
      wordCountEl.textContent = '0 words';
      statusEl.textContent = 'Enter at least one word to get started.';
      startBtn.disabled = true;
    } else if (count > 200) {
      wordCountEl.textContent = `${count} words`;
      statusEl.textContent = 'Maximum 200 words. Please remove some words.';
      startBtn.disabled = true;
    } else {
      wordCountEl.textContent = `${count} ${count === 1 ? 'word' : 'words'}`;
      statusEl.textContent = `${count} ${count === 1 ? 'word' : 'words'} ready`;
      startBtn.disabled = false;
    }
  }

  function handleStart(): void {
    const words = getWords();
    if (words.length === 0 || words.length > 200) return;

    const result = encodeWordList(words);
    if (!result.ok) {
      statusEl.textContent =
        result.code === 'payload_too_long'
          ? 'Word list is too long to encode. Please shorten some words.'
          : 'Could not create test. Please check your word list.';
      return;
    }

    window.location.href = `/play?list=${result.payload}`;
  }

  textarea.addEventListener('input', updateStatus);
  startBtn.addEventListener('click', handleStart);

  // Set initial state
  updateStatus();
</script>
