---
interface Props {
  words: Array<{ word: string }>;
  accentClass?: string;
}

const { words, accentClass = 'bg-brand-blue' } = Astro.props;
---

<div class="overflow-hidden rounded-3xl border border-line bg-white shadow-card-lg">
  <div class={`h-1.5 ${accentClass}`} aria-hidden="true"></div>
  <div class="flex items-center justify-between border-b border-line px-5 py-3 sm:px-6">
    <span class="text-sm font-semibold text-ink-soft">Word list</span>
    <span class="rounded-full bg-brand-blue px-3 py-1 font-mono text-xs font-bold text-white">
      {words.length} words
    </span>
  </div>
  <ul
    class="grid grid-cols-2 gap-x-4 gap-y-2.5 px-5 py-5 sm:grid-cols-3 sm:px-6"
    aria-label="Words in this list"
  >
    {words.map((word) => <li class="font-word text-base font-medium text-ink">{word.word}</li>)}
  </ul>
</div>
