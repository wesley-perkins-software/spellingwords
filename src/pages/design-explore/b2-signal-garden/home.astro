---
import Layout from './_Layout.astro';

const grades = [
  { g: 'K', color: 'var(--grade-k)', desc: 'First sounds, letters, and three-letter words.' },
  { g: '1', color: 'var(--grade-1)', desc: 'Silent e, letter teams, everyday high-frequency words.' },
  { g: '2', color: 'var(--grade-2)', desc: 'Blends, digraphs, and longer word families.' },
  { g: '3', color: 'var(--grade-3)', desc: 'Prefixes, suffixes, and multi-syllable patterns.' },
  { g: '4', color: 'var(--grade-4)', desc: 'Latin roots and more demanding spelling patterns.' },
  { g: '5', color: 'var(--grade-5)', desc: 'Advanced patterns getting students ready for middle school.' },
];

const skills = ['Short A Words', 'Long A Silent E Words', 'Soft C and Soft G', 'Consonant Blends', 'Silent Letters'];
---

<Layout title="Home">
  <header class="explore-b2__header">
    <div class="explore-b2__header-inner">
      <span class="explore-b2__wordmark">spelling<span class="accent">words</span></span>
      <nav class="explore-b2__nav">
        <a href="#grades">Grades</a>
        <a href="#skills">Skills</a>
        <a href="#">How it works</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="wrap hero-grid" style="padding: 60px 24px 52px; display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 44px; align-items: center;">
      <div>
        <span class="badge" style="background: var(--grade-1); margin-bottom: 20px;">Practice · Any List</span>
        <h1 style="font-size: clamp(34px, 4.6vw, 52px); line-height: 1.06; margin-bottom: 18px;">
          Spelling practice with room to be colorful.
        </h1>
        <p style="font-size: 17px; color: var(--ink-soft); max-width: 46ch; line-height: 1.6; margin-bottom: 28px;">
          Paste your own list or follow a grade-level path. Hear each word, then type it.
          No timers, no points — just clear, warm practice.
        </p>
        <button type="button" class="btn btn--primary">Start Practicing</button>
      </div>

      <div class="arch arch--outline" style="padding: 0; overflow: hidden;">
        <div style="display: flex; align-items: center; justify-content: space-between; padding: 16px 22px; background: var(--accent); color: #fff;">
          <span style="font-family: var(--font-display); font-weight: 800; font-size: 13px; text-transform: uppercase; letter-spacing: 0.04em;">Your Words</span>
          <span style="font-size: 12px; font-weight: 800; background: #fff; color: var(--accent); padding: 4px 11px; border-radius: 999px;">0</span>
        </div>
        <textarea
          rows="4"
          placeholder="Type or paste your words here, one per line"
          style="width: 100%; border: none; resize: none; padding: 20px 22px; font-family: var(--font-word); font-size: 18px; color: var(--ink); background: transparent;"
        ></textarea>
      </div>
    </section>

    <section id="grades" style="background: var(--bg-warm); padding: 48px 0;">
      <div class="wrap">
        <h2 style="font-size: 27px; margin-bottom: 8px;">Browse by Grade</h2>
        <p style="color: var(--ink-soft); max-width: 60ch; margin-bottom: 28px;">
          A Kindergarten&ndash;5th grade path across Core Spelling, High-Frequency Words, and Themed Practice —
          each grade carries its own color throughout the site.
        </p>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 16px;">
          {grades.map((item) => (
            <a href="#" class="arch" style={`background: ${item.color}; padding: 26px 24px 22px; text-decoration: none;`}>
              <span style="font-family: var(--font-display); font-weight: 800; font-size: 42px; line-height: 1;">{item.g}</span>
              <p style="margin-top: 12px; font-size: 14px; opacity: 0.95; line-height: 1.5;">{item.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="skills" class="wrap" style="padding: 48px 24px 64px;">
      <h2 style="font-size: 27px; margin-bottom: 8px;">Browse by Skill</h2>
      <p style="color: var(--ink-soft); max-width: 60ch; margin-bottom: 24px;">
        Already know what to work on? Explore 41 spelling skills, each with its own practice bank.
      </p>
      <div class="card">
        {skills.map((s, i) => (
          <a href="#" style={`display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; text-decoration: none; color: inherit; ${i < skills.length - 1 ? 'border-bottom: 1px solid var(--border);' : ''}`}>
            <span style="font-family: var(--font-display); font-weight: 700; font-size: 16px;">{s}</span>
            <span style="color: var(--accent); font-weight: 800;">→</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <footer class="explore-b2__footer">
    <div class="wrap">No accounts. No timers. Just spelling.</div>
  </footer>
</Layout>
