---
import Layout from '@/layouts/Layout.astro';
import HeroWordPanel from '@/components/HeroWordPanel.astro';
import CategoryChip from '@/components/CategoryChip.astro';
import { grade2Essentials } from '@/data/fixtures/sampleLists';
---

<Layout
  title="spellingwords — Turn spelling words into practice"
  description="Paste any word list to create a spelling test, practice session, or printable worksheet. Free, no account needed."
>
  <!-- Site header -->
  <header class="sticky top-0 z-10 border-b border-classroom-blue/10 bg-white/90 backdrop-blur-sm">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
      <!-- Logo -->
      <a
        href="/"
        class="flex items-center gap-2 font-display text-lg font-bold text-app-charcoal tracking-tight"
        aria-label="spellingwords home"
      >
        <!-- Small colored pencil dot accent -->
        <span
          aria-hidden="true"
          class="flex h-7 w-7 items-center justify-center rounded-xl bg-classroom-blue text-white text-xs"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M11.5 2.5l2 2-8 8H3.5v-2l8-8z" stroke="white" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9.5 4.5l2 2" stroke="white" stroke-width="1.75" stroke-linecap="round"/>
          </svg>
        </span>
        spelling<span class="text-classroom-blue">words</span>
      </a>

      <nav aria-label="Site navigation">
        <ul class="flex items-center gap-3 text-sm font-medium">
          <li>
            <a
              href="#"
              class="rounded-xl px-3 py-1.5 text-app-charcoal/60 transition-colors hover:bg-classroom-blue/8 hover:text-classroom-blue"
            >
              How it works
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- Main content -->
  <main id="main-content">
    <!-- Hero section -->
    <section
      class="relative mx-auto max-w-5xl overflow-hidden px-6 py-16 md:py-24"
      aria-labelledby="hero-heading"
    >
      <!-- Decorative background dots (aria-hidden, purely visual) -->
      <div aria-hidden="true" class="pointer-events-none select-none">
        <!-- Top-right yellow blob -->
        <div class="absolute -top-6 right-8 h-24 w-24 rounded-full bg-classroom-yellow/25 blur-2xl"></div>
        <!-- Top-left coral dot -->
        <div class="absolute top-10 -left-4 h-14 w-14 rounded-full bg-classroom-coral/20 blur-xl"></div>
        <!-- Bottom-right green accent -->
        <div class="absolute bottom-8 right-16 h-10 w-10 rounded-full bg-classroom-green/25 blur-lg"></div>
        <!-- Small solid dots -->
        <div class="absolute top-8 right-24 h-3 w-3 rounded-full bg-classroom-yellow/60"></div>
        <div class="absolute top-20 right-40 h-2 w-2 rounded-full bg-classroom-coral/50"></div>
        <div class="absolute bottom-16 left-8 h-3 w-3 rounded-full bg-classroom-blue/40"></div>
      </div>

      <div class="relative grid grid-cols-1 gap-10 md:grid-cols-2 md:items-start">

        <!-- Left: copy + CTAs -->
        <div class="flex flex-col gap-7">

          <!-- Headline -->
          <div class="flex flex-col gap-3">
            <h1
              id="hero-heading"
              class="font-display text-4xl font-bold leading-tight text-app-charcoal md:text-5xl"
            >
              Turn spelling words
              <br />
              <span class="relative inline-block">
                into practice.
                <!-- Underline accent -->
                <span
                  aria-hidden="true"
                  class="absolute -bottom-1 left-0 h-1 w-full rounded-full bg-classroom-yellow/70"
                ></span>
              </span>
            </h1>
            <p class="text-lg leading-relaxed text-app-charcoal/65">
              Paste any word list to create a spelling test, practice session, or printable
              worksheet. Free, no account needed.
            </p>
          </div>

          <!-- Primary + secondary CTAs -->
          <div class="flex flex-wrap items-center gap-4">
            <button
              type="button"
              class="rounded-2xl bg-classroom-blue px-7 py-3.5 text-sm font-bold text-white shadow-md shadow-classroom-blue/30 transition hover:bg-blue-600 hover:shadow-lg hover:shadow-classroom-blue/25 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-classroom-blue active:scale-95"
              aria-label="Start a spelling test"
            >
              Start Spelling Test →
            </button>
            <div class="flex items-center gap-4">
              <a
                href="#"
                class="text-sm font-semibold text-classroom-green underline-offset-4 hover:underline"
              >
                Practice Words
              </a>
              <span aria-hidden="true" class="text-app-leather/40">·</span>
              <a
                href="#"
                class="text-sm font-semibold text-app-charcoal/50 underline-offset-4 hover:text-app-charcoal hover:underline"
              >
                Print Worksheet
              </a>
            </div>
          </div>

          <!-- Category chips -->
          <div>
            <p class="mb-3 text-xs font-bold uppercase tracking-widest text-app-charcoal/40">
              Try a built-in list
            </p>
            <div
              class="flex flex-wrap gap-2"
              role="list"
              aria-label="Example word list categories"
            >
              <div role="listitem"><CategoryChip label="2nd Grade" variant="blue" /></div>
              <div role="listitem"><CategoryChip label="Sight Words" variant="green" /></div>
              <div role="listitem"><CategoryChip label="Silent E" variant="yellow" /></div>
              <div role="listitem"><CategoryChip label="Spelling Bee" variant="coral" /></div>
            </div>
          </div>

          <!-- Trust microcopy -->
          <div class="flex items-center gap-2 text-xs text-app-charcoal/45">
            <span
              aria-hidden="true"
              class="inline-block h-1.5 w-1.5 rounded-full bg-classroom-green"
            ></span>
            Free
            <span aria-hidden="true" class="text-app-leather/30">·</span>
            No account needed
            <span aria-hidden="true" class="text-app-leather/30">·</span>
            Works on Chromebooks &amp; iPads
          </div>
        </div>

        <!-- Right: word panel preview -->
        <div class="md:pt-2">
          <HeroWordPanel words={grade2Essentials.words} />
        </div>
      </div>
    </section>
  </main>

  <!-- Site footer -->
  <footer class="border-t border-slate-100 bg-white/60 mt-auto">
    <div class="mx-auto max-w-5xl px-6 py-8 text-center text-xs text-app-charcoal/40">
      &copy; {new Date().getFullYear()} spellingwords.app &mdash; Free spelling practice for every classroom.
    </div>
  </footer>
</Layout>
