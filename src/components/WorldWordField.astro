---
import type { WordFamily } from '@/lib/theme/wordFamilies';

interface Props {
  /** Every word in the list, in list order — used when `wordFamilies` is omitted. */
  words: string[];
  /** word -> example sentence, revealed on tap alongside the slow read-aloud. */
  sentences: Record<string, string>;
  /**
   * Pre-grouped word families (see shouldGroupByWordFamily) — only pass this
   * when the content actually teaches a shared-ending pattern. Omit it for
   * anything else (digraphs, vowel teams, spelling rules, etc.) and the field
   * renders a plain word list instead of a potentially misleading grouping.
   */
  wordFamilies?: WordFamily[];
}

const { words, sentences, wordFamilies } = Astro.props;

const groups: { rime: string; words: string[]; highlightRime: boolean }[] = wordFamilies
  ? wordFamilies.map((f) => ({ ...f, highlightRime: true }))
  : words.map((word) => ({ rime: '', words: [word], highlightRime: false }));
---

<div class="word-field" role="list" aria-label="Words in this list">
  {
    groups.map((group) => (
      <div class="family" role="listitem">
        <div class="family-words">
          {group.words.map((word) => {
            const onset = group.highlightRime ? word.slice(0, word.length - group.rime.length) : word;
            const sentence = sentences[word];
            return (
              <span class="word-wrap">
                <span
                  class="word"
                  role="button"
                  tabindex="0"
                  data-word={word}
                  aria-expanded="false"
                  aria-label={`Hear "${word}" said slowly, and show an example sentence`}
                >
                  <span class="onset">{onset}</span>
                  {group.highlightRime && <span class="rime">{group.rime}</span>}
                </span>
                {sentence && (
                  <span class="sentence-reveal" hidden>
                    {sentence}
                  </span>
                )}
              </span>
            );
          })}
        </div>
        {group.highlightRime && group.words.length > 1 && (
          <p class="family-caption">
            the <span class="rime-label">-{group.rime}</span> family
          </p>
        )}
      </div>
    ))
  }
</div>

<style>
  .word-field {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 40px 52px;
    padding: 12px 20px 8px;
  }

  .family {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .family:nth-child(3n + 2) {
    transform: translateY(16px);
  }
  .family:nth-child(3n + 3) {
    transform: translateY(-8px);
  }

  .family-words {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .word-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .word {
    font-family: 'Atkinson Hyperlegible', sans-serif;
    font-weight: 700;
    font-size: clamp(28px, 5.6vw, 44px);
    line-height: 1.15;
    letter-spacing: 0.01em;
    color: var(--world-ink);
    cursor: pointer;
    border-radius: 10px;
    padding: 2px 10px;
    transition: transform 0.18s ease;
  }
  .word:hover,
  .word:focus-visible {
    transform: scale(1.06);
  }
  .word:focus-visible {
    outline: 2px solid var(--world-ink);
    outline-offset: 3px;
  }
  .word .onset {
    color: var(--world-ink);
  }
  .word .rime {
    color: var(--world-accent);
    text-shadow: 0 0 22px var(--world-accent-soft);
  }

  .sentence-reveal {
    font-family: 'Nunito', sans-serif;
    font-style: italic;
    font-weight: 600;
    font-size: 14.5px;
    color: var(--world-ink);
    opacity: 0.75;
    max-width: 22ch;
    text-align: center;
    margin-top: 2px;
  }

  .family-caption {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 13.5px;
    color: var(--world-ink);
    opacity: 0.6;
    margin: 4px 0 0;
  }
  .family-caption .rime-label {
    color: var(--world-accent);
    opacity: 1;
  }

  @media (max-width: 640px) {
    .word-field {
      gap: 30px 22px;
    }
    .family:nth-child(3n + 2),
    .family:nth-child(3n + 3) {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .word {
      transition: none;
    }
  }
</style>

<script>
  import { createSpeechController } from '@/modules/speech';

  const controller = createSpeechController();

  function toggleWord(el: HTMLElement): void {
    const word = el.dataset.word;
    if (word) controller.speakWord(word, { rate: 0.7 });

    const reveal = el.nextElementSibling as HTMLElement | null;
    if (!reveal || !reveal.classList.contains('sentence-reveal')) return;

    const isHidden = reveal.hidden;
    document
      .querySelectorAll<HTMLElement>('.sentence-reveal:not([hidden])')
      .forEach((el) => (el.hidden = true));
    document
      .querySelectorAll<HTMLElement>('.word[aria-expanded="true"]')
      .forEach((el) => el.setAttribute('aria-expanded', 'false'));

    reveal.hidden = !isHidden;
    el.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
  }

  document.querySelectorAll<HTMLElement>('.word-field .word').forEach((el) => {
    el.addEventListener('click', () => toggleWord(el));
    el.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        toggleWord(el);
      }
    });
  });
</script>
