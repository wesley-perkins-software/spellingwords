---
import type { SpellingListEntry } from '@/lib/content/spellingLists';

interface Props {
  heading: string;
  items: SpellingListEntry[];
  listLink: (entry: SpellingListEntry) => string;
  /** "previous" tints the edge brand-blue (review/reinforce direction, matches
   *  categoryMeta.cardAccent). "forward" tints it amber (categoryMeta's
   *  journeyForwardAccent — the site's one supporting accent, reserved for
   *  progressing to the next list). "neutral" (default) renders a plain card
   *  with no accent edge, for lists that are simply related rather than part
   *  of the before/after progression.
   *  (Class names are written as full literal strings, not built from the
   *  categoryMeta constants, so Tailwind's JIT scanner can detect them.) */
  accent?: 'previous' | 'forward' | 'neutral';
}

const { heading, items, listLink, accent = 'neutral' } = Astro.props;
const edgeClass =
  accent === 'forward'
    ? 'before:bg-chip-sun'
    : accent === 'previous'
      ? 'before:bg-brand-blue'
      : 'before:bg-transparent';
---

{
  items.length > 0 && (
    <div class="min-w-0">
      <h3 class="mb-4 font-display text-sm font-bold uppercase tracking-wide text-ink-soft">
        {heading}
      </h3>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {items.map((linked) => (
          <a
            href={listLink(linked)}
            class={`relative block min-w-0 overflow-hidden rounded-2xl border border-line bg-app-paper py-4 pl-6 pr-5 shadow-card transition before:absolute before:inset-y-0 before:left-0 before:w-1.5 before:content-[''] ${edgeClass} hover:-translate-y-0.5 hover:bg-white hover:shadow-card-md`}
          >
            <span class="block font-display text-base font-semibold text-ink sm:text-lg">
              {linked.data.title}
            </span>
            <span class="mt-1.5 block text-base leading-relaxed text-ink-soft line-clamp-2">
              {linked.data.description}
            </span>
          </a>
        ))}
      </div>
    </div>
  )
}
