      background: var(--canvas-raised);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1rem 1.25rem;
    }

    .faq-item summary {
      cursor: pointer;
      font-weight: 700;
      font-size: 0.98rem;
      color: var(--ink);
      list-style: none;
    }
