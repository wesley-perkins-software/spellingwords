---
import Layout from './_Layout.astro';
---

<Layout title="Practice">
  <header class="explore-f__header">
    <div class="explore-f__header-inner">
      <span class="explore-f__wordmark" style="font-size: 15px;">spelling<span class="accent">words</span></span>
      <a href="#" style="font-size: 14px; font-weight: 700; color: var(--ink-soft); text-decoration: none;">← New list</a>
    </div>
  </header>

  <main class="wrap wrap--narrow" style="padding: 12px 24px 64px; display: flex; flex-direction: column; gap: 28px;">
    <section style="display: flex; align-items: center; gap: 14px;">
      <span class="badge" style="background: var(--ink);">Word 3 / 10</span>
      <div style="flex: 1; height: 6px; background: #ece9e2; border-radius: 999px; overflow: hidden;">
        <div style="width: 30%; height: 100%; background: var(--tile-4);"></div>
      </div>
    </section>

    <!-- Practice mosaic: the tray is composed of two tiles — a color field and the white input panel — sharing one seam -->
    <div class="mosaic" style="grid-template-columns: 1fr; grid-template-rows: auto;">
      <div class="tile" style="background: var(--tile-4); padding: 30px 30px 20px;">
        <p style="opacity: 0.9; font-size: 15px; font-weight: 600;">Listen carefully and type what you hear.</p>
      </div>
      <div class="panel" style="padding: 22px 26px; display: flex; flex-direction: column; gap: 18px;">
        <input
          type="text"
          class="answer-input"
          placeholder="Type the word"
          style="width: 100%; background: #f7f5f0; border: 1.5px solid #ece9e2; border-radius: 10px; padding: 16px 20px; font-family: var(--font-word); font-size: 27px; font-weight: 700; color: var(--ink);"
        />
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <button type="button" class="btn btn--ghost" style="background: var(--tile-4); border-color: var(--tile-4);">🔊 Hear word again</button>
          <button type="button" class="btn btn--ghost" style="background: var(--tile-4); border-color: var(--tile-4);">💬 Hear sentence again</button>
        </div>
      </div>
    </div>

    <button type="button" class="btn btn--primary" style="width: 100%; padding: 17px;">
      Submit Answer
    </button>

    <!-- Feedback state (correct) -->
    <section>
      <p style="font-size: 12.5px; font-weight: 700; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 14px;">Feedback state — correct</p>
      <div class="tile" style="background: var(--correct); padding: 38px 32px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px;">
        <span style="width: 40px; height: 40px; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; color: var(--correct); font-weight: 800;">✓</span>
        <span style="font-family: var(--font-word); font-weight: 700; font-size: 38px;">cake</span>
        <p style="opacity: 0.9; font-size: 14.5px;">Well spelled.</p>
      </div>
    </section>
  </main>
</Layout>
