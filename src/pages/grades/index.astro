---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { gradeConfig } from '@/lib/content/gradeConfig';

const chapters = [
  {
    marker: 'K', title: 'Kindergarten', kicker: 'Build the alphabetic foundation',
    copy: 'Kindergarten begins with first words and short-vowel spelling, then brings the five short vowels together and introduces consonant digraphs. High-frequency sets and familiar themes give children additional places to notice letters, sounds, and complete written words.',
    transition: 'The starting point: connect spoken sounds with letters and hold a whole word in mind.'
  },
  {
    marker: '1', title: '1st Grade', kicker: 'Consolidate patterns and extend the code',
    copy: 'First grade strengthens short-vowel knowledge through the C/K and FLOSS rules, then expands into digraphs, blends, silent-e words, vowel teams, inflectional endings, r-controlled vowels, and dependable word endings such as tch and dge.',
    transition: 'Compared with Kindergarten, students work across a wider range of patterns and begin choosing among spellings for the same sound.'
  },
  {
    marker: '2', title: '2nd Grade', kicker: 'Broaden patterns and word complexity',
    copy: 'Second grade widens the vowel system with long-e, long-i, oi/oy, ou/ow, oo, and au/aw patterns. It also brings in soft C and G, two-syllable words, final stable le, silent letters, compound words, and contractions.',
    transition: 'The shift is from mainly one-syllable pattern work toward longer words and more varied orthographic choices.'
  },
  {
    marker: '3', title: '3rd Grade', kicker: 'Move from patterns into word structure',
    copy: 'Third grade makes word parts more explicit. Prefixes, suffixes, suffix spelling changes, possessives, multisyllabic words, homophones, and root-word families show how spelling carries both sound and meaning.',
    transition: 'Building on Grade 2’s broader code, students increasingly analyze how a word is constructed.'
  },
  {
    marker: '4', title: '4th Grade', kicker: 'Deepen morphology and academic spelling',
    copy: 'Fourth grade develops multisyllabic academic spelling alongside advanced prefixes and suffixes, roots and patterns, commonly confused words, and derived words. Practice asks students to connect stable word parts with changes in form and meaning.',
    transition: 'Compared with Grade 3, morphology becomes deeper and more integrated with longer, more academic words.'
  },
  {
    marker: '5', title: '5th Grade', kicker: 'Integrate knowledge across complex words',
    copy: 'Fifth grade brings earlier knowledge together through multisyllabic academic words, combined prefix-and-suffix work, Greek and Latin word parts, commonly confused words, and spelling changes across related words.',
    transition: 'The capstone is flexible application: use sound, pattern, syllable, and meaning together when spelling increasingly sophisticated words.'
  },
].map((chapter, index) => ({ ...chapter, href: gradeConfig[index].hubHref }));

const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Grades' }];
const breadcrumbJsonLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem', position: index + 1, name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site ?? 'https://spellingwords.app').toString() } : {}),
  })),
};
---

<Layout title="Spelling Words by Grade: Kindergarten–5th Grade | SpellingWords.app" description="Compare how spelling develops from Kindergarten through 5th Grade, then choose a grade for Core Spelling, High-Frequency Words, and themed practice." jsonLd={breadcrumbJsonLd}>
  <SiteHeader currentPath="/grades" />
  <main id="main-content">
    <div class="mx-auto max-w-content-xl px-5 pt-8 sm:px-6"><Breadcrumbs items={breadcrumbItems} /></div>
    <section class="border-b border-da-border bg-gradient-to-b from-da-brand-tint to-da-canvas px-5 pb-14 pt-10 sm:px-6 md:pb-20 md:pt-14">
      <div class="mx-auto max-w-content-xl">
        <p class="font-quicksand text-sm font-bold uppercase tracking-[.12em] text-da-brand-strong">K–5 spelling</p>
        <h1 class="mt-3 max-w-4xl font-quicksand text-[clamp(2.35rem,6vw,4.5rem)] font-bold leading-[1.04] tracking-tight text-da-ink">Spelling Words by Grade</h1>
        <p class="mt-6 max-w-3xl text-[1.15rem] leading-relaxed text-da-ink">Across elementary school, spelling develops from foundational sound–letter knowledge into a coordinated understanding of patterns, syllables, word parts, roots, derived words, and meaning. This guide shows what changes from one grade to the next in the SpellingWords curriculum.</p>
      </div>
    </section>

    <section class="px-5 py-12 sm:px-6 md:py-16" aria-labelledby="arc-heading">
      <div class="mx-auto grid max-w-content-xl gap-7 md:grid-cols-[.7fr_1.3fr] md:gap-16">
        <h2 id="arc-heading" class="font-quicksand text-3xl font-bold text-da-ink">One connected progression</h2>
        <div class="space-y-4 text-[1.05rem] leading-relaxed text-da-ink">
          <p>Early grades establish and expand the alphabetic code. The middle of the sequence adds longer words and makes prefixes, suffixes, and roots increasingly visible. Later grades integrate those tools in multisyllabic, derived, and academic words.</p>
          <p>Each grade brings together Core Spelling, High-Frequency Words, and Themed Spelling Practice. Grade labels organize the curriculum; learners can revisit or move ahead to practice what fits their needs.</p>
        </div>
      </div>
    </section>

    <section class="border-y border-da-border bg-da-surface-home px-5 py-14 sm:px-6 md:py-20" aria-label="Kindergarten through 5th Grade progression">
      <ol class="mx-auto max-w-5xl list-none p-0">
        {chapters.map((chapter, index) => (
          <li class="relative grid gap-5 border-l-2 border-da-brand-tint pb-14 pl-8 last:pb-0 md:grid-cols-[10rem_1fr] md:gap-12 md:pl-12">
            <div class="absolute -left-[1.35rem] top-0 flex h-10 w-10 items-center justify-center rounded-full border-2 border-da-brand bg-da-canvas font-quicksand text-lg font-bold text-da-brand-strong">{chapter.marker}</div>
            <div><p class="text-sm font-bold uppercase tracking-[.08em] text-da-brand-strong">Stage {index + 1} of 6</p><h2 class="mt-1 font-quicksand text-2xl font-bold text-da-ink">{chapter.title}</h2></div>
            <article>
              <h3 class="font-quicksand text-xl font-bold text-da-ink">{chapter.kicker}</h3>
              <p class="mt-3 text-base leading-relaxed text-da-ink">{chapter.copy}</p>
              <p class="mt-3 border-l-4 border-da-coral pl-4 font-semibold leading-relaxed text-da-ink">{chapter.transition}</p>
              <a href={chapter.href} class="mt-5 inline-flex min-h-[44px] items-center font-bold text-da-brand-strong no-underline hover:underline">Explore {chapter.title} spelling <span aria-hidden="true">→</span></a>
            </article>
          </li>
        ))}
      </ol>
    </section>
  </main>
  <SiteFooter />
</Layout>
