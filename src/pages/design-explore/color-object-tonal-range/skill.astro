    display: flex;
    gap: 0.5rem;
  }
  .breadcrumb a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .breadcrumb [aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }

  .env-eyebrow {
    padding-bottom: 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
  }

  .skill-hero {
    padding-block: 0.5rem clamp(2rem, 5vw, 3rem);
    background: var(--canvas);
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    font-weight: 700;
