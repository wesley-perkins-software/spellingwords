---
import Proto from './_shared/Proto.astro';
import Header from './_shared/Header.astro';
import Footer from './_shared/Footer.astro';

const words = ['cat', 'hat', 'bed', 'red', 'pig', 'sit', 'hot', 'dog', 'bug', 'run'];
---

<Proto
  title="Short Vowels: CVC Words — Direction A prototype"
  description="Practice short-vowel CVC spelling words: cat, hat, bed, red, pig, sit, hot, dog, bug, run."
>
  <Header currentPath="/design-explore/direction-a/skill" />

  <main id="main">
    <div class="wrap page-shell">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol>
          <li><a href="/design-explore/direction-a/">Home</a></li>
          <li><a href="/design-explore/direction-a/grade-hub">Grade 1 Spelling Words</a></li>
          <li><a href="/design-explore/direction-a/skill">Core Spelling</a></li>
          <li aria-current="page">Short Vowels: CVC Words</li>
        </ol>
      </nav>

      <section class="hero-card">
        <ul class="hero-chips">
          <li class="chip chip-brand"><span class="visually-hidden">Grade: </span>Grade 1</li>
          <li class="chip chip-teal"><span class="visually-hidden">Skill area: </span>Phonics</li>
          <li class="chip chip-sun"><span class="visually-hidden">Level: </span>Beginner</li>
        </ul>
        <h1>Short Vowels: CVC Words</h1>
        <a class="cta-primary" href="/design-explore/direction-a/practice">Practice these words →</a>
      </section>

      <div class="content-grid">
        <div class="content-main">
          <section class="prose-section" aria-labelledby="what-heading">
            <h2 id="what-heading">What are Short Vowels: CVC Words?</h2>
            <p>
              This list practices short-vowel CVC words such as cat, hot, and bug — a
              foundational phonics pattern from the early-elementary curriculum.
            </p>
          </section>

          <section class="prose-section" aria-labelledby="readiness-heading">
            <h2 id="readiness-heading">These spelling words are a good fit for students who...</h2>
            <p>
              can identify beginning and ending consonant sounds, and are ready to blend a
              single short-vowel sound in the middle of a three-letter word.
            </p>
          </section>

          <section class="prose-section" aria-labelledby="wordlist-heading">
            <h2 id="wordlist-heading">Word list</h2>
            <!--
              Tinted sun field ties this word list back to its Core Spelling
              strand color on the Grade Hub. A skill page under a different
              strand (High-Frequency Words, Themed Spelling Practice) would
              use that strand's own tint (teal, periwinkle) here instead.
            -->
            <div class="word-list-panel">
              <ul class="word-list">
                {words.map((word) => <li>{word}</li>)}
              </ul>
            </div>
          </section>

          <section class="prose-section" aria-labelledby="about-heading">
            <h2 id="about-heading">About this pattern</h2>
            <p>
              Consonant-vowel-consonant (CVC) words are the first words most students decode and
              spell independently. Practicing one short-vowel sound at a time — and then mixing
              them — builds the pattern recognition that later phonics work depends on.
            </p>
          </section>

          <section class="prose-section" aria-labelledby="faq-heading">
            <h2 id="faq-heading">Frequently asked questions</h2>
            <dl class="faq-list">
              <div class="faq-item">
                <dt>What are short-vowel CVC words?</dt>
                <dd>
                  This list practices short-vowel CVC words such as cat, hot, and bug — a
                  foundational phonics pattern from the early-elementary curriculum.
                </dd>
              </div>
            </dl>
          </section>
        </div>

        <aside class="content-side" aria-label="Related skill">
          <section class="deeper-card">
            <h2>Go deeper</h2>
            <a class="deeper-link" href="#">
              <span class="deeper-title">Silent E: Long A Words</span>
              <span class="deeper-desc">
                The next step after short vowels: words where a silent e changes the vowel sound.
              </span>
            </a>
          </section>

          <p class="source-line">Curated by the SpellingWords.app editorial team.</p>
        </aside>
      </div>
    </div>
  </main>

  <Footer />

  <style>
    .page-shell {
      padding-block: clamp(2rem, 5vw, 3rem) clamp(3rem, 6vw, 4.5rem);
    }

    /* ============================= BREADCRUMB ============================= */
    .breadcrumb ol {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      list-style: none;
      margin: 0 0 1.5rem;
      padding: 0;
      font-size: 0.9rem;
      color: var(--ink-faint);
    }

    .breadcrumb li:not(:last-child)::after {
      content: '/';
      margin-left: 0.5rem;
      color: var(--border-strong);
    }

    .breadcrumb a {
      text-decoration: none;
      color: var(--ink-soft);
      font-weight: 600;
    }

    .breadcrumb a:hover {
      color: var(--brand);
    }

    .breadcrumb li[aria-current='page'] {
      color: var(--ink);
      font-weight: 700;
    }

    /* ============================= HERO CARD ============================= */
    .hero-card {
      background: var(--brand-tint);
      border: 1px solid var(--brand);
      border-radius: var(--radius-lg);
      padding: clamp(1.75rem, 4vw, 2.5rem);
      margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
      display: flex;
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }

    .hero-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .chip {
      font-weight: 700;
      font-size: 0.82rem;
      padding: 0.35rem 0.85rem;
      border-radius: var(--radius-pill);
      line-height: 1;
    }

    .chip-brand {
      background: var(--canvas-raised);
      color: var(--brand-strong);
    }
    .chip-teal {
      background: var(--teal-tint);
      color: var(--teal-ink);
    }
    .chip-sun {
      background: var(--sun-tint);
      color: var(--sun-ink);
    }

    .hero-card h1 {
      font-size: clamp(1.9rem, 4vw, 2.5rem);
    }

    .cta-primary {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      background: var(--coral);
      color: #ffffff;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1rem;
      text-decoration: none;
      border-radius: var(--radius-sm);
      padding: 0.85rem 1.6rem;
      transition: background 0.15s ease;
    }

    .cta-primary:hover {
      background: var(--coral-strong);
    }

    /* ============================= CONTENT GRID ============================= */
    .content-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: clamp(2rem, 5vw, 3rem);
      align-items: start;
    }

    .prose-section {
      margin-bottom: clamp(2rem, 4vw, 2.75rem);
    }

    .prose-section h2 {
      font-size: 1.3rem;
      margin-bottom: 0.75rem;
    }

    .prose-section p {
      color: var(--ink-soft);
      font-size: 1.02rem;
      line-height: 1.7;
      max-width: 68ch;
    }

    /* ============================= WORD LIST ============================= */
    .word-list-panel {
      background: var(--sun-tint);
      border: 1px solid var(--sun);
      border-radius: var(--radius-lg);
      padding: clamp(1.25rem, 3vw, 1.75rem);
    }

    .word-list {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.75rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .word-list li {
      background: var(--canvas-raised);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 1rem 0.5rem;
      text-align: center;
      font-family: var(--font-word);
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--ink);
      box-shadow: var(--shadow-sm);
    }

    /* ============================= FAQ ============================= */
    .faq-list {
      margin: 0;
    }

    .faq-item {
      background: var(--canvas-sunken);
      border-radius: var(--radius-sm);
      padding: 1.25rem 1.5rem;
    }

    .faq-item dt {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--ink);
      margin-bottom: 0.5rem;
    }

    .faq-item dd {
      margin: 0;
      color: var(--ink-soft);
      font-size: 1rem;
      line-height: 1.65;
    }

    /* ============================= SIDEBAR ============================= */
    .content-side {
      position: sticky;
      top: 5.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .deeper-card {
      background: var(--periwinkle-tint);
      border: 1px solid var(--periwinkle);
      border-radius: var(--radius-md);
      padding: 1.5rem;
    }

    .deeper-card h2 {
      font-size: 1rem;
      color: var(--periwinkle-ink);
      margin-bottom: 0.85rem;
    }

    .deeper-link {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      text-decoration: none;
    }

    .deeper-title {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--ink);
    }

    .deeper-link:hover .deeper-title {
      color: var(--periwinkle-ink);
      text-decoration: underline;
    }

    .deeper-desc {
      font-size: 0.92rem;
      color: var(--ink-soft);
      line-height: 1.55;
    }

    .source-line {
      font-size: 0.85rem;
      color: var(--ink-faint);
    }

    /* ============================= RESPONSIVE ============================= */
    @media (max-width: 900px) {
      .content-grid {
        grid-template-columns: 1fr;
      }

      .content-side {
        position: static;
        flex-direction: row;
        flex-wrap: wrap;
      }

      .deeper-card {
        flex: 1 1 240px;
      }

      .word-list {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    @media (max-width: 560px) {
      .word-list {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .cta-primary {
        width: 100%;
        justify-content: center;
      }

      .content-side {
        flex-direction: column;
      }
    }
  </style>
</Proto>
