---
import type { SpellingWord } from '@/types/spelling';

interface Props {
  words: SpellingWord[];
}

const { words } = Astro.props;

const previewWords = words.slice(0, 8);

// Cycle dot colors per word row for a gentle, friendly feel
const dotColors = [
  'bg-chip-sky',
  'bg-chip-grass',
  'bg-chip-sun',
  'bg-chip-berry',
];
---

<div
  class="overflow-hidden rounded-3xl border border-line bg-white shadow-[0_4px_16px_-6px_rgba(31,41,55,0.08)]"
  role="figure"
  aria-label="Example word list preview"
>
  <!-- Panel header -->
  <div class="flex items-center justify-between px-6 py-4 border-b border-line">
    <div class="flex items-center gap-2.5">
      <!-- Small pencil icon (SVG, decorative) -->
      <span aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M11.5 2.5l2 2-8 8H3.5v-2l8-8z" stroke="#2F6FED" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M9.5 4.5l2 2" stroke="#2F6FED" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="font-display text-sm font-semibold text-ink">
        Grade 2 Essentials
      </span>
    </div>
    <span
      class="rounded-full bg-brand-blue px-3 py-1 text-xs font-bold text-white"
      aria-label={`${previewWords.length} words`}
    >
      {previewWords.length} words
    </span>
  </div>

  <!-- Word rows -->
  <ol class="px-6 py-2" aria-label="Example spelling words">
    {
      previewWords.map((item: SpellingWord, index: number) => (
        <li class="flex items-center gap-4 border-b border-line py-3 last:border-0">
          <!-- Colored dot index -->
          <span
            aria-hidden="true"
            class={`h-2 w-2 flex-shrink-0 rounded-full ${dotColors[index % dotColors.length]}`}
          />
          <!-- Word -->
          <span class="flex-1 font-display text-base font-semibold text-ink">
            {item.word}
          </span>
          {item.phonicsPattern && item.phonicsPattern.length > 0 && (
            <span class="rounded-full bg-app-cloud px-2.5 py-0.5 text-xs font-semibold text-brand-blue">
              {item.phonicsPattern[0]}
            </span>
          )}
        </li>
      ))
    }
  </ol>

  <!-- Panel footer -->
  <div class="px-6 py-3">
    <p class="text-xs font-medium text-ink-soft">
      Example list preview &mdash; paste your own words to get started
    </p>
  </div>
</div>
