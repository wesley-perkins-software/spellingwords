---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import WordListPreview from '@/components/WordListPreview.astro';
import RelatedListCards from '@/components/RelatedListCards.astro';
import SourceAttribution from '@/components/SourceAttribution.astro';
import {
  isPublished,
  resolveListRefs,
  toPlayableWords,
  getListCollection,
} from '@/lib/content/spellingLists';
import { categoryLabels, difficultyLabels } from '@/lib/content/categoryMeta';
import { getListPath } from '@/lib/content/learningPaths';

export async function getStaticPaths() {
  const entries = (await getCollection('spelling-lists')).filter(isPublished);
  const allCollections = await getCollection('spelling-collections');

  return entries.map((entry) => ({
    params: { category: entry.data.category, slug: entry.data.urlSlug },
    props: { entry, allEntries: entries, allCollections },
  }));
}

const { entry, allEntries, allCollections } = Astro.props;
const { data } = entry;

const { Content } = await entry.render();

const related = resolveListRefs(data.relatedLists, allEntries);
const prerequisites = resolveListRefs(data.prerequisiteLists, allEntries);
const next = resolveListRefs(data.nextLists, allEntries);

const playWords = toPlayableWords(entry);
const playWordsJson = JSON.stringify(playWords);

function listLink(e: (typeof allEntries)[number]) {
  return `/spelling-lists/${e.data.category}/${e.data.urlSlug}`;
}

const categoryLabel = categoryLabels[data.category] ?? data.category;
const difficultyLabel = difficultyLabels[data.difficulty] ?? data.difficulty;
const listPath = getListPath(data.id);
const listCollection = getListCollection(data.id, allCollections);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Spelling Lists Library', href: '/spelling-lists' },
  { label: categoryLabel, href: `/spelling-lists/${data.category}` },
  { label: data.title },
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://spellingwords.app');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};

const faqJsonLd =
  data.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: data.faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : null;

const jsonLdBlocks = [breadcrumbJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])];

const gradeDisplay = data.grade
  ? data.grade === 'K'
    ? 'Kindergarten'
    : `Grade ${data.grade}`
  : null;
const durationDisplay = `About ${data.estimatedDurationMinutes} ${data.estimatedDurationMinutes === 1 ? 'minute' : 'minutes'}`;

const easierList = prerequisites[0];
const harderList = next[0];
---

<Layout
  title={`${data.title} — spellingwords`}
  description={data.description}
  ogType="article"
  jsonLd={jsonLdBlocks}
>
  <SiteHeader variant="discovery" currentPath="/spelling-lists" />

  <main id="main-content">
    <article class="mx-auto max-w-2xl px-5 py-10 sm:px-6 md:max-w-3xl md:py-16">
      <!-- Breadcrumbs -->
      <div class="mb-5 md:mb-6">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <!-- Hero: what is this list? -->
      <header class="mb-8 md:mb-10">
        <p class="font-sans text-xs font-bold uppercase tracking-[0.08em] text-ink-faint">
          {[gradeDisplay, categoryLabel].filter(Boolean).join(' · ')}
        </p>
        <h1 class="text-display-lg mt-2">{data.title}</h1>
        <p class="text-body-lg mt-3 max-w-2xl text-ink-soft">{data.description}</p>

        <dl class="mt-6 flex flex-wrap gap-x-6 gap-y-2" aria-label="List details">
          <div class="flex items-baseline gap-1.5">
            <dt class="sr-only">Word count</dt>
            <dd class="text-sm font-bold text-ink">{data.words.length}</dd>
            <dd class="text-sm text-ink-soft">{data.words.length === 1 ? 'word' : 'words'}</dd>
          </div>
          <div class="flex items-baseline gap-1.5">
            <dt class="sr-only">Estimated time</dt>
            <dd class="text-sm font-bold text-ink">{data.estimatedDurationMinutes}</dd>
            <dd class="text-sm text-ink-soft">min practice</dd>
          </div>
          {
            gradeDisplay && (
              <div class="flex items-baseline gap-1.5">
                <dt class="sr-only">Grade</dt>
                <dd class="text-sm font-bold text-ink">{gradeDisplay}</dd>
              </div>
            )
          }
          <div class="flex items-baseline gap-1.5">
            <dt class="sr-only">Difficulty</dt>
            <dd class="text-sm font-bold text-ink">{difficultyLabel}</dd>
          </div>
        </dl>

        {
          data.skillTags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-sm text-ink-soft">
              <span class="font-semibold text-ink-soft">Practices:</span>
              {data.skillTags.map((tag, i) => (
                <span>
                  {tag}
                  {i < data.skillTags.length - 1 ? ',' : ''}
                </span>
              ))}
            </div>
          )
        }
      </header>

      <!-- Is this the right list? -->
      {
        data.readinessSignals.length > 0 && (
          <section class="mb-8 md:mb-10" aria-labelledby="readiness-heading">
            <h2 id="readiness-heading" class="font-display text-lg font-semibold text-ink">
              Is this the right list for your child?
            </h2>
            <ul class="mt-3 space-y-1.5 text-sm leading-relaxed text-ink-soft">
              {data.readinessSignals.map((signal) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class="text-ink-faint">
                    ·
                  </span>
                  <span>{signal}</span>
                </li>
              ))}
            </ul>
            {(easierList || harderList) && (
              <p class="mt-3 text-sm leading-relaxed text-ink-soft">
                {easierList && (
                  <>
                    If this feels like too much too soon,{' '}
                    <a
                      href={listLink(easierList)}
                      class="font-semibold text-brand-blue hover:underline"
                    >
                      {easierList.data.title}
                    </a>{' '}
                    is a gentler starting point.{' '}
                  </>
                )}
                {harderList && (
                  <>
                    If your child moves through it easily,{' '}
                    <a
                      href={listLink(harderList)}
                      class="font-semibold text-brand-blue hover:underline"
                    >
                      {harderList.data.title}
                    </a>{' '}
                    is a natural next step.
                  </>
                )}
              </p>
            )}
          </section>
        )
      }

      <!-- Practice CTA -->
      <section class="mb-10 md:mb-12" aria-labelledby="practice-heading">
        <h2 id="practice-heading" class="sr-only">Practice this list</h2>
        <button
          id="btn-practice"
          type="button"
          data-words={playWordsJson}
          data-list-title={data.title}
          class="w-full rounded-full bg-brand-blue px-7 py-4 text-base font-bold text-white shadow-[0_8px_24px_-8px_rgba(47,111,237,0.45)] transition hover:bg-brand-blue-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue active:scale-[0.97] sm:w-auto"
          aria-label={`Practice this list — all ${playWords.length} words in ${data.title}`}
        >
          Practice this list
        </button>
        <p class="mt-3 text-sm text-ink-soft">
          {durationDisplay} · no timer, no score — just spelling.
        </p>
        <p
          id="start-test-status"
          class="mt-2 text-xs text-feedback-incorrect"
          aria-live="polite"
          aria-atomic="true"
        >
        </p>
      </section>

      <!-- Word list -->
      <section class="mb-10 md:mb-12" aria-labelledby="word-list-heading">
        <h2 id="word-list-heading" class="mb-3 font-display text-lg font-semibold text-ink">
          All {data.words.length} words in this list
        </h2>
        <WordListPreview words={playWords} />
      </section>

      <!-- Why these words were chosen / what children learn (markdown body) -->
      <section class="mb-10 md:mb-12" aria-labelledby="why-heading">
        <h2 id="why-heading" class="text-display-md">
          Why these words — and what your child learns
        </h2>
        <div class="prose prose-sm mt-4 max-w-2xl text-ink-soft">
          <Content />
        </div>
      </section>

      <!-- FAQ -->
      {
        data.faq.length > 0 && (
          <section class="mb-10 md:mb-12" aria-labelledby="faq-heading">
            <h2 id="faq-heading" class="mb-4 font-display text-lg font-semibold text-ink">
              Common questions
            </h2>
            <div class="divide-y divide-line">
              {data.faq.map((item) => (
                <div class="py-4 first:pt-0">
                  <h3 class="font-display text-base font-semibold text-ink">{item.question}</h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{item.answer}</p>
                </div>
              ))}
            </div>
          </section>
        )
      }

      <!-- Learning progression -->
      {
        (prerequisites.length > 0 || related.length > 0 || next.length > 0) && (
          <section class="mb-10" aria-labelledby="progression-heading">
            <h2 id="progression-heading" class="mb-1 font-display text-lg font-semibold text-ink">
              Learning progression
            </h2>
            <p class="mb-5 text-sm text-ink-soft">
              Spelling is cumulative — these lists build on each other.
              {listCollection && (
                <>
                  {' '}
                  Part of the{' '}
                  <a
                    href={`/spelling-lists/collections/${listCollection.data.urlSlug}`}
                    class="font-semibold text-brand-blue hover:underline"
                  >
                    {listCollection.data.title}
                  </a>{' '}
                  collection.
                </>
              )}
              {listPath && (
                <>
                  {' '}
                  Part of the{' '}
                  <a href="/spelling-lists" class="font-semibold text-brand-blue hover:underline">
                    {listPath.title}
                  </a>
                  .
                </>
              )}
            </p>
            <RelatedListCards
              heading="Before this list"
              items={prerequisites}
              listLink={listLink}
            />
            <RelatedListCards heading="Related lists" items={related} listLink={listLink} />
            <RelatedListCards heading="After this list" items={next} listLink={listLink} />
          </section>
        )
      }

      <SourceAttribution source={data.canonicalSource} />
    </article>
  </main>

  <SiteFooter />
</Layout>

<script>
  import { encodeWordList } from '@/lib/words';

  interface SpellingWordData {
    word: string;
    hint?: string;
    exampleSentence?: string;
    phonicsPattern?: string[];
  }

  const statusEl = document.getElementById('start-test-status');

  function getSpellingWords(button: HTMLButtonElement): SpellingWordData[] {
    try {
      const parsed: unknown = JSON.parse(button.dataset.words ?? '[]');
      if (!Array.isArray(parsed)) return [];
      return parsed.filter(
        (e): e is SpellingWordData =>
          typeof e === 'object' && e !== null && typeof (e as SpellingWordData).word === 'string',
      );
    } catch {
      return [];
    }
  }

  function handleStart(event: Event): void {
    const button = event.currentTarget as HTMLButtonElement;
    const words = getSpellingWords(button);
    if (words.length === 0) return;

    const result = encodeWordList(words.map((w) => w.word));
    if (!result.ok) {
      if (statusEl) {
        statusEl.textContent =
          result.code === 'payload_too_long'
            ? 'This list is too long to start automatically. Please try a shorter list.'
            : 'Could not start this spelling test. Please try again.';
      }
      return;
    }

    // Persist rich word data (with exampleSentence etc.) so play.astro can read it.
    const listTitle = button.dataset.listTitle ?? '';
    try {
      sessionStorage.setItem(`sw:words:${result.payload}`, JSON.stringify(words));
      if (listTitle) sessionStorage.setItem(`sw:title:${result.payload}`, listTitle);
    } catch {
      /* quota exceeded or private browsing — non-fatal */
    }

    window.location.href = `/play?list=${result.payload}`;
  }

  document.getElementById('btn-practice')?.addEventListener('click', handleStart);
</script>
