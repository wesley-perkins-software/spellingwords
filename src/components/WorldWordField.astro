---
import type { WordFamily } from '@/lib/theme/wordFamilies';
import { splitVowelHighlight } from '@/lib/theme/wordFamilies';

interface Props {
  /** Every word in the list, in list order — used when `wordFamilies` is omitted. */
  words: string[];
  /**
   * Pre-grouped word families (see shouldGroupByWordFamily) — only pass this
   * when the content actually teaches a shared vowel pattern. Omit it for
   * anything else (digraphs, vowel teams, spelling rules, etc.) and the field
   * renders a plain word list with no vowel highlighting instead.
   */
  wordFamilies?: WordFamily[];
}

const { words, wordFamilies } = Astro.props;

const groups: { words: string[]; highlightVowel: boolean }[] = wordFamilies
  ? wordFamilies.map((f) => ({ words: f.words, highlightVowel: true }))
  : words.map((word) => ({ words: [word], highlightVowel: false }));
---

<div class="word-field" role="list" aria-label="Words in this list">
  {
    groups.map((group) => (
      <div class="family" role="listitem">
        <div class="family-words">
          {group.words.map((word) => (
            <span
              class="word"
              role="button"
              tabindex="0"
              data-word={word}
              aria-label={`Hear "${word}" said slowly`}
            >{group.highlightVowel
              ? splitVowelHighlight(word).map((seg) =>
                  seg.isVowel ? <span class="vowel">{seg.text}</span> : seg.text,
                )
              : word}</span>
          ))}
        </div>
      </div>
    ))
  }
</div>

<style>
  .word-field {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    justify-items: center;
    align-items: start;
    max-width: 52rem;
    margin: 0 auto;
    gap: 36px 24px;
    padding: 12px 24px 8px;
  }

  .family {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .family-words {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .word {
    display: inline-block;
    font-family: 'Atkinson Hyperlegible', sans-serif;
    font-weight: 700;
    font-size: clamp(28px, 5.6vw, 44px);
    line-height: 1.15;
    letter-spacing: 0.01em;
    color: var(--world-ink);
    cursor: pointer;
    border-radius: 10px;
    padding: 2px 10px;
    transition: transform 0.18s ease;
  }
  .word:hover,
  .word:focus-visible {
    transform: scale(1.06);
  }
  .word:focus-visible {
    outline: 2px solid var(--world-ink);
    outline-offset: 3px;
  }
  .word .vowel {
    color: var(--world-accent);
    text-shadow: 0 0 22px var(--world-accent-soft);
  }

  @media (max-width: 640px) {
    .word-field {
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 28px 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .word {
      transition: none;
    }
  }
</style>

<script>
  import { createSpeechController } from '@/modules/speech';

  const controller = createSpeechController();

  function speakSlowly(el: HTMLElement): void {
    const word = el.dataset.word;
    if (word) controller.speakWord(word, { rate: 0.7 });
  }

  document.querySelectorAll<HTMLElement>('.word-field .word').forEach((el) => {
    el.addEventListener('click', () => speakSlowly(el));
    el.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        speakSlowly(el);
      }
    });
  });
</script>
