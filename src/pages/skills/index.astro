---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { getCanonicalUrl } from '@/lib/canonicalUrl';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { isPublished } from '@/lib/content/spellingLists';
import {
  SPELLING_SKILL_FAMILIES,
  getSpellingSkillPath,
  resolveCuratedSkillFamilyEntries,
} from '@/lib/content/spellingSkills';

const entries = (await getCollection('spelling-lists')).filter(isPublished);

const skillFamilies = SPELLING_SKILL_FAMILIES.map((family) => ({
  ...family,
  entries: resolveCuratedSkillFamilyEntries(entries, family.skillIds),
}));

// Skills is a first-class top-level journey, parallel to the grade-first journey.
const breadcrumbItems = [{ label: 'Home', href: '/' }, { label: 'Skills' }];

const canonicalURL = getCanonicalUrl(Astro.url.pathname, Astro.site);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};

let itemListPosition = 0;
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Spelling Practice by Skill',
  numberOfItems: skillFamilies.reduce((count, family) => count + family.entries.length, 0),
  itemListElement: skillFamilies.flatMap((family) =>
    family.entries.map((entry) => ({
      '@type': 'ListItem',
      position: ++itemListPosition,
      url: new URL(getSpellingSkillPath(entry), canonicalURL.origin).toString(),
      name: entry.data.title,
    })),
  ),
};
---

<Layout
  title="Spelling Practice by Skill | spellingwords.app"
  description="Browse the complete collection of spelling skills and concepts for focused, grade-independent spelling practice."
  jsonLd={[breadcrumbJsonLd, itemListJsonLd]}
>
  <SiteHeader variant="discovery" currentPath="/skills" />

  <main id="main-content">
    <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
      <div class="mb-6">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <section aria-labelledby="skills-heading" class="mb-10 flex flex-col gap-4">
        <h1 id="skills-heading" class="text-display-lg">
          Spelling Practice by Skill
        </h1>
        <p class="max-w-2xl text-body text-ink-soft">
          Browse by skill when you already know or recognize the spelling concept your child needs,
          from sound-spelling patterns and conventions to word parts and meaning-based choices. If
          you want a sequenced grade-level path,{' '}
          <a href="/#grades" class="link font-semibold"
            >browse by grade</a
          >.
        </p>
      </section>

      {skillFamilies.map((family) => {
        const headingId =
          'anchorId' in family ? family.anchorId : `${family.title.toLowerCase().replaceAll(' ', '-')}-heading`;

        return (
          <section aria-labelledby={headingId} class="mb-8 card p-5 sm:p-6">
            <div class="mb-5">
              <h2 id={headingId} class="font-display text-lg font-semibold text-ink">
                {family.title}
              </h2>
              <p class="mt-1 max-w-xl text-sm leading-relaxed text-ink-soft">
                {family.description} {family.guidance}
              </p>
            </div>

            <div class="divide-y divide-border border-y border-border">
              {family.entries.map((entry) => (
                <a href={getSpellingSkillPath(entry)} class="group flex items-start justify-between gap-4 rounded-xl px-3 py-4 transition hover:bg-canvas-sunken sm:items-center">
                  <div>
                    <h3 class="font-display text-base font-semibold text-ink transition group-hover:text-brand">
                      {entry.data.title}
                    </h3>
                    <p class="mt-1 text-sm leading-relaxed text-ink-soft">{entry.data.description}</p>
                  </div>
                  <span class="mt-1 shrink-0 text-sm font-semibold text-brand transition group-hover:translate-x-0.5 sm:mt-0" aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </main>

  <SiteFooter />
</Layout>
