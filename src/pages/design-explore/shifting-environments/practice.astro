---
// Design exploration — Direction 3: "Shifting Environments"
// Practice / focused environment — enclosed, concentrated, low-chrome.
// Static mockup: multiple states shown stacked on one page.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Practice (Design exploration)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,560;0,9..144,650&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="proto-badge" aria-hidden="true">Design exploration — Shifting Environments</div>

    <div class="env-practice">
      <header class="topline">
        <a class="wordmark" href="/design-explore/shifting-environments/">
          <span class="wordmark-mark">sw</span>spellingwords
        </a>
        <nav class="topnav" aria-label="Prototype navigation">
          <a href="/design-explore/shifting-environments/">Home</a>
          <a href="/design-explore/shifting-environments/grade-hub">Grade Hub</a>
          <a href="/design-explore/shifting-environments/skill">Skill page</a>
        </nav>
      </header>

      <p class="mockup-note">
        Static mockup &mdash; the four states below normally occur one at a time, full-screen.
        They&rsquo;re stacked here only so every state can be reviewed at once.
      </p>

      <main>
        <section class="state-block" aria-label="State: Question">
          <p class="state-label">State: Question</p>
          <div class="stage">
            <div class="stage-glow" aria-hidden="true"></div>
            <div class="stage-inner">
              <p class="progress">Word 3 of 10</p>
              <p class="instruction">Listen, then type the word.</p>
              <button type="button" class="audio-btn">
                <span aria-hidden="true">🔊</span> Hear word again
              </button>
              <div class="answer-wrap">
                <label class="sr-only" for="answer">Type the word you hear</label>
                <input id="answer" type="text" class="answer-input" value="backpack" autocomplete="off" />
              </div>
              <button type="button" class="btn-submit">Submit Answer</button>
            </div>
          </div>
        </section>

        <section class="state-block" aria-label="State: Correct feedback">
          <p class="state-label">State: Correct feedback</p>
          <div class="stage stage-correct">
            <div class="stage-glow stage-glow-correct" aria-hidden="true"></div>
            <div class="stage-inner">
              <p class="feedback-word">sunshine</p>
              <p class="feedback-line feedback-line-correct">
                <span class="feedback-mark" aria-hidden="true">&check;</span> That&rsquo;s right.
              </p>
              <button type="button" class="btn-continue">Continue</button>
            </div>
          </div>
        </section>

        <section class="state-block" aria-label="State: Incorrect feedback">
          <p class="state-label">State: Incorrect feedback</p>
          <div class="stage stage-incorrect">
            <div class="stage-glow stage-glow-incorrect" aria-hidden="true"></div>
            <div class="stage-inner">
              <p class="feedback-word">birthday</p>
              <p class="you-wrote">You wrote: <span>berthday</span></p>
              <p class="correct-shows">
                <span class="correct-shows-label">Correct spelling</span>
                <span class="correct-shows-word">birthday</span>
              </p>
              <p class="feedback-line feedback-line-incorrect">Close &mdash; take another look, then keep going.</p>
              <button type="button" class="btn-continue">Continue</button>
            </div>
          </div>
        </section>

        <section class="state-block" aria-label="State: Results">
          <p class="state-label">State: Results</p>
          <div class="stage stage-results">
            <div class="stage-inner">
              <p class="results-summary">You spelled 8 of 10 words correctly.</p>
              <div class="results-missed">
                <p class="results-missed-label">Worth another look</p>
                <ul>
                  <li>birthday</li>
                  <li>neighbor</li>
                </ul>
              </div>
              <div class="results-actions">
                <button type="button" class="btn-submit">Practice these words again</button>
                <button type="button" class="btn-ghost">Choose another list</button>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <style>
      :global(html, body) {
        margin: 0;
        padding: 0;
      }
      * {
        box-sizing: border-box;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .proto-badge {
        position: fixed;
        bottom: 10px;
        right: 10px;
        z-index: 50;
        background: rgba(24, 18, 46, 0.85);
        color: #f1ecff;
        font: 500 11px/1.4 'Inter', sans-serif;
        padding: 6px 10px;
        border-radius: 6px;
        pointer-events: none;
      }

      .env-practice {
        --env-a: #d9cff2;
        --env-b: #eae4f9;
        --ink: #241c3e;
        --ink-soft: #4e4470;
        --ink-faint: #7b6f9c;
        --accent: #5a3fa6;
        --accent-ink: #3f2a80;
        --focus-ring: #f4b942;
        --correct: #2f6b4f;
        --correct-bg: #e3f2e8;
        --incorrect: #9a4b2f;
        --incorrect-bg: #fbeee7;

        min-height: 100vh;
        background:
          radial-gradient(60% 46% at 50% 30%, rgba(255, 255, 255, 0.55), transparent 68%),
          radial-gradient(140% 100% at 50% -10%, #efe9fb 0%, #cabbe9 62%, #a98fd6 100%);
        font-family: 'Inter', system-ui, sans-serif;
        color: var(--ink);
        padding: 0 clamp(0px, 5vw, 64px) 96px;
      }
      a {
        color: inherit;
      }
      button {
        font-family: inherit;
      }
      *:focus-visible {
        outline: 3px solid var(--focus-ring);
        outline-offset: 3px;
        border-radius: 4px;
      }

      .topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 28px 20px 4px;
        max-width: 720px;
        margin: 0 auto;
        flex-wrap: wrap;
        gap: 12px;
      }
      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: 'Fraunces', serif;
        font-weight: 650;
        font-size: 20px;
        text-decoration: none;
        color: var(--ink);
      }
      .wordmark-mark {
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 9px;
        background: var(--accent);
        color: #fff;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 13px;
        font-weight: 600;
      }
      .topnav {
        display: flex;
        gap: 22px;
        font-size: 14px;
        font-weight: 500;
      }
      .topnav a {
        text-decoration: none;
        color: var(--ink-soft);
      }
      .topnav a:hover {
        text-decoration: underline;
      }

      .mockup-note {
        max-width: 640px;
        margin: 8px auto 36px;
        padding: 0 20px;
        font-size: 13px;
        color: var(--ink-soft);
        text-align: center;
      }

      main {
        max-width: 620px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 58px;
      }

      .state-label {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-soft);
        margin: 0 0 10px 24px;
      }

      /* The "stage": not a floating card, but a recessed alcove carved
         into the environment. An arch-shaped opening (large radius top,
         tight radius bottom), a dark bezel rim, and an INSET shadow (the
         shadow falls inside the opening, as if light drops into a
         cut-out) replace the drop-shadow-plus-rounded-rect vocabulary
         used elsewhere. It bleeds full-width on narrow screens so the
         enclosure reads as a room, not an object placed on wallpaper. */
      .stage {
        position: relative;
        margin: 0 auto;
        max-width: 620px;
        border-radius: 64px 64px 18px 18px;
        background: linear-gradient(185deg, #2c2050 0%, #4a3a86 46%, #6b53b0 100%);
        padding: 5px;
        box-shadow:
          0 30px 60px -28px rgba(29, 19, 61, 0.55),
          0 0 0 1px rgba(255, 255, 255, 0.06);
      }
      .stage-glow {
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: radial-gradient(60% 40% at 50% 0%, rgba(255, 255, 255, 0.22), transparent 70%);
        pointer-events: none;
      }
      .stage-glow-correct {
        background: radial-gradient(60% 40% at 50% 0%, rgba(178, 255, 214, 0.22), transparent 70%);
      }
      .stage-glow-incorrect {
        background: radial-gradient(60% 40% at 50% 0%, rgba(255, 202, 168, 0.2), transparent 70%);
      }
      .stage-inner {
        position: relative;
        z-index: 1;
        border-radius: 60px 60px 14px 14px;
        background: linear-gradient(180deg, #fbfaff 0%, #f2eefc 100%);
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.9) inset,
          0 14px 30px -16px rgba(29, 19, 61, 0.45) inset;
        padding: clamp(40px, 8vw, 64px) clamp(24px, 6vw, 60px) clamp(32px, 6vw, 48px);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .progress {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.06em;
        color: var(--accent-ink);
        margin: 0 0 18px;
      }
      .instruction {
        font-family: 'Fraunces', serif;
        font-weight: 560;
        font-size: clamp(22px, 3.4vw, 28px);
        margin: 0 0 26px;
        color: var(--ink);
      }
      .audio-btn {
        border: 1.5px solid rgba(90, 63, 166, 0.35);
        background: rgba(255, 255, 255, 0.6);
        color: var(--accent-ink);
        font-weight: 600;
        font-size: 14px;
        padding: 10px 18px;
        border-radius: 999px;
        cursor: pointer;
        margin-bottom: 34px;
      }
      .audio-btn:hover {
        background: #fff;
      }
      .answer-wrap {
        width: 100%;
        max-width: 340px;
        margin-bottom: 26px;
      }
      .answer-input {
        width: 100%;
        text-align: center;
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(26px, 5vw, 34px);
        font-weight: 600;
        letter-spacing: 0.02em;
        color: var(--ink);
        background: #fff;
        border: 2px solid rgba(90, 63, 166, 0.3);
        border-radius: 18px;
        padding: 16px 20px;
      }
      .answer-input:focus-visible {
        outline: 3px solid var(--focus-ring);
        outline-offset: 2px;
      }
      .btn-submit {
        background: var(--accent);
        color: #fff;
        border: none;
        font-weight: 600;
        font-size: 15px;
        padding: 14px 30px;
        border-radius: 999px;
        cursor: pointer;
        box-shadow: 0 12px 22px -12px rgba(90, 63, 166, 0.55);
      }
      .btn-submit:hover {
        background: var(--accent-ink);
      }

      .feedback-word {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(28px, 5vw, 36px);
        font-weight: 600;
        margin: 0 0 16px;
      }
      .feedback-line {
        font-size: 16px;
        font-weight: 500;
        margin: 0 0 30px;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .feedback-line-correct {
        color: var(--correct);
      }
      .feedback-mark {
        display: inline-grid;
        place-items: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: var(--correct-bg);
        color: var(--correct);
        font-size: 13px;
      }
      .feedback-line-incorrect {
        color: var(--incorrect);
      }
      .you-wrote {
        font-size: 15px;
        color: var(--ink-faint);
        margin: 0 0 6px;
      }
      .you-wrote span {
        text-decoration: line-through;
        text-decoration-color: rgba(154, 75, 47, 0.5);
        color: var(--incorrect);
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
      }
      .correct-shows {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin: 0 0 20px;
      }
      .correct-shows-label {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--ink-faint);
        font-weight: 600;
      }
      .correct-shows-word {
        font-family: 'Space Grotesk', sans-serif;
        font-size: clamp(24px, 4.4vw, 30px);
        font-weight: 600;
        color: var(--ink);
      }
      .btn-continue {
        background: #fff;
        color: var(--accent-ink);
        border: 1.5px solid rgba(90, 63, 166, 0.35);
        font-weight: 600;
        font-size: 15px;
        padding: 12px 28px;
        border-radius: 999px;
        cursor: pointer;
      }
      .btn-continue:hover {
        background: #f4f1fc;
      }

      .stage-results .stage-inner {
        text-align: left;
        align-items: stretch;
      }
      .results-summary {
        font-family: 'Fraunces', serif;
        font-weight: 560;
        font-size: clamp(22px, 3.6vw, 27px);
        margin: 0 0 26px;
        text-align: center;
      }
      .results-missed {
        background: rgba(90, 63, 166, 0.06);
        border-radius: 18px;
        padding: 18px 22px;
        margin: 0 0 30px;
      }
      .results-missed-label {
        margin: 0 0 10px;
        font-size: 12.5px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink-faint);
      }
      .results-missed ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
      }
      .results-missed li {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
        font-size: 17px;
      }
      .results-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
      }
      .btn-ghost {
        background: transparent;
        color: var(--ink-soft);
        border: 1.5px solid rgba(90, 63, 166, 0.3);
        font-weight: 600;
        font-size: 15px;
        padding: 14px 26px;
        border-radius: 999px;
        cursor: pointer;
      }
      .btn-ghost:hover {
        background: rgba(90, 63, 166, 0.06);
      }

      @media (max-width: 480px) {
        .stage {
          border-radius: 36px 36px 14px 14px;
        }
        .stage-inner {
          border-radius: 33px 33px 11px 11px;
        }
        .state-label {
          margin-left: 8px;
        }
        .results-actions {
          flex-direction: column;
        }
        .btn-ghost,
        .results-actions .btn-submit {
          width: 100%;
        }
      }
    </style>
  </body>
</html>
