---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SpellingListCard from '@/components/SpellingListCard.astro';
import { isPublished } from '@/lib/content/spellingLists';
import { gradeConfig, type GradeConfigEntry } from '@/lib/content/gradeConfig';
import {
  GRADE_STRANDS,
  getCanonicalGradeRoutes,
  getGradeHubPath,
  getGradeStrandPath,
  type GradeRouteClassification,
} from '@/lib/content/canonicalGradeRoutes';
import { getCanonicalUrl } from '@/lib/canonicalUrl';
import { getGradeStrandGatewayCopy, getGatewayCardDescription } from '@/lib/content/gradeStrandGatewayCopy';

export async function getStaticPaths() {
  return gradeConfig.flatMap((gradeEntry) =>
    (Object.keys(GRADE_STRANDS) as GradeRouteClassification[]).map((strand) => ({
      params: { gradeSlug: gradeEntry.slug, strand },
      props: { gradeEntry, strand },
    })),
  );
}

const { gradeEntry, strand } = Astro.props as {
  gradeEntry: GradeConfigEntry;
  strand: GradeRouteClassification;
};
const descriptor = GRADE_STRANDS[strand];
const allEntries = (await getCollection('spelling-lists')).filter(isPublished);
const entriesById = new Map(allEntries.map((entry) => [entry.data.id, entry]));
const routes = getCanonicalGradeRoutes().filter(
  (route) => route.grade === gradeEntry.grade && route.classification === strand,
);
const resources = routes.map((route) => {
  const entry = entriesById.get(route.id);
  if (!entry) throw new Error(`Gateway could not resolve ${route.id}`);
  return { route, entry };
});
const wordCount = resources.reduce((total, resource) => total + resource.entry.data.words.length, 0);
const fallbackDescription = strand === 'core-spelling'
  ? `Explore the ${descriptor.label} sequence for ${gradeEntry.label} across ${resources.length} carefully ordered spelling units.`
  : strand === 'high-frequency-words'
    ? `Practice ${wordCount} ${gradeEntry.label} High-Frequency Words across ${resources.length} manageable spelling sets.`
    : `Choose from ${resources.length} optional ${gradeEntry.label} spelling lists organized around familiar themes.`;
const pilotCopy = getGradeStrandGatewayCopy(gradeEntry.grade, strand, {
  memberCount: resources.length,
  wordCount,
});
const description = pilotCopy?.orientation ?? fallbackDescription;
const wayfindingStrands = (Object.keys(GRADE_STRANDS) as GradeRouteClassification[]).filter(
  (candidate) => candidate !== strand,
);
const ListElement = strand === 'themed-spelling-practice' ? 'ul' : 'ol';
const gatewayPath = `${getGradeHubPath(gradeEntry.grade)}/${descriptor.routeSegment}`;
const canonicalURL = getCanonicalUrl(gatewayPath, Astro.site);
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: gradeEntry.label, href: getGradeHubPath(gradeEntry.grade) },
  { label: descriptor.label },
];
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem', position: index + 1, name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};
const itemListJsonLd = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: `${gradeEntry.label} ${descriptor.label}`,
  numberOfItems: resources.length,
  itemListElement: resources.map(({ route, entry }, index) => ({
    '@type': 'ListItem', position: index + 1,
    url: new URL(route.canonicalPath, canonicalURL.origin).toString(), name: entry.data.title,
  })),
};
---

<Layout title={`${gradeEntry.label} ${descriptor.label} | spellingwords.app`} description={description} jsonLd={[breadcrumbJsonLd, itemListJsonLd]}>
  <SiteHeader variant="discovery" currentPath={gatewayPath} />
  <main id="main-content">
    <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
      <div class="mb-6"><Breadcrumbs items={breadcrumbItems} /></div>
      <header class="mb-10">
        <p class="mb-2 text-xs font-bold uppercase tracking-[0.06em] text-brand">{gradeEntry.label}</p>
        <h1 class="text-display-lg">{descriptor.label}</h1>
        <p class="mt-4 max-w-2xl text-body text-ink-soft">{description}</p>
        {pilotCopy && (
          <div class="mt-4 max-w-2xl space-y-3 text-body text-ink-soft">
            <p>{pilotCopy.synthesis}</p>
            {pilotCopy.guidance && <p>{pilotCopy.guidance}</p>}
          </div>
        )}
      </header>
      <ListElement class="flex flex-col gap-4">
        {resources.map(({ route, entry }, index) => (
          <li class="flex items-start gap-3">
            {strand !== 'themed-spelling-practice' && <span aria-hidden="true" class="mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-tint text-sm font-semibold text-brand">{index + 1}</span>}
            <div class="flex-1"><SpellingListCard href={route.canonicalPath} category={entry.data.category} title={entry.data.title} description={getGatewayCardDescription(strand, entry.data.description, entry.data.shortAnswer)} difficulty={entry.data.difficulty} durationMinutes={entry.data.durationMinutes} wordCount={entry.data.words.length} showCategoryBadge={false} /></div>
          </li>
        ))}
      </ListElement>
      <nav aria-label={`More ${gradeEntry.label} spelling practice`} class="mt-10 border-t border-border pt-6">
        <p class="text-sm text-ink-soft">
          Explore{' '}
          {wayfindingStrands.map((relatedStrand, index) => (
            <>
              {index > 0 && (index === wayfindingStrands.length - 1 ? ' or ' : ', ')}
              <a class="link font-semibold" href={getGradeStrandPath(gradeEntry.grade, relatedStrand)}>
                {gradeEntry.label} {GRADE_STRANDS[relatedStrand].label}{index === wayfindingStrands.length - 1 ? '.' : ''}
              </a>
            </>
          ))}
        </p>
      </nav>
    </div>
  </main>
  <SiteFooter />
</Layout>
