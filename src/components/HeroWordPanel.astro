---
import type { SpellingWord } from '@/types/spelling';

interface Props {
  words: SpellingWord[];
}

const { words } = Astro.props;

const previewWords = words.slice(0, 8);

// Cycle dot colors per word row for a friendly worksheet feel
const dotColors = [
  'bg-classroom-blue',
  'bg-classroom-green',
  'bg-classroom-yellow',
  'bg-classroom-coral',
];
---

<div
  class="overflow-hidden rounded-3xl bg-white shadow-xl ring-1 ring-black/5"
  role="figure"
  aria-label="Example word list preview"
>
  <!-- Colored top bar — notebook tab feel -->
  <div class="h-2 w-full bg-classroom-blue"></div>

  <!-- Panel header -->
  <div class="flex items-center justify-between bg-classroom-blue/5 px-6 py-4 border-b border-classroom-blue/10">
    <div class="flex items-center gap-2.5">
      <!-- Small pencil icon (SVG, decorative) -->
      <span aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M11.5 2.5l2 2-8 8H3.5v-2l8-8z" stroke="#3B82F6" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M9.5 4.5l2 2" stroke="#3B82F6" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="text-sm font-semibold text-classroom-blue">
        Grade 2 Essentials
      </span>
    </div>
    <span
      class="rounded-full bg-classroom-yellow/30 px-3 py-0.5 text-xs font-bold text-amber-700"
      aria-label={`${previewWords.length} words`}
    >
      {previewWords.length} words
    </span>
  </div>

  <!-- Word rows — lined worksheet style -->
  <ol class="px-6 py-2" aria-label="Example spelling words">
    {
      previewWords.map((item: SpellingWord, index: number) => (
        <li class="flex items-center gap-4 border-b border-slate-100 py-3 last:border-0">
          <!-- Colored dot index -->
          <span
            aria-hidden="true"
            class={`h-2 w-2 flex-shrink-0 rounded-full ${dotColors[index % dotColors.length]}`}
          />
          <!-- Word -->
          <span class="flex-1 font-display text-base font-semibold text-app-charcoal">
            {item.word}
          </span>
          {item.phonicsPattern && item.phonicsPattern.length > 0 && (
            <span class="rounded-xl bg-classroom-blue/10 px-2.5 py-0.5 text-xs font-semibold text-classroom-blue">
              {item.phonicsPattern[0]}
            </span>
          )}
        </li>
      ))
    }
  </ol>

  <!-- Panel footer -->
  <div class="bg-slate-50 px-6 py-3">
    <p class="text-xs font-medium text-slate-400">
      Example list preview &mdash; paste your own words to get started
    </p>
  </div>
</div>
