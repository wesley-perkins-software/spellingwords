---
// Design exploration — Shifting Environments, Variation B2:
// "Stronger environmental transitions."
//
// Hypothesis under test: the discovery → choosing → reading → practicing
// journey can carry a visible, intentional spatial grammar. Instead of
// the parent's one continuous diagonal gradient, each section here is a
// flat, fully-committed environment, and the handoff between them is
// marked by a "threshold bar" — a hard-split two-color seam labeled with
// the environment name it's leaving and entering. No arches, scoops,
// waves, blobs, or adjoining color tiles — the device is a single
// horizontal rule that changes composition, not shape.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>spellingwords.app — Practice spelling words (Design exploration)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,560;0,9..144,650;1,9..144,500&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="proto-badge" aria-hidden="true">Design exploration — Shifting Environments / B2: Transition grammar</div>

    <div class="page">
      <header class="topline env-arrival">
        <a class="wordmark" href="/design-explore/environments-transition-grammar/">
          <span class="wordmark-mark">sw</span>spellingwords
        </a>
        <nav class="topnav" aria-label="Prototype navigation">
          <a href="/design-explore/environments-transition-grammar/skill">Skill page</a>
        </nav>
      </header>

      <main>
        <section class="env-block env-arrival">
          <div class="inner hero">
            <p class="hero-eyebrow">Spelling practice, out loud</p>
            <h1 class="hero-title">Hear a word.<br />Write it down.<br />That&rsquo;s the whole idea.</h1>
            <p class="hero-sub">
              No timers, no points, no leaderboard. Just a calm way for kids to practice the words
              that trip them up &mdash; read aloud, typed by hand, one list at a time.
            </p>
          </div>
        </section>

        <div class="threshold" style="--from: #c8632f; --to: #1f5c4e;" role="presentation">
          <span class="threshold-label threshold-label-left">Discovery</span>
          <span class="threshold-label threshold-label-right">Choosing</span>
        </div>

        <section class="env-block env-choosing">
          <div class="inner">
            <div class="plate plate-input" aria-labelledby="own-words-h">
              <h2 id="own-words-h">Enter your spelling words</h2>
              <p class="plate-hint">Got a list from school this week? Paste it in and start right away.</p>
              <form class="word-form">
                <label class="sr-only" for="words">Enter your spelling words</label>
                <textarea
                  id="words"
                  name="words"
                  rows="5"
                  placeholder="Type or paste your words here, one per line"
                ></textarea>
                <div class="form-row">
                  <span class="form-note">10 words a session, by default &mdash; you can change that later.</span>
                  <button type="submit" class="btn-primary">Start Practicing</button>
                </div>
              </form>
            </div>

            <div class="strip" aria-labelledby="grade-h">
              <div class="strip-head">
                <h2 id="grade-h">Browse by Grade</h2>
                <p>Word lists mapped to what kids are actually learning in class, K&ndash;5.</p>
              </div>
              <ul class="shelf" role="list">
                <li><a href="/design-explore/environments-transition-grammar/skill"><span class="shelf-grade">K</span><span class="shelf-label">Kindergarten</span></a></li>
                <li><a href="/design-explore/environments-transition-grammar/skill"><span class="shelf-grade">1</span><span class="shelf-label">1st Grade</span></a></li>
                <li><a href="/design-explore/environments-transition-grammar/skill"><span class="shelf-grade">2</span><span class="shelf-label">2nd Grade</span></a></li>
                <li><a href="/design-explore/environments-transition-grammar/skill"><span class="shelf-grade">3</span><span class="shelf-label">3rd Grade</span></a></li>
                <li><a href="/design-explore/environments-transition-grammar/skill"><span class="shelf-grade">4</span><span class="shelf-label">4th Grade</span></a></li>
                <li><a href="/design-explore/environments-transition-grammar/skill"><span class="shelf-grade">5</span><span class="shelf-label">5th Grade</span></a></li>
              </ul>
            </div>
          </div>
        </section>

        <div class="threshold" style="--from: #1f5c4e; --to: #9a5a1f;" role="presentation">
          <span class="threshold-label threshold-label-left">Choosing</span>
          <span class="threshold-label threshold-label-right">Reading</span>
        </div>

        <section class="env-block env-reading">
          <div class="inner strip-skill" aria-labelledby="skill-h">
            <div class="strip-head">
              <h2 id="skill-h">Browse by Skill</h2>
              <p>Practice one spelling pattern at a time &mdash; digraphs, blends, silent letters, and more.</p>
            </div>
            <div class="skill-band">
              <ul class="skill-list" role="list">
                <li><a href="/design-explore/environments-transition-grammar/skill">SH Digraph Words</a></li>
                <li><a href="/design-explore/environments-transition-grammar/skill">Compound Words</a></li>
                <li><a href="/design-explore/environments-transition-grammar/skill">Silent E Words</a></li>
                <li><a href="/design-explore/environments-transition-grammar/skill">Double Consonants</a></li>
              </ul>
              <a class="skill-all" href="/design-explore/environments-transition-grammar/skill">See every skill &rarr;</a>
            </div>
          </div>
        </section>

        <div class="threshold" style="--from: #9a5a1f; --to: #2c4f7c;" role="presentation">
          <span class="threshold-label threshold-label-left">Reading</span>
          <span class="threshold-label threshold-label-right">Practicing</span>
        </div>

        <section class="env-block env-practice">
          <p class="inner trust-line">
            No accounts to make, no clock running, no score to chase &mdash; just words, read aloud, as many
            times as it takes.
          </p>
        </section>
      </main>
    </div>

    <style>
      :global(html, body) {
        margin: 0;
        padding: 0;
      }
      * {
        box-sizing: border-box;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .proto-badge {
        position: fixed;
        bottom: 10px;
        right: 10px;
        z-index: 50;
        background: rgba(24, 24, 24, 0.82);
        color: #fdf6ec;
        font: 500 11px/1.4 'Inter', sans-serif;
        padding: 6px 10px;
        border-radius: 6px;
        letter-spacing: 0.01em;
        pointer-events: none;
      }

      .page {
        font-family: 'Inter', system-ui, sans-serif;
        color: #201c14;
      }
      a {
        color: inherit;
      }
      *:focus-visible {
        outline: 3px solid #1c4f8c;
        outline-offset: 3px;
        border-radius: 4px;
      }

      .inner {
        max-width: 1080px;
        margin: 0 auto;
        padding-inline: clamp(20px, 5vw, 64px);
      }

      /* Each environment is a flat, fully-committed color block — no
         gradient blending into the next one. */
      .env-block {
        padding-block: clamp(40px, 7vw, 64px);
      }
      .env-arrival {
        background: #ffe4c7;
        color: #2b2116;
      }
      .env-choosing {
        background: #dff0e8;
        color: #16302a;
      }
      .env-reading {
        background: #f1e2bc;
        color: #362912;
      }
      .env-practice {
        background: #dce6f2;
        color: #1c2e42;
      }

      /* The threshold bar: the one recurring transition device. A hard
         two-color seam plus a small label on each side naming the
         environment being left and entered — legible, not decorative. */
      .threshold {
        position: relative;
        height: 34px;
        background: linear-gradient(90deg, var(--from) 0%, var(--from) 50%, var(--to) 50%, var(--to) 100%);
      }
      .threshold-label {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        font-family: 'Space Grotesk', sans-serif;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.88);
      }
      .threshold-label-left {
        right: calc(50% + 14px);
      }
      .threshold-label-right {
        left: calc(50% + 14px);
      }

      .topline {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 28px clamp(20px, 5vw, 64px) 20px;
        max-width: 1080px;
        margin: 0 auto;
        flex-wrap: wrap;
        gap: 12px;
      }
      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: 'Fraunces', serif;
        font-weight: 650;
        font-size: 20px;
        text-decoration: none;
        color: inherit;
      }
      .wordmark-mark {
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 9px;
        background: #c8632f;
        color: #fff;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 13px;
        font-weight: 600;
      }
      .topnav {
        display: flex;
        gap: 22px;
        font-size: 14px;
        font-weight: 500;
      }
      .topnav a {
        text-decoration: none;
        color: inherit;
        opacity: 0.75;
        border-bottom: 1px solid transparent;
        padding-bottom: 2px;
      }
      .topnav a:hover {
        opacity: 1;
        border-color: currentColor;
      }

      .hero {
        padding-block: 8px 8px;
        max-width: 720px;
      }
      .hero-eyebrow {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 13px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #7a3c17;
        margin: 0 0 18px;
        font-weight: 600;
      }
      .hero-title {
        font-family: 'Fraunces', serif;
        font-weight: 560;
        font-size: clamp(34px, 5.4vw, 58px);
        line-height: 1.06;
        margin: 0 0 22px;
        letter-spacing: -0.01em;
      }
      .hero-sub {
        font-size: 17px;
        line-height: 1.6;
        color: #5c4e3f;
        max-width: 52ch;
        margin: 0;
      }

      .plate {
        background: #fffaf1;
        border-radius: 14px;
        padding: clamp(24px, 4vw, 36px);
        margin: 0 0 48px;
        border: 1px solid rgba(22, 48, 42, 0.1);
      }
      .plate h2 {
        font-family: 'Fraunces', serif;
        font-weight: 560;
        font-size: 23px;
        margin: 0 0 8px;
      }
      .plate-hint {
        margin: 0 0 20px;
        color: #3f6157;
        font-size: 15px;
      }
      .word-form textarea {
        width: 100%;
        border: 1px solid #cfe4db;
        background: #fff;
        border-radius: 12px;
        padding: 16px 18px;
        font: 400 15px/1.5 'Inter', sans-serif;
        color: #16302a;
        resize: vertical;
        min-height: 120px;
      }
      .word-form textarea::placeholder {
        color: #8fac9f;
      }
      .word-form textarea:focus-visible {
        outline: 3px solid #1c4f8c;
        outline-offset: 2px;
      }
      .form-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-top: 16px;
        flex-wrap: wrap;
      }
      .form-note {
        font-size: 13px;
        color: #6f8c83;
      }
      .btn-primary {
        font: 600 15px/1 'Inter', sans-serif;
        background: #1f5c4e;
        color: #fff;
        border: none;
        padding: 14px 24px;
        border-radius: 999px;
        cursor: pointer;
        box-shadow: 0 10px 20px -10px rgba(31, 92, 78, 0.55);
      }
      .btn-primary:hover {
        background: #163f36;
      }

      .strip-head h2 {
        font-family: 'Fraunces', serif;
        font-weight: 560;
        font-size: 24px;
        margin: 0 0 6px;
      }
      .strip-head p {
        margin: 0 0 22px;
        color: #3f6157;
        font-size: 15px;
        max-width: 56ch;
      }

      .shelf {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 2px;
        border-top: 2px solid rgba(22, 48, 42, 0.14);
      }
      .shelf li a {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        padding: 20px 8px 4px;
        border-radius: 0 0 14px 14px;
        transition: background 0.15s ease, transform 0.15s ease;
      }
      .shelf li a:hover {
        background: rgba(255, 255, 255, 0.5);
        transform: translateY(3px);
      }
      .shelf-grade {
        font-family: 'Fraunces', serif;
        font-weight: 650;
        font-size: 26px;
        color: #1f5c4e;
      }
      .shelf-label {
        font-size: 12.5px;
        font-weight: 500;
        color: #3f6157;
        text-align: center;
      }

      .strip-skill {
        padding-top: 4px;
      }
      .skill-band {
        background: rgba(255, 255, 255, 0.45);
        border-radius: 14px;
        padding: 26px clamp(20px, 3vw, 34px);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
        border: 1px solid rgba(54, 41, 18, 0.1);
      }
      .skill-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 10px 26px;
      }
      .skill-list a {
        text-decoration: none;
        font-weight: 500;
        font-size: 15px;
        color: #362912;
        border-bottom: 1.5px solid rgba(154, 90, 31, 0.4);
        padding-bottom: 2px;
      }
      .skill-list a:hover {
        border-color: #9a5a1f;
        color: #9a5a1f;
      }
      .skill-all {
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        color: #9a5a1f;
        white-space: nowrap;
      }

      .trust-line {
        text-align: center;
        font-family: 'Fraunces', serif;
        font-style: italic;
        font-size: 18px;
        color: #1c2e42;
        max-width: 44ch;
        margin: 0 auto;
        line-height: 1.5;
      }

      @media (max-width: 720px) {
        .shelf {
          grid-template-columns: repeat(3, 1fr);
        }
        .form-row {
          align-items: stretch;
        }
        .btn-primary {
          width: 100%;
        }
        .threshold-label {
          font-size: 9.5px;
        }
        .threshold-label-left {
          right: calc(50% + 8px);
        }
        .threshold-label-right {
          left: calc(50% + 8px);
        }
      }
      @media (max-width: 480px) {
        .shelf {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .shelf li a {
          transition: none;
        }
      }
    </style>
  </body>
</html>
