---
interface Props {
  words: Array<{ word: string }>;
}

const { words } = Astro.props;
---

<div class="overflow-hidden rounded-xl border border-app-hairline bg-white">
  <div class="flex items-center justify-between border-b border-app-hairline px-5 py-3">
    <span class="text-xs font-semibold uppercase tracking-widest text-app-charcoal/40">Word list</span>
    <span class="rounded-md bg-app-sage/10 px-3 py-0.5 font-mono text-xs font-medium text-app-sage">
      {words.length} words
    </span>
  </div>
  <ul class="grid grid-cols-2 gap-x-4 gap-y-2 px-5 py-4 sm:grid-cols-3" aria-label="Words in this list">
    {words.map((word) => (
      <li class="font-sans text-sm font-medium text-app-charcoal">{word.word}</li>
    ))}
  </ul>
</div>
