---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SpellingListCard from '@/components/SpellingListCard.astro';
import { getListsByGrade, isPublished, getMemberListIds, splitProgressionGroups } from '@/lib/content/spellingLists';

const GRADE = '1';

const allCollections = (await getCollection('spelling-collections')).filter(
  (c) => c.data.status === 'published',
);
const memberIds = getMemberListIds(allCollections);
const entries = (await getCollection('spelling-lists')).filter(isPublished);

const gradeLists = getListsByGrade(GRADE, entries).filter((e) => !memberIds.has(e.data.id));
const gradeCollections = allCollections.filter((c) => c.data.grade === GRADE);
const totalItems = gradeCollections.length + gradeLists.length;
const { opening: openingLists, rest: remainingLists } = splitProgressionGroups(gradeLists);
const hasStartHere = gradeCollections.length > 0 || openingLists.length > 0;

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Spelling Lists Library', href: '/spelling-lists' },
  { label: '1st Grade' },
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://spellingwords.app');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '1st Grade Spelling Word Lists',
  numberOfItems: totalItems,
  itemListElement: [
    ...gradeCollections.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/spelling-lists/collections/${c.data.urlSlug}`, canonicalURL.origin).toString(),
      name: c.data.title,
    })),
    ...gradeLists.map((e, i) => ({
      '@type': 'ListItem',
      position: gradeCollections.length + i + 1,
      url: new URL(
        `/spelling-lists/${e.data.category}/${e.data.urlSlug}`,
        canonicalURL.origin,
      ).toString(),
      name: e.data.title,
    })),
  ],
};
---

<Layout
  title="1st Grade Spelling Words | spellingwords.app"
  description="Free 1st grade spelling word lists — sight words, action words, describing words, and phonics practice. Calm, audio-supported spelling for early readers."
  jsonLd={[breadcrumbJsonLd, itemListJsonLd]}
>
  <SiteHeader variant="discovery" currentPath="/spelling-lists" />

  <main id="main-content">
    <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
      <div class="mb-6">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <!-- Hero -->
      <div class="mb-10 flex flex-col gap-4">
        <h1 class="font-display text-2xl font-semibold text-ink md:text-3xl">
          1st Grade Spelling Words
        </h1>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">
          Here are free 1st grade spelling word lists, including Dolch sight words, action words,
          describing words, and phonics patterns like short vowels and consonant blends. All lists
          include audio support so children can hear each word before typing it.
        </p>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">
          First grade spelling lists help children build confidence with common words, short vowel
          patterns, and early phonics skills. These lists work well for both daily practice and
          weekly spelling homework.
        </p>
      </div>

      <!-- Lists -->
      {totalItems === 0 ? (
        <div class="rounded-2xl border border-line bg-app-cloud p-8 text-center">
          <p class="text-base text-ink-soft">
            First grade lists are being prepared. Check back soon, or{' '}
            <a href="/spelling-lists" class="font-semibold text-brand-blue hover:underline">
              browse the full library
            </a>{' '}
            in the meantime.
          </p>
        </div>
      ) : (
        <div class="mb-12 flex flex-col gap-10">
          {hasStartHere && (
            <section aria-labelledby="start-here-heading">
              <h2 id="start-here-heading" class="mb-4 text-xs font-semibold uppercase tracking-widest text-ink-soft">
                Start here
              </h2>
              <div class="grid gap-4 sm:grid-cols-2">
                {gradeCollections.map((c) => (
                  <a
                    href={`/spelling-lists/collections/${c.data.urlSlug}`}
                    class="flex flex-col gap-3 rounded-2xl border border-line bg-white p-5 shadow-[0_4px_16px_-6px_rgba(31,41,55,0.06)] transition hover:-translate-y-0.5 hover:shadow-[0_8px_22px_-8px_rgba(47,111,237,0.25)]"
                  >
                    <div class="flex flex-col gap-1">
                      <div class="flex items-center gap-2">
                        <span class="rounded-md bg-app-cloud px-2 py-0.5 text-xs font-medium text-ink-soft">
                          Sight Words
                        </span>
                        <span class="rounded-md bg-brand-blue/8 px-2 py-0.5 text-xs font-semibold text-brand-blue">
                          {c.data.listIds.length}-part collection
                        </span>
                      </div>
                      <h3 class="mt-1 font-display text-base font-semibold text-ink">{c.data.title}</h3>
                      <p class="text-sm leading-relaxed text-ink-soft">{c.data.description}</p>
                    </div>
                  </a>
                ))}
                {openingLists.map((entry) => (
                  <SpellingListCard
                    href={`/spelling-lists/${entry.data.category}/${entry.data.urlSlug}`}
                    category={entry.data.category}
                    title={entry.data.title}
                    description={entry.data.description}
                    difficulty={entry.data.difficulty}
                    durationMinutes={entry.data.estimatedDurationMinutes}
                    wordCount={entry.data.words.length}
                  />
                ))}
              </div>
            </section>
          )}
          {remainingLists.length > 0 && (
            <section aria-labelledby="more-lists-heading">
              <h2 id="more-lists-heading" class="sr-only">More lists</h2>
              <div class="grid gap-4 sm:grid-cols-2">
                {remainingLists.map((entry) => (
                  <SpellingListCard
                    href={`/spelling-lists/${entry.data.category}/${entry.data.urlSlug}`}
                    category={entry.data.category}
                    title={entry.data.title}
                    description={entry.data.description}
                    difficulty={entry.data.difficulty}
                    durationMinutes={entry.data.estimatedDurationMinutes}
                    wordCount={entry.data.words.length}
                  />
                ))}
              </div>
            </section>
          )}
        </div>
      )}
        </div>
      )}

      <!-- Choosing guidance -->
      {totalItems > 1 && (
        <section aria-labelledby="guidance-heading" class="mb-12 rounded-2xl border border-line bg-app-cloud p-6">
          <h2 id="guidance-heading" class="mb-2 font-display text-base font-semibold text-ink">
            How to choose a list
          </h2>
          <p class="text-sm leading-relaxed text-ink-soft">
            <strong class="font-semibold text-ink">Sight word lists</strong> are good for daily review
            — a few minutes each day builds recognition faster than longer, infrequent sessions.{' '}
            <strong class="font-semibold text-ink">Phonics lists</strong> (short vowels, blends) work
            well when your child is working through a specific sound pattern. The{' '}
            <strong class="font-semibold text-ink">grade-level lists</strong> — action words, describing
            words, everyday words — are a good match for weekly homework lists or independent reading
            support.
          </p>
        </section>
      )}

      <!-- Adjacent grade nav -->
      <nav aria-label="Adjacent grade levels" class="mb-10 flex items-center justify-between gap-4">
        <a
          href="/spelling-lists/kindergarten"
          class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
        >
          ← Kindergarten Spelling Words
        </a>
        <a
          href="/spelling-lists/2nd-grade"
          class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
        >
          2nd Grade Spelling Words →
        </a>
      </nav>

      <!-- Back to library -->
      <p>
        <a
          href="/spelling-lists"
          class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
        >
          ← Back to the Spelling Lists Library
        </a>
      </p>
    </div>
  </main>

  <SiteFooter />
</Layout>
