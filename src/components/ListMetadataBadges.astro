---
import { categoryLabels, difficultyLabels } from '@/lib/content/categoryMeta';
import type { SpellingListEntry } from '@/lib/content/spellingLists';

interface Props {
  category?: SpellingListEntry['data']['category'];
  difficulty: SpellingListEntry['data']['difficulty'];
  durationMinutes: number;
  wordCount: number;
}

const { category, difficulty, durationMinutes, wordCount } = Astro.props;
---

<div class="flex flex-wrap items-center gap-2 text-xs font-medium">
  {category && (
    <span class="rounded-full bg-chip-sky px-3 py-1 font-semibold text-white">
      {categoryLabels[category] ?? category}
    </span>
  )}
  <span class="rounded-full bg-chip-sun px-3 py-1 font-semibold text-white">
    {difficultyLabels[difficulty] ?? difficulty}
  </span>
  <span class="rounded-full bg-app-cloud px-3 py-1 font-semibold text-brand-blue">
    ~{durationMinutes} min
  </span>
  <span class="rounded-full bg-chip-berry px-3 py-1 font-semibold text-white">
    {wordCount} words
  </span>
</div>
