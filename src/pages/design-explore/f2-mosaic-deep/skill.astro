---
import Layout from './_Layout.astro';

const families = [
  { family: '-ake', words: 'cake, bake, lake, make, take, wake' },
  { family: '-ate', words: 'gate, late, date, plate, skate' },
  { family: '-ame', words: 'flame, game, name, same, tame' },
  { family: '-ape', words: 'cape, grape, shape, tape' },
  { family: '-ave', words: 'brave, cave, gave, save, wave' },
];

const compare = [
  ['cap', 'cape'],
  ['tap', 'tape'],
  ['plan', 'plane'],
  ['past', 'paste'],
];

const words = ['cake', 'gate', 'name', 'plate', 'shape'];

const faq = [
  {
    q: 'Does the silent e in cake do anything if it isn’t pronounced?',
    a: 'Yes — it changes how the vowel before it sounds. Without the final e, cake would be spelled and read like cak, with the short a sound in cat.',
  },
  {
    q: 'Is silent e the only way to spell the long a sound?',
    a: 'No. Silent e is one common way to spell long a in one-syllable words, but English also spells it with letter pairs such as ai and ay, as in rain and day.',
  },
];
---

<Layout title="Long A Silent E Words">
  <header class="explore-f2__header">
    <div class="explore-f2__header-inner">
      <span class="explore-f2__wordmark">spelling<span class="accent">words</span></span>
      <nav class="explore-f2__nav">
        <a href="#">Grades</a>
        <a href="#">Skills</a>
      </nav>
    </div>
  </header>

  <main class="wrap wrap--narrow" style="padding: 8px 24px 72px;">
    <div class="tile" style="background: var(--grade-1); color: #241b02; padding: 26px 26px; margin-bottom: 6px;">
      <p style="font-size: 13px; color: rgba(36,27,2,0.65); font-weight: 700; margin-bottom: 14px;">Home / Skills / Long A Silent E Words</p>
      <span class="badge" style="background: rgba(36,27,2,0.14); color: #241b02;">Skill · Grade 1 · Phonics</span>
      <h1 style="font-size: clamp(25px, 3.6vw, 34px); margin: 12px 0 10px;">Long A Silent E Words</h1>
      <p style="font-size: 15.5px; line-height: 1.6; max-width: 62ch; opacity: 0.85;">
        How the silent-e pattern turns a short vowel into a long "a" sound, as in cake and gate.
      </p>
    </div>

    <div class="panel" style="padding: 20px 22px; margin: 6px 0 28px;">
      <p style="font-size: 12px; font-weight: 700; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 10px;">What is this pattern?</p>
      <p style="font-size: 15px; line-height: 1.65;">
        A silent e sits at the end of a word without making its own sound, but it changes the vowel before it.
        In words like <em>cake</em>, <em>gate</em>, and <em>plate</em>, that final silent e signals that the
        earlier vowel says its own name — long a — instead of the short a sound in <em>cat</em>.
      </p>
    </div>

    <a href="#" class="btn btn--primary" style="margin-bottom: 32px;">Practice these 5 words →</a>

    <h2 style="font-size: 18px; margin-bottom: 12px;">This week's words</h2>
    <div class="panel" style="display: flex; flex-wrap: wrap; gap: 10px; padding: 16px; margin-bottom: 28px;">
      {words.map((w) => (
        <span style="background: var(--canvas); border: 1px solid var(--border); border-radius: 10px; padding: 8px 16px; font-family: var(--font-word); font-weight: 700; font-size: 15.5px;">{w}</span>
      ))}
    </div>

    <h2 style="font-size: 18px; margin-bottom: 12px;">Long A Word Families</h2>
    <div class="panel" style="margin-bottom: 28px; overflow: hidden;">
      {families.map((row, i) => (
        <div style={`display: flex; gap: 14px; align-items: center; padding: 12px 18px; ${i < families.length - 1 ? 'border-bottom: 1px solid var(--border);' : ''}`}>
          <span class="tag" style="background: var(--grade-1); color: #241b02;">{row.family}</span>
          <span style="color: var(--ink-soft); font-size: 14.5px;">{row.words}</span>
        </div>
      ))}
    </div>

    <h2 style="font-size: 18px; margin-bottom: 12px;">Long A Compared With Short A</h2>
    <div class="panel" style="margin-bottom: 28px; overflow: hidden;">
      <div style="display: flex; background: var(--canvas); padding: 9px 18px; font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--ink-faint);">
        <span style="flex: 1;">Short A</span><span style="flex: 1;">Long A</span>
      </div>
      {compare.map(([short, long], i) => (
        <div style={`display: flex; padding: 11px 18px; ${i < compare.length - 1 ? 'border-bottom: 1px solid var(--border);' : ''}`}>
          <span style="flex: 1; color: var(--ink-soft); font-size: 14.5px;">{short}</span>
          <span style="flex: 1; color: #b8790a; font-weight: 700; font-size: 14.5px;">{long}</span>
        </div>
      ))}
    </div>

    <h2 style="font-size: 18px; margin-bottom: 12px;">Common Long A Mistakes</h2>
    <p style="font-size: 15px; line-height: 1.7; margin-bottom: 28px;">
      The most common mistake is dropping the silent e when writing — a sign the learner has heard the long
      vowel but hasn't yet connected it to the e that marks it, so <em>cake</em> comes out as <em>cak</em>.
    </p>

    <h2 style="font-size: 18px; margin-bottom: 12px;">Frequently asked questions</h2>
    <div class="panel">
      {faq.map((item, i) => (
        <div style={`padding: 16px 20px; ${i < faq.length - 1 ? 'border-bottom: 1px solid var(--border);' : ''}`}>
          <p style="font-weight: 700; margin-bottom: 6px; font-size: 14.5px;">{item.q}</p>
          <p style="color: var(--ink-soft); line-height: 1.6; font-size: 14px;">{item.a}</p>
        </div>
      ))}
    </div>
  </main>

  <footer class="explore-f2__footer">
    <div class="wrap">No accounts. No timers. Just spelling.</div>
  </footer>
</Layout>
