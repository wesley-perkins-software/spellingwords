---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SpellingListCard from '@/components/SpellingListCard.astro';
import { isPublished } from '@/lib/content/spellingLists';

const entries = (await getCollection('spelling-lists')).filter(isPublished);
const challengeLists = entries
  .filter((e) => e.data.category === 'challenge')
  .sort((a, b) => a.data.order - b.data.order);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Spelling Lists Library', href: '/spelling-lists' },
  { label: 'Challenge' },
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://spellingwords.app');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Challenge Spelling Word Lists',
  numberOfItems: challengeLists.length,
  itemListElement: challengeLists.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`/spelling-lists/challenge/${e.data.urlSlug}`, canonicalURL.origin).toString(),
    name: e.data.title,
  })),
};
---

<Layout
  title="Challenge Spelling Words | spellingwords.app"
  description="Advanced spelling lists for strong upper-elementary spellers — Greek and Latin roots, academic vocabulary, and complex patterns. Great for spelling bee prep and extension practice."
  jsonLd={[breadcrumbJsonLd, itemListJsonLd]}
>
  <SiteHeader variant="discovery" currentPath="/spelling-lists" />

  <main id="main-content">
    <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
      <div class="mb-6">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <!-- Hero -->
      <div class="mb-10 flex flex-col gap-4">
        <h1 class="font-display text-2xl font-semibold text-ink md:text-3xl">
          Challenge Spelling Words
        </h1>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">
          Challenge spelling lists are for students who are ready for more advanced vocabulary,
          spelling patterns, and academic words. They are useful for extension practice, spelling
          bee preparation, and confident upper-elementary spellers who have moved beyond their
          grade-level lists and want something more demanding.
        </p>
        <p class="max-w-2xl text-base leading-relaxed text-ink-soft">
          These lists draw on Greek and Latin roots, multi-syllable words, and vocabulary common in
          academic reading. Knowing a root like <em>port</em> (carry) or <em>scrib</em> (write)
          unlocks dozens of related words — challenge lists are designed around that kind of
          structural knowledge. All lists include audio support so students can hear each word
          before they type it.
        </p>
      </div>

      <!-- Lists -->
      {challengeLists.length === 0 ? (
        <div class="rounded-2xl border border-line bg-app-cloud p-8 text-center">
          <p class="text-base text-ink-soft">
            Challenge lists are being prepared. Check back soon, or{' '}
            <a href="/spelling-lists" class="font-semibold text-brand-blue hover:underline">
              browse the full library
            </a>{' '}
            in the meantime.
          </p>
        </div>
      ) : (
        <section aria-labelledby="lists-heading" class="mb-12">
          <h2 id="lists-heading" class="mb-4 font-display text-lg font-semibold text-ink">
            All Challenge Lists
            <span class="ml-2 text-sm font-normal text-ink-faint">
              {challengeLists.length} {challengeLists.length === 1 ? 'list' : 'lists'}
            </span>
          </h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {challengeLists.map((entry) => (
              <SpellingListCard
                href={`/spelling-lists/${entry.data.category}/${entry.data.urlSlug}`}
                category={entry.data.category}
                title={entry.data.title}
                description={entry.data.description}
                difficulty={entry.data.difficulty}
                durationMinutes={entry.data.estimatedDurationMinutes}
                wordCount={entry.data.words.length}
              />
            ))}
          </div>
        </section>
      )}

      <!-- Guidance -->
      {challengeLists.length > 0 && (
        <section aria-labelledby="guidance-heading" class="mb-12 rounded-2xl border border-line bg-app-cloud p-6">
          <h2 id="guidance-heading" class="mb-2 font-display text-base font-semibold text-ink">
            How to approach challenge spelling practice
          </h2>
          <p class="text-sm leading-relaxed text-ink-soft">
            These lists work best when a student is genuinely comfortable with grade-level words and
            ready for something harder. Start with{' '}
            <strong class="font-semibold text-ink">Tier 1: Roots and Patterns</strong> to build
            awareness of how roots, prefixes, and suffixes work together. Move to{' '}
            <strong class="font-semibold text-ink">Tier 2: Greek and Latin Roots</strong> for more
            advanced root study. <strong class="font-semibold text-ink">Academic Vocabulary</strong>{' '}
            is a good preparation for reading across subjects in upper elementary and middle school.
            There is no need to complete every list — pick the one that matches the student's
            current need.
          </p>
        </section>
      )}

      <!-- Related categories -->
      <nav aria-label="Related spelling list categories" class="mb-10">
        <p class="mb-3 text-sm font-semibold text-ink">Explore other categories</p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/spelling-lists/grade-level"
            class="inline-flex items-center rounded-xl border border-line bg-white px-4 py-2 text-sm font-medium text-ink-soft transition hover:border-brand-blue/40 hover:text-brand-blue"
          >
            Grade-Level
          </a>
          <a
            href="/spelling-lists/phonics"
            class="inline-flex items-center rounded-xl border border-line bg-white px-4 py-2 text-sm font-medium text-ink-soft transition hover:border-brand-blue/40 hover:text-brand-blue"
          >
            Phonics
          </a>
          <a
            href="/spelling-lists/sight-words"
            class="inline-flex items-center rounded-xl border border-line bg-white px-4 py-2 text-sm font-medium text-ink-soft transition hover:border-brand-blue/40 hover:text-brand-blue"
          >
            Sight Words
          </a>
        </div>
      </nav>

      <!-- Back to library -->
      <p>
        <a
          href="/spelling-lists"
          class="inline-flex items-center gap-1 text-sm font-semibold text-brand-blue hover:underline"
        >
          ← Back to the Spelling Lists Library
        </a>
      </p>
    </div>
  </main>

  <SiteFooter />
</Layout>
