---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import WordListPreview from '@/components/WordListPreview.astro';
import RelatedListCards from '@/components/RelatedListCards.astro';
import SourceAttribution from '@/components/SourceAttribution.astro';
import { isPublished, resolveListRefs, toPlayableWords, getListCollection } from '@/lib/content/spellingLists';
import { categoryLabels, difficultyLabels } from '@/lib/content/categoryMeta';
import { getListPath } from '@/lib/content/learningPaths';

export async function getStaticPaths() {
  const entries = (await getCollection('spelling-lists')).filter(isPublished);
  const allCollections = await getCollection('spelling-collections');

  return entries.map((entry) => ({
    params: { category: entry.data.category, slug: entry.data.urlSlug },
    props: { entry, allEntries: entries, allCollections },
  }));
}

const { entry, allEntries, allCollections } = Astro.props;
const { data } = entry;

const { Content } = await entry.render();

const related = resolveListRefs(data.relatedLists, allEntries);
const prerequisites = resolveListRefs(data.prerequisiteLists, allEntries);
const next = resolveListRefs(data.nextLists, allEntries);

const playWords = toPlayableWords(entry);
const DEFAULT_SESSION_SIZE = 10;
const quickPracticeWords = playWords.slice(0, DEFAULT_SESSION_SIZE);
const quickPracticeWordsJson = JSON.stringify(quickPracticeWords);
const fullCollectionWordsJson = JSON.stringify(playWords);
const showFullCollectionOption = playWords.length > quickPracticeWords.length;

function listLink(e: (typeof allEntries)[number]) {
  return `/spelling-lists/${e.data.category}/${e.data.urlSlug}`;
}

const categoryLabel = categoryLabels[data.category] ?? data.category;
const difficultyLabel = difficultyLabels[data.difficulty] ?? data.difficulty;
const listPath = getListPath(data.id);
const listCollection = getListCollection(data.id, allCollections);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Spelling Lists Library', href: '/spelling-lists' },
  { label: categoryLabel },
  { label: data.title },
];

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://spellingwords.app');

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};

const gradeDisplay = data.grade ? (data.grade === 'K' ? 'Kindergarten' : `Grade ${data.grade}`) : null;
const durationDisplay = `About ${data.estimatedDurationMinutes} ${data.estimatedDurationMinutes === 1 ? 'minute' : 'minutes'}`;
---

<Layout
  title={`${data.title} — spellingwords`}
  description={data.description}
  ogType="article"
  jsonLd={breadcrumbJsonLd}
>
  <SiteHeader variant="discovery" currentPath="/spelling-lists" />

  <main id="main-content">
    <article class="mx-auto max-w-3xl px-6 py-12 md:py-16">

      <!-- Breadcrumbs -->
      <div class="mb-6">
        <Breadcrumbs items={breadcrumbItems} />
      </div>

      <!-- List identity -->
      <header class="mb-6">
        <div class="mb-2 flex flex-wrap items-center gap-2">
          {gradeDisplay && (
            <span class="rounded-full border border-line bg-app-cloud px-2.5 py-0.5 text-xs font-semibold text-ink-soft">
              {gradeDisplay}
            </span>
          )}
          <span class="rounded-full border border-line bg-app-cloud px-2.5 py-0.5 text-xs font-semibold text-ink-soft">
            {categoryLabel}
          </span>
        </div>
        <h1 class="font-display text-2xl font-semibold text-ink md:text-3xl">{data.title}</h1>
        <p class="mt-2 max-w-2xl text-base leading-relaxed text-ink-soft">{data.description}</p>
      </header>

      <!-- Trust ribbon -->
      <div
        class="mb-8 flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-t border-line py-3 text-xs font-semibold text-ink-soft"
        aria-label="List details"
      >
        <span>Curated list</span>
        <span aria-hidden="true" class="text-line">·</span>
        <span>Audio supported</span>
        <span aria-hidden="true" class="text-line">·</span>
        <span>{data.words.length} {data.words.length === 1 ? 'word' : 'words'}</span>
        <span aria-hidden="true" class="text-line">·</span>
        <span>{durationDisplay}</span>
        {gradeDisplay && (
          <>
            <span aria-hidden="true" class="text-line">·</span>
            <span>{gradeDisplay}</span>
          </>
        )}
        <span aria-hidden="true" class="text-line">·</span>
        <span>{difficultyLabel}</span>
      </div>

      <!-- Educational introduction -->
      <section class="mb-8" aria-labelledby="intro-heading">
        <h2 id="intro-heading" class="sr-only">About this list</h2>
        {data.shortAnswer ? (
          <p class="max-w-2xl rounded-xl border border-brand-blue/20 bg-brand-blue/5 px-5 py-4 text-sm leading-relaxed text-ink">
            {data.shortAnswer}
          </p>
        ) : null}

        <!-- Collection / learning path context -->
        <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:flex-wrap">
          {listCollection && (
            <div class="inline-flex items-center gap-2 rounded-lg border border-line bg-app-cloud px-3 py-2 text-sm text-ink-soft">
              <span>Part of the{' '}
                <a
                  href={`/spelling-lists/collections/${listCollection.data.urlSlug}`}
                  class="font-semibold text-ink hover:text-brand-blue hover:underline"
                >
                  {listCollection.data.title}
                </a>
                {' '}collection
              </span>
            </div>
          )}
          {listPath && (
            <div class="inline-flex items-center gap-2 rounded-lg border border-line bg-app-cloud px-3 py-2 text-sm text-ink-soft">
              <span>Part of the{' '}
                <a href="/spelling-lists" class="font-semibold text-ink hover:text-brand-blue hover:underline">
                  {listPath.title}
                </a>
                {' '}learning path
              </span>
            </div>
          )}
        </div>
      </section>

      <!-- Practice CTA -->
      <section class="mb-10" aria-labelledby="practice-heading">
        <h2 id="practice-heading" class="mb-4 font-display text-lg font-semibold text-ink">
          Ready to practice?
        </h2>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <button
            id="btn-start-test"
            type="button"
            data-words={quickPracticeWordsJson}
            class="flex-1 rounded-full bg-brand-blue px-7 py-4 text-base font-bold text-white shadow-[0_8px_24px_-8px_rgba(47,111,237,0.45)] transition hover:bg-brand-blue-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue active:scale-[0.97] sm:flex-none"
            aria-label={`Start a ${quickPracticeWords.length}-word spelling practice session for ${data.title}`}
          >
            Start Practice — {quickPracticeWords.length} words
          </button>
          {showFullCollectionOption && (
            <button
              id="btn-start-full-list"
              type="button"
              data-words={fullCollectionWordsJson}
              class="flex-1 rounded-full border-2 border-brand-blue bg-white px-7 py-4 text-base font-bold text-brand-blue transition hover:bg-brand-blue/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-blue active:scale-[0.97] sm:flex-none"
              aria-label={`Practice all ${playWords.length} words in ${data.title}`}
            >
              Practice all {playWords.length} words
            </button>
          )}
        </div>
        <p class="mt-3 max-w-xl text-sm text-ink-soft">
          {showFullCollectionOption
            ? `A standard session is ${quickPracticeWords.length} words — a comfortable amount for one sitting. You can also practice all ${playWords.length} words at once.`
            : `Each session practices all ${playWords.length} words. No timer, no score — just spelling.`}
        </p>
        <p id="start-test-status" class="mt-2 text-xs text-feedback-incorrect" aria-live="polite" aria-atomic="true"></p>
      </section>

      <!-- Word list -->
      <section class="mb-10" aria-labelledby="word-list-heading">
        <h2 id="word-list-heading" class="mb-3 font-display text-lg font-semibold text-ink">
          All {data.words.length} words in this list
        </h2>
        <WordListPreview words={data.words} />
      </section>

      <!-- How to use this list -->
      <section class="mb-10" aria-labelledby="how-to-use-heading">
        <h2 id="how-to-use-heading" class="mb-3 font-display text-lg font-semibold text-ink">
          How to use this list
        </h2>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div class="rounded-xl border border-line bg-app-cloud px-4 py-3">
            <p class="text-sm font-semibold text-ink">Weekly spelling homework</p>
            <p class="mt-1 text-xs leading-relaxed text-ink-soft">
              Assign the list Monday, practice mid-week, and test on Friday. A session takes about {data.estimatedDurationMinutes} minutes.
            </p>
          </div>
          <div class="rounded-xl border border-line bg-app-cloud px-4 py-3">
            <p class="text-sm font-semibold text-ink">Five-minute warm-up</p>
            <p class="mt-1 text-xs leading-relaxed text-ink-soft">
              Start or end a reading session with a quick run through a few words. No pressure, no score.
            </p>
          </div>
          <div class="rounded-xl border border-line bg-app-cloud px-4 py-3">
            <p class="text-sm font-semibold text-ink">Classroom practice</p>
            <p class="mt-1 text-xs leading-relaxed text-ink-soft">
              Project on a screen and work through words together, or let students practice independently at their own pace.
            </p>
          </div>
          <div class="rounded-xl border border-line bg-app-cloud px-4 py-3">
            <p class="text-sm font-semibold text-ink">Homeschool</p>
            <p class="mt-1 text-xs leading-relaxed text-ink-soft">
              Weave into your language arts rotation. The word list is always visible so children can study before they practice.
            </p>
          </div>
        </div>
      </section>

      <!-- Skill tags -->
      {data.skillTags.length > 0 && (
        <section class="mb-8" aria-labelledby="skill-tags-heading">
          <h2 id="skill-tags-heading" class="mb-3 font-display text-base font-semibold text-ink">
            What this list practices
          </h2>
          <div class="flex flex-wrap gap-2">
            {data.skillTags.map((tag) => (
              <span class="rounded-full border border-line bg-app-cloud px-3 py-1 text-xs font-semibold text-ink-soft">
                {tag}
              </span>
            ))}
          </div>
        </section>
      )}

      <!-- Why these words matter (markdown body) -->
      <section class="mb-10" aria-labelledby="why-heading">
        <h2 id="why-heading" class="mb-3 font-display text-lg font-semibold text-ink">
          Why these words matter
        </h2>
        <div class="prose prose-sm max-w-2xl text-ink-soft">
          <Content />
        </div>
      </section>

      <!-- Learning progression -->
      {(prerequisites.length > 0 || related.length > 0 || next.length > 0) && (
        <section class="mb-10" aria-labelledby="progression-heading">
          <h2 id="progression-heading" class="mb-1 font-display text-lg font-semibold text-ink">
            Learning progression
          </h2>
          <p class="mb-5 text-sm text-ink-soft">
            Spelling is cumulative. These lists build on each other — work through them in order for the best results.
          </p>
          <RelatedListCards heading="Before this list" items={prerequisites} listLink={listLink} />
          <RelatedListCards heading="Related lists" items={related} listLink={listLink} />
          <RelatedListCards heading="After this list" items={next} listLink={listLink} />
        </section>
      )}

      <SourceAttribution source={data.canonicalSource} />

      <!-- Future ad placement: below source attribution, above footer -->
    </article>
  </main>

  <SiteFooter />
</Layout>

<script>
  import { encodeWordList } from '@/lib/words';

  interface SpellingWordData { word: string; hint?: string; exampleSentence?: string; phonicsPattern?: string[] }

  const statusEl = document.getElementById('start-test-status');

  function getSpellingWords(button: HTMLButtonElement): SpellingWordData[] {
    try {
      const parsed: unknown = JSON.parse(button.dataset.words ?? '[]');
      if (!Array.isArray(parsed)) return [];
      return parsed.filter((e): e is SpellingWordData =>
        typeof e === 'object' && e !== null && typeof (e as SpellingWordData).word === 'string'
      );
    } catch {
      return [];
    }
  }

  function handleStart(event: Event): void {
    const button = event.currentTarget as HTMLButtonElement;
    const words = getSpellingWords(button);
    if (words.length === 0) return;

    const result = encodeWordList(words.map((w) => w.word));
    if (!result.ok) {
      if (statusEl) {
        statusEl.textContent =
          result.code === 'payload_too_long'
            ? 'This list is too long to start automatically. Please try a shorter list.'
            : 'Could not start this spelling test. Please try again.';
      }
      return;
    }

    // Persist rich word data (with exampleSentence etc.) so play.astro can read it.
    try {
      sessionStorage.setItem(`sw:words:${result.payload}`, JSON.stringify(words));
    } catch { /* quota exceeded or private browsing — non-fatal */ }

    window.location.href = `/play?list=${result.payload}`;
  }

  document.getElementById('btn-start-test')?.addEventListener('click', handleStart);
  document.getElementById('btn-start-full-list')?.addEventListener('click', handleStart);
</script>
