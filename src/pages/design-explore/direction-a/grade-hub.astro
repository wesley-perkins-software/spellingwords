---
import Proto from './_shared/Proto.astro';
import Header from './_shared/Header.astro';
import Footer from './_shared/Footer.astro';

const strands = [
  {
    accent: 'sun',
    name: 'Core Spelling',
    description:
      'Grade 1 core spelling patterns build on phonics fundamentals — short vowels, consonant blends, and simple long-vowel patterns like silent e.',
    href: '/design-explore/direction-a/skill',
    label: 'Explore Grade 1 Core Spelling →',
  },
  {
    accent: 'teal',
    name: 'High-Frequency Words',
    description:
      'The most common words Grade 1 readers and writers need to know by sight, organized into manageable practice sets.',
    href: '#',
    label: 'Explore Grade 1 High-Frequency Words →',
  },
  {
    accent: 'periwinkle',
    name: 'Themed Spelling Practice',
    description:
      'Grade-level word lists organized around themes and topics young learners are excited to write about.',
    href: '#',
    label: 'Explore Grade 1 Themed Spelling Practice →',
  },
];
---

<Proto
  title="Grade 1 Spelling Words — Direction A prototype"
  description="Grade 1 spelling practice: Core Spelling, High-Frequency Words, and Themed Spelling Practice."
>
  <Header currentPath="/design-explore/direction-a/grade-hub" />

  <main id="main">
    <div class="wrap page-shell">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol>
          <li><a href="/design-explore/direction-a/">Home</a></li>
          <li aria-current="page">Grade 1 Spelling Words</li>
        </ol>
      </nav>

      <header class="page-header">
        <h1>Grade 1 Spelling Words</h1>
        <p class="page-lede">
          Grade 1 spelling builds directly on phonics fundamentals — short vowels, consonant
          blends, and the earliest long-vowel patterns like silent e — alongside the
          high-frequency words first-grade readers and writers use every day.
        </p>
      </header>

      <section class="strands" aria-label="Grade 1 spelling strands">
        {
          strands.map((strand) => (
            <article class={`strand-card tint-${strand.accent}`}>
              <h2>{strand.name}</h2>
              <p>{strand.description}</p>
              <a class="strand-link" href={strand.href}>
                {strand.label}
              </a>
            </article>
          ))
        }
      </section>

      <section class="begin-panel tint-brand" aria-labelledby="begin-heading">
        <h2 id="begin-heading">Where to begin</h2>
        <p>
          Most Grade 1 students are ready to start with Core Spelling, especially short-vowel
          CVC words like the ones in <a href="/design-explore/direction-a/skill">Short Vowels: CVC Words</a>. If
          your student already reads short-vowel words comfortably, High-Frequency Words is a
          good next step.
        </p>
      </section>

      <nav class="grade-nav" aria-label="Adjacent grades">
        <a class="grade-nav-link" href="#">← Kindergarten Spelling Words</a>
        <a class="grade-nav-link grade-nav-next" href="#">Grade 2 Spelling Words →</a>
      </nav>

      <a class="back-link" href="/design-explore/direction-a/">← Back to all grades</a>
    </div>
  </main>

  <Footer />

  <style>
    .page-shell {
      padding-block: clamp(2rem, 5vw, 3rem) clamp(3rem, 6vw, 4.5rem);
    }

    /* ============================= BREADCRUMB ============================= */
    .breadcrumb ol {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      list-style: none;
      margin: 0 0 1.5rem;
      padding: 0;
      font-size: 0.9rem;
      color: var(--ink-faint);
    }

    .breadcrumb li:not(:last-child)::after {
      content: '/';
      margin-left: 0.5rem;
      color: var(--border-strong);
    }

    .breadcrumb a {
      text-decoration: none;
      color: var(--ink-soft);
      font-weight: 600;
    }

    .breadcrumb a:hover {
      color: var(--brand);
    }

    .breadcrumb li[aria-current='page'] {
      color: var(--ink);
      font-weight: 700;
    }

    /* ============================= PAGE HEADER ============================= */
    .page-header {
      max-width: 68ch;
      margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    }

    .page-header h1 {
      font-size: clamp(2rem, 4.2vw, 2.75rem);
      line-height: 1.1;
    }

    .page-lede {
      margin-top: 1rem;
      font-size: 1.1rem;
      line-height: 1.65;
      color: var(--ink-soft);
    }

    /* ============================= STRANDS ============================= */
    .strands {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
      margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    }

    .strand-card {
      border-radius: var(--radius-lg);
      padding: 1.75rem 1.5rem;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      transition: box-shadow 0.15s ease, transform 0.15s ease;
    }

    .strand-card:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }

    .strand-card h2 {
      font-size: 1.25rem;
    }

    .strand-card p {
      font-size: 0.98rem;
      line-height: 1.6;
      flex-grow: 1;
    }

    .strand-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      margin-top: 0.5rem;
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
    }

    .strand-link:hover {
      text-decoration: underline;
    }

    /* Tint recipe: full pastel fill + matching-hue border + strong-ink
       heading/link + body copy blended toward the hue rather than flat gray,
       so text reads as belonging to the tinted card. Soft tint = organization,
       never used on an action button (see color-semantic rule). */
    .tint-sun {
      background: var(--sun-tint);
      border: 1px solid var(--sun);
    }
    .tint-sun h2,
    .tint-sun .strand-link {
      color: var(--sun-ink);
    }
    .tint-sun p {
      color: color-mix(in srgb, var(--sun-ink) 82%, var(--ink-soft));
    }

    .tint-teal {
      background: var(--teal-tint);
      border: 1px solid var(--teal);
    }
    .tint-teal h2,
    .tint-teal .strand-link {
      color: var(--teal-ink);
    }
    .tint-teal p {
      color: color-mix(in srgb, var(--teal-ink) 82%, var(--ink-soft));
    }

    .tint-periwinkle {
      background: var(--periwinkle-tint);
      border: 1px solid var(--periwinkle);
    }
    .tint-periwinkle h2,
    .tint-periwinkle .strand-link {
      color: var(--periwinkle-ink);
    }
    .tint-periwinkle p {
      color: color-mix(in srgb, var(--periwinkle-ink) 82%, var(--ink-soft));
    }

    /* ============================= BEGIN PANEL ============================= */
    .begin-panel {
      border-radius: var(--radius-lg);
      padding: clamp(1.75rem, 3.5vw, 2.5rem);
      box-shadow: var(--shadow-sm);
      margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    }

    .tint-brand {
      background: var(--brand-tint);
      border: 1px solid var(--brand);
    }

    .begin-panel h2 {
      font-size: 1.3rem;
      color: var(--brand-strong);
    }

    .begin-panel p {
      margin-top: 0.75rem;
      color: color-mix(in srgb, var(--brand-strong) 78%, var(--ink-soft));
      font-size: 1.05rem;
      line-height: 1.65;
      max-width: 68ch;
    }

    .begin-panel a {
      color: var(--brand-strong);
      font-weight: 800;
      text-decoration: underline;
    }

    /* ============================= GRADE NAV ============================= */
    .grade-nav {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding-block: 1.25rem;
      margin-bottom: 1.75rem;
    }

    .grade-nav-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      text-decoration: none;
      font-weight: 700;
      color: var(--brand-strong);
      font-size: 0.98rem;
    }

    .grade-nav-link:hover {
      color: var(--brand);
      text-decoration: underline;
    }

    .grade-nav-next {
      margin-left: auto;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.92rem;
      color: var(--ink-faint);
    }

    .back-link:hover {
      color: var(--ink-soft);
    }

    /* ============================= RESPONSIVE ============================= */
    @media (max-width: 900px) {
      .strands {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 560px) {
      .grade-nav {
        flex-direction: column;
      }

      .grade-nav-next {
        margin-left: 0;
      }
    }
  </style>
</Proto>
