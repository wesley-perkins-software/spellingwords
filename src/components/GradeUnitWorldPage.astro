---
// The one real Grade Unit page template for the world-kit direction —
// every Grade Unit renders through this exact component, parameterized only
// by which content entry it's given. See docs/architecture/CONTENT_MODEL.md
// §3 for the Grade Unit contract this implements:
//   stable id, one curriculum grade, roadmap placement, grade-specific
//   title/objective, parent-friendly explanation, one primary Practice Set
//   (8-16 words), prerequisite/next sequence context, zero..n linked Skills,
//   status.
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { getCanonicalUrl } from '@/lib/canonicalUrl';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SourceAttribution from '@/components/SourceAttribution.astro';
import WorldWordField from '@/components/WorldWordField.astro';
import WorldChip from '@/components/WorldChip.astro';
import WorldRelatedCards from '@/components/WorldRelatedCards.astro';
import {
  isPublished,
  resolveListRefs,
  toPlayableWords,
} from '@/lib/content/spellingLists';
import { getSequenceNeighbors } from '@/lib/content/navigationSequence';
import { categoryLabels } from '@/lib/content/categoryMeta';
import { getKindergartenRoadmapPosition } from '@/lib/content/kindergartenProgression';
import { buildGradeUnitSequence } from '@/lib/content/gradeUnitSequence';
import { gradeConfig } from '@/lib/content/gradeConfig';
import { getCanonicalGradeRouteById, getCanonicalListPath, getGradeHubPath } from '@/lib/content/canonicalGradeRoutes';
import { assignWorldKitsInSequence, pickWorldKit } from '@/lib/theme/worldKits';

interface Props {
  listId: string;
}

const { listId } = Astro.props;

const entries = (await getCollection('spelling-lists')).filter(isPublished);
const entry = entries.find((e) => e.data.id === listId);

if (!entry) {
  throw new Error(`GradeUnitWorldPage: "${listId}" not found in the spelling-lists collection.`);
}
if (entry.data.contentRole !== 'grade-unit') {
  throw new Error(
    `GradeUnitWorldPage: "${listId}" has contentRole "${entry.data.contentRole ?? 'undefined'}", not "grade-unit".`,
  );
}

const { data } = entry;
const { Content } = await entry.render();

// Review First / Next Step are derived from the canonical CORE_SPELLING_SEQUENCE
// array, not authored frontmatter — see docs/planning/CANONICAL_NAVIGATION_RELATIONSHIPS.md.
// Core Spelling intentionally has no Explore More bucket. `relatedLists`
// remains available to the non-Core renderers, but it is never resolved here.
const { prerequisiteId, nextId } = getSequenceNeighbors(data.id);
const prerequisites = resolveListRefs(prerequisiteId ? [prerequisiteId] : [], entries);
const next = resolveListRefs(nextId ? [nextId] : [], entries);
const conceptSkills = data.skillIds
  .map((id) => entries.find((e) => e.data.id === id))
  .filter((e): e is (typeof entries)[number] => e !== undefined);

const playWords = toPlayableWords(entry);
const playWordsJson = JSON.stringify(playWords);

const words = data.words.map((w) => (typeof w === 'string' ? w : w.word));

const gradeUnitSequence = buildGradeUnitSequence(entries);
const kitAssignments = assignWorldKitsInSequence(gradeUnitSequence);
const kit = kitAssignments.get(data.id) ?? pickWorldKit(data.id);
const roadmapPosition = getKindergartenRoadmapPosition(data.id);
const gradeHub = gradeConfig.find((g) => g.grade === data.grade);
const gradeLabel = data.grade === 'K' ? 'Kindergarten' : data.grade ? `Grade ${data.grade}` : null;
const categoryLabel = categoryLabels[data.category] ?? data.category;

function listLink(e: (typeof entries)[number]) {
  return getCanonicalListPath(e.data);
}

// One true black, everywhere on the page — hierarchy comes from spacing,
// weight, and opacity, not from swapping in a different near-black per kit.
const WORLD_INK = '#000000';

const worldStyleVars = [
  `--world-sky-top:${kit.palette.skyTop}`,
  `--world-sky-mid:${kit.palette.skyMid}`,
  `--world-sky-horizon:${kit.palette.skyHorizon}`,
  `--world-ink:${WORLD_INK}`,
  `--world-accent:${kit.palette.accent}`,
  `--world-accent-soft:${kit.palette.accentSoft}`,
].join('; ');

const canonicalGradeRoute = getCanonicalGradeRouteById(data.id);
if (!canonicalGradeRoute || !gradeHub) {
  throw new Error(`GradeUnitWorldPage: "${data.id}" has no canonical grade route or grade hub.`);
}
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: gradeHub.label, href: getGradeHubPath(canonicalGradeRoute.grade) },
  { label: data.title },
];

const canonicalURL = getCanonicalUrl(Astro.url.pathname, Astro.site);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, canonicalURL.origin).toString() } : {}),
  })),
};

const faqJsonLd =
  data.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: data.faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : null;

const jsonLdBlocks = [breadcrumbJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])];
---

<Layout
  title={`${data.title} — spellingwords`}
  description={data.description}
  ogType="article"
  jsonLd={jsonLdBlocks}
>
  <SiteHeader variant="discovery" currentPath={getGradeHubPath(canonicalGradeRoute.grade)} />

  <main id="main-content">
    <!-- World Hero — the memorable, child-facing arrival moment -->
    <section class="world-hero" style={worldStyleVars}>
      <div class="world-hero-inner">
        <div class="crumbs-row">
          <Breadcrumbs items={breadcrumbItems} />
        </div>

        {
          roadmapPosition && gradeHub && (
            <p class="roadmap">
              <a href={gradeHub.hubHref}>{gradeHub.label} Spelling</a>
              <span aria-hidden="true"> · </span>
              Step {roadmapPosition.step} of {roadmapPosition.total}
            </p>
          )
        }

        <div class="chip-row">
          {gradeLabel && <WorldChip label={gradeLabel} variant="outline" />}
          <WorldChip label={categoryLabel} variant="solid" />
        </div>

        <h1 class="hero-title">{data.title}</h1>
        <p class="hero-desc">{data.description}</p>

        <div class="cta-row">
          <button
            id={`btn-practice-${data.id}`}
            type="button"
            data-words={playWordsJson}
            data-list-title={data.title}
            class="practice-token"
            aria-label={`Practice these ${playWords.length} words in ${data.title}`}
          >
            Start practice
          </button>
          <p id={`start-test-status-${data.id}`} class="cta-error" aria-live="polite" aria-atomic="true" />
        </div>
      </div>

      <h2 class="word-field-heading">
        The {words.length} words to practice in this step
      </h2>
      <WorldWordField words={words} skillTags={data.skillTags} />
    </section>

    <!-- Is this the right list? -->
    {
      data.readinessSignals.length > 0 && (
        <section class="section-block readiness-section" style={worldStyleVars}>
          <h2 class="section-heading">These spelling words are a good fit for students who...</h2>
          <ul class="readiness-list">
            {data.readinessSignals.map((signal) => (
              <li>
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--world-accent)"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span>{signal}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- Why these words (real markdown body, quieter, paper-toned) -->
    <section class="why-section" style={worldStyleVars} aria-labelledby="why-heading">
      <div class="why-inner">
        <h2 id="why-heading" class="section-heading">Why these words — and what they teach</h2>
        <div class="why-body">
          <Content />
        </div>
      </div>
    </section>

    <!-- Go deeper on the linked Skill(s) -->
    {
      conceptSkills.length > 0 && (
        <section class="section-block" style={worldStyleVars}>
          <h2 class="section-heading">
            {conceptSkills.length > 1 ? 'Go deeper on these patterns' : 'Go deeper on this pattern'}
          </h2>
          <div class="go-deeper-list">
            {conceptSkills.map((skill) => (
              <a href={listLink(skill)} class="go-deeper-card">
                <span class="go-deeper-title">
                  Learn more about {skill.data.title.replace(/ Words$/i, '')} →
                </span>
                <span class="go-deeper-desc">
                  {skill.data.title} is the full guide to this pattern — how it works, what trips
                  children up, and where else it's taught.
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- FAQ -->
    {
      data.faq.length > 0 && (
        <section class="section-block faq-section" style={worldStyleVars}>
          <h2 class="section-heading">Frequently asked questions</h2>
          <div class="faq-list">
            {data.faq.map((item) => (
              <div class="faq-item">
                <h3 class="faq-question">{item.question}</h3>
                <p class="faq-answer">{item.answer}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Where to go from here -->
    {
      (prerequisites.length > 0 || next.length > 0) && (
        <section class="section-block whats-next" style={worldStyleVars}>
          <h2 class="section-heading">Where to go from here</h2>
          <WorldRelatedCards heading="Review first" items={prerequisites} listLink={listLink} />
          <WorldRelatedCards heading="Next step" items={next} listLink={listLink} />
        </section>
      )
    }

    {
      data.canonicalSource && (
        <div class="mx-auto max-w-2xl px-5 py-8 sm:px-6 md:max-w-3xl">
          <SourceAttribution source={data.canonicalSource} />
        </div>
      )
    }
  </main>

  <SiteFooter />
</Layout>

<style>
  .world-hero {
    position: relative;
    overflow: hidden;
    padding-bottom: 24px;
    background: linear-gradient(
      180deg,
      var(--world-sky-top) 0%,
      var(--world-sky-mid) 42%,
      var(--world-sky-horizon) 72%,
      #fbf8f3 100%
    );
  }

  .world-hero-inner {
    position: relative;
    z-index: 2;
    max-width: 56rem;
    margin: 0 auto;
    padding: 28px 22px 8px;
  }

  .crumbs-row {
    display: inline-flex;
    background: color-mix(in srgb, #000 6%, transparent);
    border-radius: 999px;
    padding: 5px 13px;
    opacity: 0.75;
    margin-bottom: 20px;
  }
  .crumbs-row :global(a),
  .crumbs-row :global(span) {
    color: var(--world-ink) !important;
  }
  .crumbs-row :global(a) {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--world-ink) 35%, transparent);
    text-underline-offset: 2px;
  }
  .crumbs-row :global(a:hover) {
    text-decoration-color: var(--world-ink);
  }

  .roadmap {
    display: inline-flex;
    align-items: center;
    background: color-mix(in srgb, #000 6%, transparent);
    border-radius: 999px;
    padding: 5px 13px;
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 13px;
    color: var(--world-ink);
    opacity: 0.72;
    margin: 0 0 14px;
  }
  .roadmap a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--world-ink) 40%, transparent);
    text-underline-offset: 2px;
  }
  .roadmap a:hover {
    text-decoration-color: var(--world-ink);
  }

  .chip-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .hero-title {
    font-family: 'Baloo 2', sans-serif;
    font-weight: 700;
    font-size: clamp(32px, 5.6vw, 50px);
    line-height: 1.1;
    color: var(--world-ink);
    margin: 0 0 16px;
    text-wrap: balance;
    max-width: 20ch;
  }

  .hero-desc {
    font-family: 'Nunito', sans-serif;
    font-size: 17px;
    line-height: 1.7;
    color: var(--world-ink);
    opacity: 0.82;
    max-width: 54ch;
    margin: 0 0 28px;
  }

  .cta-row {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .practice-token {
    font-family: 'Baloo 2', sans-serif;
    font-weight: 700;
    font-size: 18px;
    color: var(--world-ink);
    background: linear-gradient(180deg, var(--world-accent-soft), var(--world-accent));
    border: none;
    border-radius: 999px;
    padding: 15px 34px;
    cursor: pointer;
    box-shadow:
      0 6px 0 0 color-mix(in srgb, var(--world-accent) 55%, black),
      0 14px 24px -10px color-mix(in srgb, var(--world-accent) 60%, transparent);
    transition:
      transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.15s ease;
  }
  .practice-token:hover {
    transform: translateY(-2px);
  }
  .practice-token:active {
    transform: translateY(4px);
    box-shadow: 0 2px 0 0 color-mix(in srgb, var(--world-accent) 55%, black) !important;
  }
  .practice-token:focus-visible {
    outline: 2px solid var(--world-ink);
    outline-offset: 3px;
  }

  .cta-error {
    width: 100%;
    order: 3;
    font-family: 'Nunito', sans-serif;
    font-size: 13.5px;
    color: #a83226;
    min-height: 1.1em;
  }

  .word-field-heading {
    position: relative;
    z-index: 2;
    text-align: center;
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 12.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--world-ink);
    opacity: 0.55;
    margin: 6px 0 28px;
  }

  /* ---------- below-the-fold sections: paper ground, world-accent touches ---------- */
  .why-section {
    background: #fbf8f3;
    padding: 56px 20px;
  }
  .why-inner {
    max-width: 42rem;
    margin: 0 auto;
    border-left: 3px solid var(--world-accent);
    padding-left: 22px;
  }
  .why-body {
    margin-top: 18px;
    max-width: 40rem;
    font-family: 'Nunito', sans-serif;
    font-size: 17px;
    line-height: 1.7;
    color: var(--world-ink);
  }
  .why-body :global(p) {
    margin: 0 0 1.15em;
  }
  .why-body :global(strong) {
    font-weight: 800;
    color: var(--world-ink);
  }
  .why-body :global(em) {
    font-style: italic;
  }
  .why-body :global(h2),
  .why-body :global(h3) {
    font-family: 'Baloo 2', sans-serif;
    font-weight: 600;
    color: var(--world-ink);
    margin: 1.7em 0 0.55em;
    line-height: 1.3;
  }
  .why-body :global(h2) {
    font-size: 19px;
  }
  .why-body :global(h3) {
    font-size: 16.5px;
  }
  .why-body :global(h2:first-child),
  .why-body :global(h3:first-child) {
    margin-top: 0;
  }
  .why-body :global(ul),
  .why-body :global(ol) {
    margin: 0 0 1.15em;
    padding-left: 1.35em;
  }
  .why-body :global(li) {
    margin-bottom: 0.5em;
    padding-left: 0.2em;
  }
  .why-body :global(ul li) {
    list-style: disc;
  }
  .why-body :global(ul li)::marker {
    color: var(--world-accent);
  }
  .why-body :global(ol li) {
    list-style: decimal;
  }
  .why-body :global(ol li)::marker {
    color: var(--world-accent);
    font-weight: 800;
  }

  .section-block {
    background: #fbf8f3;
    padding: 8px 20px 56px;
    max-width: 42rem;
    margin: 0 auto;
  }
  /* Directly follows the hero, not another section-block, so it needs its
     own top breathing room rather than the 8px other sections use. */
  .readiness-section {
    padding-top: 48px;
    padding-bottom: 8px;
  }
  .readiness-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .readiness-list li {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    font-family: 'Nunito', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: var(--world-ink);
    opacity: 0.85;
  }
  .readiness-list svg {
    flex-shrink: 0;
    margin-top: 3px;
  }
  .section-heading {
    font-family: 'Baloo 2', sans-serif;
    font-weight: 600;
    font-size: 20px;
    color: var(--world-ink);
    margin: 0 0 16px;
  }

  .go-deeper-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .go-deeper-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 16px;
    background: #ffffff;
    border: 1px solid color-mix(in srgb, var(--world-ink) 10%, transparent);
    box-shadow: 0 2px 8px -3px color-mix(in srgb, var(--world-ink) 14%, transparent);
    padding: 18px 20px 18px 22px;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      border-color 0.15s ease;
  }
  .go-deeper-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: var(--world-accent);
  }
  .go-deeper-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--world-ink) 16%, transparent);
    box-shadow: 0 12px 24px -14px color-mix(in srgb, var(--world-ink) 35%, transparent);
  }
  .go-deeper-card:focus-visible {
    outline: 2px solid var(--world-accent);
    outline-offset: 2px;
  }
  .go-deeper-title {
    display: block;
    font-family: 'Baloo 2', sans-serif;
    font-weight: 600;
    font-size: 17px;
    line-height: 1.3;
    color: var(--world-accent);
  }
  .go-deeper-desc {
    display: block;
    margin-top: 4px;
    font-family: 'Nunito', sans-serif;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--world-ink);
    opacity: 0.75;
  }

  /* Slightly deeper than the #fbf8f3 paper used everywhere else below the
     fold — deliberate: the FAQ block sits between two #fbf8f3 sections and
     needs its own visual "beat" so the page doesn't read as one unbroken
     paper field for its full scroll length. */
  .faq-section {
    background: #f3ede3;
  }
  .faq-list {
    background: #ffffff;
    border: 1px solid color-mix(in srgb, var(--world-ink) 10%, transparent);
    box-shadow: 0 2px 8px -3px color-mix(in srgb, var(--world-ink) 10%, transparent);
    border-radius: 16px;
    overflow: hidden;
  }
  .faq-item {
    padding: 20px 22px;
    border-bottom: 1px solid color-mix(in srgb, var(--world-ink) 8%, transparent);
  }
  .faq-item:last-child {
    border-bottom: none;
  }
  .faq-question {
    font-family: 'Baloo 2', sans-serif;
    font-weight: 600;
    font-size: 16px;
    line-height: 1.35;
    margin: 0 0 7px;
    color: var(--world-ink);
  }
  .faq-answer {
    font-family: 'Nunito', sans-serif;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--world-ink);
    opacity: 0.75;
    margin: 0;
  }

  @media (max-width: 640px) {
    .why-inner {
      padding-left: 16px;
    }
  }
</style>

<script>
  import { encodeWordList } from '@/lib/words';

  interface SpellingWordData {
    word: string;
    hint?: string;
    exampleSentence?: string;
    phonicsPattern?: string[];
  }

  function getSpellingWords(button: HTMLButtonElement): SpellingWordData[] {
    try {
      const parsed: unknown = JSON.parse(button.dataset.words ?? '[]');
      if (!Array.isArray(parsed)) return [];
      return parsed.filter(
        (e): e is SpellingWordData =>
          typeof e === 'object' && e !== null && typeof (e as SpellingWordData).word === 'string',
      );
    } catch {
      return [];
    }
  }

  function handleStart(event: Event): void {
    const button = event.currentTarget as HTMLButtonElement;
    const statusEl = document.getElementById(button.id.replace('btn-practice-', 'start-test-status-'));
    const words = getSpellingWords(button);
    if (words.length === 0) return;

    const result = encodeWordList(words.map((w) => w.word));
    if (!result.ok) {
      if (statusEl) {
        statusEl.textContent =
          result.code === 'payload_too_long'
            ? 'There are too many words to start automatically. Please try a shorter list.'
            : 'Could not start this spelling test. Please try again.';
      }
      return;
    }

    const listTitle = button.dataset.listTitle ?? '';
    try {
      sessionStorage.setItem(`sw:words:${result.payload}`, JSON.stringify(words));
      if (listTitle) sessionStorage.setItem(`sw:title:${result.payload}`, listTitle);
    } catch {
      /* quota exceeded or private browsing — non-fatal */
    }

    window.location.href = `/play?list=${result.payload}`;
  }

  document.querySelectorAll<HTMLButtonElement>('[id^="btn-practice-"]').forEach((btn) => {
    btn.addEventListener('click', handleStart);
  });
</script>
